{% doc %}
  @prompt
    做一个quiz，有四个答案，五个问题，每个问题五个选项
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-quiz-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-quiz-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-quiz-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
  }

  .ai-quiz-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
  }

  .ai-quiz-progress-{{ ai_gen_id }} {
    width: 100%;
    height: 8px;
    background-color: {{ block.settings.progress_bg_color }};
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 32px;
  }

  .ai-quiz-progress-bar-{{ ai_gen_id }} {
    height: 100%;
    background-color: {{ block.settings.progress_color }};
    transition: width 0.3s ease;
    width: 0%;
  }

  .ai-quiz-question-{{ ai_gen_id }} {
    display: none;
    animation: ai-quiz-fade-in-{{ ai_gen_id }} 0.4s ease;
  }

  .ai-quiz-question-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-quiz-question-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.question_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 24px;
    font-weight: 600;
  }

  .ai-quiz-options-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-quiz-option-{{ ai_gen_id }} {
    padding: 16px 20px;
    background-color: {{ block.settings.option_bg_color }};
    border: 2px solid {{ block.settings.option_border_color }};
    border-radius: {{ block.settings.option_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.option_size }}px;
    text-align: left;
  }

  .ai-quiz-option-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.option_hover_bg_color }};
    border-color: {{ block.settings.option_hover_border_color }};
    transform: translateX(4px);
  }

  .ai-quiz-option-{{ ai_gen_id }}.selected {
    background-color: {{ block.settings.option_selected_bg_color }};
    border-color: {{ block.settings.option_selected_border_color }};
  }

  .ai-quiz-navigation-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    margin-top: 32px;
    gap: 16px;
  }

  .ai-quiz-button-{{ ai_gen_id }} {
    padding: 14px 28px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    font-size: 16px;
    transition: all 0.3s ease;
    font-weight: 600;
  }

  .ai-quiz-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-quiz-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-quiz-button-secondary-{{ ai_gen_id }} {
    background-color: transparent;
    color: {{ block.settings.text_color }};
    border: 2px solid {{ block.settings.button_bg_color }};
  }

  .ai-quiz-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
  }

  .ai-quiz-results-{{ ai_gen_id }} {
    display: none;
    text-align: center;
    animation: ai-quiz-fade-in-{{ ai_gen_id }} 0.4s ease;
  }

  .ai-quiz-results-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-quiz-results-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
  }

  .ai-quiz-results-message-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    margin-bottom: 24px;
  }

  .ai-quiz-restart-{{ ai_gen_id }} {
    margin-top: 24px;
  }

  @keyframes ai-quiz-fade-in-{{ ai_gen_id }} {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-quiz-container-{{ ai_gen_id }} {
      padding: 24px 16px;
    }

    .ai-quiz-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-quiz-question-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.question_size }}px * 0.85);
    }

    .ai-quiz-navigation-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-quiz-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<quiz-component-{{ ai_gen_id }} class="ai-quiz-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-quiz-header-{{ ai_gen_id }}">
    {% if block.settings.quiz_title != blank %}
      <h2 class="ai-quiz-title-{{ ai_gen_id }}">{{ block.settings.quiz_title }}</h2>
    {% endif %}
    {% if block.settings.quiz_description != blank %}
      <div class="ai-quiz-description-{{ ai_gen_id }}">{{ block.settings.quiz_description }}</div>
    {% endif %}
  </div>

  <div class="ai-quiz-progress-{{ ai_gen_id }}">
    <div class="ai-quiz-progress-bar-{{ ai_gen_id }}" data-progress-bar></div>
  </div>

  <div class="ai-quiz-questions-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign question_key = 'question_' | append: i
        assign option_1_key = 'q' | append: i | append: '_option_1'
        assign option_2_key = 'q' | append: i | append: '_option_2'
        assign option_3_key = 'q' | append: i | append: '_option_3'
        assign option_4_key = 'q' | append: i | append: '_option_4'
        assign option_5_key = 'q' | append: i | append: '_option_5'

        assign question = block.settings[question_key]
        assign option_1 = block.settings[option_1_key]
        assign option_2 = block.settings[option_2_key]
        assign option_3 = block.settings[option_3_key]
        assign option_4 = block.settings[option_4_key]
        assign option_5 = block.settings[option_5_key]
      %}

      <div class="ai-quiz-question-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}" data-question="{{ i }}">
        <h3 class="ai-quiz-question-title-{{ ai_gen_id }}">{{ i }}. {{ question }}</h3>
        <div class="ai-quiz-options-{{ ai_gen_id }}">
          {% if option_1 != blank %}
            <div class="ai-quiz-option-{{ ai_gen_id }}" data-option="1">{{ option_1 }}</div>
          {% endif %}
          {% if option_2 != blank %}
            <div class="ai-quiz-option-{{ ai_gen_id }}" data-option="2">{{ option_2 }}</div>
          {% endif %}
          {% if option_3 != blank %}
            <div class="ai-quiz-option-{{ ai_gen_id }}" data-option="3">{{ option_3 }}</div>
          {% endif %}
          {% if option_4 != blank %}
            <div class="ai-quiz-option-{{ ai_gen_id }}" data-option="4">{{ option_4 }}</div>
          {% endif %}
          {% if option_5 != blank %}
            <div class="ai-quiz-option-{{ ai_gen_id }}" data-option="5">{{ option_5 }}</div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  <div class="ai-quiz-navigation-{{ ai_gen_id }}">
    <button class="ai-quiz-button-{{ ai_gen_id }} ai-quiz-button-secondary-{{ ai_gen_id }}" data-prev-btn disabled>
      {{ block.settings.previous_button_text }}
    </button>
    <button class="ai-quiz-button-{{ ai_gen_id }}" data-next-btn disabled>
      {{ block.settings.next_button_text }}
    </button>
  </div>

  <div class="ai-quiz-results-{{ ai_gen_id }}" data-results>
    <h2 class="ai-quiz-results-title-{{ ai_gen_id }}">{{ block.settings.results_title }}</h2>
    <div class="ai-quiz-results-message-{{ ai_gen_id }}">{{ block.settings.results_message }}</div>
    <button class="ai-quiz-button-{{ ai_gen_id }} ai-quiz-restart-{{ ai_gen_id }}" data-restart-btn>
      {{ block.settings.restart_button_text }}
    </button>
  </div>
</quiz-component-{{ ai_gen_id }}>

<script>
  (function() {
    class QuizComponent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentQuestion = 1;
        this.totalQuestions = 5;
        this.answers = {};
      }

      connectedCallback() {
        this.progressBar = this.querySelector('[data-progress-bar]');
        this.questions = this.querySelectorAll('.ai-quiz-question-{{ ai_gen_id }}');
        this.prevBtn = this.querySelector('[data-prev-btn]');
        this.nextBtn = this.querySelector('[data-next-btn]');
        this.results = this.querySelector('[data-results]');
        this.restartBtn = this.querySelector('[data-restart-btn]');

        this.setupEventListeners();
        this.updateProgress();
      }

      setupEventListeners() {
        this.querySelectorAll('.ai-quiz-option-{{ ai_gen_id }}').forEach(option => {
          option.addEventListener('click', (e) => this.selectOption(e));
        });

        this.prevBtn.addEventListener('click', () => this.previousQuestion());
        this.nextBtn.addEventListener('click', () => this.nextQuestion());
        this.restartBtn.addEventListener('click', () => this.restartQuiz());
      }

      selectOption(e) {
        const questionEl = e.target.closest('.ai-quiz-question-{{ ai_gen_id }}');
        const questionNum = questionEl.dataset.question;
        
        questionEl.querySelectorAll('.ai-quiz-option-{{ ai_gen_id }}').forEach(opt => {
          opt.classList.remove('selected');
        });
        
        e.target.classList.add('selected');
        this.answers[questionNum] = e.target.dataset.option;
        
        this.nextBtn.disabled = false;
      }

      previousQuestion() {
        if (this.currentQuestion > 1) {
          this.currentQuestion--;
          this.showQuestion();
          this.updateProgress();
        }
      }

      nextQuestion() {
        if (this.currentQuestion < this.totalQuestions) {
          this.currentQuestion++;
          this.showQuestion();
          this.updateProgress();
        } else {
          this.showResults();
        }
      }

      showQuestion() {
        this.questions.forEach(q => q.classList.remove('active'));
        const currentQ = this.querySelector(`[data-question="${this.currentQuestion}"]`);
        currentQ.classList.add('active');

        this.prevBtn.disabled = this.currentQuestion === 1;
        
        const hasAnswer = this.answers[this.currentQuestion];
        this.nextBtn.disabled = !hasAnswer;
        
        if (this.currentQuestion === this.totalQuestions && hasAnswer) {
          this.nextBtn.textContent = '{{ block.settings.submit_button_text }}';
        } else {
          this.nextBtn.textContent = '{{ block.settings.next_button_text }}';
        }
      }

      updateProgress() {
        const progress = ((this.currentQuestion - 1) / this.totalQuestions) * 100;
        this.progressBar.style.width = progress + '%';
      }

      showResults() {
        this.querySelector('.ai-quiz-questions-{{ ai_gen_id }}').style.display = 'none';
        this.querySelector('.ai-quiz-navigation-{{ ai_gen_id }}').style.display = 'none';
        this.results.classList.add('active');
        this.progressBar.style.width = '100%';
      }

      restartQuiz() {
        this.currentQuestion = 1;
        this.answers = {};
        
        this.querySelector('.ai-quiz-questions-{{ ai_gen_id }}').style.display = 'block';
        this.querySelector('.ai-quiz-navigation-{{ ai_gen_id }}').style.display = 'flex';
        this.results.classList.remove('active');
        
        this.querySelectorAll('.ai-quiz-option-{{ ai_gen_id }}').forEach(opt => {
          opt.classList.remove('selected');
        });
        
        this.showQuestion();
        this.updateProgress();
      }
    }

    customElements.define('quiz-component-{{ ai_gen_id }}', QuizComponent{{ ai_gen_id }});
  })();
</script>

