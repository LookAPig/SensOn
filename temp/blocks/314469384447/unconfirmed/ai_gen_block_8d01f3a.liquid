{% doc %}
  @prompt
    做一个quiz，有四个答案，五个问题，每个问题五个选项, 结论页面分成一个单独可以设计的, 答案页面我需要一个单独section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-quiz-results-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-quiz-results-container-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_align }};
    box-shadow: {{ block.settings.shadow_intensity }}px {{ block.settings.shadow_intensity | times: 2 }}px {{ block.settings.shadow_intensity | times: 3 }}px rgba(0, 0, 0, 0.1);
  }

  .ai-quiz-results-image-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.image_spacing }}px;
  }

  .ai-quiz-results-image-{{ ai_gen_id }} img {
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin: 0 auto;
    display: block;
  }

  .ai-quiz-results-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
    margin: 0 auto {{ block.settings.image_spacing }}px;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
  }

  .ai-quiz-results-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-quiz-results-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-quiz-results-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-quiz-results-message-{{ ai_gen_id }} {
    font-size: {{ block.settings.message_size }}px;
    color: {{ block.settings.message_color }};
    margin-bottom: {{ block.settings.message_spacing }}px;
    line-height: 1.6;
  }

  .ai-quiz-results-message-{{ ai_gen_id }} p {
    margin: 0 0 16px;
  }

  .ai-quiz-results-message-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-quiz-results-cta-container-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    justify-content: {{ block.settings.buttons_alignment }};
    flex-wrap: wrap;
    margin-bottom: {{ block.settings.buttons_spacing }}px;
  }

  .ai-quiz-results-cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.primary_btn_bg }};
    color: {{ block.settings.primary_btn_text }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: 2px solid {{ block.settings.primary_btn_bg }};
  }

  .ai-quiz-results-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.primary_btn_hover_bg }};
    border-color: {{ block.settings.primary_btn_hover_bg }};
    transform: translateY(-2px);
  }

  .ai-quiz-results-cta-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.secondary_btn_bg }};
    color: {{ block.settings.secondary_btn_text }};
    border: 2px solid {{ block.settings.secondary_btn_border }};
  }

  .ai-quiz-results-cta-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.secondary_btn_hover_bg }};
    color: {{ block.settings.secondary_btn_hover_text }};
    border-color: {{ block.settings.secondary_btn_hover_border }};
  }

  .ai-quiz-results-features-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 24px;
    margin-top: {{ block.settings.features_spacing }}px;
  }

  .ai-quiz-results-feature-{{ ai_gen_id }} {
    padding: 24px;
    background-color: {{ block.settings.feature_bg_color }};
    border-radius: {{ block.settings.feature_border_radius }}px;
    border: 1px solid {{ block.settings.feature_border_color }};
  }

  .ai-quiz-results-feature-icon-{{ ai_gen_id }} {
    font-size: 32px;
    margin-bottom: 12px;
  }

  .ai-quiz-results-feature-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-quiz-results-feature-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_text_size }}px;
    color: {{ block.settings.message_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-quiz-results-divider-{{ ai_gen_id }} {
    width: {{ block.settings.divider_width }}px;
    height: {{ block.settings.divider_height }}px;
    background-color: {{ block.settings.divider_color }};
    margin: {{ block.settings.divider_spacing }}px auto;
    border-radius: {{ block.settings.divider_height | divided_by: 2 }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-quiz-results-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 16px;
    }

    .ai-quiz-results-container-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.7 }}px;
    }

    .ai-quiz-results-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.75);
    }

    .ai-quiz-results-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.85);
    }

    .ai-quiz-results-message-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.message_size }}px * 0.9);
    }

    .ai-quiz-results-cta-container-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: stretch;
    }

    .ai-quiz-results-cta-{{ ai_gen_id }} {
      width: 100%;
      text-align: center;
    }

    .ai-quiz-results-features-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-quiz-results-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-quiz-results-container-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <div class="ai-quiz-results-image-{{ ai_gen_id }}">
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      </div>
    {% elsif block.settings.show_placeholder_image %}
      <div class="ai-quiz-results-image-placeholder-{{ ai_gen_id }}">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <div class="ai-quiz-results-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
    {% endif %}

    {% if block.settings.title != blank %}
      <h2 class="ai-quiz-results-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    {% if block.settings.show_divider %}
      <div class="ai-quiz-results-divider-{{ ai_gen_id }}"></div>
    {% endif %}

    {% if block.settings.message != blank %}
      <div class="ai-quiz-results-message-{{ ai_gen_id }}">{{ block.settings.message }}</div>
    {% endif %}

    {% if block.settings.primary_btn_label != blank or block.settings.secondary_btn_label != blank %}
      <div class="ai-quiz-results-cta-container-{{ ai_gen_id }}">
        {% if block.settings.primary_btn_label != blank %}
          <a href="{{ block.settings.primary_btn_link }}" class="ai-quiz-results-cta-{{ ai_gen_id }}">
            {{ block.settings.primary_btn_label }}
          </a>
        {% endif %}

        {% if block.settings.secondary_btn_label != blank %}
          <a href="{{ block.settings.secondary_btn_link }}" class="ai-quiz-results-cta-{{ ai_gen_id }} ai-quiz-results-cta-secondary-{{ ai_gen_id }}">
            {{ block.settings.secondary_btn_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.show_features %}
      <div class="ai-quiz-results-features-{{ ai_gen_id }}">
        {% if block.settings.feature_1_title != blank %}
          <div class="ai-quiz-results-feature-{{ ai_gen_id }}">
            {% if block.settings.feature_1_icon != blank %}
              <div class="ai-quiz-results-feature-icon-{{ ai_gen_id }}">{{ block.settings.feature_1_icon }}</div>
            {% endif %}
            <h3 class="ai-quiz-results-feature-title-{{ ai_gen_id }}">{{ block.settings.feature_1_title }}</h3>
            {% if block.settings.feature_1_text != blank %}
              <p class="ai-quiz-results-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_1_text }}</p>
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.feature_2_title != blank %}
          <div class="ai-quiz-results-feature-{{ ai_gen_id }}">
            {% if block.settings.feature_2_icon != blank %}
              <div class="ai-quiz-results-feature-icon-{{ ai_gen_id }}">{{ block.settings.feature_2_icon }}</div>
            {% endif %}
            <h3 class="ai-quiz-results-feature-title-{{ ai_gen_id }}">{{ block.settings.feature_2_title }}</h3>
            {% if block.settings.feature_2_text != blank %}
              <p class="ai-quiz-results-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_2_text }}</p>
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.feature_3_title != blank %}
          <div class="ai-quiz-results-feature-{{ ai_gen_id }}">
            {% if block.settings.feature_3_icon != blank %}
              <div class="ai-quiz-results-feature-icon-{{ ai_gen_id }}">{{ block.settings.feature_3_icon }}</div>
            {% endif %}
            <h3 class="ai-quiz-results-feature-title-{{ ai_gen_id }}">{{ block.settings.feature_3_title }}</h3>
            {% if block.settings.feature_3_text != blank %}
              <p class="ai-quiz-results-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_3_text }}</p>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

