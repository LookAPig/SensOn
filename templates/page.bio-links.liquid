{% layout 'senson-bio-links' %}

<div id="senson-links" class="senson-links" aria-busy="true">
  <main class="senson-links__main">
    <header class="senson-links__profile">
      <div class="senson-links__logo" id="profile-logo" aria-label="SensOn logo placeholder">
        <span class="senson-links__logo-fallback" aria-hidden="true">S</span>
      </div>
      <p class="senson-links__eyebrow">THE OFFICIAL SPACE</p>
      <p class="senson-links__bio" id="profile-bio">Come for the voice. Stay for the story.</p>
    </header>

    <section id="campaign-section" class="senson-links__campaign-section" aria-label="Featured offer"></section>

    <nav class="senson-links__links-section" aria-label="Explore SensOn">
      <p class="senson-links__section-label">EXPLORE SENSON</p>
      <div id="primary-links" class="senson-links__links"></div>
    </nav>

    <footer class="senson-links__footer">
      <div class="senson-links__footer-rule" aria-hidden="true"></div>
      <p class="senson-links__section-label">FIND US ELSEWHERE</p>
      <nav id="social-links" class="senson-links__socials" aria-label="Social media"></nav>
      <p class="senson-links__footer-note">A little closer, wherever you are.</p>
    </footer>
  </main>
  <div id="link-toast" class="senson-links__toast" role="status" aria-live="polite"></div>
</div>

<script>
/* Edit this file to update content, destinations, order, visibility, and theme. */
window.SENSON_LINKS_CONFIG = {
  profile: {
    name: "SensOn.official",
    bio: "Come for the voice. Stay for the story.",
    logo: "data:image/webp;base64," +
    "" +
    ""
  },

  theme: {
    background: "#eee8f3",
    surface: "#fcf9f6",
    text: "#34233f",
    muted: "#75697e",
    accent: "#4b3058",
    border: "#d9d0df",
    buttonStyle: "soft", // "soft", "outline", or "solid"
    buttonRadius: "18px"
  },

  // Official destinations. Existing query parameters are kept exactly as provided.
  destinations: {
    blackFriday: "https://senson.ai/products/senson-s1-wellness-companion",
    webChat: "https://app.senson.ai/?utm_source=Shopify&utm_medium=web&utm_campaign=web_introduction",
    download: "https://apps.apple.com/us/app/senson/id6755462239",
    discordCommunity: "https://discord.gg/zWaEnjzwM9",
    instagram: "https://www.instagram.com/senson_official/",
    tiktok: "https://www.tiktok.com/@senson_official?_r=1&_t=ZS-9BWk4XO9kcG",
    x: "https://x.com/senson_official?s=11",
    youtube: "https://www.youtube.com/@senson_ai"
  },

  campaign: {
    visible: true,
    image: "data:image/webp;base64," +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "" +
    "",
    imageAlt: "Black Friday SensOn offer: $159, originally $299. Shop now through Dec 6 or while the 100 units last.",
    destinationKey: "blackFriday",
    utm: {} // Optional campaign-specific UTM values override global values.
  },

  links: [
    { id: "web-chat", label: "Start Chatting on Web", destinationKey: "webChat", visible: true, style: "featured", order: 1, utm: {} },
    { id: "download", label: "Download SensOn AI", destinationKey: "download", visible: true, order: 2, utm: {} },
    { id: "discord-community", label: "Join Our Discord", destinationKey: "discordCommunity", visible: true, order: 3, utm: {} }
  ],

  socials: [
    { id: "instagram", label: "Instagram", destinationKey: "instagram", visible: true, order: 1 },
    { id: "tiktok", label: "TikTok", destinationKey: "tiktok", visible: true, order: 2 },
    { id: "x", label: "X", destinationKey: "x", visible: true, order: 3 },
    { id: "youtube", label: "YouTube", destinationKey: "youtube", visible: true, order: 4 }
  ],

  utm: {
    enabled: false,
    source: "instagram",
    medium: "social",
    campaign: "bio_links",
    content: ""
  },

  tracking: {
    enabled: true // Emits a local "senson:link-click" browser event only.
  }
};

(function () {
  "use strict";

  const config = window.SENSON_LINKS_CONFIG;
  const root = document.getElementById("senson-links");
  if (!config || !root) return;

  const iconPaths = {
    instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>',
    tiktok: '<path d="M14 3v10.5a4.5 4.5 0 1 1-4.5-4.5"/><path d="M14 3c.7 3.1 2.8 4.9 6 5v3c-2.6 0-4.6-.8-6-2.3"/>',
    facebook: '<path d="M15 21v-8h3l.5-3H15V8.3c0-1 .4-1.5 1.5-1.5H19V4.1A15 15 0 0 0 16.7 4C13.8 4 12 5.7 12 8.8V10H9v3h3v8"/>',
    x: '<path d="M4 4l16 16M20 4L4 20"/><path d="M4 4h4l12 16h-4L4 4Z"/>',
    youtube: '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="m10 9 5 3-5 3V9Z" fill="currentColor" stroke="none"/>',
    discord: '<path d="M7 6.5c3.2-1.4 6.8-1.4 10 0l1.7 2.7c.8 1.5 1.3 3.3 1.4 5.3-1.4 1.1-2.6 1.7-4 2.2l-.8-1.1M7 6.5 5.3 9.2c-.8 1.5-1.3 3.3-1.4 5.3 1.4 1.1 2.6 1.7 4 2.2l.8-1.1M8 17.8c2.5 1.4 5.5 1.4 8 0"/><circle cx="9" cy="12" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="12" r="1" fill="currentColor" stroke="none"/>',
    email: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>'
  };

  const arrowSvg = '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h13m-5-5 5 5-5 5"/></svg>';

  function makeIcon(name) {
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">' + (iconPaths[name] || "") + "</svg>";
  }

  function setText(id, value) {
    const node = document.getElementById(id);
    if (node) node.textContent = value || "";
  }

  function sortedVisible(items) {
    return (Array.isArray(items) ? items : [])
      .filter(item => item && item.visible !== false)
      .sort((a, b) => (a.order || 0) - (b.order || 0));
  }

  function destination(rawUrl, itemUtm) {
    const raw = typeof rawUrl === "string" ? rawUrl.trim() : "";
    if (!raw || raw === "#") return "";
    if (/^mailto:[^\s]+$/i.test(raw)) return raw;
    if (!/^(https?:\/\/|\/|\.\/|\.\.\/)/i.test(raw)) return "";
    try {
      const parsed = new URL(raw, window.location.href);
      if (!["http:", "https:", "file:"].includes(parsed.protocol)) return "";
      if (config.utm && config.utm.enabled) {
        const values = Object.assign({}, config.utm, itemUtm || {});
        ["source", "medium", "campaign", "content"].forEach(key => {
          if (values[key]) parsed.searchParams.set("utm_" + key, values[key]);
        });
      }
      return parsed.href;
    } catch (_) {
      return "";
    }
  }

  let toastTimer;
  function showPlaceholderMessage() {
    const toast = document.getElementById("link-toast");
    toast.textContent = "This link is coming soon.";
    toast.classList.add("is-visible");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove("is-visible"), 2600);
  }

  function makeAction(item, section, className) {
    const rawUrl = config.destinations && config.destinations[item.destinationKey];
    const href = destination(rawUrl, item.utm);
    const element = document.createElement(href ? "a" : "button");
    element.className = className;
    if (href) element.href = href;
    else {
      element.type = "button";
      element.dataset.pending = "true";
      element.title = "Destination pending";
    }
    element.dataset.linkId = item.id || "";
    element.dataset.section = section;
    if (href && /^https?:/i.test(href) && new URL(href).origin !== window.location.origin) {
      element.rel = "noopener noreferrer";
    }
    element.addEventListener("click", () => {
      if (config.tracking && config.tracking.enabled) {
        window.dispatchEvent(new CustomEvent("senson:link-click", {
          detail: {
            id: item.id || "",
            section,
            label: item.label || item.cta || "",
            destination: href || null,
            placeholder: !href,
            timestamp: new Date().toISOString()
          }
        }));
      }
      if (!href) {
        showPlaceholderMessage();
      }
    });
    return element;
  }

  function renderProfile() {
    setText("profile-bio", config.profile && config.profile.bio);
    const logo = document.getElementById("profile-logo");
    if (config.profile && config.profile.logo) {
      const image = document.createElement("img");
      image.src = config.profile.logo;
      image.alt = (config.profile.name || "SensOn AI") + " logo";
      image.addEventListener("load", () => {
        logo.replaceChildren(image);
        logo.removeAttribute("aria-label");
      });
    }
  }

  function renderCampaign() {
    const section = document.getElementById("campaign-section");
    const campaign = config.campaign || {};
    if (campaign.visible === false) {
      section.hidden = true;
      return;
    }
    if (!campaign.image) {
      section.hidden = true;
      return;
    }
    const banner = makeAction({ id: "black-friday", label: "Black Friday offer", destinationKey: campaign.destinationKey, utm: campaign.utm }, "campaign", "senson-links__campaign");
    banner.setAttribute("aria-label", "Explore the SensOn Black Friday offer");
    const img = document.createElement("img");
    img.className = "senson-links__campaign-image";
    img.src = campaign.image;
    img.alt = campaign.imageAlt || "SensOn Black Friday offer";
    img.width = 2800;
    img.height = 1400;
    banner.append(img);
    section.append(banner);
  }

  function renderLinks() {
    const list = document.getElementById("primary-links");
    const links = sortedVisible(config.links);
    if (!links.length) {
      document.querySelector(".senson-links__links-section").hidden = true;
      return;
    }
    links.forEach((item, index) => {
      const link = makeAction(item, "primary", "senson-links__link" + (item.style === "featured" ? " senson-links__link--featured" : ""));
      link.style.setProperty("--link-index", index);
      const text = document.createElement("span");
      text.textContent = item.label || "";
      link.append(text);
      link.insertAdjacentHTML("beforeend", arrowSvg);
      list.append(link);
    });
  }

  function renderSocials() {
    const list = document.getElementById("social-links");
    sortedVisible(config.socials).forEach(item => {
      if (!iconPaths[item.id]) return;
      const link = makeAction(item, "social", "senson-links__social");
      link.setAttribute("aria-label", item.label || item.id);
      link.title = item.label || item.id;
      link.innerHTML = makeIcon(item.id);
      list.append(link);
    });
  }

  function applyTheme() {
    const theme = config.theme || {};
    const vars = {
      "--sl-bg": theme.background,
      "--sl-surface": theme.surface,
      "--sl-text": theme.text,
      "--sl-muted": theme.muted,
      "--sl-accent": theme.accent,
      "--sl-border": theme.border,
      "--sl-radius": theme.buttonRadius
    };
    Object.entries(vars).forEach(([name, value]) => {
      if (typeof value === "string" && value) root.style.setProperty(name, value);
    });
    const style = ["soft", "outline", "solid"].includes(theme.buttonStyle) ? theme.buttonStyle : "soft";
    root.dataset.buttonStyle = style;
  }

  applyTheme();
  renderProfile();
  renderCampaign();
  renderLinks();
  renderSocials();
  root.removeAttribute("aria-busy");
})();

</script>
