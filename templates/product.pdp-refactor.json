        "liquid_Dn6djg": {
          "type": "liquid",
          "name": "Add to Cart And Buy Now",
          "settings": {
            "liquid": "{%- assign target_product = all_products['senson-s1-wellness-companion'] -%}\n{%- assign target_variant = target_product.selected_or_first_available_variant -%}\n\n<style>\n  #pdp-add-to-cart .atc-section {\n    width: 100%;\n    background-color: #fff;\n  }\n\n  #pdp-add-to-cart .atc-container {\n    width: 100%;\n    margin: 0 auto;\n    box-sizing: border-box;\n    padding: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    align-items: flex-start;\n  }\n\n  #pdp-add-to-cart .atc-buttons {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    width: 100%;\n  }\n\n  #pdp-add-to-cart .atc-btn-form {\n    width: 100%;\n    margin: 0;\n  }\n\n  #pdp-add-to-cart .atc-btn {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 100%;\n    padding: 12px 24px;\n    border-radius: 1000px;\n    box-sizing: border-box;\n    cursor: pointer;\n    border: none;\n    background: none;\n    -webkit-appearance: none;\n    appearance: none;\n    font-family: inherit;\n    position: relative;\n    overflow: hidden;\n    transition: opacity 0.3s ease;\n  }\n\n  #pdp-add-to-cart .atc-btn:disabled {\n    opacity: 0.6;\n    cursor: not-allowed;\n  }\n\n  #pdp-add-to-cart .atc-btn-secondary {\n    border: 1px solid #f287ec;\n    background-color: #fff;\n    gap: 8px;\n  }\n\n  #pdp-add-to-cart .atc-btn-primary {\n    background: linear-gradient(to right, #f287ec, #8543ff);\n  }\n\n  #pdp-add-to-cart .atc-cart-icon {\n    width: 18px;\n    height: 18px;\n    object-fit: contain;\n    flex-shrink: 0;\n  }\n\n  #pdp-add-to-cart .atc-btn-secondary .atc-btn-text {\n    background: linear-gradient(to right, #f287ec, #8543ff);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    color: transparent;\n    font-size: 16px;\n    font-weight: 500;\n    line-height: 1.1;\n    white-space: nowrap;\n    flex-shrink: 0;\n  }\n\n  #pdp-add-to-cart .atc-btn-primary .atc-btn-text {\n    color: #fff;\n    font-size: 16px;\n    font-weight: 500;\n    line-height: 1.1;\n    white-space: nowrap;\n    flex-shrink: 0;\n  }\n\n  /* Loading State Styles */\n  #pdp-add-to-cart .atc-btn.is-loading .atc-btn-text,\n  #pdp-add-to-cart .atc-btn.is-loading .atc-cart-icon {\n    opacity: 0;\n  }\n  \n  #pdp-add-to-cart .atc-btn .atc-loader {\n    display: none;\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    width: 20px;\n    height: 20px;\n    border-radius: 50%;\n    animation: atc-spin 0.8s linear infinite;\n  }\n\n  #pdp-add-to-cart .atc-btn.is-loading .atc-loader {\n    display: block;\n  }\n\n  #pdp-add-to-cart .atc-btn-primary .atc-loader {\n    border: 2px solid rgba(255, 255, 255, 0.3);\n    border-top-color: #fff;\n  }\n\n  #pdp-add-to-cart .atc-btn-secondary .atc-loader {\n    border: 2px solid rgba(133, 67, 255, 0.3);\n    border-top-color: #8543ff;\n  }\n\n  @keyframes atc-spin {\n    to { transform: translate(-50%, -50%) rotate(360deg); }\n  }\n\n  /* PC Overrides */\n  @media (min-width: 1000px) {\n    #pdp-add-to-cart .atc-container {\n      gap: 16px;\n      padding: 0;\n    }\n\n    #pdp-add-to-cart .atc-buttons {\n      flex-direction: row;\n      align-items: flex-start;\n    }\n\n    #pdp-add-to-cart .atc-btn-form {\n      flex: 1 0 0;\n    }\n  }\n</style>\n\n<section id=\"pdp-add-to-cart\" class=\"atc-section\">\n  <div class=\"atc-container\">\n    <div class=\"atc-buttons\">\n      \n      <!-- Add to Cart Form -->\n      <form action=\"{{ routes.cart_url }}/add\" method=\"post\" enctype=\"multipart/form-data\" class=\"atc-btn-form\" id=\"atc-add-to-cart-form\">\n        <input type=\"hidden\" name=\"id\" value=\"{{ target_variant.id }}\">\n        <input type=\"hidden\" name=\"quantity\" value=\"1\">\n        <button \n          type=\"submit\" \n          name=\"add\"\n          class=\"atc-btn atc-btn-secondary\" \n          id=\"atc-add-to-cart-btn\" \n          data-btn-addToCart\n          {% unless target_variant.available %}disabled{% endunless %}\n        >\n          <img src=\"https://cdn.shopify.com/s/files/1/0775/2446/7967/files/shopping-cart-2-line.svg?v=1774850088\" alt=\"cart\" class=\"atc-cart-icon\" />\n          <span class=\"atc-btn-text\">\n            {% if target_variant.available %}\n              Add to Cart\n            {% else %}\n              Sold Out\n            {% endif %}\n          </span>\n          <span class=\"atc-loader\"></span>\n        </button>\n      </form>\n      \n      <!-- Buy Now Form / Shop with Pride -->\n      <form action=\"{{ routes.cart_url }}/add\" method=\"post\" enctype=\"multipart/form-data\" class=\"atc-btn-form\" id=\"atc-buy-now-form\">\n        <input type=\"hidden\" name=\"id\" value=\"{{ target_variant.id }}\">\n        <input type=\"hidden\" name=\"quantity\" value=\"1\">\n        <button \n          type=\"button\" \n          class=\"atc-btn atc-btn-primary\" \n          id=\"atc-buy-now-btn\" \n          data-btn-buyNow\n          {% unless target_variant.available %}disabled{% endunless %}\n        >\n          <span class=\"atc-btn-text\">\n            {% if target_variant.available %}\n              Shop with Pride\n            {% else %}\n              Sold Out\n            {% endif %}\n          </span>\n          <span class=\"atc-loader\"></span>\n        </button>\n      </form>\n\n    </div>\n  </div>\n</section>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    \n    // Add to Cart Logic - strictly prevents page jump, fetches add.js, then opens drawer natively\n    document.addEventListener('click', function(event) {\n      var atcBtn = event.target.closest('#atc-add-to-cart-btn');\n      if (atcBtn) {\n        event.preventDefault(); // 阻止表单默认提交和跳转\n        event.stopPropagation(); // 阻止冒泡\n        \n        if (atcBtn.classList.contains('is-loading') || atcBtn.disabled) return;\n        \n        var form = atcBtn.closest('form');\n        if (form) {\n          atcBtn.classList.add('is-loading');\n          var formData = new FormData(form);\n          \n          fetch(window.Shopify.routes.root + 'cart/add.js', {\n            method: 'POST',\n            body: formData,\n            headers: {\n              'X-Requested-With': 'XMLHttpRequest'\n            }\n          })\n          .then(function(response) {\n            return response.json();\n          })\n          .then(function(data) {\n             // 1. 先触发变体添加事件，让主题知道有新商品加入\n             document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));\n             document.dispatchEvent(new CustomEvent('cart:build', { bubbles: true }));\n             \n             // 延迟 500 毫秒后，再去模拟点击打开购物车抽屉，等待列表数据渲染完成\n             setTimeout(function() {\n                 atcBtn.classList.remove('is-loading');\n                 \n                 // 核心：通过模拟点击顶部的购物车Icon，唤醒Stretch主题的原生侧边栏 Drawer\n                 var cartIcon = document.querySelector('a[aria-controls=\"cart-drawer\"], a[href=\"/cart\"], .header__cart-link a');\n                 if (cartIcon) {\n                   cartIcon.click();\n                 }\n             }, 500);\n          })\n          .catch(function(error) {\n            console.error('Add to Cart Error:', error);\n            atcBtn.classList.remove('is-loading');\n          });\n        }\n      }\n    });\n\n    // Buy Now Logic (now \"Shop with Pride\") - Only purchase this specific product (uses Shopify Permalinks)\n    document.addEventListener('click', function(event) {\n      var buyNowBtn = event.target.closest('#atc-buy-now-btn');\n      if (buyNowBtn) {\n        event.preventDefault(); // 阻止表单默认提交和跳转\n        event.stopPropagation(); // 阻止冒泡\n        \n        if (buyNowBtn.classList.contains('is-loading') || buyNowBtn.disabled) return;\n        \n        buyNowBtn.classList.add('is-loading');\n        var form = buyNowBtn.closest('form');\n        var variantId = form.querySelector('input[name=\"id\"]').value;\n        var quantity = form.querySelector('input[name=\"quantity\"]').value || 1;\n        \n        // 使用 Shopify 的 Permalinks 直达结账，跳过当前购物车中的其他商品\n        // 格式: /cart/{variant_id}:{quantity}\n        var checkoutUrl = window.Shopify.routes.root + 'cart/' + variantId + ':' + quantity;\n        window.location.href = checkoutUrl;\n      }\n    });\n\n  });\n</script>"
          }
        },
