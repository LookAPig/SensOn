          "settings": {
            "liquid": "<style>\n  /* 仅在移动端（屏幕宽度小于 1000px）隐藏右下角的放大按钮 */\n  @media screen and (max-width: 999px) {\n    .product-gallery open-lightbox-button {\n      display: none !important;\n    }\n    \n    /* 提升用户体验：让图片在移动端看起来是可点击的 */\n    .product-gallery__media[data-media-type=\"image\"] {\n      cursor: zoom-in;\n      -webkit-tap-highlight-color: transparent; /* 移除移动端点击的高亮背景 */\n    }\n\n  }\n</style>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    // 使用事件代理监听整个文档的点击。\n    // 这样做的好处是：Impact 主题在切换变体时会触发 <product-rerender> 局部刷新 DOM，\n    // 事件代理可以确保刷新后的新图片依然能响应点击。\n    document.body.addEventListener('click', function(e) {\n      \n      // 1. 拦截条件：仅针对移动端 (Impact 主题的移动端断点通常为 999px)\n      if (window.innerWidth >= 1000) return;\n\n      // 2. 判断点击的目标是否为产品图\n      const mediaContainer = e.target.closest('.product-gallery__media[data-media-type=\"image\"]');\n\n      if (mediaContainer) {\n        // 3. 获取对应的放大按钮\n        // Impact 有时在 Grid 布局下每个图带一个 btn，在 Carousel 下是全局统一一个 btn\n        let zoomBtn = mediaContainer.querySelector('open-lightbox-button button');\n        \n        if (!zoomBtn) {\n           const gallery = e.target.closest('.product-gallery');\n           if (gallery) {\n             zoomBtn = gallery.querySelector('open-lightbox-button button');\n           }\n        }\n\n        // 4. 如果找到了被隐藏的放大按钮，则触发模拟点击\n        if (zoomBtn) {\n          // 阻止默认行为（防止某些情况下图片拖拽等）\n          e.preventDefault(); \n          zoomBtn.click();\n        }\n      }\n    });\n  });\n</script>"
