aysinline webkit-playsinline x5-playsinline\n          style=\"position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;pointer-events:none;\"></video>\n        <div id=\"swpt-h5-mute-btn-4\" onclick=\"event.stopPropagation();swptH5ToggleMute()\"\n          style=\"position:absolute;top:12px;right:12px;width:26px;height:26px;border-radius:50px;background:rgba(0,0,0,0.35);backdrop-filter:blur(8px);display:none;align-items:center;justify-content:center;cursor:pointer;z-index:2;\">\n          <img id=\"swpt-h5-mute-icon-4\" src=\"https://cdn.shopify.com/s/files/1/0775/2446/7967/files/volume-mute-fill.svg?v=1772728781\" style=\"width:14px;height:14px\"/>\n        </div>\n        <div id=\"swpt-h5-play-btn-4\"\n          style=\"position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:32px;height:32px;border-radius:100px;background:rgba(0,0,0,0.35);backdrop-filter:blur(24px);display:flex;align-items:center;justify-content:center;z-index:2;pointer-events:none;\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0775/2446/7967/files/play-fill.svg?v=1772728781\" style=\"width:14px;height:14px\"/>\n        </div>\n        <div style=\"position:absolute;width:100%;right:0;bottom:0;left:0;background:linear-gradient(0deg,#000,rgba(128,128,128,0));display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:12px;box-sizing:border-box;z-index:2;\">\n          <div style=\"align-self:stretch;position:relative;line-height:110%;\">Your Story, Felt</div>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<script>\n  var SWPT_TOTAL = 5\n  var swptCurrent = 0\n  var swptMuted = true\n  var swptH5Current = 0\n  var swptH5Muted = true\n  var swptH5Playing = -1\n  var swptH5Swiped = false\n  var CARD_W = 160\n  var CARD_GAP = 12\n\n  var SWPT_ICON_MUTE = 'https://cdn.shopify.com/s/files/1/0775/2446/7967/files/volume-mute-fill.svg?v=1772728781'\n  var SWPT_ICON_VOLUME = 'https://cdn.shopify.com/s/files/1/0775