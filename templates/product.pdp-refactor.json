        "liquid": "<style>\n  #pdp-sticky-nav-section {\n    width: 100%;\n    background-color: #f5f5f5;\n    box-sizing: border-box;\n  }\n  \n  #pdp-sticky-nav-section.is-fixed {\n    position: fixed;\n    top: 0;\n    left: 0;\n    z-index: 998;\n  }\n\n  #pdp-sticky-nav-wrapper {\n    width: 100%;\n    background-color: transparent;\n  }\n  \n  #pdp-sticky-nav-section * {\n    box-sizing: border-box;\n  }\n\n  #pdp-sticky-nav-section .nav-scroll-area {\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n    gap: 24px;\n    padding: 0 16px;\n    height: 48px;\n    overflow-x: auto;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n  }\n\n  #pdp-sticky-nav-section .nav-scroll-area::-webkit-scrollbar {\n    display: none;\n  }\n\n  #pdp-sticky-nav-section .nav-item {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    height: 100%;\n    position: relative;\n    flex-shrink: 0;\n    cursor: pointer;\n  }\n\n  #pdp-sticky-nav-section .nav-item span {\n    font-size: 14px;\n    line-height: 1.4;\n    color: #000;\n    white-space: nowrap;\n    transition: color 0.3s ease;\n  }\n\n  #pdp-sticky-nav-section .nav-item::after {\n    content: '';\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    width: 100%;\n    height: 2px;\n    background-color: #f287ec;\n    transform: scaleX(0);\n    transition: transform 0.3s ease;\n  }\n\n  #pdp-sticky-nav-section .nav-item.is-active::after {\n    transform: scaleX(1);\n  }\n\n  @media (min-width: 1000px) {\n    #pdp-sticky-nav-section .nav-scroll-area {\n      max-width: 1200px;\n      margin: 0 auto;\n      padding: 0 80px;\n      height: 64px;\n      justify-content: center;\n      gap: 60px;\n      overflow-x: visible;\n    }\n\n    #pdp-sticky-nav-section .nav-item {\n      width: auto;\n    }\n\n    #pdp-sticky-nav-section .nav-item span {\n      font-size: 20px;\n    }\n  }\n</style>\n\n<div id=\"pdp-sticky-nav-wrapper\">\n  <section id=\"pdp-sticky-nav-section\">\n    <div class=\"nav-scroll-area\">\n      <!-- Creator Buzz -->\n      <div class=\"nav-item\" data-target-class=\"creator-buzz-slider\">\n        <span>Creator Buzz</span>\n      </div>\n      <!-- The Tech -->\n      <div class=\"nav-item\" data-target-id=\"pdp-intelligence-intimacy\">\n        <span>The Tech</span>\n      </div>\n      <!-- The SensOn Edge -->\n      <div class=\"nav-item\" data-target-id=\"senson-edge-section\">\n        <span>The SensOn Edge</span>\n      </div>\n      <!-- Real Voices -->\n      <div class=\"nav-item\" data-target-id=\"yotpo-reviews-main-widget\">\n        <span>Real Voices</span>\n      </div>\n    </div>\n  </section>\n</div>\n\n<script>\n  ;(function () {\n    var navSection = document.getElementById('pdp-sticky-nav-section')\n    var navWrapper = document.getElementById('pdp-sticky-nav-wrapper')\n    if (!navSection || !navWrapper) return\n\n    var items = navSection.querySelectorAll('.nav-item')\n    var scrollArea = navSection.querySelector('.nav-scroll-area')\n    \n    var isClickScrolling = false\n    var clickScrollCheckInterval\n\n    // 获取 header 底部在视口中的位置（考虑 Announcement bar）\n    function getHeaderBottomInViewport() {\n      var header = document.querySelector('.shopify-section--header');\n      if (!header) return 0;\n      var rect = header.getBoundingClientRect();\n      return rect.bottom; // header 底部距离视口顶部的距离\n    }\n\n    function updateStickyPosition() {\n      var headerBottom = getHeaderBottomInViewport();\n      var wrapperRect = navWrapper.getBoundingClientRect(); // 相对视口\n\n      // 当 navWrapper 的顶部接触到 header 底部时，开始吸附\n      if (wrapperRect.top <= headerBottom) {\n        if (!navSection.classList.contains('is-fixed')) {\n          navWrapper.style.height = navSection.offsetHeight + 'px';\n          navSection.classList.add('is-fixed');\n        }\n        // fixed 后直接贴在 header 下方，即 top = headerBottom\n        navSection.style.top = headerBottom + 'px';\n      } else {\n        if (navSection.classList.contains('is-fixed')) {\n          navSection.classList.remove('is-fixed');\n          navSection.style.top = 'auto';\n          navWrapper.style.height = 'auto';\n        }\n      }\n    }\n\n    function getTargetElement(item) {\n      var targetId = item.getAttribute('data-target-id')\n      if (targetId) {\n        return document.getElementById(targetId)\n      }\n      var targetClass = item.getAttribute('data-target-class')\n      if (targetClass) {\n        return document.querySelector('.' + targetClass)\n      }\n      return null\n    }\n\n    function updateActiveTab() {\n      if (isClickScrolling) return\n\n      var headerBottom = getHeaderBottomInViewport();\n      var navHeight = navSection.offsetHeight;\n      // 计算偏移：header底部 + 导航栏自身高度 + 20px 余量\n      var offset = headerBottom + navHeight + 20;\n\n      var currentActive = null\n      var sectionPositions = []\n\n      for (var i = 0; i < items.length; i++) {\n        var item = items[i]\n        var targetSection = getTargetElement(item)\n\n        if (targetSection) {\n          var rect = targetSection.getBoundingClientRect()\n          var sectionTop = rect.top + window.scrollY\n          sectionPositions.push({\n            item: item,\n            top: sectionTop\n          })\n        }\n      }\n\n      sectionPositions.sort(function (a, b) {\n        return a.top - b.top\n      })\n\n      var scrollPosition = window.scrollY\n      var isAtAbsoluteBottom = (window.innerHeight + window.scrollY) >= document.documentElement.scrollHeight - 20;\n\n      if (isAtAbsoluteBottom && sectionPositions.length > 0) {\n        currentActive = sectionPositions[sectionPositions.length - 1].item;\n      } else {\n        for (var j = 0; j < sectionPositions.length; j++) {\n          if (scrollPosition >= sectionPositions[j].top - offset) {\n            currentActive = sectionPositions[j].item\n          }\n        }\n      }\n\n      if (!currentActive && items.length > 0) {\n        currentActive = sectionPositions.length > 0 ? sectionPositions[0].item : items[0]\n      }\n\n      if (currentActive && !currentActive.classList.contains('is-active')) {\n        items.forEach(function (i) {\n          i.classList.remove('is-active')\n        })\n        currentActive.classList.add('is-active')\n\n        if (window.innerWidth < 1000) {\n          var scrollLeft =\n            currentActive.offsetLeft -\n            scrollArea.offsetWidth / 2 +\n            currentActive.offsetWidth / 2\n          scrollArea.scrollTo({ left: scrollLeft, behavior: 'smooth' })\n        }\n      }\n    }\n\n    function abortClickScroll() {\n      if (!isClickScrolling) return;\n      clearInterval(clickScrollCheckInterval);\n      isClickScrolling = false;\n      window.removeEventListener('wheel', abortClickScroll);\n      window.removeEventListener('touchstart', abortClickScroll);\n      window.removeEventListener('keydown', abortClickScroll);\n      updateActiveTab();\n    }\n\n    items.forEach(function (item) {\n      item.addEventListener('click', function () {\n        var targetSection = getTargetElement(this)\n        if (!targetSection) return\n\n        isClickScrolling = true\n        clearInterval(clickScrollCheckInterval)\n\n        items.forEach(function (i) {\n          i.classList.remove('is-active')\n        })\n        this.classList.add('is-active')\n\n        if (window.innerWidth < 1000) {\n          var scrollLeft =\n            this.offsetLeft -\n            scrollArea.offsetWidth / 2 +\n            this.offsetWidth / 2\n          scrollArea.scrollTo({ left: scrollLeft, behavior: 'smooth' })\n        }\n\n        var headerBottom = getHeaderBottomInViewport();\n        var navHeight = navSection.offsetHeight;\n        var sectionTop = targetSection.getBoundingClientRect().top + window.scrollY;\n        // 目标滚动位置：section 顶部 - header底部 - 导航栏高度 + 1px 微调\n        var finalScrollTop = Math.round(sectionTop - headerBottom - navHeight + 1);\n        \n        window.scrollTo({\n          top: finalScrollTop,\n          behavior: 'smooth',\n        })\n\n        var lastScrollY = window.scrollY;\n        var unchangedCount = 0;\n        \n        clickScrollCheckInterval = setInterval(function() {\n          var currentScrollY = Math.round(window.scrollY);\n          \n          if (Math.abs(currentScrollY - finalScrollTop) <= 5) {\n            abortClickScroll();\n            return;\n          }\n          \n          if (currentScrollY === lastScrollY) {\n            unchangedCount++;\n            if (unchangedCount >= 3) {\n              abortClickScroll();\n              return;\n            }\n          } else {\n            unchangedCount = 0;\n            lastScrollY = currentScrollY;\n          }\n        }, 100);\n\n        window.addEventListener('wheel', abortClickScroll, { passive: true });\n        window.addEventListener('touchstart', abortClickScroll, { passive: true });\n        window.addEventListener('keydown', abortClickScroll, { passive: true });\n      })\n    })\n\n    window.addEventListener(\n      'scroll',\n      function () {\n        requestAnimationFrame(function() {\n          updateStickyPosition()\n          updateActiveTab()\n        })\n      },\n      { passive: true }\n    )\n\n    window.addEventListener('resize', function () {\n      updateStickyPosition()\n      updateActiveTab()\n    })\n\n    updateStickyPosition()\n    updateActiveTab()\n  })()\n</script>",
        "text_alignment": "center",
        "add_vertical_spacing": false,
        "add_horizontal_spacing": false
      }
    },
