swpt-play-btn-' + idx).style.display = 'flex'\n          document.getElementById('swpt-mute-btn-' + idx).style.display = 'none'\n        })\n      swptPCScrollTo(idx)\n    } else {\n      video.pause()\n      document.getElementById('swpt-play-btn-' + idx).style.display = 'flex'\n      document.getElementById('swpt-mute-btn-' + idx).style.display = 'none'\n    }\n  }\n\n  function swptToggleMute() {\n    swptMuted = !swptMuted\n    var video = document.getElementById('swpt-video-' + swptCurrent)\n    video.muted = swptMuted\n    document.getElementById('swpt-mute-icon-' + swptCurrent).src = swptMuted ? SWPT_ICON_MUTE : SWPT_ICON_VOLUME\n  }\n\n  function swptPrev() {\n    if (window.innerWidth <= 999) {\n      if (swptH5Current > 0) swptH5ScrollTo(swptH5Current - 1)\n    } else {\n      if (swptCurrent > 0) swptPCScrollTo(swptCurrent - 1)\n    }\n  }\n\n  function swptNext() {\n    if (window.innerWidth <= 999) {\n      if (swptH5Current < SWPT_TOTAL - 1) swptH5ScrollTo(swptH5Current + 1)\n    } else {\n      if (swptCurrent < SWPT_TOTAL - 1) swptPCScrollTo(swptCurrent + 1)\n    }\n  }\n\n  function swptH5ScrollTo(idx) {\n    swptH5Current = idx\n    var track = document.getElementById('swpt-h5-track')\n    var viewport = track.parentElement\n    var totalWidth = SWPT_TOTAL * CARD_W + (SWPT_TOTAL - 1) * CARD_GAP\n    var maxOffset = Math.max(0, totalWidth - (viewport.clientWidth - 16))\n    var offset = Math.min((CARD_W + CARD_GAP) * idx, maxOffset)\n    track.style.transform = 'translateX(' + -offset + 'px)'\n    document.getElementById('swpt-prev').style.opacity = idx === 0 ? '0.4' : '1'\n    document.getElementById('swpt-next').style.opacity = idx === SWPT_TOTAL - 1 ? '0.4' : '1'\n  }\n\n  function swptH5TogglePlay(idx) {\n    if (swptH5Swiped) return\n    var video = document.getElementById('swpt-h5-video-' + idx)\n    if (video.paused) {\n      for (var i = 0; i < SWPT_TOTAL; i++) {\n        if (i !== idx) {\n          document.getElementById('swpt-h5-video-' + i).pause()\n          document.getElementById('swpt-h5-play-btn-' + i).style.display = 'flex'\n          document.getElementById('swpt-h5-mute-btn-' + i).style.display = 'none'\n        }\n      }\n      swptH5Playing = idx\n      if (!video.getAttribute('src')) {\n        video.src = video.dataset.src\n        /* ✅ 修复2：删除了 video.load()，play() 会自动处理加载，\n           load() 会中断 iOS 用户手势上下文导致 play() 被拒绝 */\n      }\n      video.muted = swptH5Muted\n      video.play()\n        .then(function () {\n          if (swptH5Playing !== idx) return\n          document.getElementById('swpt-h5-play-btn-' + idx).style.display = 'none'\n          document.getElementById('swpt-h5-mute-btn-' + idx).style.display = 'flex'\n          document.getElementById('swpt-h5-mute-icon-' + idx).src = swptH5Muted ? SWPT_ICON_MUTE : SWPT_ICON_VOLUME\n        })\n        .catch(function () {\n          if (swptH5Playing !== idx) return\n          document.getElementById('swpt-h5-play-btn-' + idx).style.display = 'flex'\n          document.getElementById('swpt-h5-mute-btn-' + idx).style.display = 'none'\n        })\n    } else {\n      video.pause()\n      document.getElementById('swpt-h5-play-btn-' + idx).style.display = 'flex'\n      document.getElementById('swpt-h5-mute-btn-' + idx).style.display = 'none'\n      swptH5Playing = -1\n    }\n  }\n\n  function swptH5ToggleMute() {\n    swptH5Muted = !swptH5Muted\n    if (swptH5Playing < 0) return\n    var video = document.getElementById('swpt-h5-video-' + swptH5Playing)\n    video.muted = swptH5Muted\n    document.getElementById('swpt-h5-mute-icon-' + swptH5Playing).src = swptH5Muted ? SWPT_ICON_MUTE : SWPT_ICON_VOLUME\n  }\n\n  ;(function () {\n    var track = document.getElementById('swpt-h5-track')\n    var startX = 0\n    track.addEventListener('touchstart', function (e) {\n      startX = e.touches[0].clientX\n    })\n    track.addEventListener('touchend', function (e) {\n      var diff = startX - e.changedTouches[0].clientX\n      if (Math.abs(diff) > 40) {\n        swptH5Swiped = true\n        setTimeout(function () { swptH5Swiped = false }, 400)\n        if (diff > 0 && swptH5Current < SWPT_TOTAL - 1) swptH5ScrollTo(swptH5Current + 1)\n        else if (diff < 0 && swptH5Current > 0) swptH5ScrollTo(swptH5Current - 1)\n      }\n    })\n  })()\n</script>"
