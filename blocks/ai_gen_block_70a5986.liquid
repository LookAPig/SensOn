{% doc %}
  @prompt
    Software
    Female-POV Erotica
    SensOn offers a curated library of immersive audio stories created for women, spanning a wide spectrum of desires and kinks. Designed to spark imagination and emotional connection, each experience is crafted with intention—featuring leading creators and an inclusive, LGBTQ+-friendly approach. 
    
    Be With Your Fantasy
    Users engage in private, one-to-one voice conversations with AI-driven characters within each fantasy narrative. Interaction unfolds naturally inside the script as the story progresses, with long-term memory preserving continuity over time—shaping a deeply personal fantasy that evolves, adapts, and responds with every exchange.Please help me create a section with the content described above. It needs to be customizable and designed in the style of Whoop – very techy but also feminine. It needs to be mobile-friendly, and the text, images, and icons should all be freely replaceable., Everything else is fine, but the image is not displaying., Everything else remains the same, but the section with the icon should be removed.  The image section needs to be modified to allow uploading of images, GIFs, and videos., Everything else remains unchanged, but there needs to be an option for displaying image and video sizes (such as automatically adjusting to the image/video size).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_mobile }}px 20px;
    background: {{ block.settings.background_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-feature-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_desktop }}px 40px;
    }
  }

  .ai-feature-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-feature-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    margin-bottom: 40px;
  }

  .ai-feature-subheading-{{ ai_gen_id }} {
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ block.settings.subheading_color }};
    margin-bottom: 16px;
    font-weight: 500;
  }

  .ai-feature-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_mobile }}px;
    line-height: 1.1;
    color: {{ block.settings.heading_color }};
    margin: 0 0 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  @media screen and (min-width: 750px) {
    .ai-feature-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }
  }

  .ai-feature-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size_mobile }}px;
    line-height: 1.6;
    color: {{ block.settings.description_color }};
    max-width: 700px;
    margin: 0 auto;
  }

  @media screen and (min-width: 750px) {
    .ai-feature-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size_desktop }}px;
    }
  }

  .ai-feature-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ block.settings.grid_gap_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-feature-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
      gap: {{ block.settings.grid_gap_desktop }}px;
    }
  }

  .ai-feature-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding_mobile }}px;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  @media screen and (min-width: 750px) {
    .ai-feature-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding_desktop }}px;
    }
  }

  .ai-feature-card-{{ ai_gen_id }}:hover {
    {% comment %} transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
    border-color: {{ block.settings.card_border_hover_color }}; {% endcomment %}
  }

  .ai-feature-media-wrapper-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.media_border_radius }}px;
    overflow: hidden;
    background: {{ block.settings.media_placeholder_bg }};
    position: relative;
  }

  .ai-feature-media-wrapper-{{ ai_gen_id }}.ai-media-fixed-{{ ai_gen_id }} {
    height: {{ block.settings.media_height_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-feature-media-wrapper-{{ ai_gen_id }}.ai-media-fixed-{{ ai_gen_id }} {
      height: {{ block.settings.media_height_desktop }}px;
    }
  }

  .ai-feature-media-wrapper-{{ ai_gen_id }}.ai-media-auto-{{ ai_gen_id }} {
    height: auto;
  }

  .ai-feature-media-wrapper-{{ ai_gen_id }}.ai-media-aspect-{{ ai_gen_id }} {
    aspect-ratio: {{ block.settings.media_aspect_ratio }};
  }

  .ai-feature-media-wrapper-{{ ai_gen_id }}.ai-media-fixed-{{ ai_gen_id }} img,
  .ai-feature-media-wrapper-{{ ai_gen_id }}.ai-media-fixed-{{ ai_gen_id }} video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-feature-media-wrapper-{{ ai_gen_id }}.ai-media-aspect-{{ ai_gen_id }} img,
  .ai-feature-media-wrapper-{{ ai_gen_id }}.ai-media-aspect-{{ ai_gen_id }} video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-feature-media-wrapper-{{ ai_gen_id }}.ai-media-auto-{{ ai_gen_id }} img,
  .ai-feature-media-wrapper-{{ ai_gen_id }}.ai-media-auto-{{ ai_gen_id }} video {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-feature-media-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-media-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.2;
  }

  .ai-feature-card-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-feature-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size_mobile }}px;
    line-height: 1.3;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 12px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  @media screen and (min-width: 750px) {
    .ai-feature-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_title_size_desktop }}px;
    }
  }

  .ai-feature-card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size_mobile }}px;
    line-height: 1.6;
    color: {{ block.settings.card_text_color }};
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .ai-feature-card-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_text_size_desktop }}px;
    }
  }
{% endstyle %}

<div class="ai-feature-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-container-{{ ai_gen_id }}">
    {% if block.settings.show_header %}
      <div class="ai-feature-header-{{ ai_gen_id }}">
        {% if block.settings.subheading != blank %}
          <div class="ai-feature-subheading-{{ ai_gen_id }}">
            {{ block.settings.subheading }}
          </div>
        {% endif %}
        
        {% if block.settings.heading != blank %}
          <h2 class="ai-feature-heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h2>
        {% endif %}
        
        {% if block.settings.description != blank %}
          <div class="ai-feature-description-{{ ai_gen_id }}">
            {{ block.settings.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-feature-grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign feature_enabled_key = 'feature_' | append: i | append: '_enabled'
          assign feature_image_key = 'feature_' | append: i | append: '_image'
          assign feature_video_key = 'feature_' | append: i | append: '_video'
          assign feature_title_key = 'feature_' | append: i | append: '_title'
          assign feature_text_key = 'feature_' | append: i | append: '_text'
          
          assign feature_enabled = block.settings[feature_enabled_key]
          assign feature_image = block.settings[feature_image_key]
          assign feature_video = block.settings[feature_video_key]
          assign feature_title = block.settings[feature_title_key]
          assign feature_text = block.settings[feature_text_key]
        %}

        {% if feature_enabled %}
          <div class="ai-feature-card-{{ ai_gen_id }}">
            {% if block.settings.media_size_mode == 'fixed' %}
              {% assign media_class = 'ai-media-fixed-' | append: ai_gen_id %}
            {% elsif block.settings.media_size_mode == 'aspect' %}
              {% assign media_class = 'ai-media-aspect-' | append: ai_gen_id %}
            {% else %}
              {% assign media_class = 'ai-media-auto-' | append: ai_gen_id %}
            {% endif %}

            <div class="ai-feature-media-wrapper-{{ ai_gen_id }} {{ media_class }}">
              {% if feature_video %}
                {{
                  feature_video
                  | video_tag:
                    image_size: '800x',
                    autoplay: true,
                    loop: true,
                    muted: true,
                    controls: false
                }}
              {% elsif feature_image %}
                <img
                  src="{{ feature_image | image_url: width: 800 }}"
                  alt="{{ feature_title | escape }}"
                  loading="lazy"
                  width="800"
                  height="{{ feature_image.height }}"
                >
              {% else %}
                <div class="ai-feature-media-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-feature-card-content-{{ ai_gen_id }}">
              {% if feature_title != blank %}
                <h3 class="ai-feature-card-title-{{ ai_gen_id }}">
                  {{ feature_title }}
                </h3>
              {% endif %}
              
              {% if feature_text != blank %}
                <div class="ai-feature-card-text-{{ ai_gen_id }}">
                  {{ feature_text }}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

