{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-app-intro-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 1400px;
    padding: 60px 20px;
    
    padding-block-end: calc(var(--section-vertical-spacing-block-end, var(--section-vertical-spacing)) * .5);

    /* padding-bottom: 0; */
    margin: 0 auto;
    {% if block.settings.background_image %}
      background-image: url('{{ block.settings.background_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% else %}
      background-color: {{ block.settings.background_color }};
    {% endif %}

  }

  .ai-app-intro-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .ai-app-intro-left-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 60px;
    min-height: 100%;
  }

  .ai-app-intro-text-area-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex-grow: 1;
  }

  .ai-app-intro-text-module-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.divider_color }};
    padding-bottom: 20px;
  }

  .ai-app-intro-text-module-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-app-intro-module-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    gap: 16px;
  }

  .ai-app-intro-module-header-{{ ai_gen_id }}:hover .ai-app-intro-module-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_hover_color }};
  }

  .ai-app-intro-module-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0;
    transition: color 0.3s ease;
  }

  .ai-app-intro-arrow-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
    color: {{ block.settings.arrow_color }};
  }

  .ai-app-intro-arrow-icon-{{ ai_gen_id }}.active {
    transform: rotate(180deg);
  }

  .ai-app-intro-module-body-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, margin-top 0.4s ease;
    color: {{ block.settings.body_color }};
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
  }

  .ai-app-intro-module-body-{{ ai_gen_id }}.active {
    max-height: 500px;
    margin-top: 16px;
  }

  .ai-app-intro-download-section-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
    /* align-items: center; */
    padding-top: 40px;
    border-top: 1px solid {{ block.settings.divider_color }};
    margin-top: auto;
  }

  .ai-app-intro-download-icons-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    /* align-items: center; */
    flex-wrap: wrap;
    /* justify-content: center; */
  }

  .ai-app-intro-download-link-{{ ai_gen_id }} {
    display: block;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .ai-app-intro-download-link-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    opacity: 0.8;
  }

  .ai-app-intro-download-link-{{ ai_gen_id }} img {
    height: {{ block.settings.store_icon_height }}px;
    width: auto;
    display: block;
  }

  .ai-app-intro-download-text-{{ ai_gen_id }} {
    color: {{ block.settings.download_text_color }};
    font-size: {{ block.settings.download_text_size }}px;
    text-align: left;
  }

  .ai-app-intro-image-area-{{ ai_gen_id }} {
    position: sticky;
    top: 100px;
    display: flex;
    justify-content: center;
    align-items: center;
    max-width: 100%
  }

  .ai-app-intro-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    box-shadow: {{ block.settings.image_shadow }};
  }

  .ai-app-intro-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .ai-app-intro-image-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-app-intro-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-app-intro-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-app-intro-video-item-{{ ai_gen_id }} {
    background-color: #f4f4f4;
  }

  .ai-app-intro-video-poster-{{ ai_gen_id }},
  .ai-app-intro-video-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-app-intro-video-poster-{{ ai_gen_id }} {
    z-index: 1;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .ai-app-intro-video-{{ ai_gen_id }} {
    z-index: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-app-intro-video-item-{{ ai_gen_id }}.is-playing .ai-app-intro-video-poster-{{ ai_gen_id }} {
    opacity: 0;
  }

  .ai-app-intro-video-item-{{ ai_gen_id }}.is-playing .ai-app-intro-video-{{ ai_gen_id }} {
    opacity: 1;
  }

  @media screen and (max-width: 989px) {
    .ai-app-intro-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-app-intro-image-area-{{ ai_gen_id }} {
      position: relative;
      top: 0;
      order: -1;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-app-intro-{{ ai_gen_id }} {
      padding: 40px 16px;
      /* padding-bottom: 0 */
    }

    .ai-app-intro-module-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.85);
    }

    .ai-app-intro-module-body-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.body_size }}px * 0.9);
    }

    .ai-app-intro-download-icons-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 12px;
      width: max-content;
    }
  }
{% endstyle %}

<app-intro-section-{{ ai_gen_id }}
  class="ai-app-intro-{{ ai_gen_id }} ai-app-intro-wrapper"
  {{ block.shopify_attributes }}
>
  <div class="ai-app-intro-container-{{ ai_gen_id }}">
    <div class="ai-app-intro-image-area-{{ ai_gen_id }}">
      <div class="ai-app-intro-image-wrapper-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign image_key = 'module_' | append: i | append: '_image'
            assign video_key = 'module_' | append: i | append: '_video'
            assign image = block.settings[image_key]
            assign video = block.settings[video_key]
          %}

          {% if video %}
            {% liquid
              assign video_src = blank

              for source in video.sources
                if source.mime_type == 'video/mp4'
                  assign video_src = source.url
                  break
                endif
              endfor

              if video_src == blank and video.sources.size > 0
                assign video_src = video.sources.first.url
              endif

              assign poster_url = blank

              if image != blank
                assign poster_url = image | image_url: width: 800
              elsif video.preview_image != blank
                assign poster_url = video.preview_image | image_url: width: 800
              endif
            %}

            <div
              class="ai-app-intro-image-{{ ai_gen_id }} ai-app-intro-video-item-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
              data-image="{{ i }}"
              data-app-intro-video-item
            >
              {% if poster_url != blank %}
                <img
                  class="ai-app-intro-video-poster-{{ ai_gen_id }}"
                  src="{{ poster_url }}"
                  alt="{{ image.alt | default: video.alt | escape }}"
                  loading="lazy"
                  width="800"
                  {% if video.aspect_ratio != blank and video.aspect_ratio > 0 %}
                    height="{{ 800 | divided_by: video.aspect_ratio | round }}"
                  {% endif %}
                  data-app-intro-video-poster
                >
              {% else %}
                <div
                  class="ai-app-intro-image-placeholder-{{ ai_gen_id }} ai-app-intro-video-poster-{{ ai_gen_id }}"
                  data-app-intro-video-poster
                  aria-hidden="true"
                >
                  {{ 'product-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              <video
                class="ai-app-intro-video-{{ ai_gen_id }}"
                data-app-intro-video
                data-src="{{ video_src | escape }}"
                {% if poster_url != blank %}poster="{{ poster_url }}"{% endif %}
                preload="none"
                playsinline
                muted
                loop
              ></video>
            </div>
          {% elsif image %}
            <img
              src="{{ image | image_url: width: 800 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
              class="ai-app-intro-image-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
              data-image="{{ i }}"
            >
          {% else %}
            <div
              class="ai-app-intro-image-placeholder-{{ ai_gen_id }} ai-app-intro-image-{{ ai_gen_id }} "
              data-image="{{ i }}"
            >
              {{ 'product-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ai-app-intro-left-column-{{ ai_gen_id }}">
      <div class="ai-app-intro-text-area-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign title_key = 'module_' | append: i | append: '_title'
            assign body_key = 'module_' | append: i | append: '_body'
            assign title = block.settings[title_key]
            assign body = block.settings[body_key]
          %}

          {% if title != blank %}

          <div class="ai-app-intro-text-module-{{ ai_gen_id }}" data-module="{{ i }}">
            <div class="ai-app-intro-module-header-{{ ai_gen_id }}">
              <h3 class="ai-app-intro-module-title-{{ ai_gen_id }}">{{ title }}</h3>
              <svg
                class="ai-app-intro-arrow-icon-{{ ai_gen_id }} "
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
            <div class="ai-app-intro-module-body-{{ ai_gen_id }} ">
              {{ body }}
            </div>
          </div>
          {%  endif %}
        {% endfor %}
      </div>

      {% if  block.settings.download_text != blank %}
      <div class="ai-app-intro-download-section-{{ ai_gen_id }}">
        {% if block.settings.download_text != blank %}
          <div class="ai-app-intro-download-text-{{ ai_gen_id }}">
            {{ block.settings.download_text }}
          </div>
        {% endif %}

        <div class="ai-app-intro-download-icons-{{ ai_gen_id }}">
          {% if block.settings.app_store_icon or block.settings.app_store_link != blank %}
            {% if block.settings.app_store_link != blank %}
              <a
                href="{{ block.settings.app_store_link }}"
                class="ai-app-intro-download-link-{{ ai_gen_id }}"
                target="_blank"
                rel="noopener"
              >
            {% else %}
              <div class="ai-app-intro-download-link-{{ ai_gen_id }}">
            {% endif %}
            {% if block.settings.app_store_icon %}
              <img
                src="{{ block.settings.app_store_icon | image_url: height: 120 }}"
                alt="Download on the App Store"
                loading="lazy"
              >
            {% else %}
              {%- render 'icon' with 'apple_download', width: 120 -%}
            {% endif %}
            {% if block.settings.app_store_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          {% else %}
            <div style="background-image: linear-gradient(90deg, {{ block.settings.icon_start_color |default:'transparent'}}, {{ block.settings.icon_end_color |default:'transparent'}});border-radius: 4px;">
              {%- render 'icon' with 'apple_download', width: 120 -%}
            </div>
          {% endif %}

          {% if block.settings.google_play_icon or block.settings.google_play_link != blank %}
            {% if block.settings.google_play_link != blank %}
              <a
                href="{{ block.settings.google_play_link }}"
                class="ai-app-intro-download-link-{{ ai_gen_id }}"
                target="_blank"
                rel="noopener"
              >
            {% else %}
              <div class="ai-app-intro-download-link-{{ ai_gen_id }}">
            {% endif %}
            {% if block.settings.google_play_icon %}
              <img
                src="{{ block.settings.google_play_icon | image_url: height: 120 }}"
                alt="Get it on Google Play"
                loading="lazy"
              >
            {% else %}
              <svg
                width="135"
                height="40"
                viewBox="0 0 135 40"
                xmlns="http://www.w3.org/2000/svg"
              >
                <rect width="135" height="40" rx="5" fill="#000000"/>
                <text x="67.5" y="25" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Google Play</text>
              </svg>
            {% endif %}
            {% if block.settings.google_play_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          {% endif %}
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</app-intro-section-{{ ai_gen_id }}>

<script>
  (function() {
    class AppIntroSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.isInView = false;
        this.videoLoadStates = new WeakMap();
      }

      connectedCallback() {
        this.modules = this.querySelectorAll(".ai-app-intro-text-module-{{ ai_gen_id }}");
        this.images = this.querySelectorAll(".ai-app-intro-image-{{ ai_gen_id }}");
        this.videoItems = this.querySelectorAll("[data-app-intro-video-item]");
        this.setupEventListeners();
        this.setupVideoObserver();
      }

      disconnectedCallback() {
        if (this.videoObserver) {
          this.videoObserver.disconnect();
        }
      }

      setupVideoObserver() {
        if (!this.videoItems.length) {
          return;
        }

        if (!("IntersectionObserver" in window)) {
          this.isInView = true;
          this.playActiveVideo();
          return;
        }

        this.videoObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            this.isInView = entry.isIntersecting;

            if (entry.isIntersecting) {
              this.playActiveVideo();
            } else {
              this.pauseAllVideos();
            }
          });
        }, {
          threshold: 0.35,
          rootMargin: "0px 0px -10% 0px"
        });

        this.videoObserver.observe(this);
      }

      loadVideo(video) {
        const existingState = this.videoLoadStates.get(video);

        if (existingState && existingState.hasLoaded) {
          return Promise.resolve();
        }

        if (existingState && existingState.loadPromise) {
          return existingState.loadPromise;
        }

        const videoSrc = video.getAttribute("data-src");

        if (!videoSrc) {
          return Promise.resolve();
        }

        const loadPromise = new Promise((resolve) => {
          const source = document.createElement("source");

          source.src = videoSrc;
          source.type = "video/mp4";
          video.appendChild(source);
          video.load();

          video.addEventListener("loadeddata", () => {
            this.videoLoadStates.set(video, {
              hasLoaded: true,
              loadPromise: null
            });
            resolve();
          }, { once: true });
        });

        this.videoLoadStates.set(video, {
          hasLoaded: false,
          loadPromise: loadPromise
        });

        return loadPromise;
      }

      playVideoItem(videoItem) {
        if (!videoItem) {
          return;
        }

        const video = videoItem.querySelector("[data-app-intro-video]");

        if (!video) {
          return;
        }

        this.loadVideo(video).then(() => {
          const playPromise = video.play();

          if (playPromise !== undefined) {
            playPromise.then(() => {
              videoItem.classList.add("is-playing");
            }).catch(() => {});
          }
        });
      }

      pauseAllVideos() {
        this.videoItems.forEach((videoItem) => {
          const video = videoItem.querySelector("[data-app-intro-video]");

          if (video && !video.paused) {
            video.pause();
          }
        });
      }

      playActiveVideo() {
        if (!this.isInView) {
          return;
        }

        this.pauseAllVideos();

        const activeVideoItem = this.querySelector("[data-app-intro-video-item].active");

        if (activeVideoItem) {
          this.playVideoItem(activeVideoItem);
        }
      }

      setActiveImage(moduleIndex) {
        this.images.forEach((img) => {
          img.classList.remove("active");
        });

        const targetImage = this.querySelector('[data-image="' + moduleIndex + '"]');

        if (targetImage) {
          targetImage.classList.add("active");
        }

        this.playActiveVideo();
      }

      setupEventListeners() {
        this.modules.forEach((module) => {
          const header = module.querySelector(".ai-app-intro-module-header-{{ ai_gen_id }}");
          const body = module.querySelector(".ai-app-intro-module-body-{{ ai_gen_id }}");
          const arrow = module.querySelector(".ai-app-intro-arrow-icon-{{ ai_gen_id }}");
          const moduleIndex = module.getAttribute("data-module");

          header.addEventListener("click", () => {
            const isActive = body.classList.contains("active");

            if (!isActive) {
              this.modules.forEach((m) => {
                m.querySelector(".ai-app-intro-module-body-{{ ai_gen_id }}").classList.remove("active");
                m.querySelector(".ai-app-intro-arrow-icon-{{ ai_gen_id }}").classList.remove("active");
              });

              body.classList.add("active");
              arrow.classList.add("active");
              this.setActiveImage(moduleIndex);
            } else {
              this.modules.forEach((m) => {
                m.querySelector(".ai-app-intro-module-body-{{ ai_gen_id }}").classList.remove("active");
                m.querySelector(".ai-app-intro-arrow-icon-{{ ai_gen_id }}").classList.remove("active");
              });

              this.setActiveImage("1");
            }
          });
        });
      }
    }

    customElements.define("app-intro-section-{{ ai_gen_id }}", AppIntroSection{{ ai_gen_id }});
  })();
</script>

