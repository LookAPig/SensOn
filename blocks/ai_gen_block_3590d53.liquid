{% doc %}
  @prompt
    i need 4 trusted icons as the benefit bar , make icon color as theme pink color, keep the style along as the other sections.  4 trusted icon contents : Global Free Shipping
    1 Year Warranty
    Discreet Packaging
    Medical-Grade Material
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefit-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 24px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-benefit-bar__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-benefit-bar__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }

  .ai-benefit-bar__icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
  }

  .ai-benefit-bar__icon-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke-width: {{ block.settings.icon_stroke_width }};
  }

  .ai-benefit-bar__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.4;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-benefit-bar__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefit-bar-{{ ai_gen_id }} {
      padding: 20px 16px;
    }

    .ai-benefit-bar__container-{{ ai_gen_id }} {
      gap: 16px;
    }

    .ai-benefit-bar__icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-benefit-bar__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<benefit-bar-{{ ai_gen_id }} class="ai-benefit-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-benefit-bar__container-{{ ai_gen_id }}">
    <div class="ai-benefit-bar__item-{{ ai_gen_id }}">
      <div class="ai-benefit-bar__icon-wrapper-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          <path d="M2 12h20"></path>
        </svg>
      </div>
      <p class="ai-benefit-bar__text-{{ ai_gen_id }}">{{ block.settings.benefit_1_text }}</p>
    </div>

    <div class="ai-benefit-bar__item-{{ ai_gen_id }}">
      <div class="ai-benefit-bar__icon-wrapper-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path>
          <path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z"></path>
        </svg>
      </div>
      <p class="ai-benefit-bar__text-{{ ai_gen_id }}">{{ block.settings.benefit_2_text }}</p>
    </div>

    <div class="ai-benefit-bar__item-{{ ai_gen_id }}">
      <div class="ai-benefit-bar__icon-wrapper-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="7" width="18" height="13" rx="2"></rect>
          <path d="M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2"></path>
          <path d="M12 12l0 .01"></path>
          <path d="M3 13a20 20 0 0 0 18 0"></path>
        </svg>
      </div>
      <p class="ai-benefit-bar__text-{{ ai_gen_id }}">{{ block.settings.benefit_3_text }}</p>
    </div>

    <div class="ai-benefit-bar__item-{{ ai_gen_id }}">
      <div class="ai-benefit-bar__icon-wrapper-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2"></path>
          <rect x="9" y="3" width="6" height="4" rx="2"></rect>
          <path d="M9 14l2 2l4 -4"></path>
        </svg>
      </div>
      <p class="ai-benefit-bar__text-{{ ai_gen_id }}">{{ block.settings.benefit_4_text }}</p>
    </div>
  </div>
</benefit-bar-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Benefit bar",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Benefits"
    },
    {
      "type": "text",
      "id": "benefit_1_text",
      "label": "Benefit 1",
      "default": "Global Free Shipping"
    },
    {
      "type": "text",
      "id": "benefit_2_text",
      "label": "Benefit 2",
      "default": "1 Year Warranty"
    },
    {
      "type": "text",
      "id": "benefit_3_text",
      "label": "Benefit 3",
      "default": "Discreet Packaging"
    },
    {
      "type": "text",
      "id": "benefit_4_text",
      "label": "Benefit 4",
      "default": "Medical-Grade Material"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 24,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "icon_stroke_width",
      "label": "Icon thickness",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "unit": "px",
      "default": 1.5
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#f287ec"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#321e1e"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#faf4f0"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Benefit bar"
    }
  ]
}
{% endschema %}
