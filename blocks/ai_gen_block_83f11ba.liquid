<script>
  (function() {
    class HowItWorks{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.steps = [];
        this.navItems = [];
        this.activeIndex = 0;
        this.autoplayTimer = null;
        this.autoplayInterval = 7000;
        this.autoplayEnabled = true;
        this.loopEnabled = true;
        this.resumeAfterClick = true;
        this.pauseOutOfView = true;
        this.pauseReducedMotion = true;
        this.isInView = false;
        this.observer = null;
        this.prefersReducedMotion = false;
        this.userInteracted = false;
      }

      connectedCallback() {
        this.steps = Array.from(this.querySelectorAll('.ai-how-it-works-step-{{ ai_gen_id }}'));
        this.navItems = Array.from(this.querySelectorAll('.ai-how-it-works-nav-item-{{ ai_gen_id }}'));
        
        if (this.steps.length === 0) return;

        this.autoplayEnabled = this.getAttribute('data-autoplay') === 'true';
        this.loopEnabled = this.getAttribute('data-loop') === 'true';
        this.resumeAfterClick = this.getAttribute('data-resume-after-click') === 'true';
        this.pauseOutOfView = this.getAttribute('data-pause-out-of-view') === 'true';
        this.pauseReducedMotion = this.getAttribute('data-pause-reduced-motion') === 'true';
        
        const intervalAttr = this.getAttribute('data-interval');
        if (intervalAttr) {
          this.autoplayInterval = parseInt(intervalAttr) * 1000;
        }

        this.prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        this.setupClickHandlers();
        this.setActiveStep(0);

        if (this.autoplayEnabled) {
          if (this.pauseOutOfView) {
            this.setupIntersectionObserver();
          } else {
            this.startAutoplay();
          }
        }
      }

      setupClickHandlers() {
        this.navItems.forEach((item, index) => {
          item.addEventListener('click', () => {
            this.userInteracted = true;
            const stepIndex = parseInt(item.dataset.stepIndex);
            this.stopAutoplay();
            this.setActiveStep(stepIndex);
            
            if (this.resumeAfterClick && this.autoplayEnabled) {
              this.startAutoplay();
            }
          });
        });
      }

      setupIntersectionObserver() {
        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            this.isInView = entry.isIntersecting;
            if (this.isInView) {
              this.startAutoplay();
            } else {
              this.stopAutoplay();
            }
          });
        }, {
          threshold: 0.2
        });

        this.observer.observe(this);
      }

      startAutoplay() {
        if (!this.autoplayEnabled) return;
        if (this.pauseReducedMotion && this.prefersReducedMotion) return;
        if (this.autoplayTimer) return;

        this.autoplayTimer = setInterval(() => {
          let nextIndex = this.activeIndex + 1;
          
          if (nextIndex >= this.steps.length) {
            if (this.loopEnabled) {
              nextIndex = 0;
            } else {
              this.stopAutoplay();
              return;
            }
          }
          
          this.setActiveStep(nextIndex);
        }, this.autoplayInterval);
      }

      stopAutoplay() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
          this.autoplayTimer = null;
        }
      }

      setActiveStep(index) {
        this.steps.forEach((step, i) => {
          if (i === index) {
            step.classList.add('active');
          } else {
            step.classList.remove('active');
          }
        });

        this.navItems.forEach((item, i) => {
          const itemIndex = parseInt(item.dataset.stepIndex);
          
          if (itemIndex === index) {
            item.classList.add('active');
            item.classList.remove('inactive', 'completed');
            const progressBar = item.querySelector('.ai-how-it-works-progress-bar-{{ ai_gen_id }}');
            if (progressBar) {
              progressBar.style.animation = 'none';
              void progressBar.offsetWidth;
              progressBar.style.animation = null;
            }
          } else if (itemIndex < index) {
            item.classList.add('completed');
            item.classList.remove('active', 'inactive');
          } else {
            item.classList.add('inactive');
            item.classList.remove('active', 'completed');
          }
        });

        this.activeIndex = index;
      }

      disconnectedCallback() {
        this.stopAutoplay();
        if (this.observer) {
          this.observer.disconnect();
        }
      }
    }

    customElements.define('how-it-works-{{ ai_gen_id }}', HowItWorks{{ ai_gen_id }});
  })();
</script>

