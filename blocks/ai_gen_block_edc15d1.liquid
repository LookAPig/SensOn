{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-quiz-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-quiz-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-quiz-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
  }

  .ai-quiz-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin: 0;
  }

  .ai-quiz-progress-{{ ai_gen_id }} {
    width: 100%;
    height: 8px;
    background-color: {{ block.settings.progress_bg_color }};
    border-radius: 4px;
    margin-bottom: 30px;
    overflow: hidden;
  }

  .ai-quiz-progress-bar-{{ ai_gen_id }} {
    height: 100%;
    background-color: {{ block.settings.progress_color }};
    transition: width 0.3s ease;
    width: 0%;
  }

  .ai-quiz-question-{{ ai_gen_id }} {
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-quiz-question-{{ ai_gen_id }}.active {
    display: block;
    opacity: 1;
  }

  .ai-quiz-question-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.question_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 24px;
    font-weight: 600;
    line-height: 1.4;
  }

  .ai-quiz-options-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-quiz-option-{{ ai_gen_id }} {
    padding: 16px 20px;
    background-color: {{ block.settings.option_bg_color }};
    border: 2px solid {{ block.settings.option_border_color }};
    border-radius: {{ block.settings.option_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.option_size }}px;
    text-align: left;
    line-height: 1.5;
  }

  .ai-quiz-option-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.option_hover_bg_color }};
    border-color: {{ block.settings.option_hover_border_color }};
    transform: translateX(4px);
  }

  .ai-quiz-option-{{ ai_gen_id }}.selected {
    background-color: {{ block.settings.option_selected_bg_color }};
    border-color: {{ block.settings.option_selected_border_color }};
    color: {{ block.settings.option_selected_text_color }};
  }

  .ai-quiz-navigation-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    margin-top: 30px;
    gap: 12px;
  }

  .ai-quiz-btn-{{ ai_gen_id }} {
    padding: 14px 28px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    font-size: {{ block.settings.button_size }}px;
    transition: all 0.3s ease;
  }

  .ai-quiz-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-quiz-btn-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-quiz-btn-secondary-{{ ai_gen_id }} {
    background-color: transparent;
    border: 2px solid {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_bg_color }};
  }

  .ai-quiz-btn-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
  }

  .ai-quiz-results-{{ ai_gen_id }} {
    display: none;
    text-align: center;
  }

  .ai-quiz-results-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-quiz-result-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.result_card_bg_color }};
    border-radius: {{ block.settings.result_card_border_radius }}px;
    padding: 40px 30px;
    margin-top: 20px;
  }

  .ai-quiz-result-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.result_title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
    font-weight: 700;
  }

  .ai-quiz-result-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.result_subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 24px;
    opacity: 0.9;
  }

  .ai-quiz-result-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.result_description_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0 0 30px;
    opacity: 0.8;
  }

  .ai-quiz-result-images-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin: 0 0 24px;
  }

  .ai-quiz-result-image-{{ ai_gen_id }} {
    width: calc(33.333% - 8px);
    min-width: 150px;
    max-width: 300px;
    height: auto;
    border-radius: {{ block.settings.result_image_border_radius }}px;
    object-fit: cover;
  }

  .ai-quiz-restart-{{ ai_gen_id }} {
    margin-top: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-quiz-container-{{ ai_gen_id }} {
      padding: 30px 16px;
    }

    .ai-quiz-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-quiz-question-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.question_size }}px * 0.9);
    }

    .ai-quiz-navigation-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-quiz-result-image-{{ ai_gen_id }} {
      width: calc(50% - 6px);
    }
  }
{% endstyle %}

