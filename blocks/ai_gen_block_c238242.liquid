{% doc %}
  @prompt
    I want to create a section with this content that is interactive, not rigid, and PC-friendly. I don't want the 2x2 two-row display format; please give me other styles. Every Detail Considered:
    - A wireless charging and storage case keeps the device powered, protected, and discreet.
    - Made with FDA-compliant, body-safe silicone to ensure lasting comfort and safety with every use.
    - Waterproof to IPX6 for easy cleaning and flexibility in different settings.
    - Dual connectivity through Bluetooth and Wi-Fi enables seamless control and updates from the SensOn.AI app., I think everything else is great, but we need to add one more icon and a section where users can upload their own logo.  Everything else should remain the same., Everything else remains unchanged; a description section will be added below the section title.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-showcase-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 40px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-features-showcase__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-features-showcase__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 50px;
  }

  .ai-features-showcase__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px 0;
    font-weight: 600;
  }

  .ai-features-showcase__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    line-height: 1.6;
    margin: 0 auto;
    max-width: 700px;
  }

  .ai-features-showcase__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.gap_size }}px;
  }

  .ai-features-showcase__item-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
    overflow: hidden;
  }

  .ai-features-showcase__item-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
  }

  .ai-features-showcase__icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_background }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    transition: transform 0.3s ease;
  }

  .ai-features-showcase__item-{{ ai_gen_id }}:hover .ai-features-showcase__icon-wrapper-{{ ai_gen_id }} {
    transform: scale(1.1) rotate(5deg);
  }

  .ai-features-showcase__icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
    color: {{ block.settings.icon_color }};
  }

  .ai-features-showcase__custom-icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.icon_size }}px * 0.6);
    height: calc({{ block.settings.icon_size }}px * 0.6);
    object-fit: contain;
  }

  .ai-features-showcase__content-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-features-showcase__feature-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_title_size }}px;
    color: {{ block.settings.feature_title_color }};
    margin: 0 0 12px 0;
    font-weight: 600;
  }

  .ai-features-showcase__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-features-showcase__accent-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    right: 0;
    width: 60px;
    height: 60px;
    background: {{ block.settings.accent_color }};
    opacity: 0.1;
    border-radius: 0 {{ block.settings.card_border_radius }}px 0 100%;
    transition: opacity 0.3s ease;
  }

  .ai-features-showcase__item-{{ ai_gen_id }}:hover .ai-features-showcase__accent-{{ ai_gen_id }} {
    opacity: 0.2;
  }

  @media screen and (max-width: 989px) {
    .ai-features-showcase-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-features-showcase__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
      gap: {{ block.settings.gap_size | times: 0.8 }}px;
    }

    .ai-features-showcase__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-features-showcase__subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-features-showcase__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.gap_size | times: 0.6 }}px;
    }

    .ai-features-showcase__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-features-showcase__subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.85);
    }

    .ai-features-showcase__feature-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.feature_title_size }}px * 0.9);
    }

    .ai-features-showcase__description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }
  }
{% endstyle %}

<feature-showcase-{{ ai_gen_id }} class="ai-features-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-features-showcase__container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank or block.settings.section_subtitle != blank %}
      <div class="ai-features-showcase__header-{{ ai_gen_id }}">
        {% if block.settings.section_title != blank %}
          <h2 class="ai-features-showcase__title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
        {% endif %}
        {% if block.settings.section_subtitle != blank %}
          <div class="ai-features-showcase__subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-features-showcase__grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign title_key = 'feature_' | append: i | append: '_title'
          assign description_key = 'feature_' | append: i | append: '_description'
          assign icon_key = 'feature_' | append: i | append: '_icon'
          assign custom_icon_key = 'feature_' | append: i | append: '_custom_icon'
          
          assign feature_title = block.settings[title_key]
          assign feature_description = block.settings[description_key]
          assign feature_icon = block.settings[icon_key]
          assign custom_icon = block.settings[custom_icon_key]
        %}

        {% if feature_title != blank or feature_description != blank %}
          <div class="ai-features-showcase__item-{{ ai_gen_id }}" data-feature="{{ i }}">
            <div class="ai-features-showcase__accent-{{ ai_gen_id }}"></div>
            
            <div class="ai-features-showcase__icon-wrapper-{{ ai_gen_id }}">
              {% if custom_icon != blank %}
                <img 
                  src="{{ custom_icon | image_url: width: 200 }}" 
                  alt="{{ feature_title }}"
                  class="ai-features-showcase__custom-icon-{{ ai_gen_id }}"
                  loading="lazy"
                >
              {% else %}
                {% case feature_icon %}
                  {% when 'battery' %}
                    <svg class="ai-features-showcase__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="7" width="16" height="10" rx="2" ry="2"></rect>
                      <line x1="22" y1="11" x2="22" y2="13"></line>
                      <line x1="6" y1="11" x2="6" y2="13"></line>
                      <line x1="10" y1="11" x2="10" y2="13"></line>
                    </svg>
                  {% when 'shield' %}
                    <svg class="ai-features-showcase__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                      <path d="M9 12l2 2 4-4"></path>
                    </svg>
                  {% when 'droplet' %}
                    <svg class="ai-features-showcase__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                    </svg>
                  {% when 'wifi' %}
                    <svg class="ai-features-showcase__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12.55a11 11 0 0 1 14.08 0"></path>
                      <path d="M1.42 9a16 16 0 0 1 21.16 0"></path>
                      <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
                      <line x1="12" y1="20" x2="12.01" y2="20"></line>
                    </svg>
                  {% when 'star' %}
                    <svg class="ai-features-showcase__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  {% when 'heart' %}
                    <svg class="ai-features-showcase__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                  {% when 'zap' %}
                    <svg class="ai-features-showcase__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                  {% when 'check' %}
                    <svg class="ai-features-showcase__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  {% when 'package' %}
                    <svg class="ai-features-showcase__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line>
                      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                      <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                      <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                {% endcase %}
              {% endif %}
            </div>

            <div class="ai-features-showcase__content-{{ ai_gen_id }}">
              {% if feature_title != blank %}
                <h3 class="ai-features-showcase__feature-title-{{ ai_gen_id }}">{{ feature_title }}</h3>
              {% endif %}
              {% if feature_description != blank %}
                <p class="ai-features-showcase__description-{{ ai_gen_id }}">{{ feature_description }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</feature-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class FeatureShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-features-showcase__item-{{ ai_gen_id }}');
        this.setupInteractions();
      }

      setupInteractions() {
        this.items.forEach((item) => {
          item.addEventListener('mouseenter', () => {
            this.items.forEach((otherItem) => {
              if (otherItem !== item) {
                otherItem.style.opacity = '0.6';
              }
            });
          });

          item.addEventListener('mouseleave', () => {
            this.items.forEach((otherItem) => {
              otherItem.style.opacity = '1';
            });
          });
        });
      }
    }

    customElements.define('feature-showcase-{{ ai_gen_id }}', FeatureShowcase{{ ai_gen_id }});
  })();
</script>

