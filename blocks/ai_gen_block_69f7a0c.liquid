    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Image max width",
      "default": 800
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Image border radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_spacing_mobile",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Image spacing (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "image_spacing_desktop",
      "min": 30,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Image spacing (desktop)",
      "default": 60
    },
    {
      "type": "header",
      "content": "Bottom content"
    },
    {
      "type": "inline_richtext",
      "id": "bottom_headline",
      "label": "Bottom headline",
      "default": "Built on integrity"
    },
    {
      "type": "range",
      "id": "bottom_headline_size_mobile",
      "min": 20,
      "max": 48,
