      "step": 5,
      "unit": "px",
      "label": "Spacing below heading",
      "default": 15
    },
    {
      "type": "header",
      "content": "Top description"
    },
    {
      "type": "richtext",
      "id": "top_description",
      "label": "Description text",
      "default": "<p>These principles guide everything we do and shape our vision for the future.</p>"
    },
    {
      "type": "range",
      "id": "description_size_mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Description size (mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "description_size_desktop",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description size (desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "description_spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Spacing above description",
      "default": 20
    },
    {
      "type": "range",
      "id": "header_spacing_mobile",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Header bottom spacing (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "header_spacing_desktop",
      "min": 30,
      "max": 120,
