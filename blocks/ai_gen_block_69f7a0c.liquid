      "label": "Bottom headline size (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "bottom_headline_size_desktop",
      "min": 24,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Bottom headline size (desktop)",
      "default": 36
    },
    {
      "type": "richtext",
      "id": "bottom_paragraph",
      "label": "Bottom paragraph",
      "default": "<p>We are committed to transparency, authenticity, and creating meaningful connections with our community. Every decision we make reflects our dedication to these values.</p>"
