{% doc %}
  @prompt
    I need a "What's in the box" section including images and text: Main Unit (Charging Case), Core, Clitoral Stimulator, Vaginal Stimulator, Nipple Stimulator, USB-C Charging Cable, User Manual. The font needs to be consistent with the font used for the main text and headings of the theme.
    Additionally, the color of the checkmark symbol can be changed. The overall section should have a high-tech feel reminiscent of Whoop, with a frosted glass effect and interactive elements., It's a bit messy; let's try a different style., I think it's pretty good, but I still need a place to put the pictures. I need to show pictures of what's inside the box., Not every item needs an image; the entire section only needs one image., Everything else remains the same, but the image height and size should be adjustable, and the font should be consistent with the overall style of my website.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-whats-in-box-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 80px 20px;
    background: {{ block.settings.background_color }};
    font-weight: {{ settings.text_font.weight }};
    font-style: {{ settings.text_font.style }};
  }

  .ai-whats-in-box-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-whats-in-box-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-whats-in-box-title-{{ ai_gen_id }} {
    font-weight: {{ settings.heading_font.weight }};
    font-style: {{ settings.heading_font.style }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .ai-whats-in-box-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    margin: 0;
    font-weight: 400;
  }

  .ai-whats-in-box-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .ai-whats-in-box-image-section-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-whats-in-box-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.image_width }}%;
    height: {{ block.settings.image_height }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background: {{ block.settings.image_background }};
    backdrop-filter: blur({{ block.settings.blur_amount }}px);
    -webkit-backdrop-filter: blur({{ block.settings.blur_amount }}px);
    margin: 0 auto;
  }

  .ai-whats-in-box-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-whats-in-box-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 16px;
  }

  .ai-whats-in-box-image-placeholder-{{ ai_gen_id }} svg {
    width: 40%;
    height: 40%;
    opacity: 0.2;
  }

  .ai-whats-in-box-placeholder-text-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.4;
  }

  .ai-whats-in-box-list-section-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-whats-in-box-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: {{ block.settings.divider_color }};
    border-radius: {{ block.settings.container_border_radius }}px;
    overflow: hidden;
    backdrop-filter: blur({{ block.settings.blur_amount }}px);
    -webkit-backdrop-filter: blur({{ block.settings.blur_amount }}px);
  }

  .ai-whats-in-box-item-{{ ai_gen_id }} {
    position: relative;
    background: {{ block.settings.item_background }};
    padding: {{ block.settings.item_padding }}px;
    display: flex;
    align-items: center;
    gap: 20px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }

  .ai-whats-in-box-item-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: {{ block.settings.accent_color }};
    transform: scaleY(0);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-whats-in-box-item-{{ ai_gen_id }}:hover {
    background: {{ block.settings.item_hover_background }};
    padding-left: calc({{ block.settings.item_padding }}px + 8px);
  }

  .ai-whats-in-box-item-{{ ai_gen_id }}:hover::before {
    transform: scaleY(1);
  }

  .ai-whats-in-box-checkmark-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.checkmark_size }}px;
    height: {{ block.settings.checkmark_size }}px;
    border-radius: 50%;
    background: {{ block.settings.checkmark_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-whats-in-box-item-{{ ai_gen_id }}:hover .ai-whats-in-box-checkmark-{{ ai_gen_id }} {
    transform: scale(1.1);
    box-shadow: 0 0 20px {{ block.settings.checkmark_color }};
  }

  .ai-whats-in-box-checkmark-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.checkmark_size }}px * 0.5);
    height: calc({{ block.settings.checkmark_size }}px * 0.5);
    stroke: {{ block.settings.checkmark_icon_color }};
    stroke-width: 2.5;
    fill: none;
  }

  .ai-whats-in-box-item-content-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-whats-in-box-item-title-{{ ai_gen_id }} {
    font-weight: {{ settings.heading_font.weight }};
    font-size: {{ block.settings.item_title_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 4px;
    line-height: 1.4;
  }

  .ai-whats-in-box-item-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.item_description_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    margin: 0;
    line-height: 1.5;
  }

  .ai-whats-in-box-item-number-{{ ai_gen_id }} {
    flex-shrink: 0;
    font-weight: {{ settings.heading_font.weight }};
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.3;
    min-width: 30px;
    text-align: right;
    transition: opacity 0.3s ease;
  }

  .ai-whats-in-box-item-{{ ai_gen_id }}:hover .ai-whats-in-box-item-number-{{ ai_gen_id }} {
    opacity: 0.6;
  }

  @media screen and (max-width: 989px) {
    .ai-whats-in-box-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-whats-in-box-image-section-{{ ai_gen_id }} {
      order: 2;
    }

    .ai-whats-in-box-list-section-{{ ai_gen_id }} {
      order: 1;
    }

    .ai-whats-in-box-image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.image_height_mobile }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-whats-in-box-{{ ai_gen_id }} {
      padding: 50px 16px;
    }

    .ai-whats-in-box-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-whats-in-box-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }

    .ai-whats-in-box-item-{{ ai_gen_id }} {
      padding: 20px 16px;
      gap: 16px;
    }

    .ai-whats-in-box-item-{{ ai_gen_id }}:hover {
      padding-left: 24px;
    }

    .ai-whats-in-box-item-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.item_title_size }}px * 0.9);
    }

    .ai-whats-in-box-item-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.item_description_size }}px * 0.9);
    }

    .ai-whats-in-box-item-number-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<whats-in-box-{{ ai_gen_id }} class="ai-whats-in-box-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-whats-in-box-container-{{ ai_gen_id }}">
    <div class="ai-whats-in-box-header-{{ ai_gen_id }}">
      <h2 class="ai-whats-in-box-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% if block.settings.subtitle != blank %}
        <p class="ai-whats-in-box-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="ai-whats-in-box-content-{{ ai_gen_id }}">
      <div class="ai-whats-in-box-image-section-{{ ai_gen_id }}">
        <div class="ai-whats-in-box-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.main_image %}
            <img
              src="{{ block.settings.main_image | image_url: width: 800 }}"
              alt="{{ block.settings.title | escape }}"
              class="ai-whats-in-box-image-{{ ai_gen_id }}"
              loading="lazy"
              width="800"
              height="800"
            >
          {% else %}
            <div class="ai-whats-in-box-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
              <div class="ai-whats-in-box-placeholder-text-{{ ai_gen_id }}">Add an image</div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-whats-in-box-list-section-{{ ai_gen_id }}">
        <div class="ai-whats-in-box-list-{{ ai_gen_id }}">
          {% assign item_count = 0 %}
          {% for i in (1..7) %}
            {% liquid
              assign item_enabled_key = 'item_' | append: i | append: '_enabled'
              assign item_title_key = 'item_' | append: i | append: '_title'
              assign item_description_key = 'item_' | append: i | append: '_description'

              assign item_enabled = block.settings[item_enabled_key]
              assign item_title = block.settings[item_title_key]
              assign item_description = block.settings[item_description_key]
            %}

            {% if item_enabled %}
              {% assign item_count = item_count | plus: 1 %}
              <div class="ai-whats-in-box-item-{{ ai_gen_id }}" data-item="{{ i }}">
                <div class="ai-whats-in-box-checkmark-{{ ai_gen_id }}">
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <div class="ai-whats-in-box-item-content-{{ ai_gen_id }}">
                  <h3 class="ai-whats-in-box-item-title-{{ ai_gen_id }}">{{ item_title }}</h3>
                  {% if item_description != blank %}
                    <p class="ai-whats-in-box-item-description-{{ ai_gen_id }}">{{ item_description }}</p>
                  {% endif %}
                </div>
                <div class="ai-whats-in-box-item-number-{{ ai_gen_id }}">{{ item_count | prepend: '0' | slice: -2, 2 }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</whats-in-box-{{ ai_gen_id }}>

<script>
  (function() {
    class WhatsInBox{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-whats-in-box-item-{{ ai_gen_id }}');
        this.setupInteractivity();
      }

      setupInteractivity() {
        this.items.forEach((item, index) => {
          item.style.opacity = '0';
          item.style.transform = 'translateX(-20px)';
          
          setTimeout(() => {
            item.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            item.style.opacity = '1';
            item.style.transform = 'translateX(0)';
          }, index * 80);
        });
      }
    }

    customElements.define('whats-in-box-{{ ai_gen_id }}', WhatsInBox{{ ai_gen_id }});
  })();
</script>

