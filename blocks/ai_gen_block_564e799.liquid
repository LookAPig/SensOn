{% doc %}
  @prompt
    I want to create a section with a list of logos, 8 logos in total, that is mobile-friendly and allows for image replacement., It can accommodate 8 slots, but only 5 logos are displayed, and the logo positions are adjusted automatically., Columns on tablet at least 5 , There should be 5 logos in a row.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign logo_count = 0
  for i in (1..8)
    assign logo_key = 'logo_' | append: i
    assign logo = block.settings[logo_key]
    if logo
      assign logo_count = logo_count | plus: 1
    endif
  endfor
%}

{% style %}
  .ai-logo-list-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-logo-list-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-logo-list-heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 40px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-logo-list-grid-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.logo_spacing }}px;
    align-items: center;
    justify-content: center;
  }

  .ai-logo-list-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.logo_padding }}px;
    background-color: {{ block.settings.logo_background }};
    border-radius: {{ block.settings.logo_border_radius }}px;
    transition: transform 0.3s ease;
    flex: 0 0 calc((100% - ({{ block.settings.logo_spacing }}px * 4)) / 5);
    max-width: calc((100% - ({{ block.settings.logo_spacing }}px * 4)) / 5);
  }

  .ai-logo-list-item-{{ ai_gen_id }}:hover {
    transform: scale(1.05);
  }

  .ai-logo-list-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    max-height: {{ block.settings.logo_max_height }}px;
    object-fit: contain;
  }

  @media screen and (max-width: 989px) {
    .ai-logo-list-item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.logo_spacing }}px * ({{ block.settings.columns_tablet }} - 1))) / {{ block.settings.columns_tablet }});
      max-width: calc((100% - ({{ block.settings.logo_spacing }}px * ({{ block.settings.columns_tablet }} - 1))) / {{ block.settings.columns_tablet }});
    }
  }

  @media screen and (max-width: 749px) {
    .ai-logo-list-{{ ai_gen_id }} {
      padding: 30px 15px;
    }

    .ai-logo-list-heading-{{ ai_gen_id }} {
      margin-bottom: 30px;
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-logo-list-grid-{{ ai_gen_id }} {
      gap: {{ block.settings.logo_spacing | times: 0.75 }}px;
    }

    .ai-logo-list-item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.logo_spacing | times: 0.75 }}px * ({{ block.settings.columns_mobile }} - 1))) / {{ block.settings.columns_mobile }});
      max-width: calc((100% - ({{ block.settings.logo_spacing | times: 0.75 }}px * ({{ block.settings.columns_mobile }} - 1))) / {{ block.settings.columns_mobile }});
    }
  }
{% endstyle %}

<logo-list-{{ ai_gen_id }} class="ai-logo-list-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-logo-list-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-logo-list-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-logo-list-grid-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign logo_key = 'logo_' | append: i
          assign logo = block.settings[logo_key]
        %}

        {% if logo %}
          <div class="ai-logo-list-item-{{ ai_gen_id }}">
            <img
              src="{{ logo | image_url: width: 400 }}"
              alt="{{ logo.alt | escape }}"
              loading="lazy"
              width="{{ logo.width }}"
              height="{{ logo.height }}"
              class="ai-logo-list-image-{{ ai_gen_id }}"
            >
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</logo-list-{{ ai_gen_id }}>

