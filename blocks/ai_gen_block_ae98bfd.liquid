{%- if template.name == 'product' -%}
  {% doc %}
    @prompt
      我要在这里插入一个图片公告栏，他会有一个背景底色，除此之外没有其他
  {% enddoc %}
  {% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

  {% style %}
    /* 外层容器：全宽，背景色铺满整个屏幕宽度 */
    .ai-image-banner-{{ ai_gen_id }} {
      display: block;
      width: 100%;
      background-color: {{ block.settings.background_color }};
      /* 上下内边距进一步减为原来的 1/3（原来是减半，现在再压缩） */
      padding: calc({{ block.settings.padding }}px / 3) 0;
      border-radius: {{ block.settings.border_radius }}px;
    }

    /* 内层图片容器：控制图片宽度，水平居中 */
    .ai-image-banner-inner-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_width_percent }}%;
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
    }

    .ai-image-banner-wrapper-{{ ai_gen_id }} {
      position: relative;
      width: 100%;
      overflow: hidden;
      border-radius: {{ block.settings.image_border_radius }}px;
    }

    .ai-image-banner-image-{{ ai_gen_id }} {
      width: 100%;
      height: auto;
      display: block;
      /* 图片最大高度从 50vh 改为 33vh（原高度的 2/3） */
      max-height: 33vh;
      object-fit: contain;
    }

    .ai-image-banner-placeholder-{{ ai_gen_id }} {
      width: 100%;
      min-height: 100px;  /* 占位高度也相应缩小 */
      background-color: #f4f4f4;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .ai-image-banner-placeholder-{{ ai_gen_id }} svg {
      width: 100%;
      height: 100%;
      max-width: 400px;
      max-height: 400px;
    }

    .ai-image-banner-empty-state-{{ ai_gen_id }} {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      padding: 12px 20px;
      font-size: 14px;
      color: #666;
      text-align: center;
      pointer-events: none;
    }

    @media screen and (max-width: 749px) {
      .ai-image-banner-{{ ai_gen_id }} {
        /* 移动端内边距依然按比例压缩 */
        padding: calc({{ block.settings.padding | times: 0.6 }}px / 3) 0;
      }
      .ai-image-banner-inner-{{ ai_gen_id }} {
        width: 100%;
      }
      .ai-image-banner-image-{{ ai_gen_id }} {
        max-height: 25vh;  /* 移动端也适当降低 */
      }
    }
  {% endstyle %}

  <image-banner-{{ ai_gen_id }}
    class="ai-image-banner-{{ ai_gen_id }}"
    {{ block.shopify_attributes }}
  >
    <div class="ai-image-banner-inner-{{ ai_gen_id }}">
      <div class="ai-image-banner-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 2000 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-image-banner-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-image-banner-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-image-banner-empty-state-{{ ai_gen_id }}">
              添加图片以创建公告栏
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </image-banner-{{ ai_gen_id }}>
{%- endif -%}

{% schema %}
{
  "name": "图片公告栏",
  "blocks": [],
  "settings": [
    {
      "type": "header",
      "content": "图片"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "图片"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "图片圆角",
      "default": 0
    },
    {
      "type": "header",
      "content": "背景"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#fef5fd"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "上下内边距（实际显示再压缩至1/3）",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "外层容器圆角",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "桌面端图片宽度（百分比）",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "图片公告栏"
    }
  ]
}
{% endschema %}