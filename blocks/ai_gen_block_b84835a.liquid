{% doc %}
  @prompt
    Read these words of mine and help me write a section. You can change the pictures and copy if needed. It’s mobile-friendly. The design is in the style of whoop. It’s more feminine. The Experience, Step by Step
    Step 1｜Connect & Get Comfortable
    You set the stage
    Open the SensOn.AI app
    Pair the device via Bluetooth
    Adjust it to fit your body naturally
    
    Key message
    This is not something you hold.
    It’s something you sink into.
    
    Step 2｜Choose a Fantasy
    The experience begins in the mind
    Browse female-POV erotic audio
    Enter a scene or meet a character
    Or start a private one-on-one conversation
    
    Key message
    Desire doesn’t start with touch.
    It starts with imagination.
    
    Step 3｜AI Synchronizes Story & Touch
    
    What you hear shapes what you feel
    Audio narratives unfold in real time
    The AI ​​interprets rhythm, pacing, and emotional cues
    Stimulation evolves with the story
    
    Key message
    This isn’t playback.
    It’s a living experience.
    
    Step 4｜Your Body Talks Back
    Sensory intelligence closes the loop
    Advanced sensors detect movement and pressure
    The system reads subtle physical responses
    Stimulation adjusts instantly
    
    Key message
    Your body is part of the conversation.
    
    Step 5｜Everything Adapts to You
    The experience becomes personal
    Intensity shifts with your rhythm
    Scenes deepen as arousal builds
    No hands. No instructions. No effort.
    
    Key message
    You don’t control it.
    You let it respond to you., I don't like the style, let's rewrite it.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-steps-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_gradient }};
    padding: 80px 20px;
    position: relative;
  }

  .ai-steps__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-steps__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 80px;
  }

  .ai-steps__subtitle-{{ ai_gen_id }} {
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ block.settings.accent_color }};
    margin: 0 0 16px;
    font-weight: 500;
  }

  .ai-steps__title-{{ ai_gen_id }} {
    font-size: 36px;
    color: {{ block.settings.text_color }};
    margin: 0;
    font-weight: 300;
    letter-spacing: -0.5px;
    line-height: 1.2;
  }

  .ai-steps__timeline-{{ ai_gen_id }} {
    position: relative;
    padding-left: 0;
  }

  .ai-steps__timeline-line-{{ ai_gen_id }} {
    position: absolute;
    left: 19px;
    top: 60px;
    bottom: 60px;
    width: 2px;
    background: linear-gradient(180deg, {{ block.settings.accent_color }} 0%, {{ block.settings.accent_light }} 100%);
    opacity: 0.3;
  }

  .ai-steps__step-{{ ai_gen_id }} {
    position: relative;
    margin-bottom: 60px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .ai-steps__step-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-steps__step-marker-{{ ai_gen_id }} {
    position: absolute;
    left: 0;
    top: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: {{ block.settings.background_color }};
    border: 2px solid {{ block.settings.accent_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.accent_color }};
    z-index: 2;
  }

  .ai-steps__step-content-{{ ai_gen_id }} {
    padding-left: 60px;
  }

  .ai-steps__step-label-{{ ai_gen_id }} {
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: {{ block.settings.accent_color }};
    margin: 0 0 8px;
    font-weight: 500;
  }

  .ai-steps__step-title-{{ ai_gen_id }} {
    font-size: 24px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
    font-weight: 400;
    line-height: 1.3;
  }

  .ai-steps__step-description-{{ ai_gen_id }} {
    font-size: 15px;
    color: {{ block.settings.text_color }};
    line-height: 1.7;
    opacity: 0.8;
    margin-bottom: 20px;
  }

  .ai-steps__step-description-{{ ai_gen_id }} p {
    margin: 0 0 12px;
  }

  .ai-steps__step-description-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-steps__step-quote-{{ ai_gen_id }} {
    position: relative;
    padding: 24px 28px;
    background: {{ block.settings.quote_background }};
    border-radius: 20px;
    margin-top: 20px;
  }

  .ai-steps__step-quote-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    left: 28px;
    top: -8px;
    width: 0;
    height: 0;
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-bottom: 8px solid {{ block.settings.quote_background }};
  }

  .ai-steps__step-quote-text-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
    font-weight: 300;
    font-style: italic;
  }

  .ai-steps__step-image-{{ ai_gen_id }} {
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
  }

  .ai-steps__step-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-steps__step-image-placeholder-{{ ai_gen_id }} {
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, {{ block.settings.placeholder_bg_1 }} 0%, {{ block.settings.placeholder_bg_2 }} 100%);
    border-radius: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-steps__step-image-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.2;
  }

  @media screen and (min-width: 750px) {
    .ai-steps-{{ ai_gen_id }} {
      padding: 120px 40px;
    }

    .ai-steps__header-{{ ai_gen_id }} {
      margin-bottom: 100px;
    }

    .ai-steps__title-{{ ai_gen_id }} {
      font-size: 48px;
    }

    .ai-steps__timeline-line-{{ ai_gen_id }} {
      left: 50%;
      transform: translateX(-50%);
    }

    .ai-steps__step-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
      margin-bottom: 100px;
    }

    .ai-steps__step-marker-{{ ai_gen_id }} {
      left: 50%;
      transform: translateX(-50%);
      width: 50px;
      height: 50px;
      font-size: 16px;
    }

    .ai-steps__step-content-{{ ai_gen_id }} {
      padding-left: 0;
      grid-column: 1;
      text-align: right;
      padding-right: 80px;
    }

    .ai-steps__step-image-{{ ai_gen_id }},
    .ai-steps__step-image-placeholder-{{ ai_gen_id }} {
      grid-column: 2;
    }

    .ai-steps__step-{{ ai_gen_id }}:nth-child(even) .ai-steps__step-content-{{ ai_gen_id }} {
      grid-column: 2;
      text-align: left;
      padding-right: 0;
      padding-left: 80px;
    }

    .ai-steps__step-{{ ai_gen_id }}:nth-child(even) .ai-steps__step-image-{{ ai_gen_id }},
    .ai-steps__step-{{ ai_gen_id }}:nth-child(even) .ai-steps__step-image-placeholder-{{ ai_gen_id }} {
      grid-column: 1;
      grid-row: 1;
    }

    .ai-steps__step-{{ ai_gen_id }}:nth-child(even) .ai-steps__step-quote-{{ ai_gen_id }}::before {
      left: auto;
      right: 28px;
    }

    .ai-steps__step-title-{{ ai_gen_id }} {
      font-size: 28px;
    }
  }

  @media screen and (min-width: 990px) {
    .ai-steps__title-{{ ai_gen_id }} {
      font-size: 56px;
    }

    .ai-steps__step-title-{{ ai_gen_id }} {
      font-size: 32px;
    }
  }
{% endstyle %}

<experience-steps-{{ ai_gen_id }} class="ai-steps-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-steps__container-{{ ai_gen_id }}">
    <div class="ai-steps__header-{{ ai_gen_id }}">
      {% if block.settings.subtitle != blank %}
        <p class="ai-steps__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
      {% if block.settings.title != blank %}
        <h2 class="ai-steps__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
    </div>

    <div class="ai-steps__timeline-{{ ai_gen_id }}">
      <div class="ai-steps__timeline-line-{{ ai_gen_id }}"></div>

      {% for i in (1..5) %}
        {% liquid
          assign step_label_key = 'step_' | append: i | append: '_label'
          assign step_title_key = 'step_' | append: i | append: '_title'
          assign step_description_key = 'step_' | append: i | append: '_description'
          assign step_quote_key = 'step_' | append: i | append: '_quote'
          assign step_image_key = 'step_' | append: i | append: '_image'

          assign step_label = block.settings[step_label_key]
          assign step_title = block.settings[step_title_key]
          assign step_description = block.settings[step_description_key]
          assign step_quote = block.settings[step_quote_key]
          assign step_image = block.settings[step_image_key]
        %}

        <div class="ai-steps__step-{{ ai_gen_id }}" data-step="{{ i }}">
          <div class="ai-steps__step-marker-{{ ai_gen_id }}">{{ i }}</div>

          <div class="ai-steps__step-content-{{ ai_gen_id }}">
            {% if step_label != blank %}
              <p class="ai-steps__step-label-{{ ai_gen_id }}">{{ step_label }}</p>
            {% endif %}

            {% if step_title != blank %}
              <h3 class="ai-steps__step-title-{{ ai_gen_id }}">{{ step_title }}</h3>
            {% endif %}

            {% if step_description != blank %}
              <div class="ai-steps__step-description-{{ ai_gen_id }}">
                {{ step_description }}
              </div>
            {% endif %}

            {% if step_quote != blank %}
              <div class="ai-steps__step-quote-{{ ai_gen_id }}">
                <p class="ai-steps__step-quote-text-{{ ai_gen_id }}">{{ step_quote }}</p>
              </div>
            {% endif %}
          </div>

          {% if step_image %}
            <div class="ai-steps__step-image-{{ ai_gen_id }}">
              <img
                src="{{ step_image | image_url: width: 800 }}"
                alt="{{ step_image.alt | escape }}"
                loading="lazy"
                width="{{ step_image.width }}"
                height="{{ step_image.height }}"
              >
            </div>
          {% else %}
            <div class="ai-steps__step-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</experience-steps-{{ ai_gen_id }}>

<script>
  (function() {
    class ExperienceSteps{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initScrollAnimation();
      }

      initScrollAnimation() {
        const steps = this.querySelectorAll('.ai-steps__step-{{ ai_gen_id }}');
        
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
              }
            });
          }, {
            threshold: 0.2,
            rootMargin: '0px 0px -100px 0px'
          });

          steps.forEach((step, index) => {
            step.style.opacity = '0';
            step.style.transform = 'translateY(40px)';
            step.style.transition = `opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1) ${index * 0.15}s, transform 0.8s cubic-bezier(0.4, 0, 0.2, 1) ${index * 0.15}s`;
            observer.observe(step);
          });
        }
      }
    }

    customElements.define('experience-steps-{{ ai_gen_id }}', ExperienceSteps{{ ai_gen_id }});
  })();
</script>

