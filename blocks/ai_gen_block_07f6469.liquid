{% doc %}
  @prompt
    Specifications
    Material: FDA-compliant, body-safe silicone
    Weight: 700 g (entire product)
    Charging: USB-C rechargeable
    Water Resistance: IPX6 (resistant to strong water splashes; easy to clean)
    Noise Level: ~55 dB (quiet, comparable to soft conversation)
    Usage: Up to 90 minutes (at highest intensity)
    Connectivity: Bluetooth & Wi-Fi enabled  I need this presented in a table format, with all data replaceable and editable, mobile-friendly, and with a clean and elegant design., The table style is not visually appealing and lacks a title. Please change it. 把这个spec做成一个有背景图衬底，然后spec表格是毛玻璃效果
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-spec-table-container-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    padding: 60px 20px;
    min-height: 500px;
    overflow: hidden;
  }

  .ai-spec-table-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-spec-table-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-spec-table-background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, {{ block.settings.fallback_gradient_start }} 0%, {{ block.settings.fallback_gradient_end }} 100%);
  }

  .ai-spec-table-background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.1;
  }

  .ai-spec-table-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-spec-table-title-{{ ai_gen_id }} {
    text-align: {{ block.settings.title_alignment }};
    margin-bottom: 40px;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-spec-table-wrapper-{{ ai_gen_id }} {
    background: {{ block.settings.glass_background }};
    backdrop-filter: blur({{ block.settings.glass_blur }}px);
    -webkit-backdrop-filter: blur({{ block.settings.glass_blur }}px);
    border-radius: {{ block.settings.border_radius }}px;
    border: {{ block.settings.glass_border_width }}px solid {{ block.settings.glass_border_color }};
    padding: {{ block.settings.table_padding }}px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
  }

  .ai-spec-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
  }

  .ai-spec-table-{{ ai_gen_id }} tr {
    border-bottom: 1px solid {{ block.settings.row_border_color }};
  }

  .ai-spec-table-{{ ai_gen_id }} tr:last-child {
    border-bottom: none;
  }

  .ai-spec-table-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding }}px;
    vertical-align: middle;
  }

  .ai-spec-table-{{ ai_gen_id }} td:first-child {
    font-weight: 600;
    color: {{ block.settings.label_color }};
    font-size: {{ block.settings.label_font_size }}px;
    width: {{ block.settings.label_column_width }}%;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-spec-table-{{ ai_gen_id }} td:last-child {
    color: {{ block.settings.value_color }};
    font-size: {{ block.settings.value_font_size }}px;
    text-align: {{ block.settings.value_alignment }};
  }

  @media screen and (max-width: 749px) {
    .ai-spec-table-container-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-spec-table-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
      margin-bottom: 30px;
    }

    .ai-spec-table-wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.table_padding | times: 0.6 }}px;
    }

    .ai-spec-table-{{ ai_gen_id }} td {
      padding: {{ block.settings.cell_padding | times: 0.7 }}px;
      display: block;
      width: 100%;
    }

    .ai-spec-table-{{ ai_gen_id }} td:first-child {
      font-size: {{ block.settings.label_font_size | times: 0.9 }}px;
      padding-bottom: 8px;
      width: 100%;
    }

    .ai-spec-table-{{ ai_gen_id }} td:last-child {
      font-size: {{ block.settings.value_font_size | times: 0.9 }}px;
      padding-top: 0;
      text-align: left;
    }
  }
{% endstyle %}

<product-specifications-{{ ai_gen_id }}
  class="ai-spec-table-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-spec-table-background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-spec-table-background-placeholder-{{ ai_gen_id }}">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-spec-table-content-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-spec-table-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <div class="ai-spec-table-wrapper-{{ ai_gen_id }}">
      <table class="ai-spec-table-{{ ai_gen_id }}">
        <tbody>
          {% if block.settings.spec_1_label != blank %}
            <tr>
              <td>{{ block.settings.spec_1_label }}</td>
              <td>{{ block.settings.spec_1_value }}</td>
            </tr>
          {% endif %}

          {% if block.settings.spec_2_label != blank %}
            <tr>
              <td>{{ block.settings.spec_2_label }}</td>
              <td>{{ block.settings.spec_2_value }}</td>
            </tr>
          {% endif %}

          {% if block.settings.spec_3_label != blank %}
            <tr>
              <td>{{ block.settings.spec_3_label }}</td>
              <td>{{ block.settings.spec_3_value }}</td>
            </tr>
          {% endif %}

          {% if block.settings.spec_4_label != blank %}
            <tr>
              <td>{{ block.settings.spec_4_label }}</td>
              <td>{{ block.settings.spec_4_value }}</td>
            </tr>
          {% endif %}

          {% if block.settings.spec_5_label != blank %}
            <tr>
              <td>{{ block.settings.spec_5_label }}</td>
              <td>{{ block.settings.spec_5_value }}</td>
            </tr>
          {% endif %}

          {% if block.settings.spec_6_label != blank %}
            <tr>
              <td>{{ block.settings.spec_6_label }}</td>
              <td>{{ block.settings.spec_6_value }}</td>
            </tr>
          {% endif %}

          {% if block.settings.spec_7_label != blank %}
            <tr>
              <td>{{ block.settings.spec_7_label }}</td>
              <td>{{ block.settings.spec_7_value }}</td>
            </tr>
          {% endif %}

          {% if block.settings.spec_8_label != blank %}
            <tr>
              <td>{{ block.settings.spec_8_label }}</td>
              <td>{{ block.settings.spec_8_value }}</td>
            </tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  </div>
</product-specifications-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductSpecifications{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustBackgroundPosition();
        window.addEventListener('resize', () => this.adjustBackgroundPosition());
      }

      adjustBackgroundPosition() {
        const background = this.querySelector('.ai-spec-table-background-{{ ai_gen_id }}');
        if (background) {
          const img = background.querySelector('img');
          if (img) {
            img.style.objectPosition = 'center';
          }
        }
      }
    }

    customElements.define('product-specifications-{{ ai_gen_id }}', ProductSpecifications{{ ai_gen_id }});
  })();
</script>

