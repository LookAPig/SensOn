{% doc %}
  @prompt
    add a 4 product features cards section, style and interaction refer to anker.com, the homepage Power for Every Moment
    section. , The interactive 4-card display is laid out horizontally like four playing cards. The first card is on top and displayed by default to showcase product feature. When the mouse slides from the edge of the first card to the second, the second card fully expands, while the first on the left and the two on the right narrow down. When the mouse slides to the third card, the two on the left and the one on the right narrow down. When the mouse slides to the fourth card, the three on the left narrow down, and the last one fully expands., remove the 01 02 03 04 from each card
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-expanding-cards-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_mobile }}px 20px;
  }

  @media screen and (min-width: 750px) {
    .ai-expanding-cards-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_desktop }}px 40px;
    }
  }

  .ai-expanding-cards-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-expanding-cards-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-expanding-cards-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_mobile }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    font-weight: 600;
  }

  @media screen and (min-width: 750px) {
    .ai-expanding-cards-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }
  }

  .ai-expanding-cards-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-expanding-cards-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    height: {{ block.settings.card_height_mobile }}px;
    position: relative;
  }

  @media screen and (min-width: 990px) {
    .ai-expanding-cards-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.card_height_desktop }}px;
    }
  }

  .ai-expanding-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.collapsed_width }}px;
    height: 100%;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    transition: flex 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-expanding-card-{{ ai_gen_id }}.active {
    flex: 1;
  }

  .ai-expanding-card-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.card_background }};
  }

  .ai-expanding-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-expanding-card-{{ ai_gen_id }}.active .ai-expanding-card-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-expanding-card-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, {{ block.settings.card_background }} 0%, {{ block.settings.image_background }} 100%);
  }

  .ai-expanding-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 40%;
    height: 40%;
    opacity: 0.2;
  }

  .ai-expanding-card-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}) 100%);
    transition: opacity 0.6s ease;
  }

  .ai-expanding-card-{{ ai_gen_id }}:not(.active) .ai-expanding-card-overlay-{{ ai_gen_id }} {
    opacity: 0.7;
  }

  .ai-expanding-card-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.card_padding }}px;
    color: {{ block.settings.card_text_color }};
    z-index: 2;
  }

  .ai-expanding-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size_mobile }}px;
    font-weight: 600;
    margin: 0 0 12px;
    transition: font-size 0.3s ease;
  }

  @media screen and (min-width: 990px) {
    .ai-expanding-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_title_size_desktop }}px;
    }
  }

  .ai-expanding-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_size }}px;
    line-height: 1.6;
    margin: 0;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: opacity 0.4s ease 0.2s, max-height 0.4s ease 0.2s;
  }

  .ai-expanding-card-{{ ai_gen_id }}.active .ai-expanding-card-description-{{ ai_gen_id }} {
    opacity: 1;
    max-height: 200px;
  }

  @media screen and (max-width: 989px) {
    .ai-expanding-cards-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
      height: auto;
      gap: {{ block.settings.card_gap }}px;
    }

    .ai-expanding-card-{{ ai_gen_id }} {
      flex: 0 0 auto;
      height: 300px;
      width: 100%;
    }

    .ai-expanding-card-{{ ai_gen_id }}.active {
      height: 400px;
    }

    .ai-expanding-card-description-{{ ai_gen_id }} {
      opacity: 1;
      max-height: 200px;
    }
  }
{% endstyle %}

<expanding-feature-cards-{{ ai_gen_id }} class="ai-expanding-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-expanding-cards-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-expanding-cards-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-expanding-cards-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-expanding-cards-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-expanding-cards-wrapper-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign image_key = 'card_' | append: i | append: '_image'
          assign title_key = 'card_' | append: i | append: '_title'
          assign description_key = 'card_' | append: i | append: '_description'

          assign card_image = block.settings[image_key]
          assign card_title = block.settings[title_key]
          assign card_description = block.settings[description_key]
        %}

        <div class="ai-expanding-card-{{ ai_gen_id }}{% if forloop.first %} active{% endif %}" data-card-index="{{ forloop.index }}">
          <div class="ai-expanding-card-background-{{ ai_gen_id }}">
            {% if card_image %}
              <img
                src="{{ card_image | image_url: width: 1200 }}"
                alt="{{ card_image.alt | escape }}"
                loading="lazy"
                width="{{ card_image.width }}"
                height="{{ card_image.height }}"
                class="ai-expanding-card-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-expanding-card-image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-expanding-card-overlay-{{ ai_gen_id }}"></div>

          <div class="ai-expanding-card-content-{{ ai_gen_id }}">
            {% if card_title != blank %}
              <h3 class="ai-expanding-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
            {% endif %}
            {% if card_description != blank %}
              <p class="ai-expanding-card-description-{{ ai_gen_id }}">{{ card_description }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</expanding-feature-cards-{{ ai_gen_id }}>

<script>
  (function() {
    class ExpandingFeatureCards{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.cards = [];
        this.activeIndex = 0;
      }

      connectedCallback() {
        this.cards = Array.from(this.querySelectorAll('.ai-expanding-card-{{ ai_gen_id }}'));
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.cards.forEach((card, index) => {
          card.addEventListener('mouseenter', () => {
            this.activateCard(index);
          });

          card.addEventListener('click', () => {
            this.activateCard(index);
          });

          card.addEventListener('focus', () => {
            this.activateCard(index);
          });

          card.setAttribute('tabindex', '0');
          card.setAttribute('role', 'button');
          card.setAttribute('aria-label', `Feature card ${index + 1}`);
        });

        this.cards[0].setAttribute('aria-pressed', 'true');
      }

      activateCard(index) {
        if (this.activeIndex === index) return;

        this.cards.forEach((card, i) => {
          if (i === index) {
            card.classList.add('active');
            card.setAttribute('aria-pressed', 'true');
          } else {
            card.classList.remove('active');
            card.setAttribute('aria-pressed', 'false');
          }
        });

        this.activeIndex = index;
      }
    }

    customElements.define('expanding-feature-cards-{{ ai_gen_id }}', ExpandingFeatureCards{{ ai_gen_id }});
  })();
</script>

