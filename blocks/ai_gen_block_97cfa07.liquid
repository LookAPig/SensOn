{% doc %}
  @prompt
    The entire section appears very clunky and not streamlined enough; it's too long. Please revise it. Please design this section in the style of women's intimate products, incorporating the style of the Whoop official website, and ensuring it is user-friendly on both desktop and mobile devices., Three features are simply not enough. I don't need the navigation buttons, and everything else should remain unchanged., I think everything else is fine, but there's no interaction in this entire section. Please add some interactive elements. Also, the second row should contain four features, and the background should be dark.  Everything else remains unchanged., 我觉得都很好，就是hover交互有点奇怪，没有办法调整overlay capacity，改成毛玻璃效果, I don't want any hover effects; just give me the frosted glass effect directly., I want to be able to adjust the placeholder size of the feature myself, and I want to be able to adjust the curvature of the frosted glass border myself; everything else should remain unchanged., There are only 4 key features/selling points in total; please reformat the layout.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-intimate-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.mobile_padding }}px 20px;
    background: {{ block.settings.background_color }};
  }

  .ai-intimate-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-intimate-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-intimate-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: {{ block.settings.eyebrow_color }};
    margin: 0;
  }

  .ai-intimate-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_mobile }}px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-intimate-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    color: {{ block.settings.description_color }};
    opacity: 0.85;
    margin: 0;
  }

  .ai-intimate-features-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ block.settings.feature_gap }}px;
    margin-top: {{ block.settings.features_spacing }}px;
  }

  .ai-intimate-feature-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: {{ block.settings.feature_padding }}px;
    border-radius: {{ block.settings.feature_border_radius }}px;
    background: {{ block.settings.feature_overlay_color }};
    backdrop-filter: blur({{ block.settings.glass_blur }}px);
    -webkit-backdrop-filter: blur({{ block.settings.glass_blur }}px);
    position: relative;
    overflow: hidden;
  }

  .ai-intimate-feature-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: 50%;
    background: {{ block.settings.icon_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  .ai-intimate-feature-icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
    stroke: {{ block.settings.icon_color }};
    fill: none;
  }

  .ai-intimate-feature-text-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-intimate-feature-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_title_size }}px;
    font-weight: 500;
    color: {{ block.settings.heading_color }};
    margin: 0 0 4px 0;
  }

  .ai-intimate-feature-desc-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_desc_size }}px;
    line-height: 1.5;
    color: {{ block.settings.description_color }};
    opacity: 0.8;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .ai-intimate-section-{{ ai_gen_id }} {
      padding: {{ block.settings.desktop_padding }}px 40px;
    }

    .ai-intimate-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }

    .ai-intimate-content-{{ ai_gen_id }} {
      gap: {{ block.settings.content_gap_desktop }}px;
    }

    .ai-intimate-features-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.feature_gap_desktop }}px;
    }

    .ai-intimate-feature-{{ ai_gen_id }} {
      padding: {{ block.settings.feature_padding_desktop }}px;
    }
  }
{% endstyle %}

<div class="ai-intimate-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-intimate-container-{{ ai_gen_id }}">
    <div class="ai-intimate-content-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-intimate-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</p>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-intimate-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-intimate-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      {% if block.settings.show_features %}
        <div class="ai-intimate-features-{{ ai_gen_id }}">
          {% for i in (1..4) %}
            {% liquid
              assign feature_title_key = 'feature_' | append: i | append: '_title'
              assign feature_desc_key = 'feature_' | append: i | append: '_description'
              assign feature_title = block.settings[feature_title_key]
              assign feature_desc = block.settings[feature_desc_key]
            %}

            {% if feature_title != blank %}
              <div class="ai-intimate-feature-{{ ai_gen_id }}">
                <div class="ai-intimate-feature-icon-{{ ai_gen_id }}">
                  <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <div class="ai-intimate-feature-text-{{ ai_gen_id }}">
                  <h3 class="ai-intimate-feature-title-{{ ai_gen_id }}">{{ feature_title }}</h3>
                  {% if feature_desc != blank %}
                    <p class="ai-intimate-feature-desc-{{ ai_gen_id }}">{{ feature_desc }}</p>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

