{% doc %}
  @prompt
    三个卡片，pc端横向排，移动端左右滑动。卡片以图片为底。卡片上有title和subtitle俩行文字，在图片上下左右的最下方。可以设置文字大小, 卡片长宽比3:4, 最顶部再加一个大标题，pc局中，移动端向左对齐，可以分别调节pc和移动端字号
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-card-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-card-main-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.main_heading_size }}px;
    color: {{ block.settings.main_heading_color }};
    margin: 0 0 {{ block.settings.main_heading_spacing }}px 0;
    text-align: center;
    font-weight: 600;
  }

  .ai-card-wrapper-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-card-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    aspect-ratio: {{ block.settings.card_aspect_ratio }};
  }

  .ai-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-card-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.content_padding }}px;
    background: linear-gradient(to top, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}), transparent);
  }

  .ai-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
    font-weight: 600;
  }

  .ai-card-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    opacity: 0.9;
  }

  @media screen and (max-width: 749px) {
    .ai-card-main-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.main_heading_size_mobile }}px;
      text-align: left;
    }

    .ai-card-wrapper-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: {{ block.settings.card_gap_mobile }}px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .ai-card-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.mobile_card_width }}%;
      scroll-snap-align: start;
    }

    .ai-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-card-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size_mobile }}px;
    }
  }
{% endstyle %}

<card-carousel-{{ ai_gen_id }} class="ai-card-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.main_heading != blank %}
    <h2 class="ai-card-main-heading-{{ ai_gen_id }}">{{ block.settings.main_heading }}</h2>
  {% endif %}

  <div class="ai-card-wrapper-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'card_' | append: i | append: '_image'
        assign title_key = 'card_' | append: i | append: '_title'
        assign subtitle_key = 'card_' | append: i | append: '_subtitle'
        assign link_key = 'card_' | append: i | append: '_link'

        assign card_image = block.settings[image_key]
        assign card_title = block.settings[title_key]
        assign card_subtitle = block.settings[subtitle_key]
        assign card_link = block.settings[link_key]
      %}

      {% if card_link != blank %}
        <a href="{{ card_link }}" class="ai-card-{{ ai_gen_id }}">
      {% else %}
        <div class="ai-card-{{ ai_gen_id }}">
      {% endif %}

        {% if card_image %}
          <img
            src="{{ card_image | image_url: width: 800 }}"
            alt="{{ card_image.alt | escape }}"
            loading="lazy"
            width="{{ card_image.width }}"
            height="{{ card_image.height }}"
            class="ai-card-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-card-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}

        <div class="ai-card-content-{{ ai_gen_id }}">
          {% if card_title != blank %}
            <h3 class="ai-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
          {% endif %}
          {% if card_subtitle != blank %}
            <p class="ai-card-subtitle-{{ ai_gen_id }}">{{ card_subtitle }}</p>
          {% endif %}
        </div>

      {% if card_link != blank %}
        </a>
      {% else %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</card-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CardCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.ai-card-wrapper-{{ ai_gen_id }}');
        this.setupMobileScroll();
      }

      setupMobileScroll() {
        if (window.innerWidth <= 749 && this.wrapper) {
          this.wrapper.addEventListener('touchstart', this.handleTouchStart.bind(this), { passive: true });
        }
      }

      handleTouchStart(e) {
        this.startX = e.touches[0].pageX;
      }
    }

    customElements.define('card-carousel-{{ ai_gen_id }}', CardCarousel{{ ai_gen_id }});
  })();
</script>

