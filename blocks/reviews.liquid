{%- liquid
  assign reviews_uid = block.id | replace: "_", "" | downcase
  assign reviews_count = 0

  for child_block in block.blocks
    if child_block.type == "_review-item" and child_block.settings.tab_label != blank and child_block.settings.quote != blank
      assign reviews_count = reviews_count | plus: 1
    endif
  endfor
-%}

{%- if reviews_count > 0 -%}
  <product-customer-reviews
    class="product-customer-reviews product-customer-reviews--{{ reviews_uid }}"
    id="product-customer-reviews-{{ reviews_uid }}"
    {{ block.shopify_attributes }}
  >
    {%- style -%}
      #product-customer-reviews-{{ reviews_uid }} {
        --pcr-bg: {{ block.settings.background_color }};
        --pcr-heading-color: {{ block.settings.heading_color }};
        --pcr-quote-color: {{ block.settings.quote_color }};
        --pcr-attribution-color: {{ block.settings.attribution_color }};
        --pcr-tab-inactive-border: {{ block.settings.tab_inactive_border }};
        --pcr-tab-inactive-text: {{ block.settings.tab_inactive_text }};
        --pcr-tab-active-border: {{ block.settings.tab_active_border }};
        --pcr-tab-active-text: {{ block.settings.tab_active_text }};
        --pcr-tab-active-bg: {{ block.settings.tab_active_background }};
      }

      #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__inner {
        width: 100%;
        padding: {{ block.settings.padding_vertical_mobile }}px {{ block.settings.padding_horizontal }}px;
        background-color: var(--pcr-bg);
        border-radius: {{ block.settings.border_radius }}px;
        text-align: center;
        box-sizing: border-box;
      }

      #product-customer-reviews-{{ reviews_uid }} * {
        box-sizing: border-box;
      }

      #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__heading {
        margin: 0 0 {{ block.settings.heading_spacing }}px;
        font-family: var(--heading-font-family), Georgia, "Times New Roman", serif;
        font-style: var(--heading-font-style);
        font-weight: 400;
        font-size: {{ block.settings.heading_size_mobile }}px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        line-height: 1.2;
        color: var(--pcr-heading-color);
      }

      #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__content {
        position: relative;
        min-height: {{ block.settings.content_min_height_mobile }}px;
        margin-bottom: {{ block.settings.tabs_spacing }}px;
      }

      #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__panel {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 0 8px;
        opacity: 0;
        visibility: hidden;
        transform: translateY(14px);
        transition: opacity 0.45s ease, transform 0.45s ease, visibility 0.45s ease;
        pointer-events: none;
      }

      #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__panel.is-active {
        position: relative;
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        pointer-events: auto;
      }

      #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__panel.is-leaving {
        position: absolute;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px);
      }

      #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__quote {
        margin: 0;
        max-width: 920px;
        font-family: var(--text-font-family), system-ui, sans-serif;
        font-size: {{ block.settings.quote_size_mobile }}px;
        font-weight: 700;
        line-height: 1.35;
        color: var(--pcr-quote-color);
      }

      #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__quote::before {
        content: "\201C";
      }

      #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__quote::after {
        content: "\201D";
      }

      #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__attribution {
        display: inline-block;
        margin-top: 12px;
        font-family: var(--text-font-family), system-ui, sans-serif;
        font-size: {{ block.settings.attribution_size }}px;
        font-weight: 700;
        line-height: 1.3;
        color: var(--pcr-attribution-color);
      }

      #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__tabs {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 10px;
      }

      #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__tab {
        appearance: none;
        border: 1.5px solid var(--pcr-tab-inactive-border);
        background: transparent;
        color: var(--pcr-tab-inactive-text);
        border-radius: 999px;
        padding: 10px 20px;
        font-family: var(--text-font-family), system-ui, sans-serif;
        font-size: {{ block.settings.tab_font_size }}px;
        font-weight: 600;
        line-height: 1.2;
        cursor: pointer;
        transition: border-color 0.25s ease, color 0.25s ease, background-color 0.25s ease, transform 0.2s ease;
      }

      #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__tab:hover {
        transform: translateY(-1px);
      }

      #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__tab.is-active {
        border-color: var(--pcr-tab-active-border);
        color: var(--pcr-tab-active-text);
        background-color: var(--pcr-tab-active-bg);
      }

      #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__tab:focus-visible {
        outline: 2px solid var(--pcr-tab-active-border);
        outline-offset: 2px;
      }

      @media screen and (min-width: 750px) {
        #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__inner {
          padding-top: {{ block.settings.padding_vertical_desktop }}px;
          padding-bottom: {{ block.settings.padding_vertical_desktop }}px;
        }

        #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__heading {
          font-size: {{ block.settings.heading_size_desktop }}px;
        }

        #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__content {
          min-height: {{ block.settings.content_min_height_desktop }}px;
        }

        #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__quote {
          font-size: {{ block.settings.quote_size_desktop }}px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__panel,
        #product-customer-reviews-{{ reviews_uid }} .product-customer-reviews__tab {
          transition: none;
        }
      }
    {%- endstyle -%}

    <div class="product-customer-reviews__inner">
      {%- if block.settings.heading != blank -%}
        <h2 class="product-customer-reviews__heading">{{ block.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="product-customer-reviews__content" data-reviews-panels>
        {%- assign reviews_panel_index = 0 -%}
        {%- for child_block in block.blocks -%}
          {%- if child_block.type == "_review-item" and child_block.settings.tab_label != blank and child_block.settings.quote != blank -%}
            <div
              class="product-customer-reviews__panel{% if reviews_panel_index == 0 %} is-active{% endif %}"
              data-reviews-panel
              data-index="{{ reviews_panel_index }}"
              role="tabpanel"
              id="product-customer-reviews-panel-{{ reviews_uid }}-{{ reviews_panel_index }}"
              aria-labelledby="product-customer-reviews-tab-{{ reviews_uid }}-{{ reviews_panel_index }}"
              {% unless reviews_panel_index == 0 %}
                hidden
              {% endunless %}
              {{ child_block.shopify_attributes }}
            >
              <p class="product-customer-reviews__quote">{{ child_block.settings.quote | escape }}</p>
              {%- if child_block.settings.attribution != blank -%}
                <span class="product-customer-reviews__attribution">— {{ child_block.settings.attribution | escape }}</span>
              {%- endif -%}
            </div>
            {%- assign reviews_panel_index = reviews_panel_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="product-customer-reviews__tabs" role="tablist" aria-label="{{ block.settings.heading | default: 'Customer reviews' | escape }}">
        {%- assign reviews_tab_index = 0 -%}
        {%- for child_block in block.blocks -%}
          {%- if child_block.type == "_review-item" and child_block.settings.tab_label != blank and child_block.settings.quote != blank -%}
            <button
              type="button"
              class="product-customer-reviews__tab{% if reviews_tab_index == 0 %} is-active{% endif %}"
              role="tab"
              data-reviews-tab
              data-index="{{ reviews_tab_index }}"
              id="product-customer-reviews-tab-{{ reviews_uid }}-{{ reviews_tab_index }}"
              aria-controls="product-customer-reviews-panel-{{ reviews_uid }}-{{ reviews_tab_index }}"
              aria-selected="{% if reviews_tab_index == 0 %}true{% else %}false{% endif %}"
            >
              {{ child_block.settings.tab_label | escape }}
            </button>
            {%- assign reviews_tab_index = reviews_tab_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </product-customer-reviews>

  <script>
    (() => {
      if (customElements.get("product-customer-reviews")) {
        return;
      }

      class ProductCustomerReviews extends HTMLElement {
        connectedCallback() {
          this.tabs = Array.from(this.querySelectorAll("[data-reviews-tab]"));
          this.panels = Array.from(this.querySelectorAll("[data-reviews-panel]"));
          this.activeIndex = 0;
          this.isAnimating = false;
          this.reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

          this.tabs.forEach((tab) => {
            tab.addEventListener("click", () => {
              const index = Number(tab.dataset.index);

              if (Number.isNaN(index) || index === this.activeIndex) {
                return;
              }

              this.activate(index);
            });
          });
        }

        activate(index) {
          const nextPanel = this.panels[index];
          const currentPanel = this.panels[this.activeIndex];

          if (!nextPanel || !currentPanel || this.isAnimating) {
            return;
          }

          this.isAnimating = true;

          this.tabs.forEach((tab, tabIndex) => {
            const isActive = tabIndex === index;
            tab.classList.toggle("is-active", isActive);
            tab.setAttribute("aria-selected", isActive ? "true" : "false");
          });

          if (this.reduceMotion) {
            currentPanel.classList.remove("is-active");
            currentPanel.hidden = true;
            nextPanel.hidden = false;
            nextPanel.classList.add("is-active");
            this.activeIndex = index;
            this.isAnimating = false;
            return;
          }

          currentPanel.classList.add("is-leaving");
          currentPanel.classList.remove("is-active");

          window.setTimeout(() => {
            currentPanel.classList.remove("is-leaving");
            currentPanel.hidden = true;

            nextPanel.hidden = false;
            nextPanel.classList.add("is-active");

            window.setTimeout(() => {
              this.activeIndex = index;
              this.isAnimating = false;
            }, 450);
          }, 200);
        }
      }

      customElements.define("product-customer-reviews", ProductCustomerReviews);
    })();
  </script>
{%- endif -%}

