{% doc %}
  @prompt
    做一个quiz，有四个答案，五个问题，每个问题五个选项, 结论页面分成一个单独可以设计的
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign quiz_newsletter_form_id = 'quiz-newsletter-' | append: ai_gen_id %}
{% assign quiz_newsletter_form_class = 'ai-quiz-result-form-' | append: ai_gen_id %}

{% style %}
  .ai-quiz-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-quiz-container-{{ ai_gen_id }}.is-results {
    padding: 0;
    background-color: transparent;
    max-width: {{ block.settings.results_max_width }}px;
  }

  .ai-quiz-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-quiz-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
  }

  .ai-quiz-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
  }

  .ai-quiz-progress-{{ ai_gen_id }} {
    width: 100%;
    height: 8px;
    background-color: {{ block.settings.progress_bg_color }};
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 32px;
  }

  .ai-quiz-progress-bar-{{ ai_gen_id }} {
    height: 100%;
    background-color: {{ block.settings.progress_color }};
    transition: width 0.3s ease;
    width: 0%;
  }

  .ai-quiz-question-{{ ai_gen_id }} {
    display: none;
    animation: ai-quiz-fade-in-{{ ai_gen_id }} 0.4s ease;
  }

  .ai-quiz-question-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-quiz-question-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.question_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 24px;
    font-weight: 600;
  }

  .ai-quiz-options-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-quiz-option-{{ ai_gen_id }} {
    padding: 16px 20px;
    background-color: {{ block.settings.option_bg_color }};
    border: 2px solid {{ block.settings.option_border_color }};
    border-radius: {{ block.settings.option_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.option_size }}px;
    text-align: left;
  }

  .ai-quiz-option-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.option_hover_bg_color }};
    border-color: {{ block.settings.option_hover_border_color }};
    transform: translateX(4px);
  }

  .ai-quiz-option-{{ ai_gen_id }}.selected {
    background-color: {{ block.settings.option_selected_bg_color }};
    border-color: {{ block.settings.option_selected_border_color }};
  }

  .ai-quiz-navigation-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    margin-top: 32px;
    gap: 16px;
  }

  .ai-quiz-button-{{ ai_gen_id }} {
    padding: 14px 28px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    font-size: 16px;
    transition: all 0.3s ease;
    font-weight: 600;
  }

  .ai-quiz-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-quiz-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-quiz-button-secondary-{{ ai_gen_id }} {
    background-color: transparent;
    color: {{ block.settings.text_color }};
    border: 2px solid {{ block.settings.button_bg_color }};
  }

  .ai-quiz-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
  }

  /* ========== Results page ========== */
  .ai-quiz-results-{{ ai_gen_id }} {
    display: none;
    animation: ai-quiz-fade-in-{{ ai_gen_id }} 0.4s ease;
  }

  .ai-quiz-results-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-quiz-result-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.results_bg_color }};
    border-radius: {{ block.settings.results_border_radius }}px;
    padding: {{ block.settings.results_padding }}px;
    color: {{ block.settings.results_text_color }};
    text-align: left;
  }

  .ai-quiz-result-top-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }

  .ai-quiz-result-brand-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_brand_size }}px;
    font-weight: 700;
    color: {{ block.settings.results_text_color }};
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .ai-quiz-result-status-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_status_size }}px;
    color: {{ block.settings.results_muted_color }};
    font-weight: 400;
    white-space: nowrap;
  }

  .ai-quiz-result-divider-{{ ai_gen_id }} {
    height: {{ block.settings.results_divider_height }}px;
    background-color: {{ block.settings.results_accent_color }};
    border: none;
    margin: 0 0 28px;
    width: 100%;
  }

  .ai-quiz-result-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_label_size }}px;
    color: {{ block.settings.results_accent_color }};
    font-weight: 500;
    margin: 0 0 10px;
    line-height: 1.3;
  }

  .ai-quiz-result-type-{{ ai_gen_id }} {
    font-family: Georgia, "Times New Roman", Times, serif;
    font-size: {{ block.settings.results_type_size }}px;
    font-weight: 400;
    color: {{ block.settings.results_text_color }};
    margin: 0 0 16px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .ai-quiz-result-desc-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_desc_size }}px;
    color: {{ block.settings.results_text_color }};
    line-height: 1.55;
    margin: 0 0 28px;
    max-width: 36em;
  }

  .ai-quiz-result-locked-{{ ai_gen_id }} {
    background-color: {{ block.settings.results_locked_bg_color }};
    border: 1px solid {{ block.settings.results_locked_border_color }};
    border-radius: {{ block.settings.results_locked_radius }}px;
    padding: 22px 20px;
    margin-bottom: 28px;
  }

  .ai-quiz-result-dim-{{ ai_gen_id }} {
    margin-bottom: 18px;
  }

  .ai-quiz-result-dim-{{ ai_gen_id }}:last-of-type {
    margin-bottom: 20px;
  }

  .ai-quiz-result-dim-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  .ai-quiz-result-dim-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_dim_label_size }}px;
    color: {{ block.settings.results_text_color }};
    font-weight: 500;
  }

  .ai-quiz-result-dim-value-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_dim_label_size }}px;
    color: {{ block.settings.results_text_color }};
    font-weight: 600;
    min-width: 42px;
    text-align: right;
    transition: filter 0.35s ease;
  }

  .ai-quiz-result-dim-bar-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.results_bar_height }}px;
    background-color: {{ block.settings.results_bar_bg_color }};
    border-radius: 999px;
    overflow: hidden;
  }

  .ai-quiz-result-dim-fill-{{ ai_gen_id }} {
    height: 100%;
    width: 0%;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      {{ block.settings.results_bar_fill_start }},
      {{ block.settings.results_bar_fill_end }}
    );
    transition: width 0.6s ease;
  }

  .ai-quiz-result-locked-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_locked_text_size }}px;
    color: {{ block.settings.results_text_color }};
    line-height: 1.6;
    margin: 0;
    transition: filter 0.35s ease;
  }

  .ai-quiz-result-blur-{{ ai_gen_id }} {
    filter: blur({{ block.settings.results_blur_amount }}px);
    user-select: none;
    pointer-events: none;
  }

  .ai-quiz-result-subscribe-note-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_subscribe_note_size }}px;
    color: {{ block.settings.results_text_color }};
    margin: 0 0 16px;
    line-height: 1.45;
  }

  .ai-quiz-result-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 16px;
  }

  .ai-quiz-result-email-{{ ai_gen_id }} {
    width: 100%;
    box-sizing: border-box;
    padding: 14px 16px;
    background-color: {{ block.settings.results_input_bg_color }};
    border: 1px solid {{ block.settings.results_input_border_color }};
    border-radius: {{ block.settings.results_input_radius }}px;
    color: {{ block.settings.results_text_color }};
    font-size: {{ block.settings.results_input_size }}px;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .ai-quiz-result-email-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.results_muted_color }};
  }

  .ai-quiz-result-email-{{ ai_gen_id }}:focus {
    border-color: {{ block.settings.results_accent_color }};
  }

  .ai-quiz-result-submit-{{ ai_gen_id }} {
    width: 100%;
    box-sizing: border-box;
    padding: 15px 20px;
    background-color: {{ block.settings.results_cta_bg_color }};
    color: {{ block.settings.results_cta_text_color }};
    border: none;
    border-radius: {{ block.settings.results_cta_border_radius }}px;
    font-size: {{ block.settings.results_cta_size }}px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }

  .ai-quiz-result-submit-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.results_cta_hover_bg_color }};
  }

  .ai-quiz-result-submit-{{ ai_gen_id }}:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .ai-quiz-result-privacy-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_privacy_size }}px;
    color: {{ block.settings.results_muted_color }};
    line-height: 1.5;
    margin: 0;
    text-align: left;
  }

  .ai-quiz-result-message-{{ ai_gen_id }} {
    font-size: 14px;
    margin: 0 0 12px;
    line-height: 1.4;
    display: none;
  }

  .ai-quiz-result-message-{{ ai_gen_id }}.is-error {
    display: block;
    color: {{ block.settings.results_accent_color }};
  }

  .ai-quiz-result-message-{{ ai_gen_id }}.is-success {
    display: block;
    color: {{ block.settings.results_text_color }};
  }

  .ai-quiz-result-subscribe-{{ ai_gen_id }}.is-unlocked .ai-quiz-result-form-{{ ai_gen_id }},
  .ai-quiz-result-subscribe-{{ ai_gen_id }}.is-unlocked .ai-quiz-result-subscribe-note-{{ ai_gen_id }} {
    display: none;
  }

  .ai-quiz-result-restart-wrap-{{ ai_gen_id }} {
    margin-top: 24px;
  }

  .ai-quiz-result-restart-wrap-{{ ai_gen_id }} .ai-quiz-button-{{ ai_gen_id }} {
    background-color: transparent;
    color: {{ block.settings.results_text_color }};
    border: 1px solid {{ block.settings.results_input_border_color }};
  }

  .ai-quiz-result-restart-wrap-{{ ai_gen_id }} .ai-quiz-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.results_locked_bg_color }};
    color: {{ block.settings.results_text_color }};
  }

  @keyframes ai-quiz-fade-in-{{ ai_gen_id }} {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-quiz-container-{{ ai_gen_id }} {
      padding: 24px 16px;
    }

    .ai-quiz-container-{{ ai_gen_id }}.is-results {
      padding: 0;
    }

    .ai-quiz-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-quiz-question-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.question_size }}px * 0.85);
    }

    .ai-quiz-result-card-{{ ai_gen_id }} {
      padding: {{ block.settings.results_padding | times: 0.7 }}px;
      border-radius: {{ block.settings.results_border_radius | times: 0.75 }}px;
    }

    .ai-quiz-result-type-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.results_type_size }}px * 0.82);
    }

    .ai-quiz-navigation-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-quiz-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<script type="application/json" data-quiz-types-{{ ai_gen_id }}>
  [
    {
      "name": {{ block.settings.type_1_name | json }},
      "tagline": {{ block.settings.type_1_tagline | json }},
      "percent": {{ block.settings.type_1_percent | default: 8 }},
      "dim1_label": {{ block.settings.type_1_dim1_label | json }},
      "dim1_value": {{ block.settings.type_1_dim1_value | default: 78 }},
      "dim2_label": {{ block.settings.type_1_dim2_label | json }},
      "dim2_value": {{ block.settings.type_1_dim2_value | default: 85 }},
      "dim3_label": {{ block.settings.type_1_dim3_label | json }},
      "dim3_value": {{ block.settings.type_1_dim3_value | default: 62 }},
      "locked_text": {{ block.settings.type_1_locked_text | json }}
    },
    {
      "name": {{ block.settings.type_2_name | json }},
      "tagline": {{ block.settings.type_2_tagline | json }},
      "percent": {{ block.settings.type_2_percent | default: 14 }},
      "dim1_label": {{ block.settings.type_2_dim1_label | json }},
      "dim1_value": {{ block.settings.type_2_dim1_value | default: 55 }},
      "dim2_label": {{ block.settings.type_2_dim2_label | json }},
      "dim2_value": {{ block.settings.type_2_dim2_value | default: 70 }},
      "dim3_label": {{ block.settings.type_2_dim3_label | json }},
      "dim3_value": {{ block.settings.type_2_dim3_value | default: 88 }},
      "locked_text": {{ block.settings.type_2_locked_text | json }}
    },
    {
      "name": {{ block.settings.type_3_name | json }},
      "tagline": {{ block.settings.type_3_tagline | json }},
      "percent": {{ block.settings.type_3_percent | default: 21 }},
      "dim1_label": {{ block.settings.type_3_dim1_label | json }},
      "dim1_value": {{ block.settings.type_3_dim1_value | default: 90 }},
      "dim2_label": {{ block.settings.type_3_dim2_label | json }},
      "dim2_value": {{ block.settings.type_3_dim2_value | default: 48 }},
      "dim3_label": {{ block.settings.type_3_dim3_label | json }},
      "dim3_value": {{ block.settings.type_3_dim3_value | default: 67 }},
      "locked_text": {{ block.settings.type_3_locked_text | json }}
    },
    {
      "name": {{ block.settings.type_4_name | json }},
      "tagline": {{ block.settings.type_4_tagline | json }},
      "percent": {{ block.settings.type_4_percent | default: 11 }},
      "dim1_label": {{ block.settings.type_4_dim1_label | json }},
      "dim1_value": {{ block.settings.type_4_dim1_value | default: 64 }},
      "dim2_label": {{ block.settings.type_4_dim2_label | json }},
      "dim2_value": {{ block.settings.type_4_dim2_value | default: 92 }},
      "dim3_label": {{ block.settings.type_4_dim3_label | json }},
      "dim3_value": {{ block.settings.type_4_dim3_value | default: 73 }},
      "locked_text": {{ block.settings.type_4_locked_text | json }}
    }
  ]
</script>

<quiz-component-{{ ai_gen_id }} class="ai-quiz-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-quiz-header-{{ ai_gen_id }}" data-quiz-header>
    {% if block.settings.quiz_title != blank %}
      <h2 class="ai-quiz-title-{{ ai_gen_id }}">{{ block.settings.quiz_title }}</h2>
    {% endif %}
    {% if block.settings.quiz_description != blank %}
      <div class="ai-quiz-description-{{ ai_gen_id }}">{{ block.settings.quiz_description }}</div>
    {% endif %}
  </div>

  <div class="ai-quiz-progress-{{ ai_gen_id }}" data-quiz-progress>
    <div class="ai-quiz-progress-bar-{{ ai_gen_id }}" data-progress-bar></div>
  </div>

  <div class="ai-quiz-questions-{{ ai_gen_id }}" data-quiz-questions>
    {% for i in (1..5) %}
      {% liquid
        assign question_key = 'question_' | append: i
        assign option_1_key = 'q' | append: i | append: '_option_1'
        assign option_2_key = 'q' | append: i | append: '_option_2'
        assign option_3_key = 'q' | append: i | append: '_option_3'
        assign option_4_key = 'q' | append: i | append: '_option_4'
        assign option_5_key = 'q' | append: i | append: '_option_5'

        assign question = block.settings[question_key]
        assign option_1 = block.settings[option_1_key]
        assign option_2 = block.settings[option_2_key]
        assign option_3 = block.settings[option_3_key]
        assign option_4 = block.settings[option_4_key]
        assign option_5 = block.settings[option_5_key]
      %}

      <div class="ai-quiz-question-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}" data-question="{{ i }}">
        <h3 class="ai-quiz-question-title-{{ ai_gen_id }}">{{ i }}. {{ question }}</h3>
        <div class="ai-quiz-options-{{ ai_gen_id }}">
          {% if option_1 != blank %}
            <div class="ai-quiz-option-{{ ai_gen_id }}" data-option="1">{{ option_1 }}</div>
          {% endif %}
          {% if option_2 != blank %}
            <div class="ai-quiz-option-{{ ai_gen_id }}" data-option="2">{{ option_2 }}</div>
          {% endif %}
          {% if option_3 != blank %}
            <div class="ai-quiz-option-{{ ai_gen_id }}" data-option="3">{{ option_3 }}</div>
          {% endif %}
          {% if option_4 != blank %}
            <div class="ai-quiz-option-{{ ai_gen_id }}" data-option="4">{{ option_4 }}</div>
          {% endif %}
          {% if option_5 != blank %}
            <div class="ai-quiz-option-{{ ai_gen_id }}" data-option="5">{{ option_5 }}</div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  <div class="ai-quiz-navigation-{{ ai_gen_id }}" data-quiz-nav>
    <button type="button" class="ai-quiz-button-{{ ai_gen_id }} ai-quiz-button-secondary-{{ ai_gen_id }}" data-prev-btn disabled>
      {{ block.settings.previous_button_text }}
    </button>
    <button type="button" class="ai-quiz-button-{{ ai_gen_id }}" data-next-btn disabled>
      {{ block.settings.next_button_text }}
    </button>
  </div>

  <div class="ai-quiz-results-{{ ai_gen_id }}" data-results>
    <div class="ai-quiz-result-card-{{ ai_gen_id }}">
      <div class="ai-quiz-result-top-{{ ai_gen_id }}">
        <div class="ai-quiz-result-brand-{{ ai_gen_id }}">{{ block.settings.results_brand_name }}</div>
        <div class="ai-quiz-result-status-{{ ai_gen_id }}">{{ block.settings.results_status_text }}</div>
      </div>

      <hr class="ai-quiz-result-divider-{{ ai_gen_id }}">

      {% if block.settings.results_type_label != blank %}
        <div class="ai-quiz-result-label-{{ ai_gen_id }}">{{ block.settings.results_type_label }}</div>
      {% endif %}

      <h2 class="ai-quiz-result-type-{{ ai_gen_id }}" data-type-name></h2>

      <p class="ai-quiz-result-desc-{{ ai_gen_id }}">
        <span data-type-tagline></span>
        {% if block.settings.results_percent_prefix != blank or block.settings.results_percent_suffix != blank %}
          <span data-percent-sentence>
            {{ block.settings.results_percent_prefix }}<span data-type-percent></span>{{ block.settings.results_percent_suffix }}
          </span>
        {% endif %}
      </p>

      <div class="ai-quiz-result-locked-{{ ai_gen_id }}" data-locked-card>
        {% for dim_index in (1..3) %}
          <div class="ai-quiz-result-dim-{{ ai_gen_id }}" data-dim="{{ dim_index }}">
            <div class="ai-quiz-result-dim-row-{{ ai_gen_id }}">
              <span class="ai-quiz-result-dim-label-{{ ai_gen_id }}" data-dim-label></span>
              <span
                class="ai-quiz-result-dim-value-{{ ai_gen_id }} ai-quiz-result-blur-{{ ai_gen_id }}"
                data-dim-value
                aria-hidden="true"
              >88%</span>
            </div>
            <div class="ai-quiz-result-dim-bar-{{ ai_gen_id }}">
              <div class="ai-quiz-result-dim-fill-{{ ai_gen_id }}" data-dim-fill></div>
            </div>
          </div>
        {% endfor %}

        <p
          class="ai-quiz-result-locked-text-{{ ai_gen_id }} ai-quiz-result-blur-{{ ai_gen_id }}"
          data-locked-text
          aria-hidden="true"
        ></p>
      </div>

      <div class="ai-quiz-result-subscribe-{{ ai_gen_id }}" data-subscribe-area>
        {% if block.settings.results_subscribe_note != blank %}
          <p class="ai-quiz-result-subscribe-note-{{ ai_gen_id }}">{{ block.settings.results_subscribe_note }}</p>
        {% endif %}

        <p class="ai-quiz-result-message-{{ ai_gen_id }}" data-form-message role="status"></p>

        {% form 'customer', id: quiz_newsletter_form_id, class: quiz_newsletter_form_class %}
          <input type="hidden" name="contact[tags]" value="{{ block.settings.results_newsletter_tags }}">
          <input
            class="ai-quiz-result-email-{{ ai_gen_id }}"
            type="email"
            name="contact[email]"
            placeholder="{{ block.settings.results_email_placeholder }}"
            autocomplete="email"
            required
            data-email-input
          >
