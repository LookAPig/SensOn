{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign quiz_newsletter_form_id = 'quiz-newsletter-' | append: ai_gen_id %}
{% assign quiz_newsletter_form_class = 'ai-quiz-result-form-' | append: ai_gen_id %}

{% style %}
  /* Quiz journey: keep logo + quiz only; hide site chrome */
  body.template-quiz-journey {
    padding-bottom: 0 !important;
  }

  body.template-quiz-journey .shopify-section-group-header-group > .shopify-section:not(.shopify-section--header),
  body.template-quiz-journey .shopify-section--announcement-bar,
  body.template-quiz-journey .header__primary-nav,
  body.template-quiz-journey .header__secondary-nav,
  body.template-quiz-journey #sticky-bar-pc,
  body.template-quiz-journey #sticky-bar-h5,
  body.template-quiz-journey .sb-section-pc,
  body.template-quiz-journey .sb-section-h5,
  body.template-quiz-journey .shopify-section-group-footer-group,
  body.template-quiz-journey .shopify-section-group-overlay-group {
    display: none !important;
  }

  body.template-quiz-journey .shopify-section-group-header-group {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    pointer-events: none;
  }

  body.template-quiz-journey .shopify-section--header,
  body.template-quiz-journey .x-header-wrapper,
  body.template-quiz-journey .header {
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    border: none !important;
    box-shadow: none !important;
    --background: 0 0 0 / 0 !important;
    --background-gradient: none !important;
    --border-color: 0 0 0 / 0 !important;
  }

  body.template-quiz-journey .header {
    --header-grid: "logo" / auto !important;
    justify-content: start;
    padding-block: 12px;
  }

  body.template-quiz-journey .header__logo {
    justify-self: start;
    pointer-events: auto;
  }

  .ai-quiz-container-{{ ai_gen_id }} {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: 100svh;
    box-sizing: border-box;
    margin: 0 auto;
    padding: 40px 20px;
    background-color: transparent;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-quiz-container-{{ ai_gen_id }} h2,
  .ai-quiz-container-{{ ai_gen_id }} h3,
  .ai-quiz-container-{{ ai_gen_id }} h4,
  .ai-quiz-container-{{ ai_gen_id }} h5,
  .ai-quiz-container-{{ ai_gen_id }} h6 {
    text-transform: none !important;
  }

  .ai-quiz-container-{{ ai_gen_id }}::before {
    content: "";
    position: absolute;
    z-index: 0;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    min-height: 100svh;
    transform: translateX(-50%);
    pointer-events: none;
    background-color: {{ block.settings.background_color }};
    {% if block.settings.desktop_background_image != blank %}
      background-image: url('{{ block.settings.desktop_background_image | image_url: width: 2400 }}');
      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
    {% endif %}
  }

  .ai-quiz-container-{{ ai_gen_id }} > * {
    position: relative;
    z-index: 1;
  }

  .ai-quiz-container-{{ ai_gen_id }}.is-results {
    padding: 0;
    min-height: auto;
    background-color: transparent;
    background-image: none;
    width: 100%;
    max-width: 440px;
  }

  .ai-quiz-container-{{ ai_gen_id }}.is-results::before {
    display: none;
  }

  .ai-quiz-start-{{ ai_gen_id }} {
    display: none;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
  }

  .ai-quiz-container-{{ ai_gen_id }}.is-start .ai-quiz-start-{{ ai_gen_id }} {
    display: flex;
  }

  .ai-quiz-container-{{ ai_gen_id }}.is-start .ai-quiz-progress-{{ ai_gen_id }},
  .ai-quiz-container-{{ ai_gen_id }}.is-start .ai-quiz-questions-{{ ai_gen_id }},
  .ai-quiz-container-{{ ai_gen_id }}.is-start .ai-quiz-navigation-{{ ai_gen_id }} {
    display: none;
  }

  .ai-quiz-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 28px;
  }

  .ai-quiz-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
  }

  .ai-quiz-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    white-space: pre-line;
    line-height: 1.5;
  }

  .ai-quiz-start-cta-{{ ai_gen_id }} {
    margin-top: 8px;
    min-width: 200px;
  }

  .ai-quiz-progress-{{ ai_gen_id }} {
    width: 100%;
    height: 8px;
    background-color: {{ block.settings.progress_bg_color }};
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 16px;
  }

  .ai-quiz-progress-bar-{{ ai_gen_id }} {
    height: 100%;
    background: linear-gradient(
      90deg,
      {{ block.settings.results_bar_fill_start }},
      {{ block.settings.results_bar_fill_end }}
    );
    transition: width 0.3s ease;
    width: 0%;
  }

  .ai-quiz-question-{{ ai_gen_id }} {
    display: none;
    animation: ai-quiz-fade-in-{{ ai_gen_id }} 0.4s ease;
  }

  .ai-quiz-question-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-quiz-question-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.question_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 24px;
    font-weight: 600;
    text-transform: none !important;
  }

  .ai-quiz-chapter-{{ ai_gen_id }} {
    margin: 0 0 12px;
    font-size: {{ block.settings.chapter_size }}px;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
    color: {{ block.settings.text_color }};
    opacity: 0.72;
  }

  .ai-quiz-options-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-quiz-option-{{ ai_gen_id }} {
    padding: 16px 20px;
    background-color: {{ block.settings.option_bg_color }};
    border: 2px solid {{ block.settings.option_border_color }};
    border-radius: {{ block.settings.option_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    color: {{ block.settings.option_text_color }};
    font-size: {{ block.settings.option_size }}px;
    text-align: left;
  }

  .ai-quiz-option-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.option_hover_bg_color }};
    border-color: {{ block.settings.option_hover_border_color }};
    color: {{ block.settings.option_active_text_color }};
    transform: translateX(4px);
  }

  .ai-quiz-option-{{ ai_gen_id }}.selected {
    background-color: {{ block.settings.option_selected_bg_color }};
    border-color: {{ block.settings.option_selected_border_color }};
    color: {{ block.settings.option_active_text_color }};
  }

  .ai-quiz-navigation-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    margin-top: 32px;
    gap: 16px;
  }

  .ai-quiz-button-{{ ai_gen_id }} {
    padding: 14px 28px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    font-size: 16px;
    transition: all 0.3s ease;
    font-weight: 600;
  }

  .ai-quiz-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-quiz-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-quiz-button-secondary-{{ ai_gen_id }} {
    background-color: transparent;
    color: {{ block.settings.text_color }};
    border: 2px solid {{ block.settings.button_bg_color }};
  }

  .ai-quiz-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
  }

  /* ========== Results page ========== */
  .ai-quiz-results-{{ ai_gen_id }} {
    display: none;
    animation: ai-quiz-fade-in-{{ ai_gen_id }} 0.4s ease;
  }

  .ai-quiz-results-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-quiz-result-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.results_bg_color }};
    border-radius: {{ block.settings.results_border_radius }}px;
    padding: {{ block.settings.results_padding }}px;
    color: {{ block.settings.results_text_color }};
    text-align: left;
  }

  .ai-quiz-result-top-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }

  .ai-quiz-result-brand-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_brand_size }}px;
    font-weight: 700;
    color: {{ block.settings.results_text_color }};
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .ai-quiz-result-status-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_status_size }}px;
    color: {{ block.settings.results_muted_color }};
    font-weight: 400;
    white-space: nowrap;
  }

  .ai-quiz-result-divider-{{ ai_gen_id }} {
    height: {{ block.settings.results_divider_height }}px;
    background-color: {{ block.settings.results_accent_color }};
    border: none;
    margin: 0 0 28px;
    width: 100%;
  }

  .ai-quiz-result-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_label_size }}px;
    color: {{ block.settings.results_accent_color }};
    font-weight: 500;
    margin: 0 0 10px;
    line-height: 1.3;
  }

  .ai-quiz-result-type-{{ ai_gen_id }} {
    font-family: inherit !important;
    font-size: {{ block.settings.results_type_size }}px;
    font-weight: 400;
    color: {{ block.settings.results_text_color }};
    margin: 0 0 16px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .ai-quiz-result-body-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-bottom: 28px;
  }

  .ai-quiz-result-main-{{ ai_gen_id }} {
    min-width: 0;
  }

  .ai-quiz-result-desc-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_desc_size }}px;
    color: {{ block.settings.results_text_color }};
    line-height: 1.55;
    margin: 0;
    max-width: 36em;
  }

  .ai-quiz-result-desc-{{ ai_gen_id }} [data-type-tagline],
  .ai-quiz-result-locked-text-{{ ai_gen_id }} {
    white-space: pre-line;
  }

  .ai-quiz-result-locked-{{ ai_gen_id }} {
    background-color: {{ block.settings.results_locked_bg_color }};
    border: 1px solid {{ block.settings.results_locked_border_color }};
    border-radius: {{ block.settings.results_locked_radius }}px;
    padding: 22px 20px;
    margin: 0;
  }

  .ai-quiz-result-dim-{{ ai_gen_id }} {
    margin-bottom: 18px;
  }

  .ai-quiz-result-dim-{{ ai_gen_id }}:last-of-type {
    margin-bottom: 20px;
  }

  .ai-quiz-result-dim-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  .ai-quiz-result-dim-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_dim_label_size }}px;
    color: {{ block.settings.results_text_color }};
    font-weight: 500;
  }

  .ai-quiz-result-dim-value-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_dim_label_size }}px;
    color: {{ block.settings.results_text_color }};
    font-weight: 600;
    min-width: 42px;
    text-align: right;
    transition: filter 0.35s ease;
  }

  .ai-quiz-result-dim-bar-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.results_bar_height }}px;
    background-color: {{ block.settings.results_bar_bg_color }};
    border-radius: 999px;
    overflow: hidden;
  }

  .ai-quiz-result-dim-fill-{{ ai_gen_id }} {
    height: 100%;
    width: 0%;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      {{ block.settings.results_bar_fill_start }},
      {{ block.settings.results_bar_fill_end }}
    );
    transition: width 0.6s ease;
  }

  .ai-quiz-result-locked-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_locked_text_size }}px;
    color: {{ block.settings.results_text_color }};
    line-height: 1.6;
    margin: 0;
    transition: filter 0.35s ease;
  }

  .ai-quiz-result-blur-{{ ai_gen_id }} {
    filter: blur({{ block.settings.results_blur_amount }}px);
    user-select: none;
    pointer-events: none;
  }

  .ai-quiz-result-subscribe-note-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_subscribe_note_size }}px;
    color: {{ block.settings.results_text_color }};
    margin: 0 0 16px;
    line-height: 1.45;
  }

  .ai-quiz-result-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 16px;
  }

  .ai-quiz-result-email-{{ ai_gen_id }} {
    width: 100%;
    box-sizing: border-box;
    padding: 14px 16px;
    background-color: {{ block.settings.results_input_bg_color }};
    border: 1px solid {{ block.settings.results_input_border_color }};
    border-radius: {{ block.settings.results_input_radius }}px;
    color: {{ block.settings.results_text_color }};
    font-size: {{ block.settings.results_input_size }}px;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .ai-quiz-result-email-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.results_muted_color }};
  }

  .ai-quiz-result-email-{{ ai_gen_id }}:focus {
    border-color: {{ block.settings.results_accent_color }};
  }

  button.ai-quiz-result-submit-{{ ai_gen_id }}[type="submit"] {
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 15px 20px;
    background-color: {{ block.settings.results_cta_bg_color }};
    background-image: none;
    color: {{ block.settings.results_cta_text_color }};
    border: none;
    border-radius: {{ block.settings.results_cta_border_radius }}px;
    font-size: {{ block.settings.results_cta_size }}px;
    font-weight: 700;
    line-height: 1.3;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }

  button.ai-quiz-result-submit-{{ ai_gen_id }}[type="submit"]:hover {
    background-color: {{ block.settings.results_cta_hover_bg_color }};
    color: {{ block.settings.results_cta_text_color }};
  }

  button.ai-quiz-result-submit-{{ ai_gen_id }}[type="submit"]:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .ai-quiz-result-privacy-{{ ai_gen_id }} {
    font-size: {{ block.settings.results_privacy_size }}px;
    color: {{ block.settings.results_muted_color }};
    line-height: 1.5;
    margin: 0;
    text-align: left;
  }

  .ai-quiz-result-message-{{ ai_gen_id }} {
    font-size: 14px;
    margin: 0 0 12px;
    line-height: 1.4;
    display: none;
  }

  .ai-quiz-result-message-{{ ai_gen_id }}.is-error {
    display: block;
    color: {{ block.settings.results_accent_color }};
  }

  .ai-quiz-result-message-{{ ai_gen_id }}.is-success {
    display: block;
    color: {{ block.settings.results_text_color }};
  }

  .ai-quiz-result-subscribe-{{ ai_gen_id }}.is-subscribed .ai-quiz-result-form-{{ ai_gen_id }},
  .ai-quiz-result-subscribe-{{ ai_gen_id }}.is-subscribed .ai-quiz-result-subscribe-note-{{ ai_gen_id }} {
    display: none;
  }

  .ai-quiz-result-subscribe-{{ ai_gen_id }}.is-subscribed .ai-quiz-result-message-{{ ai_gen_id }}.is-success {
    margin-bottom: 0;
  }

  .ai-quiz-result-restart-wrap-{{ ai_gen_id }} {
    margin-top: 24px;
  }

  .ai-quiz-result-restart-wrap-{{ ai_gen_id }} .ai-quiz-button-{{ ai_gen_id }} {
    background-color: transparent;
    color: {{ block.settings.results_text_color }};
    border: 1px solid {{ block.settings.results_input_border_color }};
  }

  .ai-quiz-result-restart-wrap-{{ ai_gen_id }} .ai-quiz-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.results_locked_bg_color }};
    color: {{ block.settings.results_text_color }};
  }

  @keyframes ai-quiz-fade-in-{{ ai_gen_id }} {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Desktop results layout */
  @media screen and (min-width: 750px) {
    .ai-quiz-container-{{ ai_gen_id }}.is-results {
      max-width: {{ block.settings.results_max_width }}px;
      padding: 24px 20px;
    }

    .ai-quiz-result-card-{{ ai_gen_id }} {
      padding: 48px 56px;
      border-radius: {{ block.settings.results_border_radius | plus: 4 }}px;
    }

    .ai-quiz-result-top-{{ ai_gen_id }} {
      margin-bottom: 20px;
    }

    .ai-quiz-result-brand-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.results_brand_size }}px * 1.15);
    }

    .ai-quiz-result-divider-{{ ai_gen_id }} {
      margin-bottom: 36px;
    }

    .ai-quiz-result-body-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 40px 48px;
      align-items: start;
      margin-bottom: 36px;
    }

    .ai-quiz-result-main-{{ ai_gen_id }} {
      padding-top: 4px;
    }

    .ai-quiz-result-label-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.results_label_size }}px * 1.05);
      margin-bottom: 14px;
    }

    .ai-quiz-result-type-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.results_type_size }}px * 1.2);
      margin-bottom: 20px;
      max-width: 12em;
    }

    .ai-quiz-result-desc-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.results_desc_size }}px * 1.05);
      line-height: 1.65;
      max-width: 28em;
    }

    .ai-quiz-result-locked-{{ ai_gen_id }} {
      padding: 28px 26px;
      height: 100%;
      box-sizing: border-box;
    }

    .ai-quiz-result-dim-{{ ai_gen_id }} {
      margin-bottom: 22px;
    }

    .ai-quiz-result-subscribe-{{ ai_gen_id }} {
      max-width: 100%;
      padding-top: 8px;
      border-top: 1px solid {{ block.settings.results_locked_border_color }};
    }

    .ai-quiz-result-subscribe-note-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.results_subscribe_note_size }}px * 1.05);
      margin-bottom: 18px;
    }

    .ai-quiz-result-form-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(220px, 0.9fr);
      gap: 12px;
      align-items: stretch;
      margin-bottom: 14px;
    }

    .ai-quiz-result-email-{{ ai_gen_id }} {
      height: 100%;
      min-height: 52px;
      padding: 16px 18px;
    }

    button.ai-quiz-result-submit-{{ ai_gen_id }}[type="submit"] {
      width: 100%;
      min-height: 52px;
      padding: 16px 24px;
      white-space: nowrap;
    }

    .ai-quiz-result-privacy-{{ ai_gen_id }} {
      max-width: 42em;
    }

    .ai-quiz-result-restart-wrap-{{ ai_gen_id }} {
      margin-top: 28px;
    }

    .ai-quiz-result-restart-wrap-{{ ai_gen_id }} .ai-quiz-button-{{ ai_gen_id }} {
      width: auto;
      min-width: 180px;
    }
  }

  @media screen and (min-width: 990px) {
    .ai-quiz-container-{{ ai_gen_id }}.is-results {
      padding: 32px 24px;
    }

    .ai-quiz-result-card-{{ ai_gen_id }} {
      padding: 56px 64px;
    }

    .ai-quiz-result-body-{{ ai_gen_id }} {
      gap: 48px 64px;
      margin-bottom: 40px;
    }

    .ai-quiz-result-type-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.results_type_size }}px * 1.35);
    }

    .ai-quiz-result-form-{{ ai_gen_id }} {
      max-width: 720px;
      grid-template-columns: minmax(0, 1.5fr) minmax(240px, 0.85fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-quiz-container-{{ ai_gen_id }} {
      padding: 24px 16px;
    }

    .ai-quiz-container-{{ ai_gen_id }}::before {
      {% if block.settings.mobile_background_image != blank %}
        background-image: url('{{ block.settings.mobile_background_image | image_url: width: 1200 }}');
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;
      {% endif %}
    }

    .ai-quiz-container-{{ ai_gen_id }}.is-results {
      padding: 0;
      max-width: 440px;
    }

    .ai-quiz-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-quiz-question-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.question_size }}px * 0.85);
    }

    .ai-quiz-result-card-{{ ai_gen_id }} {
      padding: {{ block.settings.results_padding | times: 0.7 }}px;
      border-radius: {{ block.settings.results_border_radius | times: 0.75 }}px;
    }

    .ai-quiz-result-type-{{ ai_gen_id }} {
