<quiz-component-{{ ai_gen_id }} class="ai-quiz-container-{{ ai_gen_id }} is-start" {{ block.shopify_attributes }}>
  <div class="ai-quiz-start-{{ ai_gen_id }}" data-quiz-start>
    <div class="ai-quiz-header-{{ ai_gen_id }}" data-quiz-header>
      {% if block.settings.quiz_title != blank %}
        <h2 class="ai-quiz-title-{{ ai_gen_id }}">{{ block.settings.quiz_title }}</h2>
      {% endif %}
      {% if block.settings.quiz_description != blank %}
        <div class="ai-quiz-description-{{ ai_gen_id }}">{{ block.settings.quiz_description }}</div>
      {% endif %}
    </div>

    <button type="button" class="ai-quiz-button-{{ ai_gen_id }} ai-quiz-start-cta-{{ ai_gen_id }}" data-start-btn>
      {{ block.settings.start_button_text }}
    </button>
  </div>

  <div class="ai-quiz-progress-{{ ai_gen_id }}" data-quiz-progress>
    <div class="ai-quiz-progress-bar-{{ ai_gen_id }}" data-progress-bar></div>
  </div>

  <div class="ai-quiz-questions-{{ ai_gen_id }}" data-quiz-questions>
    {% for i in (1..5) %}
      {% liquid
        assign question_key = 'question_' | append: i
        assign chapter_key = 'q' | append: i | append: '_chapter'
        assign option_1_key = 'q' | append: i | append: '_option_1'
        assign option_2_key = 'q' | append: i | append: '_option_2'
        assign option_3_key = 'q' | append: i | append: '_option_3'
        assign option_4_key = 'q' | append: i | append: '_option_4'
        assign option_5_key = 'q' | append: i | append: '_option_5'

        assign question = block.settings[question_key]
        assign chapter = block.settings[chapter_key]
        assign option_1 = block.settings[option_1_key]
        assign option_2 = block.settings[option_2_key]
        assign option_3 = block.settings[option_3_key]
        assign option_4 = block.settings[option_4_key]
        assign option_5 = block.settings[option_5_key]
      %}

      <div class="ai-quiz-question-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}" data-question="{{ i }}">
        {% if chapter != blank %}
          <p class="ai-quiz-chapter-{{ ai_gen_id }}">{{ i }} OF 5 · {{ chapter }}</p>
        {% endif %}
        <h3 class="ai-quiz-question-title-{{ ai_gen_id }}">{{ i }}. {{ question }}</h3>
        <div class="ai-quiz-options-{{ ai_gen_id }}">
          {% if option_1 != blank %}
            <div class="ai-quiz-option-{{ ai_gen_id }}" data-option="1">{{ option_1 }}</div>
          {% endif %}
          {% if option_2 != blank %}
            <div class="ai-quiz-option-{{ ai_gen_id }}" data-option="2">{{ option_2 }}</div>
          {% endif %}
          {% if option_3 != blank %}
            <div class="ai-quiz-option-{{ ai_gen_id }}" data-option="3">{{ option_3 }}</div>
          {% endif %}
          {% if option_4 != blank %}
            <div class="ai-quiz-option-{{ ai_gen_id }}" data-option="4">{{ option_4 }}</div>
          {% endif %}
          {% if option_5 != blank %}
            <div class="ai-quiz-option-{{ ai_gen_id }}" data-option="5">{{ option_5 }}</div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  <div class="ai-quiz-navigation-{{ ai_gen_id }}" data-quiz-nav>
    <button type="button" class="ai-quiz-button-{{ ai_gen_id }} ai-quiz-button-secondary-{{ ai_gen_id }}" data-prev-btn disabled>
      {{ block.settings.previous_button_text }}
    </button>
    <button type="button" class="ai-quiz-button-{{ ai_gen_id }}" data-next-btn disabled>
      {{ block.settings.next_button_text }}
    </button>
  </div>

  <div class="ai-quiz-results-{{ ai_gen_id }}" data-results>
    <div class="ai-quiz-result-card-{{ ai_gen_id }}">
      <div class="ai-quiz-result-top-{{ ai_gen_id }}">
        <div class="ai-quiz-result-brand-{{ ai_gen_id }}">{{ block.settings.results_brand_name }}</div>
        <div class="ai-quiz-result-status-{{ ai_gen_id }}">{{ block.settings.results_status_text }}</div>
      </div>

      <hr class="ai-quiz-result-divider-{{ ai_gen_id }}">

      <div class="ai-quiz-result-body-{{ ai_gen_id }}">
        <div class="ai-quiz-result-main-{{ ai_gen_id }}">
          {% if block.settings.results_type_label != blank %}
            <div class="ai-quiz-result-label-{{ ai_gen_id }}">{{ block.settings.results_type_label }}</div>
          {% endif %}

          <h2 class="ai-quiz-result-type-{{ ai_gen_id }}" data-type-name></h2>

          <p class="ai-quiz-result-desc-{{ ai_gen_id }}">
            <span data-type-tagline></span>
            {% if block.settings.results_percent_prefix != blank or block.settings.results_percent_suffix != blank %}
              <span data-percent-sentence>
                {{ block.settings.results_percent_prefix }}<span data-type-percent></span>{{ block.settings.results_percent_suffix }}
              </span>
            {% endif %}
          </p>
        </div>

        <div class="ai-quiz-result-locked-{{ ai_gen_id }}" data-locked-card>
          {% for dim_index in (1..3) %}
            <div class="ai-quiz-result-dim-{{ ai_gen_id }}" data-dim="{{ dim_index }}">
              <div class="ai-quiz-result-dim-row-{{ ai_gen_id }}">
                <span class="ai-quiz-result-dim-label-{{ ai_gen_id }}" data-dim-label></span>
                <span
                  class="ai-quiz-result-dim-value-{{ ai_gen_id }} ai-quiz-result-blur-{{ ai_gen_id }}"
                  data-dim-value
                  aria-hidden="true"
                >88%</span>
              </div>
              <div class="ai-quiz-result-dim-bar-{{ ai_gen_id }}">
                <div class="ai-quiz-result-dim-fill-{{ ai_gen_id }}" data-dim-fill></div>
              </div>
            </div>
          {% endfor %}

          <p
            class="ai-quiz-result-locked-text-{{ ai_gen_id }} ai-quiz-result-blur-{{ ai_gen_id }}"
            data-locked-text
            aria-hidden="true"
          ></p>
        </div>
      </div>

      <div class="ai-quiz-result-subscribe-{{ ai_gen_id }}" data-subscribe-area>
        {% if block.settings.results_subscribe_note != blank %}
          <p class="ai-quiz-result-subscribe-note-{{ ai_gen_id }}">{{ block.settings.results_subscribe_note }}</p>
        {% endif %}

        <p class="ai-quiz-result-message-{{ ai_gen_id }}" data-form-message role="status"></p>

        {% form 'customer', id: quiz_newsletter_form_id, class: quiz_newsletter_form_class %}
          <input type="hidden" name="contact[tags]" value="{{ block.settings.results_newsletter_tags }}" data-tags-input>
          <input type="hidden" name="contact[accepts_marketing]" value="true">
          <input type="hidden" name="return_to" value="{{ request.path }}">
          {% if form.posted_successfully? %}
            <input type="hidden" data-subscribe-posted value="1">
          {% endif %}
          <input
            class="ai-quiz-result-email-{{ ai_gen_id }}"
            type="email"
            name="contact[email]"
            placeholder="{{ block.settings.results_email_placeholder }}"
            autocomplete="email"
            required
            data-email-input
          >
          <button type="submit" class="ai-quiz-result-submit-{{ ai_gen_id }}" data-submit-btn>
            {{ block.settings.results_cta_text }}
          </button>
        {% endform %}

        {% if block.settings.results_privacy_text != blank %}
          <p class="ai-quiz-result-privacy-{{ ai_gen_id }}" data-privacy-text>
            {{ block.settings.results_privacy_text }}
          </p>
        {% endif %}
      </div>

      {% if block.settings.show_restart_button %}
        <div class="ai-quiz-result-restart-wrap-{{ ai_gen_id }}">
          <button type="button" class="ai-quiz-button-{{ ai_gen_id }} ai-quiz-restart-{{ ai_gen_id }}" data-restart-btn>
            {{ block.settings.restart_button_text }}
          </button>
        </div>
      {% endif %}
    </div>
  </div>
</quiz-component-{{ ai_gen_id }}>

<script>
  (function() {
    class QuizComponent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentQuestion = 1;
        this.totalQuestions = 5;
        this.answers = {};
        this.resultTypeIndex = 0;
        this.isSubscribed = false;
        this.resultsCookieName = "quiz-results-{{ ai_gen_id }}";
        this.resultsCookieMaxAge = 2 * 60 * 60;
      }

      connectedCallback() {
        this.progressBar = this.querySelector("[data-progress-bar]");
        this.questions = this.querySelectorAll(".ai-quiz-question-{{ ai_gen_id }}");
        this.startScreen = this.querySelector("[data-quiz-start]");
        this.startBtn = this.querySelector("[data-start-btn]");
        this.prevBtn = this.querySelector("[data-prev-btn]");
        this.nextBtn = this.querySelector("[data-next-btn]");
        this.results = this.querySelector("[data-results]");
        this.restartBtn = this.querySelector("[data-restart-btn]");
        this.subscribeForm = this.querySelector("#{{ quiz_newsletter_form_id }}");
        this.formMessage = this.querySelector("[data-form-message]");
        this.subscribeArea = this.querySelector("[data-subscribe-area]");
        this.types = this.loadTypes();

        this.setupEventListeners();
        this.updateProgress();

        if (this.restoreResultsFromCookie()) {
          return;
        }

        this.showStartScreen();
      }

      getCookie(name) {
        const prefix = name + "=";
        const parts = document.cookie.split(";");

        for (let i = 0; i < parts.length; i++) {
          const part = parts[i].trim();

          if (part.indexOf(prefix) === 0) {
            return decodeURIComponent(part.slice(prefix.length));
          }
        }

        return "";
      }

      setCookie(name, value, maxAgeSeconds) {
        document.cookie = [
          name + "=" + encodeURIComponent(value),
          "path=/",
          "max-age=" + maxAgeSeconds,
          "SameSite=Lax"
        ].join("; ");
      }

      clearCookie(name) {
        document.cookie = name + "=; path=/; max-age=0; SameSite=Lax";
      }

      getResultsCookiePayload() {
        return {
          answers: this.answers,
          resultTypeIndex: this.resultTypeIndex,
          subscribed: this.isSubscribed ? 1 : 0
        };
      }

      saveResultsCookie() {
        this.setCookie(
          this.resultsCookieName,
          JSON.stringify(this.getResultsCookiePayload()),
          this.resultsCookieMaxAge
        );
      }

      clearResultsCookie() {
        this.clearCookie(this.resultsCookieName);
      }

      readResultsCookie() {
        const raw = this.getCookie(this.resultsCookieName);

        if (!raw) {
          return null;
        }

        try {
          const data = JSON.parse(raw);

          if (!data || typeof data !== "object" || !data.answers) {
            return null;
          }

          return data;
        } catch (error) {
          console.error("Quiz results cookie parse failed", error);
          return null;
        }
      }

      restoreResultsFromCookie() {
        const data = this.readResultsCookie();

        if (!data) {
          return false;
        }

        this.answers = data.answers || {};
        this.resultTypeIndex = Number(data.resultTypeIndex) || 0;

        Object.keys(this.answers).forEach((questionNum) => {
          const option = this.querySelector(
            `[data-question="${questionNum}"] [data-option="${this.answers[questionNum]}"]`
          );

          if (option) {
            option.classList.add("selected");
          }
        });

        this.showResults({ skipCookieWrite: true });

        const formPosted = Boolean(this.subscribeForm && this.subscribeForm.querySelector("[data-subscribe-posted]"));
        const storageKey = this.getSubscribeStorageKey();
        const fromStorage = storageKey && window.sessionStorage.getItem(storageKey) === "1";

        if (formPosted || fromStorage || data.subscribed === 1) {
          this.showSubscribeSuccess(true);
        }

        return true;
      }

      loadTypes() {
        const typesNode = document.querySelector("[data-quiz-types-{{ ai_gen_id }}]");

        if (!typesNode) {
          return [];
        }

        try {
          return JSON.parse(typesNode.textContent);
        } catch (error) {
          console.error("Quiz types JSON parse failed", error);
          return [];
        }
      }

      setupEventListeners() {
        this.querySelectorAll(".ai-quiz-option-{{ ai_gen_id }}").forEach((option) => {
          option.addEventListener("click", (event) => this.selectOption(event));
        });

        if (this.startBtn) {
          this.startBtn.addEventListener("click", () => this.startQuiz());
        }

        this.prevBtn.addEventListener("click", () => this.previousQuestion());
        this.nextBtn.addEventListener("click", () => this.nextQuestion());

        if (this.restartBtn) {
          this.restartBtn.addEventListener("click", () => this.restartQuiz());
        }

        if (this.subscribeForm) {
          this.subscribeForm.addEventListener("submit", (event) => this.handleSubscribe(event));
        }
      }

      showStartScreen() {
        this.classList.add("is-start");
        this.classList.remove("is-results");

        if (this.startScreen) {
          this.startScreen.style.display = "";
        }

        this.querySelector("[data-quiz-progress]").style.display = "";
        this.querySelector("[data-quiz-questions]").style.display = "";
        this.querySelector("[data-quiz-nav]").style.display = "";

        if (this.results) {
          this.results.classList.remove("active");
        }
      }

      startQuiz() {
        this.classList.remove("is-start");
        this.currentQuestion = 1;
        this.showQuestion();
        this.updateProgress();
      }

      selectOption(event) {
        const questionEl = event.target.closest(".ai-quiz-question-{{ ai_gen_id }}");
        const questionNum = questionEl.dataset.question;

        questionEl.querySelectorAll(".ai-quiz-option-{{ ai_gen_id }}").forEach((opt) => {
          opt.classList.remove("selected");
        });

        event.target.classList.add("selected");
        this.answers[questionNum] = event.target.dataset.option;
        this.nextBtn.disabled = false;
      }

      previousQuestion() {
        if (this.currentQuestion > 1) {
          this.currentQuestion--;
          this.showQuestion();
          this.updateProgress();
        }
      }

      nextQuestion() {
        if (this.currentQuestion < this.totalQuestions) {
          this.currentQuestion++;
          this.showQuestion();
          this.updateProgress();
        } else {
          this.showResults();
        }
      }

      showQuestion() {
        this.questions.forEach((question) => question.classList.remove("active"));
        const currentQ = this.querySelector(`[data-question="${this.currentQuestion}"]`);
        currentQ.classList.add("active");

        this.prevBtn.disabled = this.currentQuestion === 1;

        const hasAnswer = this.answers[this.currentQuestion];
        this.nextBtn.disabled = !hasAnswer;

        if (this.currentQuestion === this.totalQuestions && hasAnswer) {
          this.nextBtn.textContent = {{ block.settings.submit_button_text | json }};
        } else {
          this.nextBtn.textContent = {{ block.settings.next_button_text | json }};
        }
      }

      updateProgress() {
        const progress = ((this.currentQuestion - 1) / this.totalQuestions) * 100;
        this.progressBar.style.width = progress + "%";
      }

      calculateResultIndex() {
        let totalScore = 0;

        for (let i = 1; i <= this.totalQuestions; i++) {
          totalScore += Number(this.answers[i] || 1);
        }

        if (totalScore <= 10) {
          return 0;
        }

        if (totalScore <= 15) {
          return 1;
        }

        if (totalScore <= 20) {
          return 2;
        }

        return 3;
      }

      showResults(options = {}) {
        this.resultTypeIndex = this.calculateResultIndex();
        this.renderResultType(this.types[this.resultTypeIndex] || this.types[0]);
        this.updateSubscribeTags();

        this.classList.remove("is-start");
        this.classList.add("is-results");

        if (this.startScreen) {
          this.startScreen.style.display = "none";
        }

        this.querySelector("[data-quiz-progress]").style.display = "none";
        this.querySelector("[data-quiz-questions]").style.display = "none";
        this.querySelector("[data-quiz-nav]").style.display = "none";
        this.results.classList.add("active");

        if (!options.skipCookieWrite) {
          this.saveResultsCookie();
        }

        const storageKey = this.getSubscribeStorageKey();

        if (storageKey && window.sessionStorage.getItem(storageKey) === "1") {
          this.showSubscribeSuccess(true);
        }
      }

      getSubscribeStorageKey() {
        const type = this.types[this.resultTypeIndex];

        if (!type || !type.name) {
          return "";
        }

        return "quiz-subscribed-{{ ai_gen_id }}-" + type.name;
      }

      parseTagList(value) {
        return String(value || "")
          .split(",")
          .map((tag) => tag.trim())
          .filter(Boolean);
      }

      getSubscribeTags() {
        const type = this.types[this.resultTypeIndex] || {};
        const baseTags = this.parseTagList({{ block.settings.results_newsletter_tags | json }});
        const typeTags = this.parseTagList(type.customer_tags);
        const uniqueTags = [];

        [...baseTags, ...typeTags].forEach((tag) => {
          if (!uniqueTags.includes(tag)) {
            uniqueTags.push(tag);
          }
        });

        return uniqueTags.join(", ");
      }

      updateSubscribeTags() {
        if (!this.subscribeForm) {
          return;
        }

        const tagsInput = this.subscribeForm.querySelector("[data-tags-input]");

        if (tagsInput) {
          tagsInput.value = this.getSubscribeTags();
        }
      }

      renderResultType(type) {
        if (!type) {
          return;
        }

        const nameEl = this.querySelector("[data-type-name]");
        const taglineEl = this.querySelector("[data-type-tagline]");
        const percentEl = this.querySelector("[data-type-percent]");
        const lockedTextEl = this.querySelector("[data-locked-text]");

        if (nameEl) {
          nameEl.textContent = type.name || "";
        }

        if (taglineEl) {
          this.renderMultilineText(taglineEl, type.tagline || "");
        }

        if (percentEl) {
          percentEl.textContent = String(type.percent || "");
        }

        if (lockedTextEl) {
          this.renderMultilineText(lockedTextEl, type.locked_text || "");
        }

        const dimensions = [
          { label: type.dim1_label, value: type.dim1_value },
          { label: type.dim2_label, value: type.dim2_value },
          { label: type.dim3_label, value: type.dim3_value }
        ];

        dimensions.forEach((dimension, index) => {
          const dimEl = this.querySelector(`[data-dim="${index + 1}"]`);

          if (!dimEl) {
            return;
          }

          const labelEl = dimEl.querySelector("[data-dim-label]");
          const valueEl = dimEl.querySelector("[data-dim-value]");
          const fillEl = dimEl.querySelector("[data-dim-fill]");
          const safeValue = Math.max(0, Math.min(100, Number(dimension.value) || 0));

          if (labelEl) {
            labelEl.textContent = dimension.label || "";
          }

          if (valueEl) {
            valueEl.textContent = safeValue + "%";
          }

          if (fillEl) {
            requestAnimationFrame(() => {
              fillEl.style.width = safeValue + "%";
            });
          }
        });

        this.resetLockedState();
      }

      renderMultilineText(element, value) {
        const lines = String(value).replace(/\r\n?/g, "\n").split("\n");
        element.replaceChildren();

        lines.forEach((line, index) => {
          if (index > 0) {
            element.appendChild(document.createElement("br"));
          }

          element.appendChild(document.createTextNode(line));
        });
      }

      resetLockedState() {
        this.isSubscribed = false;

        this.querySelectorAll("[data-dim-value], [data-locked-text]").forEach((el) => {
          el.classList.add("ai-quiz-result-blur-{{ ai_gen_id }}");
          el.setAttribute("aria-hidden", "true");
        });

        if (this.subscribeArea) {
          this.subscribeArea.classList.remove("is-subscribed");
        }

        if (this.formMessage) {
          this.formMessage.textContent = "";
          this.formMessage.classList.remove("is-error", "is-success");
        }

        if (this.subscribeForm) {
          this.subscribeForm.reset();
          const submitBtn = this.subscribeForm.querySelector("[data-submit-btn]");

          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = {{ block.settings.results_cta_text | json }};
          }

          this.updateSubscribeTags();
        }
      }

      showSubscribeSuccess(fromStorage) {
        this.isSubscribed = true;

        this.querySelectorAll("[data-dim-value], [data-locked-text]").forEach((el) => {
          el.classList.remove("ai-quiz-result-blur-{{ ai_gen_id }}");
          el.removeAttribute("aria-hidden");
        });

        if (this.subscribeArea) {
          this.subscribeArea.classList.add("is-subscribed");
        }

        if (this.formMessage) {
          this.formMessage.textContent = fromStorage
            ? {{ block.settings.results_unlocked_message | json }}
            : {{ block.settings.results_success_message | json }};
          this.formMessage.classList.remove("is-error");
          this.formMessage.classList.add("is-success");
        }

        const storageKey = this.getSubscribeStorageKey();

        if (storageKey) {
          window.sessionStorage.setItem(storageKey, "1");
        }

        this.saveResultsCookie();
      }

      async handleSubscribe(event) {
        event.preventDefault();
        event.stopPropagation();

        if (!this.subscribeForm || this.isSubscribed) {
          return;
        }

        const emailInput = this.subscribeForm.querySelector("[data-email-input]");
        const submitBtn = this.subscribeForm.querySelector("[data-submit-btn]");
        const email = emailInput ? emailInput.value.trim() : "";

        if (!email || !emailInput.checkValidity()) {
          this.showFormError({{ block.settings.results_invalid_email_message | json }});
          emailInput.focus();
          return;
        }

        this.updateSubscribeTags();

        submitBtn.disabled = true;
        submitBtn.textContent = {{ block.settings.results_loading_text | json }};
        this.clearFormMessage();

        try {
          const formData = new FormData(this.subscribeForm);
          const body = new URLSearchParams(formData);
          const actionUrl = this.subscribeForm.getAttribute("action") || "/contact";

          const response = await fetch(actionUrl, {
            method: "POST",
            body: body,
            headers: {
              Accept: "application/json",
              "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
              "X-Requested-With": "XMLHttpRequest"
            },
            credentials: "same-origin",
            redirect: "manual"
          });

          const isOpaqueRedirect = response.type === "opaqueredirect";
          const isSuccessStatus = response.ok || response.status === 0 || (response.status >= 300 && response.status < 400);

          if (!isOpaqueRedirect && !isSuccessStatus && response.status >= 500) {
            throw new Error("Subscribe request failed");
          }

          this.showSubscribeSuccess(false);
        } catch (error) {
          console.error(error);
          this.showFormError({{ block.settings.results_error_message | json }});
          submitBtn.disabled = false;
          submitBtn.textContent = {{ block.settings.results_cta_text | json }};
        }
      }

      showFormError(message) {
        if (!this.formMessage) {
          return;
        }

        this.formMessage.textContent = message;
        this.formMessage.classList.remove("is-success");
        this.formMessage.classList.add("is-error");
      }

      clearFormMessage() {
        if (!this.formMessage) {
          return;
        }

        this.formMessage.textContent = "";
        this.formMessage.classList.remove("is-error", "is-success");
      }

      restartQuiz() {
        this.currentQuestion = 1;
        this.answers = {};
        this.resultTypeIndex = 0;
        this.isSubscribed = false;
        this.clearResultsCookie();

        this.querySelectorAll(".ai-quiz-option-{{ ai_gen_id }}").forEach((opt) => {
          opt.classList.remove("selected");
        });

        this.resetLockedState();
        this.showStartScreen();
        this.updateProgress();
      }
    }

    customElements.define("quiz-component-{{ ai_gen_id }}", QuizComponent{{ ai_gen_id }});
  })();
</script>

