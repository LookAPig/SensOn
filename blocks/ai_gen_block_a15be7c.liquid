{% doc %}
  @prompt
    We need to create a section with the following content: Title: AI Lover you can feel
    Content: SensOn delivers the first AI-powered pleasure experience created for women. It combines bionic stimulation through the S1 device with a premium erotica platform to create cinematic intimacy that users can truly feel.
    
    The following section should separate the software and hardware descriptions, with one accompanying image: an image showing the software and hardware working together.
    SensOn S1 Device:
    - Real-time, content-synced motion
    - Pulsating air-pressure clitoral sensation
    - Lightweight thrusting sex machine
    - Surround-stimulation nipple clamps
    - Hands-free experience
    - Wireless charging case
    
    SensOn App:
    - Female-focused, LGBTQ+-inclusive audio erotica
    - Hyper-realistic voices and cinema-grade 3D characters, built for an immersive, cinematic experience
    - Real-time voice interaction with AI characters
    
    Mobile-friendly, no explicit content., I hope the sections and images will have consistent heights and can be adjusted independently., Everything else remains unchanged; please leave space between the sections above and below, which can be adjusted as needed., The image width is adjustable, and the image position is adjustable on mobile devices; everything else remains unchanged.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-features-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding-top: {{ block.settings.spacing_top }}px;
    padding-bottom: {{ block.settings.spacing_bottom }}px;
  }

  .ai-product-features__container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.section_spacing }}px;
  }

  .ai-product-features__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    padding: {{ block.settings.header_padding }}px;
    background-color: {{ block.settings.header_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-product-features__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-product-features__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-product-features__content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ block.settings.section_spacing }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-product-features__content-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.desktop_columns }}, 1fr);
    }
  }

  .ai-product-features__section-{{ ai_gen_id }} {
    background-color: {{ block.settings.section_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.section_padding }}px;
    display: flex;
    flex-direction: column;
    height: {{ block.settings.section_height }}px;
  }

  .ai-product-features__section-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_title_size }}px;
    color: {{ block.settings.section_title_color }};
    margin: 0 0 {{ block.settings.list_spacing }}px 0;
    font-weight: 600;
  }

  .ai-product-features__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.list_item_spacing }}px;
    flex-grow: 1;
  }

  .ai-product-features__list-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: {{ block.settings.list_item_size }}px;
    color: {{ block.settings.list_item_color }};
    line-height: 1.5;
  }

  .ai-product-features__list-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-top: 2px;
  }

  .ai-product-features__list-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
  }

  .ai-product-features__image-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.image_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    height: {{ block.settings.image_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-features__image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-features__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-features__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-product-features__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-product-features__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-product-features__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-product-features__section-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.section_title_size | times: 0.9 }}px;
    }

    .ai-product-features__section-{{ ai_gen_id }},
    .ai-product-features__image-section-{{ ai_gen_id }} {
      height: auto;
      min-height: 200px;
    }

    .ai-product-features__content-{{ ai_gen_id }} {
      {% if block.settings.mobile_image_position == 'top' %}
        display: flex;
        flex-direction: column;
      {% elsif block.settings.mobile_image_position == 'bottom' %}
        display: flex;
        flex-direction: column-reverse;
      {% endif %}
    }

    {% if block.settings.mobile_image_position == 'top' %}
      .ai-product-features__image-section-{{ ai_gen_id }} {
        order: -1;
      }
    {% elsif block.settings.mobile_image_position == 'bottom' %}
      .ai-product-features__image-section-{{ ai_gen_id }} {
        order: 999;
      }
    {% endif %}

    .ai-product-features__image-wrapper-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<ai-product-features-{{ ai_gen_id }}
  class="ai-product-features-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-features__container-{{ ai_gen_id }}">
    {% if block.settings.show_header %}
      <div class="ai-product-features__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-product-features__title-{{ ai_gen_id }}">
            {{ block.settings.title }}
          </h2>
