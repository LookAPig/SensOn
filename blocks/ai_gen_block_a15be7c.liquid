                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span>{{ block.settings.hardware_feature_3 }}</span>
              </li>
            {% endif %}
            {% if block.settings.hardware_feature_4 != blank %}
