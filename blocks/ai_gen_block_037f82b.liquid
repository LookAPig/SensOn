{% doc %}
  @prompt
    Large bold text filled with an image. Include a setting to control the background color., I want the background to be an image, and for this section to have some interactive elements.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
    overflow: hidden;
    padding: 80px 20px;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-text-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    transition: transform 0.6s ease;
  }

  .ai-image-text-{{ ai_gen_id }}:hover .ai-image-text-background-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-image-text-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-text-background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }

  .ai-image-text-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    z-index: 2;
    transition: opacity 0.4s ease;
  }

  .ai-image-text-{{ ai_gen_id }}:hover .ai-image-text-overlay-{{ ai_gen_id }} {
    opacity: {{ block.settings.overlay_opacity | times: 0.7 }};
  }

  .ai-image-text-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
    position: relative;
    z-index: 3;
    text-align: center;
  }

  .ai-image-text-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size_mobile }}px;
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: cover;
    background-position: center;
    cursor: pointer;
    transition: transform 0.3s ease, letter-spacing 0.3s ease;
    {% if block.settings.text_fill_image %}
      background-image: url('{{ block.settings.text_fill_image | image_url: width: 2000 }}');
    {% else %}
      background-image: linear-gradient(135deg, #ffd700 0%, #ff6b6b 100%);
    {% endif %}
  }

  .ai-image-text-{{ ai_gen_id }}:hover .ai-image-text-heading-{{ ai_gen_id }} {
    transform: scale(1.02);
    letter-spacing: 0.02em;
  }

  .ai-image-text-subtext-{{ ai_gen_id }} {
    margin-top: 20px;
    font-size: 18px;
    color: {{ block.settings.subtext_color }};
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s ease 0.1s, transform 0.4s ease 0.1s;
  }

  .ai-image-text-{{ ai_gen_id }}:hover .ai-image-text-subtext-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-image-text-button-{{ ai_gen_id }} {
    display: inline-block;
    margin-top: 30px;
    padding: 15px 40px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 600;
    font-size: 16px;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s ease 0.2s, transform 0.4s ease 0.2s, background-color 0.3s ease;
  }

  .ai-image-text-{{ ai_gen_id }}:hover .ai-image-text-button-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-image-text-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  @media screen and (min-width: 750px) {
    .ai-image-text-{{ ai_gen_id }} {
      padding: 120px 20px;
      min-height: 500px;
    }

    .ai-image-text-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_desktop }}px;
    }

    .ai-image-text-subtext-{{ ai_gen_id }} {
      font-size: 22px;
    }
  }
{% endstyle %}

<interactive-text-{{ ai_gen_id }} class="ai-image-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-text-background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-image-text-background-placeholder-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>

  <div class="ai-image-text-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-image-text-container-{{ ai_gen_id }}">
    <h2 class="ai-image-text-heading-{{ ai_gen_id }}">
      {{ block.settings.text }}
    </h2>

    {% if block.settings.subtext != blank %}
      <p class="ai-image-text-subtext-{{ ai_gen_id }}">
        {{ block.settings.subtext }}
      </p>
    {% endif %}

    {% if block.settings.button_text != blank and block.settings.button_link != blank %}
      <a href="{{ block.settings.button_link }}" class="ai-image-text-button-{{ ai_gen_id }}">
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</interactive-text-{{ ai_gen_id }}>

<script>
  (function() {
    class InteractiveText{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.heading = this.querySelector('.ai-image-text-heading-{{ ai_gen_id }}');
        this.setupParallax();
      }

      setupParallax() {
        this.addEventListener('mousemove', (e) => {
          const rect = this.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          const deltaX = (x - centerX) / centerX;
          const deltaY = (y - centerY) / centerY;

          if (this.heading) {
            this.heading.style.transform = `scale(1.02) translate(${deltaX * 10}px, ${deltaY * 10}px)`;
          }
        });

        this.addEventListener('mouseleave', () => {
          if (this.heading) {
            this.heading.style.transform = '';
          }
        });
      }
    }

    customElements.define('interactive-text-{{ ai_gen_id }}', InteractiveText{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Interactive image text",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Heading",
      "default": "Bold Statement"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size (mobile)",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Font size (desktop)",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "image_picker",
      "id": "text_fill_image",
      "label": "Text fill image"
    },
    {
      "type": "inline_richtext",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.5
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#f0f0f0"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Interactive image text"
    }
  ]
}
{% endschema %}
