{%- comment -%}
  Content is rendered by the parent "reviews" block. This file only defines editor settings.
{%- endcomment -%}

{% schema %}
{
  "name": "Review item",
  "settings": [
    {
      "type": "text",
      "id": "tab_label",
      "label": "Tab label",
      "default": "Review"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "Share what customers love about your product."
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution",
      "default": "Customer name",
      "info": "Shown after the quote, e.g. Kathryn, 30"
    }
  ],
  "presets": [
    {
      "name": "Review item"
    }
  ]
}
{% endschema %}
