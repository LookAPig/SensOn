{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-how-to-use-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-how-to-use-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-how-to-use-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-how-to-use-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.subtitle_spacing }}px;
  }

  .ai-how-to-use-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-how-to-use-steps-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: nowrap;
    gap: {{ block.settings.step_gap }}px;
  }

  .ai-how-to-use-step-{{ ai_gen_id }} {
    flex: 1;
    text-align: center;
    min-width: 0;
  }

  .ai-how-to-use-step-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: {{ block.settings.image_spacing }}px;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-how-to-use-step-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-how-to-use-step-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    padding-bottom: 100%;
    background-color: #f5f5f5;
    position: relative;
  }

  .ai-how-to-use-step-image-placeholder-{{ ai_gen_id }} svg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 50%;
    height: 50%;
  }

  .ai-how-to-use-step-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    font-weight: 700;
    color: {{ block.settings.number_color }};
    margin-bottom: {{ block.settings.number_spacing }}px;
  }

  .ai-how-to-use-step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_title_size }}px;
    color: {{ block.settings.step_title_color }};
    margin: 0 0 {{ block.settings.step_title_spacing }}px;
    font-weight: 600;
  }

  .ai-how-to-use-step-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_description_size }}px;
    color: {{ block.settings.step_description_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-how-to-use-dots-{{ ai_gen_id }} {
    display: none;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  .ai-how-to-use-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #d0d0d0;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-how-to-use-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.number_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-how-to-use-header-{{ ai_gen_id }} {
      text-align: left;
      padding-left: 0;
    }

    .ai-how-to-use-steps-{{ ai_gen_id }} {
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      gap: {{ block.settings.mobile_step_gap }}px;
    }

    .ai-how-to-use-steps-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-how-to-use-step-{{ ai_gen_id }} {
      flex: 0 0 calc(100% - 40px);
      scroll-snap-align: center;
    }

    .ai-how-to-use-dots-{{ ai_gen_id }} {
      display: flex;
    }

    .ai-how-to-use-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-how-to-use-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-how-to-use-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-how-to-use-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-how-to-use-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-how-to-use-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <div class="ai-how-to-use-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-how-to-use-steps-wrapper-{{ ai_gen_id }}">
      <div class="ai-how-to-use-steps-{{ ai_gen_id }}" data-steps-container>
        {% for i in (1..3) %}
          {% liquid
            assign step_number_key = 'step_' | append: i | append: '_number'
            assign step_image_key = 'step_' | append: i | append: '_image'
            assign step_title_key = 'step_' | append: i | append: '_title'
            assign step_description_key = 'step_' | append: i | append: '_description'

            assign step_number = block.settings[step_number_key]
            assign step_image = block.settings[step_image_key]
            assign step_title = block.settings[step_title_key]
            assign step_description = block.settings[step_description_key]
          %}

          <div class="ai-how-to-use-step-{{ ai_gen_id }}" data-step-index="{{ forloop.index0 }}">
            <div class="ai-how-to-use-step-image-wrapper-{{ ai_gen_id }}">
              {% if step_image %}
                <img
                  src="{{ step_image | image_url: width: 800 }}"
                  alt="{{ step_title | escape }}"
                  loading="lazy"
                  width="{{ step_image.width }}"
                  height="{{ step_image.height }}"
                  class="ai-how-to-use-step-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-how-to-use-step-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if block.settings.show_numbers and step_number != blank %}
              <div class="ai-how-to-use-step-number-{{ ai_gen_id }}">{{ step_number }}</div>
            {% endif %}

            {% if step_title != blank %}
              <h3 class="ai-how-to-use-step-title-{{ ai_gen_id }}">{{ step_title }}</h3>
            {% endif %}

            {% if step_description != blank %}
              <div class="ai-how-to-use-step-description-{{ ai_gen_id }}">{{ step_description }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <div class="ai-how-to-use-dots-{{ ai_gen_id }}" data-dots>
        {% for i in (1..3) %}
          <button
            class="ai-how-to-use-dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            data-dot-index="{{ forloop.index0 }}"
            aria-label="Go to step {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const initMobileScroll = () => {
      const stepsContainer = document.querySelector('[data-steps-container]');
      const dots = document.querySelectorAll('[data-dot-index]');
      
      if (!stepsContainer || !dots.length) return;
      
      const isMobile = () => window.innerWidth <= 749;
      
      let scrollTimeout;
      let currentIndex = 0;
      
      const updateActiveStep = () => {
        if (!isMobile()) return;
        
        const scrollLeft = stepsContainer.scrollLeft;
        const containerWidth = stepsContainer.offsetWidth;
        const steps = stepsContainer.querySelectorAll('[data-step-index]');
        
        if (steps.length === 0) return;
        
        const stepWidth = steps[0].offsetWidth;
        const gap = parseInt(getComputedStyle(stepsContainer).gap) || 20;
        const newIndex = Math.round(scrollLeft / (stepWidth + gap));
        
        if (newIndex !== currentIndex && newIndex >= 0 && newIndex < steps.length) {
          currentIndex = newIndex;
          dots.forEach((dot, index) => {
            if (index === currentIndex) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        }
      };
      
      const scrollToStep = (index) => {
        const steps = stepsContainer.querySelectorAll('[data-step-index]');
        const step = steps[index];
        if (step) {
          const stepLeft = step.offsetLeft;
          const containerWidth = stepsContainer.offsetWidth;
          const stepWidth = step.offsetWidth;
          const scrollPosition = stepLeft - (containerWidth / 2) + (stepWidth / 2);
          
          stepsContainer.scrollTo({
            left: scrollPosition,
            behavior: 'smooth'
          });
        }
      };
      
      const handleScroll = () => {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(updateActiveStep, 100);
      };
      
      const handleResize = () => {
        if (isMobile()) {
          stepsContainer.addEventListener('scroll', handleScroll);
          updateActiveStep();
        } else {
          stepsContainer.removeEventListener('scroll', handleScroll);
        }
      };
      
      // 初始化点和点击事件
      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          if (!isMobile()) return;
          const index = parseInt(dot.getAttribute('data-dot-index'));
          scrollToStep(index);
        });
      });
      
      // 监听滚动和窗口变化
      window.addEventListener('resize', handleResize);
      handleResize();
      
      // 初始激活状态更新
      if (isMobile()) {
        updateActiveStep();
      }
    };
    
    // 等待 DOM 加载完成
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMobileScroll);
    } else {
      initMobileScroll();
    }
  })();
</script>

