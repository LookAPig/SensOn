{% doc %}
  @prompt
    App Introduction Section
    
    This section is a vertical layout with a text area on the left and an App interface display area on the right, with a download module at the bottom of the whole section. The detailed functional and interactive requirements are as follows:
    
    1. Left Text Area
    
    1. Contains 3 text modules in vertical arrangement, and each module corresponds to a unique App interface image on the right (one-to-one mapping).
    
    2. Default state: Only the 1st text module is fully expanded (showing both title and body); the 2nd and 3rd modules only display their titles, with their body content collapsed/hidden.
    
    3. Click interaction: Click the title of the 2nd/3rd text module (a downward arrow icon is attached to the title), its body content will expand, and the corresponding App image on the right will switch synchronously with the clicked text module.
    
    2. Right Image Display Area
    
    1. Displays the interface screenshots of the App, with the layout being a vertical rectangle or a square (adapting to the vertical display of mobile App interfaces).
    
    2. Realizes synchronous switching with the left text module: the image switches to the one matching the currently expanded text module (the 1st module by default, or the 2nd/3rd module after manual click).
    
    3. Bottom Download Module
    
    1. Includes the official icons of App Store and Google Play in horizontal arrangement.
    
    2. Adds a short descriptive text below/next to the icons, with the content: Available on the App Store and Google Play.
    
    4. Overall Layout
    
    • The left text area is a vertical long strip; the right image area is a square or vertical long strip, keeping the visual balance of the whole section in vertical layout., "Available on the App Store and Google Play" do not put this in the center of the bottom, put this and apple store logo, google play logo in the left bottom part. fill in the blank space in the left bottom. also, the background color can be customized as a image background. , Available on the App Store and Google Play , above this add a divider too. and this download section part move to the bottom of this section, now it's too close with module 3, the icon for apple play and google play i uploaded didn't show up. please correct this bug, Download section move to bottom , the bottom center of the left module part
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-app-intro-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
    {% if block.settings.background_image %}
      background-image: url('{{ block.settings.background_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% else %}
      background-color: {{ block.settings.background_color }};
    {% endif %}
  }

  .ai-app-intro-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .ai-app-intro-left-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 60px;
    min-height: 100%;
  }

  .ai-app-intro-text-area-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex-grow: 1;
  }

  .ai-app-intro-text-module-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.divider_color }};
    padding-bottom: 20px;
  }

  .ai-app-intro-text-module-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-app-intro-module-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    gap: 16px;
  }

  .ai-app-intro-module-header-{{ ai_gen_id }}:hover .ai-app-intro-module-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_hover_color }};
  }

  .ai-app-intro-module-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0;
    transition: color 0.3s ease;
  }

  .ai-app-intro-arrow-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
    color: {{ block.settings.arrow_color }};
  }

  .ai-app-intro-arrow-icon-{{ ai_gen_id }}.active {
    transform: rotate(180deg);
  }

  .ai-app-intro-module-body-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, margin-top 0.4s ease;
    color: {{ block.settings.body_color }};
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
  }

  .ai-app-intro-module-body-{{ ai_gen_id }}.active {
    max-height: 500px;
    margin-top: 16px;
  }

  .ai-app-intro-download-section-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
    padding-top: 40px;
    border-top: 1px solid {{ block.settings.divider_color }};
    margin-top: auto;
  }

  .ai-app-intro-download-icons-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ai-app-intro-download-link-{{ ai_gen_id }} {
    display: block;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .ai-app-intro-download-link-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    opacity: 0.8;
  }

  .ai-app-intro-download-link-{{ ai_gen_id }} img {
    height: {{ block.settings.store_icon_height }}px;
    width: auto;
    display: block;
  }

  .ai-app-intro-download-text-{{ ai_gen_id }} {
    color: {{ block.settings.download_text_color }};
    font-size: {{ block.settings.download_text_size }}px;
    text-align: center;
  }

  .ai-app-intro-image-area-{{ ai_gen_id }} {
    position: sticky;
    top: 100px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-app-intro-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    box-shadow: {{ block.settings.image_shadow }};
  }

  .ai-app-intro-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .ai-app-intro-image-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-app-intro-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-app-intro-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  @media screen and (max-width: 989px) {
    .ai-app-intro-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-app-intro-image-area-{{ ai_gen_id }} {
      position: relative;
      top: 0;
      order: -1;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-app-intro-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-app-intro-module-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.85);
    }

    .ai-app-intro-module-body-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.body_size }}px * 0.9);
    }

    .ai-app-intro-download-icons-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 12px;
    }
  }
{% endstyle %}

<app-intro-section-{{ ai_gen_id }}
  class="ai-app-intro-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-app-intro-container-{{ ai_gen_id }}">
    <div class="ai-app-intro-left-column-{{ ai_gen_id }}">
      <div class="ai-app-intro-text-area-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign title_key = 'module_' | append: i | append: '_title'
            assign body_key = 'module_' | append: i | append: '_body'
            assign title = block.settings[title_key]
            assign body = block.settings[body_key]
          %}

          <div class="ai-app-intro-text-module-{{ ai_gen_id }}" data-module="{{ i }}">
            <div class="ai-app-intro-module-header-{{ ai_gen_id }}">
              <h3 class="ai-app-intro-module-title-{{ ai_gen_id }}">{{ title }}</h3>
              <svg
                class="ai-app-intro-arrow-icon-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
            <div class="ai-app-intro-module-body-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}">
              {{ body }}
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="ai-app-intro-download-section-{{ ai_gen_id }}">
        {% if block.settings.download_text != blank %}
          <div class="ai-app-intro-download-text-{{ ai_gen_id }}">
            {{ block.settings.download_text }}
          </div>
        {% endif %}

        <div class="ai-app-intro-download-icons-{{ ai_gen_id }}">
          {% if block.settings.app_store_icon or block.settings.app_store_link != blank %}
            {% if block.settings.app_store_link != blank %}
              <a
                href="{{ block.settings.app_store_link }}"
                class="ai-app-intro-download-link-{{ ai_gen_id }}"
                target="_blank"
                rel="noopener"
              >
            {% else %}
              <div class="ai-app-intro-download-link-{{ ai_gen_id }}">
            {% endif %}
                {% if block.settings.app_store_icon %}
                  <img
                    src="{{ block.settings.app_store_icon | image_url: height: 120 }}"
                    alt="Download on the App Store"
                    loading="lazy"
                  >
                {% else %}
                  <svg
                    width="135"
                    height="40"
                    viewBox="0 0 135 40"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <rect width="135" height="40" rx="5" fill="#000000"/>
                    <text x="67.5" y="25" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">App Store</text>
                  </svg>
                {% endif %}
            {% if block.settings.app_store_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          {% endif %}

          {% if block.settings.google_play_icon or block.settings.google_play_link != blank %}
            {% if block.settings.google_play_link != blank %}
              <a
                href="{{ block.settings.google_play_link }}"
                class="ai-app-intro-download-link-{{ ai_gen_id }}"
                target="_blank"
                rel="noopener"
              >
            {% else %}
              <div class="ai-app-intro-download-link-{{ ai_gen_id }}">
            {% endif %}
                {% if block.settings.google_play_icon %}
                  <img
                    src="{{ block.settings.google_play_icon | image_url: height: 120 }}"
                    alt="Get it on Google Play"
                    loading="lazy"
                  >
                {% else %}
                  <svg
                    width="135"
                    height="40"
                    viewBox="0 0 135 40"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <rect width="135" height="40" rx="5" fill="#000000"/>
                    <text x="67.5" y="25" font-family="Arial" font-size="12" fill="#ffffff" text-anchor="middle">Google Play</text>
                  </svg>
                {% endif %}
            {% if block.settings.google_play_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          {% endif %}
        </div>
      </div>
    </div>

    <div class="ai-app-intro-image-area-{{ ai_gen_id }}">
      <div class="ai-app-intro-image-wrapper-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign image_key = 'module_' | append: i | append: '_image'
            assign image = block.settings[image_key]
          %}

          {% if image %}
            <img
              src="{{ image | image_url: width: 800 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
              class="ai-app-intro-image-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
              data-image="{{ i }}"
            >
          {% else %}
            <div
              class="ai-app-intro-image-placeholder-{{ ai_gen_id }} ai-app-intro-image-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
              data-image="{{ i }}"
            >
              {{ 'product-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</app-intro-section-{{ ai_gen_id }}>

<script>
  (function() {
    class AppIntroSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.modules = this.querySelectorAll('.ai-app-intro-text-module-{{ ai_gen_id }}');
        this.images = this.querySelectorAll('.ai-app-intro-image-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.modules.forEach((module) => {
          const header = module.querySelector('.ai-app-intro-module-header-{{ ai_gen_id }}');
          const body = module.querySelector('.ai-app-intro-module-body-{{ ai_gen_id }}');
          const arrow = module.querySelector('.ai-app-intro-arrow-icon-{{ ai_gen_id }}');
          const moduleIndex = module.getAttribute('data-module');

          header.addEventListener('click', () => {
            const isActive = body.classList.contains('active');

            if (!isActive) {
              this.modules.forEach((m) => {
                m.querySelector('.ai-app-intro-module-body-{{ ai_gen_id }}').classList.remove('active');
                m.querySelector('.ai-app-intro-arrow-icon-{{ ai_gen_id }}').classList.remove('active');
              });

              body.classList.add('active');
              arrow.classList.add('active');

              this.images.forEach((img) => {
                img.classList.remove('active');
              });

              const targetImage = this.querySelector('[data-image="' + moduleIndex + '"]');
              if (targetImage) {
                targetImage.classList.add('active');
              }
            }
          });
        });
      }
    }

    customElements.define('app-intro-section-{{ ai_gen_id }}', AppIntroSection{{ ai_gen_id }});
  })();
</script>

