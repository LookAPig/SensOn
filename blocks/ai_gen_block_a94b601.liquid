    {
      "type": "color",
      "id": "overlay_text_color",
      "label": "Overlay text color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "overlay_position_bottom",
      "label": "Overlay position from bottom",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "overlay_position_right",
      "label": "Overlay position from right",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Tech split section"
    }
  ]
}
{% endschema %}
