    {
      "type": "header",
      "content": "Overlay card"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay card",
      "default": true
    },
    {
      "type": "text",
      "id": "overlay_title",
      "label": "Overlay title",
      "default": "99.9% Uptime"
    },
    {
      "type": "textarea",
      "id": "overlay_text",
      "label": "Overlay text",
      "default": "Trusted by over 10,000 businesses worldwide"
    },
    {
      "type": "range",
      "id": "overlay_title_size",
      "label": "Overlay title size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "overlay_text_size",
      "label": "Overlay text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "overlay_bg_color",
      "label": "Overlay background",
      "default": "rgba(255, 255, 255, 0.95)"
