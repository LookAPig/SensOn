{%- if block.settings.text != blank -%}
  {%- liquid
    assign size_mobile = block.settings.font_size_mobile | default: 0 | plus: 0
    assign size_desktop = block.settings.font_size_desktop | default: 0 | plus: 0
    if size_mobile == 0
      assign size_mobile = size_desktop
    endif
    if size_desktop == 0
      assign size_desktop = size_mobile
    endif
  -%}
  <div
    id="shopify-block-{{ block.id }}"
    class="{% if block.settings.content_width != 'full' %}max-w-{{ block.settings.content_width }}{% endif %}"
    {{ block.shopify_attributes }}
  >
    {{- block.settings.text -}}
  </div>
  {%- if size_mobile > 0 -%}
    <style>
      #shopify-block-{{ block.id }},
      #shopify-block-{{ block.id }} :is(p, li) {
        font-size: {{ size_mobile }}px;
      }
      @media screen and (min-width: 750px) {
        #shopify-block-{{ block.id }},
        #shopify-block-{{ block.id }} :is(p, li) {
          font-size: {{ size_desktop }}px;
        }
      }
    </style>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.rich_text.name",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:global.text.content",
      "default": "<p>Write some text about your products or your brand.</p>"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:global.sizes.content_width",
      "options": [
        {
          "value": "xs",
          "label": "t:global.sizes.x_small"
        },
        {
          "value": "sm",
          "label": "t:global.sizes.small"
        },
        {
          "value": "md",
          "label": "t:global.sizes.medium"
        },
        {
          "value": "lg",
          "label": "t:global.sizes.large"
        },
        {
          "value": "full",
          "label": "t:global.sizes.full_width"
        }
      ],
      "default": "sm"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "t:global.text.desktop_size",
      "info": "t:sections.rich_text.font_size_info",
      "default": 0
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "t:global.text.mobile_size",
      "info": "t:sections.rich_text.font_size_info",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:blocks.rich_text.name"
    }
  ]
}
{% endschema %}