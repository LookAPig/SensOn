{%- liquid
  assign cr_bid = block.id
  assign cr_title = block.settings.title | default: 'WHAT CUSTOMERS SAY'
  assign cr_bg = block.settings.background_color | default: '#f5f0eb'
  assign cr_accent = block.settings.accent_color | default: '#e91ead'
  assign cr_border = block.settings.tag_border_color | default: '#c8c4c0'
  assign cr_json_raw = block.settings.reviews_json | strip
  assign cr_has_json = false
  assign cr_count = 0

  if cr_json_raw != blank
    assign cr_has_json = true
  else
    for i in (1..6)
      assign cr_tag_key = 'tag_' | append: i
      assign cr_review_key = 'review_' | append: i
      assign cr_tag = block.settings[cr_tag_key]
      assign cr_review = block.settings[cr_review_key]

      if cr_tag != blank and cr_review != blank
        assign cr_count = cr_count | plus: 1
      endif
    endfor
  endif
-%}

{%- if cr_has_json or cr_count > 0 -%}
  <div
    id="pdp-cr-{{ cr_bid }}"
    class="pdp-customer-reviews"
    data-cr-root
    data-cr-block-id="{{ cr_bid }}"
    {{ block.shopify_attributes }}
  >
    <style>
      #pdp-cr-{{ cr_bid }} {
        --pdp-cr-bg: {{ cr_bg }};
        --pdp-cr-accent: {{ cr_accent }};
        --pdp-cr-border: {{ cr_border }};
        --pdp-cr-accent-soft: color-mix(in srgb, var(--pdp-cr-accent) 14%, #fff);
        width: 100%;
        background-color: var(--pdp-cr-bg);
        text-align: center;
        box-sizing: border-box;
      }

      #pdp-cr-{{ cr_bid }} * {
        box-sizing: border-box;
      }

      #pdp-cr-{{ cr_bid }} .pdp-customer-reviews__title {
        margin: 0 0 24px;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #000;
      }

      #pdp-cr-{{ cr_bid }} .pdp-customer-reviews__panels {
        display: grid;
        grid-template: 1fr / 1fr;
        margin: 0 auto 24px;
      }

      #pdp-cr-{{ cr_bid }} .pdp-customer-reviews__panel {
        grid-area: 1 / 1;
        width: 100%;
        margin: 0 auto;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.4s ease, visibility 0.4s ease;
        pointer-events: none;
      }

      #pdp-cr-{{ cr_bid }} .pdp-customer-reviews__panel.is-active {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }

      #pdp-cr-{{ cr_bid }} .pdp-customer-reviews__quote {
        margin: 0;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        font-size: 16px;
        font-weight: 700;
        line-height: 1.35;
        color: #000;
      }

      #pdp-cr-{{ cr_bid }} .pdp-customer-reviews__quote::before {
        content: '\201C';
      }

      #pdp-cr-{{ cr_bid }} .pdp-customer-reviews__quote::after {
        content: '\201D';
      }

      #pdp-cr-{{ cr_bid }} .pdp-customer-reviews__author {
        font-weight: 700;
      }

      #pdp-cr-{{ cr_bid }} .pdp-customer-reviews__tags {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-start;
        gap: 12px;
        max-width: 900px;
        margin: 0 auto;
      }

      #pdp-cr-{{ cr_bid }} .pdp-customer-reviews__tag {
        appearance: none;
        border: 1px solid var(--pdp-cr-border);
        background: transparent;
        color: #000;
        cursor: pointer;
        padding: 10px 22px;
        border-radius: 100px;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        font-size: 14px;
        font-weight: 500;
        line-height: 1.2;
        transition: border-color 0.25s ease, color 0.25s ease, background-color 0.25s ease;
      }

      #pdp-cr-{{ cr_bid }} .pdp-customer-reviews__tag[aria-selected='true'] {
        border-color: var(--pdp-cr-accent);
        color: var(--pdp-cr-accent);
        background-color: var(--pdp-cr-accent-soft);
      }

      #pdp-cr-{{ cr_bid }} .pdp-customer-reviews__tag:focus-visible {
        outline: 2px solid var(--pdp-cr-accent);
        outline-offset: 2px;
      }

      @media screen and (max-width: 749px) {
        #pdp-cr-{{ cr_bid }} {
          padding: 36px 16px 44px;
        }

        #pdp-cr-{{ cr_bid }} .pdp-customer-reviews__title {
          margin-bottom: 24px;
        }

        #pdp-cr-{{ cr_bid }} .pdp-customer-reviews__panels {
          margin-bottom: 28px;
        }

        #pdp-cr-{{ cr_bid }} .pdp-customer-reviews__tag {
          padding: 8px 16px;
          font-size: 13px;
        }
      }
    </style>

    {%- if cr_title != blank -%}
      <h2 class="pdp-customer-reviews__title">{{ cr_title | escape }}</h2>
    {%- endif -%}

    {%- if cr_has_json -%}
      <script type="application/json" data-cr-json>{{ cr_json_raw }}</script>
      <div class="pdp-customer-reviews__panels" data-cr-panels></div>
      <div class="pdp-customer-reviews__tags" data-cr-tags role="tablist" aria-label="{{ cr_title | escape }}"></div>
    {%- else -%}
      <div class="pdp-customer-reviews__panels">
        {%- assign cr_idx = 0 -%}
        {%- for i in (1..6) -%}
          {%- liquid
            assign cr_tag_key = 'tag_' | append: i
            assign cr_review_key = 'review_' | append: i
            assign cr_author_key = 'author_' | append: i
            assign cr_label = block.settings[cr_tag_key]
            assign cr_quote = block.settings[cr_review_key]
            assign cr_author = block.settings[cr_author_key]
          -%}
          {%- if cr_label != blank and cr_quote != blank -%}
            <div
              class="pdp-customer-reviews__panel{% if cr_idx == 0 %} is-active{% endif %}"
              data-cr-panel
              data-cr-index="{{ cr_idx }}"
              role="tabpanel"
              id="pdp-cr-panel-{{ cr_bid }}-{{ cr_idx }}"
              aria-labelledby="pdp-cr-tab-{{ cr_bid }}-{{ cr_idx }}"
              {% unless cr_idx == 0 %}
                aria-hidden="true"
              {% endunless %}
            >
              <p class="pdp-customer-reviews__quote">
                {{- cr_quote | escape -}}
                {%- if cr_author != blank -%}
                  <span class="pdp-customer-reviews__author"> — {{ cr_author | escape }}</span>
                {%- endif -%}
              </p>
            </div>
            {%- assign cr_idx = cr_idx | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="pdp-customer-reviews__tags" role="tablist" aria-label="{{ cr_title | escape }}">
        {%- assign cr_idx = 0 -%}
        {%- for i in (1..6) -%}
          {%- liquid
            assign cr_tag_key = 'tag_' | append: i
            assign cr_review_key = 'review_' | append: i
            assign cr_label = block.settings[cr_tag_key]
            assign cr_quote = block.settings[cr_review_key]
          -%}
          {%- if cr_label != blank and cr_quote != blank -%}
            <button
              type="button"
              class="pdp-customer-reviews__tag"
              data-cr-tab
              data-cr-index="{{ cr_idx }}"
              role="tab"
              id="pdp-cr-tab-{{ cr_bid }}-{{ cr_idx }}"
              aria-controls="pdp-cr-panel-{{ cr_bid }}-{{ cr_idx }}"
              aria-selected="{% if cr_idx == 0 %}true{% else %}false{% endif %}"
            >
              {{ cr_label | escape }}
            </button>
            {%- assign cr_idx = cr_idx | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <script>
    (function () {
      function escapeHtml(text) {
        return String(text)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      function normalizeReviewItem(raw) {
        if (!raw || typeof raw !== "object") return null;

        var label = raw.label || raw.tag || "";
        var quote = raw.quote || raw.review || raw.content || "";
        var author = raw.author || "";

        if (!label || !quote) return null;

        return { label: label, quote: quote, author: author };
      }

      function bindTabSwitch(root) {
        var tabs = root.querySelectorAll("[data-cr-tab]");
        var panels = root.querySelectorAll("[data-cr-panel]");

        function activateTab(index) {
          var indexStr = String(index);

          tabs.forEach(function (tab) {
            var isActive = tab.getAttribute("data-cr-index") === indexStr;
            tab.setAttribute("aria-selected", isActive ? "true" : "false");
          });

          panels.forEach(function (panel) {
            var isActive = panel.getAttribute("data-cr-index") === indexStr;
            panel.classList.toggle("is-active", isActive);
            panel.setAttribute("aria-hidden", isActive ? "false" : "true");
          });
        }

        root.addEventListener("click", function (event) {
          var tab = event.target.closest("[data-cr-tab]");
          if (!tab || !root.contains(tab)) return;

          activateTab(tab.getAttribute("data-cr-index"));
        });
      }

      function renderFromJson(root) {
        var dataEl = root.querySelector("[data-cr-json]");
        var panelsEl = root.querySelector("[data-cr-panels]");
        var tagsEl = root.querySelector("[data-cr-tags]");
        var blockId = root.getAttribute("data-cr-block-id");

        if (!dataEl || !panelsEl || !tagsEl || !blockId) return;

        var items;

        try {
          items = JSON.parse(dataEl.textContent.trim());
        } catch (error) {
          console.warn("[pdp-customer-reviews] Invalid JSON:", error);
          return;
        }

        if (!Array.isArray(items)) {
          console.warn("[pdp-customer-reviews] JSON must be an array.");
          return;
        }

        items = items.map(normalizeReviewItem).filter(Boolean);

        if (!items.length) return;

        panelsEl.innerHTML = "";
        tagsEl.innerHTML = "";

        items.forEach(function (item, index) {
          var panel = document.createElement("div");
          panel.className = "pdp-customer-reviews__panel" + (index === 0 ? " is-active" : "");
          panel.setAttribute("data-cr-panel", "");
          panel.setAttribute("data-cr-index", String(index));
          panel.setAttribute("role", "tabpanel");
          panel.id = "pdp-cr-panel-" + blockId + "-" + index;
          panel.setAttribute("aria-labelledby", "pdp-cr-tab-" + blockId + "-" + index);
          panel.setAttribute("aria-hidden", index === 0 ? "false" : "true");

          var quoteHtml = escapeHtml(item.quote);

          if (item.author) {
            quoteHtml += '<span class="pdp-customer-reviews__author"> — ' + escapeHtml(item.author) + "</span>";
          }

          panel.innerHTML = '<p class="pdp-customer-reviews__quote">' + quoteHtml + "</p>";
          panelsEl.appendChild(panel);

          var tab = document.createElement("button");
          tab.type = "button";
          tab.className = "pdp-customer-reviews__tag";
          tab.setAttribute("data-cr-tab", "");
          tab.setAttribute("data-cr-index", String(index));
          tab.setAttribute("role", "tab");
          tab.id = "pdp-cr-tab-" + blockId + "-" + index;
          tab.setAttribute("aria-controls", panel.id);
          tab.setAttribute("aria-selected", index === 0 ? "true" : "false");
          tab.textContent = item.label;
          tagsEl.appendChild(tab);
        });

        bindTabSwitch(root);
      }

      function initCustomerReviews(root) {
        if (!root || root.getAttribute("data-cr-initialized") === "true") return;

        if (root.querySelector("[data-cr-json]")) {
          renderFromJson(root);
        } else {
          bindTabSwitch(root);
        }

        root.setAttribute("data-cr-initialized", "true");
      }

      function initAll(scope) {
        var container = scope || document;
        container.querySelectorAll("[data-cr-root]").forEach(initCustomerReviews);
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", function () {
          initAll();
        });
      } else {
        initAll();
      }

      document.addEventListener("shopify:section:load", function (event) {
        initAll(event.target);
      });
    })();
  </script>
{%- endif -%}
