<style>
  #shopify-section-{{ sid }} .pmb {
    --sub-c: {{ s.subtitle_color }}; --h-c: {{ s.heading_color }};
    --btn-bg: {{ s.button_bg }}; --btn-c: {{ s.button_text_color }};
    --bar-bg: {{ s.stat_bar_bg }}; --bar-n: {{ s.stat_number_color }};
    --bar-cap: {{ s.stat_caption_color }}; --bar-t: {{ s.stat_text_color }};
    --bar-line: {{ s.stat_divider_color }};
  }
  #shopify-section-{{ sid }} .pmb * { box-sizing: border-box; }
  #shopify-section-{{ sid }} .pmb_bar {
    background: var(--bar-bg); padding: 28px 16px 32px;
  }
  #shopify-section-{{ sid }} .pmb_bar .number {
    color: var(--bar-n); font-size: {{ s.stat_number_size_mobile }}px; font-weight: 500;
    letter-spacing: -0.02em; line-height: 1.1; margin: 0;
  }
  #shopify-section-{{ sid }} .pmb_bar .caption {
    color: var(--bar-cap); font-size: {{ s.stat_caption_size_mobile }}px; font-weight: 400;
    line-height: 1.3; margin: 8px 0 0;
  }
  #shopify-section-{{ sid }} .pmb_bar .divider {
    background: var(--bar-line); height: 1px; margin: 20px 0; width: 100%;
  }
  #shopify-section-{{ sid }} .pmb_bar .copy {
    color: var(--bar-t); font-size: {{ s.stat_text_size_mobile }}px; line-height: 1.4; margin: 0;
  }
  #shopify-section-{{ sid }} .pmb_bar .copy p { margin: 0; }
  #shopify-section-{{ sid }} .pmb_bar .copy p + p { margin-top: 0.75em; }
  #shopify-section-{{ sid }} .pmb_hero {
    background: #1a1218; min-height: {{ s.mobile_height | default: 560 }}px;
    overflow: hidden; position: relative;
  }
  #shopify-section-{{ sid }} .pmb_hero .media,
  #shopify-section-{{ sid }} .pmb_hero .image,
  #shopify-section-{{ sid }} .pmb_hero .placeholder {
    height: 100%; inset: 0; position: absolute; width: 100%;
  }
  #shopify-section-{{ sid }} .pmb_hero .image { object-fit: cover; object-position: center; }
  #shopify-section-{{ sid }} .pmb_hero .desktop_image { display: none; }
  #shopify-section-{{ sid }} .pmb_hero .placeholder {
    background: linear-gradient(180deg, #2a1a24 0%, #8a6a78 55%, #d8c8c0 100%);
  }
  #shopify-section-{{ sid }} .pmb_hero .content {
    align-items: center; display: flex; flex-direction: column; left: 50%;
    padding: 40px 16px 0; position: absolute; text-align: center;
    transform: translateX(-50%); width: calc(100% - 32px); z-index: 2;
  }
  #shopify-section-{{ sid }} .pmb_hero .subtitle {
    color: var(--sub-c); font-size: {{ s.subtitle_font_size_mobile }}px; font-weight: 500;
    line-height: 1.3; margin: 0 0 10px;
  }
  #shopify-section-{{ sid }} .pmb_hero .title {
    color: var(--h-c); font-size: {{ s.heading_font_size_mobile }}px; font-weight: 500;
    letter-spacing: -0.02em; line-height: 1.25; margin: 0; max-width: 340px;
  }
  #shopify-section-{{ sid }} .pmb_hero .cta {
    align-items: center; background: var(--btn-bg); border-radius: 100px; color: var(--btn-c);
    display: inline-flex; font-size: {{ s.button_font_size_mobile }}px; font-weight: 500;
    height: 36px; justify-content: center; margin-top: 20px; text-decoration: none; width: 162px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ sid }} .pmb_bar { padding: 28px 80px; }
    #shopify-section-{{ sid }} .pmb_bar .inner {
      align-items: center; display: flex; gap: 40px; justify-content: space-between;
    }
    #shopify-section-{{ sid }} .pmb_bar .stat { flex: 0 0 auto; }
    #shopify-section-{{ sid }} .pmb_bar .number { font-size: {{ s.stat_number_size }}px; }
    #shopify-section-{{ sid }} .pmb_bar .caption { font-size: {{ s.stat_caption_size }}px; margin-top: 6px; }
    #shopify-section-{{ sid }} .pmb_bar .divider {
      align-self: stretch; flex: 0 0 1px; height: auto; margin: 4px 0; min-height: 48px; width: 1px;
    }
    #shopify-section-{{ sid }} .pmb_bar .copy {
      flex: 0 1 420px; font-size: {{ s.stat_text_size }}px; max-width: 420px;
    }
    #shopify-section-{{ sid }} .pmb_hero { min-height: {{ s.desktop_height | default: 640 }}px; }
    #shopify-section-{{ sid }} .pmb_hero .desktop_image { display: block; }
    #shopify-section-{{ sid }} .pmb_hero .mobile_image { display: none; }
    #shopify-section-{{ sid }} .pmb_hero .content {
      max-width: min(720px, calc(100% - 48px)); padding-top: {{ s.content_offset_top | default: 80 }}px;
      width: calc(100% - 48px);
    }
    #shopify-section-{{ sid }} .pmb_hero .subtitle { font-size: {{ s.subtitle_font_size }}px; margin-bottom: 12px; }
    #shopify-section-{{ sid }} .pmb_hero .title { font-size: {{ s.heading_font_size }}px; max-width: 680px; }
    #shopify-section-{{ sid }} .pmb_hero .cta {
      font-size: {{ s.button_font_size }}px; height: 48px; margin-top: 24px; width: 220px;
    }
  }
</style>
