{%- liquid
  assign ratio_class = ''
  if block.settings.video_aspect_ratio == '3-4'
    assign ratio_class = 'cs-video--portrait'
  endif
  assign has_video = false
  if block.settings.video != blank
    assign has_video = true
  endif
  assign has_cover = false
  if block.settings.video_cover != blank
    assign has_cover = true
  endif
  assign media_label = block.settings.creator_name | default: 'Creator'
  assign video_controls = true
  assign video_preload = 'metadata'
  if has_cover
    assign video_controls = false
    assign video_preload = 'none'
  endif
-%}

<article class="cs-card">
  {% if has_video or has_cover %}
    <div
      class="cs-video {{ ratio_class }}{% if has_video and has_cover %} cs-video--inline{% endif %}"
      {% if has_video and has_cover %}
        data-cs-inline-video
        tabindex="0"
        role="group"
        aria-label="{{ media_label | escape }} — Video"
      {% endif %}
    >
      {% if has_cover %}
        <div class="cs-video-poster">
          {{
            block.settings.video_cover
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '360, 540, 720, 900',
              sizes: '(min-width: 1000px) 360px, 85vw',
              alt: media_label
          }}
          {% if has_video %}
            <button type="button" class="cs-play" aria-label="Play video">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </button>
          {% endif %}
        </div>
      {% endif %}
      {% if has_video %}
        <div class="cs-video-host">
          {{
            block.settings.video
            | video_tag:
              playsinline: true,
              controls: video_controls,
              preload: video_preload,
              muted: false,
              loop: false
          }}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="cs-card-body">
    {% if block.settings.profile_url != blank %}
      <a class="cs-profile" href="{{ block.settings.profile_url }}" target="_blank" rel="noopener noreferrer">
    {% else %}
      <div class="cs-profile">
    {% endif %}

      {% if block.settings.avatar != blank %}
        <div class="cs-avatar">
          {{
            block.settings.avatar
            | image_url: width: 160
            | image_tag:
              loading: 'lazy',
              widths: '64, 96, 160',
              sizes: '48px',
              alt: media_label
          }}
        </div>
      {% endif %}

      <div class="cs-profile-info">
        {% unless block.settings.creator_name == blank %}
          <p class="cs-name">{{ block.settings.creator_name | escape }}</p>
        {% endunless %}
        {% unless block.settings.creator_desc == blank %}
          <p class="cs-desc">{{ block.settings.creator_desc | escape }}</p>
        {% endunless %}
        {% unless block.settings.creator_subs == blank %}
          <p class="cs-desc">{{ block.settings.creator_subs | escape }}</p>
        {% endunless %}
      </div>

    {% if block.settings.profile_url != blank %}
      </a>
    {% else %}
      </div>
    {% endif %}

    {% unless block.settings.quote == blank %}
      <div class="cs-quote rte">{{ block.settings.quote }}</div>
    {% endunless %}
  </div>
</article>
