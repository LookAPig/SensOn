{%- liquid
  assign tab_creator = block.settings.tab_creator_label | default: 'Creator Review'
  assign tab_how = block.settings.tab_how_label | default: 'How to Use'
  assign tab_specs = block.settings.tab_specs_label | default: 'Specifications'
  assign tab_tech = block.settings.tab_tech_label | default: 'Tech'

  assign color_tab_pink = block.settings.color_tab_pink | default: '#e91ead'
  assign color_tab_bar_bg = block.settings.color_tab_bar_bg | default: '#fde8ef'
  assign color_tab_active_bg = block.settings.color_tab_active_bg | default: '#ffffff'
  assign color_tab_card_bg = block.settings.color_tab_card_bg | default: '#fdf7f9'
  assign color_tab_step_bg = block.settings.color_tab_step_bg | default: '#e91ead'

  assign color_tab_text_inactive = block.settings.color_tab_text_inactive | default: color_tab_pink
  assign color_tab_text_active = block.settings.color_tab_text_active | default: color_tab_pink
  assign specs_json_raw = block.settings.specs_json | strip
-%}

<div id="pdp-wh-{{ block.id }}" class="pdp-info-tabs" {{ block.shopify_attributes }}>
  <style>
    #pdp-wh-{{ block.id }} {
      --pdp-tab-pink: {{ color_tab_pink }};
      --pdp-tab-bar-bg: {{ color_tab_bar_bg }};
      --pdp-tab-active-bg: {{ color_tab_active_bg }};
      --pdp-tab-card-bg: {{ color_tab_card_bg }};
      --pdp-tab-step-bg: {{ color_tab_step_bg }};
      --pdp-tab-text-inactive: {{ color_tab_text_inactive }};
      --pdp-tab-text-active: {{ color_tab_text_active }};
      width: 100%;
      margin-top: 42px;
      margin-bottom: 0.5rem;
    }
    #pdp-wh-{{ block.id }} * {
      box-sizing: border-box;
    }

    #pdp-wh-{{ block.id }} .pdp-info-tabs__bar {
      display: flex;
      align-items: stretch;
      gap: 8px;
      padding: 4px;
      width: 100%;
      background: var(--pdp-tab-bar-bg);
      border-radius: 100px;
      margin-bottom: 16px;
      overflow: hidden;
      flex-wrap: nowrap;
    }

    #pdp-wh-{{ block.id }} .pdp-info-tabs__tab {
      flex: 1 1 0;
      min-width: 0;
      appearance: none;
      border: none;
      background: transparent;
      cursor: pointer;
      padding: 10px 8px;
      font-size: 14px;
      font-weight: 700;
      line-height: 1.3;
      color: var(--pdp-tab-text-inactive);
      text-align: center;
      border-radius: 100px;
      transition: background 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #pdp-wh-{{ block.id }} .pdp-info-tabs__tab-text--mobile {
      display: none;
    }

    #pdp-wh-{{ block.id }} .pdp-info-tabs__tab-text--desktop {
      display: block;
      width: 100%;
      overflow-wrap: break-word;
      word-break: break-word;
      white-space: normal;
    }

    #pdp-wh-{{ block.id }} .pdp-info-tabs__tab[aria-selected='true'] {
      background: var(--pdp-tab-active-bg);
      box-shadow: 0 2px 6px rgb(0 0 0 / 0.08);
      color: var(--pdp-tab-text-active);
    }

    #pdp-wh-{{ block.id }} .pdp-info-tabs__panel[hidden] {
      display: none !important;
    }

    /* Creator Review */
    #pdp-wh-{{ block.id }} .pdp-creator-stack {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-card {
      display: flex;
      flex-direction: column;
      background: var(--pdp-tab-card-bg);
      border-radius: 12px;
      padding: 20px 18px;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-card .pdp-creator-author {
      order: 1;
      margin-bottom: 20px;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-card .pdp-creator-video {
      order: 2;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-card .pdp-creator-quote {
      order: 3;
      margin-bottom: 0;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-quote {
      margin: 0;
      {% comment %} font-family: Georgia, 'Times New Roman', serif; {% endcomment %}
      font-size: 14px;
      line-height: 1.45;
      color: #000;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-quote::before {
      content: '\201C';
    }

    #pdp-wh-{{ block.id }} .pdp-creator-quote::after {
      content: '\201D';
    }

    #pdp-wh-{{ block.id }} .pdp-creator-author {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-video {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      margin-bottom: 20px;
      /* border: 2px solid #4a9eff; */
      border-radius: 12px;
      overflow: hidden;
      background: #000;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-video__poster {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      background: #000;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-video.is-playing .pdp-creator-video__poster {
      display: none;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-video__cover {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-video__play-btn {
      position: relative;
      z-index: 3;
      width: 56px;
      height: 56px;
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: rgb(80 80 80 / 0.55);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      cursor: pointer;
      flex-shrink: 0;
      pointer-events: none;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-video__play-btn svg {
      width: 22px;
      height: 22px;
      margin-left: 3px;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-video__host {
      position: absolute;
      inset: 0;
      z-index: 1;
      cursor: pointer;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-video__host video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      cursor: pointer;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-video.is-playing .pdp-creator-video__host {
      z-index: 2;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-video__pause-overlay {
      display: none;
      position: absolute;
      inset: 0;
      z-index: 3;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      background: rgb(0 0 0 / 0.15);
    }

    #pdp-wh-{{ block.id }} .pdp-creator-video.is-playing.is-paused .pdp-creator-video__pause-overlay {
      display: flex;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-avatar {
      flex-shrink: 0;
      width: 64px;
      height: 64px;
      border-radius: 50%;
      overflow: hidden;
      background: #e8e8e8;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-name {
      margin: 0 0 4px;
      font-size: 16px;
      font-weight: 700;
      color: #000;
      line-height: 1.2;
    }

    #pdp-wh-{{ block.id }} .pdp-creator-credentials {
      margin: 0;
      font-size: 10px;
      line-height: 1.35;
      color: #666;
    }

    /* How to Use and Tech共用步骤样式 */
    #pdp-wh-{{ block.id }} .pdp-how-panel,
    #pdp-wh-{{ block.id }} .pdp-tech-panel {
      background: var(--pdp-tab-card-bg);
      border-radius: 12px;
      padding: 20px 18px;
    }

    #pdp-wh-{{ block.id }} .pdp-how-heading,
    #pdp-wh-{{ block.id }} .pdp-tech-heading {
      margin: 0 0 18px;
      font-size: 16px;
      font-weight: 700;
      color: #000;
      line-height: 1.2;
    }

    #pdp-wh-{{ block.id }} .pdp-steps-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    #pdp-wh-{{ block.id }} .pdp-step-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
    }

    #pdp-wh-{{ block.id }} .pdp-step-num {
      flex-shrink: 0;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: var(--pdp-tab-step-bg);
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }

    #pdp-wh-{{ block.id }} .pdp-step-body {
      min-width: 0;
      padding-top: 2px;
    }

    #pdp-wh-{{ block.id }} .pdp-step-title {
      margin: 0 0 4px;
      font-size: 14px;
      font-weight: 700;
      color: #000;
      line-height: 1.3;
    }

    #pdp-wh-{{ block.id }} .pdp-step-desc {
      margin: 0;
      font-size: 14px;
      line-height: 1.3;
      color: #333;
    }

    /* Specifications 两列布局 */
    #pdp-wh-{{ block.id }} .pdp-specs-panel {
      background: var(--pdp-tab-card-bg);
      border-radius: 12px;
      padding: 20px 18px;
    }

    #pdp-wh-{{ block.id }} .pdp-specs-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px 40px;
    }

    #pdp-wh-{{ block.id }} .pdp-spec-item {
      min-width: 0;
    }

    #pdp-wh-{{ block.id }} .pdp-spec-label {
      margin: 0 0 4px;
      font-size: 12px;
      font-weight: 400;
      line-height: 1.35;
      color: #333;
    }

    #pdp-wh-{{ block.id }} .pdp-spec-value {
      margin: 0;
      font-size: 16px;
      font-weight: 700;
      line-height: 1.35;
      color: #000;
    }

    #pdp-wh-{{ block.id }} .pdp-specs-placeholder {
      margin: 0;
      font-size: 14px;
      line-height: 1.5;
      color: #999;
    }

    /* 移动端 */
    @media (max-width: 768px) {
      #pdp-wh-{{ block.id }} .pdp-info-tabs__bar {
        gap: 4px;
        padding: 4px;
      }

      #pdp-wh-{{ block.id }} .pdp-info-tabs__tab {
        flex: 1 1 0;
        font-size: 11px;
        padding: 8px 4px;
        line-height: 1.15;
      }

      #pdp-wh-{{ block.id }} .pdp-info-tabs__tab-text--desktop {
        display: none;
      }

      #pdp-wh-{{ block.id }} .pdp-info-tabs__tab-text--mobile {
        display: block;
        width: 100%;
      }

      #pdp-wh-{{ block.id }} .pdp-info-tabs__tab-label {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: calc(2 * 1.15em);
      }

      #pdp-wh-{{ block.id }} .pdp-info-tabs__tab-line {
        display: block;
        width: 100%;
        line-height: 1.15;
        overflow-wrap: break-word;
        word-break: break-word;
      }

      #pdp-wh-{{ block.id }} .pdp-specs-grid {
        gap: 16px 12px;
      }

      #pdp-wh-{{ block.id }} .pdp-spec-value {
        font-size: 15px;
      }
    }
  </style>

  <div class="pdp-info-tabs__bar" role="tablist" aria-label="Product information">
    <button
      type="button"
      class="pdp-info-tabs__tab"
      role="tab"
      aria-selected="true"
      data-pdp-info-tab="{{ block.id }}"
      data-index="0"
    >
      {%- render 'pdp-info-tab-label', label: tab_creator -%}
    </button>
    <button
      type="button"
      class="pdp-info-tabs__tab"
      role="tab"
      aria-selected="false"
      data-pdp-info-tab="{{ block.id }}"
      data-index="1"
    >
      {%- render 'pdp-info-tab-label', label: tab_how -%}
    </button>
    <button
      type="button"
      class="pdp-info-tabs__tab"
      role="tab"
      aria-selected="false"
      data-pdp-info-tab="{{ block.id }}"
      data-index="2"
    >
      {%- render 'pdp-info-tab-label', label: tab_specs -%}
    </button>
    <button
      type="button"
      class="pdp-info-tabs__tab"
      role="tab"
      aria-selected="false"
      data-pdp-info-tab="{{ block.id }}"
      data-index="3"
    >
      {%- render 'pdp-info-tab-label', label: tab_tech -%}
    </button>
  </div>

  <div class="pdp-info-tabs__panels">
    {%- comment -%} Tab 0: Creator Review {%- endcomment -%}
    <div
      class="pdp-info-tabs__panel"
      role="tabpanel"
      data-pdp-info-panel="{{ block.id }}"
      data-index="0"
    >
      {%- liquid
        assign creator_2_has_content = false
        if block.settings.creator_2_quote != blank
          assign creator_2_has_content = true
        elsif block.settings.creator_2_avatar != blank
          assign creator_2_has_content = true
        elsif block.settings.creator_2_name != blank
          assign creator_2_has_content = true
        elsif block.settings.creator_2_credentials != blank
          assign creator_2_has_content = true
        endif
      -%}
      <div class="pdp-creator-stack">
        <div class="pdp-creator-card">
          {%- if block.settings.creator_avatar != blank
            or block.settings.creator_name != blank
            or block.settings.creator_credentials != blank
          -%}
            <div class="pdp-creator-author">
              {%- if block.settings.creator_avatar != blank -%}
                <div class="pdp-creator-avatar">
                  {{
                    block.settings.creator_avatar
                    | image_url: width: 112
                    | image_tag: loading: 'lazy', widths: '56, 112', sizes: '56px', alt: block.settings.creator_name
                  }}
                </div>
              {%- endif -%}
              <div>
                {%- if block.settings.creator_name != blank -%}
                  <p class="pdp-creator-name">{{ block.settings.creator_name | escape }}</p>
                {%- endif -%}
                {%- if block.settings.creator_credentials != blank -%}
                  <p class="pdp-creator-credentials">{{ block.settings.creator_credentials | escape }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          {%- if block.settings.creator_video != blank -%}
            <div class="pdp-creator-video" data-pdp-creator-video tabindex="0" role="group" aria-label="{% if block.settings.creator_name != blank %}{{ block.settings.creator_name | escape }} — {% endif %}Video">
              <div class="pdp-creator-video__poster" data-pdp-creator-video-poster>
                {%- if block.settings.creator_video_cover != blank -%}
                  {{
                    block.settings.creator_video_cover
                    | image_url: width: 900
                    | image_tag:
                      class: 'pdp-creator-video__cover',
                      loading: 'lazy',
                      widths: '400, 600, 900',
                      sizes: '100vw',
                      alt: block.settings.creator_name | default: 'Video' | escape
                  }}
                {%- elsif block.settings.creator_video.preview_image != blank -%}
                  {{
                    block.settings.creator_video.preview_image
                    | image_url: width: 900
                    | image_tag:
                      class: 'pdp-creator-video__cover',
                      loading: 'lazy',
                      widths: '400, 600, 900',
                      sizes: '100vw',
                      alt: block.settings.creator_name | default: 'Video' | escape
                  }}
                {%- endif -%}
                <button type="button" class="pdp-creator-video__play-btn" aria-label="Play video" tabindex="-1">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>
              </div>
              <div class="pdp-creator-video__host" data-pdp-creator-video-host>
                {{
                  block.settings.creator_video
                  | video_tag:
                    playsinline: true,
                    controls: false,
                    preload: 'none',
                    muted: false,
                    loop: false
                }}
              </div>
              <div class="pdp-creator-video__pause-overlay" data-pdp-creator-video-pause-overlay>
                <button type="button" class="pdp-creator-video__play-btn" aria-label="Play video" tabindex="-1">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>
              </div>
            </div>
          {%- endif -%}

          {%- if block.settings.creator_quote != blank -%}
            <p class="pdp-creator-quote">{{ block.settings.creator_quote | escape }}</p>
          {%- endif -%}
        </div>

        {%- if creator_2_has_content -%}
          <div class="pdp-creator-card">
            {%- if block.settings.creator_2_quote != blank -%}
              <p class="pdp-creator-quote">{{ block.settings.creator_2_quote | escape }}</p>
            {%- endif -%}
            {%- if block.settings.creator_2_avatar != blank
              or block.settings.creator_2_name != blank
              or block.settings.creator_2_credentials != blank
            -%}
              <div class="pdp-creator-author">
                {%- if block.settings.creator_2_avatar != blank -%}
                  <div class="pdp-creator-avatar">
                    {{
                      block.settings.creator_2_avatar
                      | image_url: width: 112
                      | image_tag: loading: 'lazy', widths: '56, 112', sizes: '56px', alt: block.settings.creator_2_name
                    }}
                  </div>
                {%- endif -%}
                <div>
                  {%- if block.settings.creator_2_name != blank -%}
                    <p class="pdp-creator-name">{{ block.settings.creator_2_name | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.creator_2_credentials != blank -%}
                    <p class="pdp-creator-credentials">{{ block.settings.creator_2_credentials | escape }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Tab 1: How to Use {%- endcomment -%}
    <div
      class="pdp-info-tabs__panel"
      role="tabpanel"
      data-pdp-info-panel="{{ block.id }}"
      data-index="1"
      hidden
    >
      <div class="pdp-how-panel">
        {%- if block.settings.how_heading != blank -%}
          <h3 class="pdp-how-heading">{{ block.settings.how_heading | escape }}</h3>
        {%- endif -%}
        <ol class="pdp-steps-list">
          {%- for i in (1..5) -%}
            {%- liquid
              case i
                when 1
                  assign step_title = block.settings.how_step_1_title
                  assign step_desc = block.settings.how_step_1_desc
                when 2
                  assign step_title = block.settings.how_step_2_title
                  assign step_desc = block.settings.how_step_2_desc
                when 3
                  assign step_title = block.settings.how_step_3_title
                  assign step_desc = block.settings.how_step_3_desc
                when 4
                  assign step_title = block.settings.how_step_4_title
                  assign step_desc = block.settings.how_step_4_desc
                when 5
                  assign step_title = block.settings.how_step_5_title
                  assign step_desc = block.settings.how_step_5_desc
              endcase
            %}
            <li class="pdp-step-item">
              <span class="pdp-step-num" aria-hidden="true">{{ i }}</span>
              <div class="pdp-step-body">
                <p class="pdp-step-title">
                  {%- if step_title != blank -%}
                    {{ step_title | escape }}
                  {%- else -%}
                    Step {{ i }}
                  {%- endif -%}
                </p>
                <p class="pdp-step-desc">
                  {%- if step_desc != blank -%}
                    {{ step_desc | escape }}
                  {%- else -%}
                    Description coming soon.
                  {%- endif -%}
                </p>
              </div>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </div>

    {%- comment -%} Tab 2: Specifications (JSON 两列) {%- endcomment -%}
    <div
      class="pdp-info-tabs__panel"
      role="tabpanel"
      data-pdp-info-panel="{{ block.id }}"
      data-index="2"
      hidden
    >
      <div class="pdp-specs-panel">
        {%- if specs_json_raw != blank -%}
          <script type="application/json" data-pdp-specs-json>{{ specs_json_raw }}</script>
          <div class="pdp-specs-grid" data-pdp-specs-grid></div>
        {%- else -%}
          <p class="pdp-specs-placeholder">{{ tab_specs | escape }} — content coming soon.</p>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Tab 3: Tech (3 steps) {%- endcomment -%}
    <div
      class="pdp-info-tabs__panel"
      role="tabpanel"
      data-pdp-info-panel="{{ block.id }}"
      data-index="3"
      hidden
    >
      <div class="pdp-tech-panel">
        {%- if block.settings.tech_heading != blank -%}
          <h3 class="pdp-tech-heading">{{ block.settings.tech_heading | escape }}</h3>
        {%- endif -%}
        <ol class="pdp-steps-list">
          {%- for i in (1..3) -%}
            {%- liquid
              case i
                when 1
                  assign step_title = block.settings.tech_step_1_title
                  assign step_desc = block.settings.tech_step_1_desc
                when 2
                  assign step_title = block.settings.tech_step_2_title
                  assign step_desc = block.settings.tech_step_2_desc
                when 3
                  assign step_title = block.settings.tech_step_3_title
                  assign step_desc = block.settings.tech_step_3_desc
              endcase
            %}
            <li class="pdp-step-item">
              <span class="pdp-step-num" aria-hidden="true">{{ i }}</span>
              <div class="pdp-step-body">
                <p class="pdp-step-title">
                  {%- if step_title != blank -%}
                    {{ step_title | escape }}
                  {%- else -%}
                    Step {{ i }}
                  {%- endif -%}
                </p>
                <p class="pdp-step-desc">
                  {%- if step_desc != blank -%}
                    {{ step_desc | escape }}
                  {%- else -%}
                    Description coming soon.
                  {%- endif -%}
                </p>
              </div>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var id = "{{ block.id }}";
      var root = document.getElementById("pdp-wh-" + id);
      if (!root) return;

      var tabs = root.querySelectorAll('[data-pdp-info-tab="' + id + '"]');
      var panels = root.querySelectorAll('[data-pdp-info-panel="' + id + '"]');

      function escapeHtml(text) {
        return String(text)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      function normalizeSpecItem(raw) {
        if (!raw || typeof raw !== "object") return null;

        var label = raw.label || raw.name || "";
        var value = raw.value || raw.text || "";

        if (!label && !value) return null;

        return { label: label, value: value };
      }

      function renderSpecsGrid() {
        var jsonEl = root.querySelector("[data-pdp-specs-json]");
        var gridEl = root.querySelector("[data-pdp-specs-grid]");
        if (!jsonEl || !gridEl) return;

        var items;

        try {
          items = JSON.parse(jsonEl.textContent.trim());
        } catch (error) {
          console.warn("[pdp-info-tabs] Invalid specs JSON:", error);
          return;
        }

        if (!Array.isArray(items)) {
          console.warn("[pdp-info-tabs] Specifications JSON must be an array.");
          return;
        }

        items = items.map(normalizeSpecItem).filter(Boolean);

        if (!items.length) return;

        gridEl.innerHTML = "";

        items.forEach(function (item) {
          var specItem = document.createElement("div");
          specItem.className = "pdp-spec-item";

          var html = "";

          if (item.label) {
            html += '<p class="pdp-spec-label">' + escapeHtml(item.label) + "</p>";
          }

          if (item.value) {
            html += '<p class="pdp-spec-value">' + escapeHtml(item.value) + "</p>";
          }

          specItem.innerHTML = html;
          gridEl.appendChild(specItem);
        });
      }

      function setTab(idx) {
        tabs.forEach(function (t) {
          var i = parseInt(t.getAttribute("data-index"), 10);
          t.setAttribute("aria-selected", i === idx ? "true" : "false");
        });
        panels.forEach(function (p) {
          var i = parseInt(p.getAttribute("data-index"), 10);
          p.hidden = i !== idx;
        });
      }

      tabs.forEach(function (tab) {
        tab.addEventListener("click", function () {
          setTab(parseInt(tab.getAttribute("data-index"), 10) || 0);
        });
      });

      function setupCreatorVideos() {
        root.querySelectorAll("[data-pdp-creator-video]").forEach(function (wrap) {
          if (wrap.dataset.pdpCreatorVideoBound === "1") return;
          wrap.dataset.pdpCreatorVideoBound = "1";

          var poster = wrap.querySelector("[data-pdp-creator-video-poster]");
          var videoHost = wrap.querySelector("[data-pdp-creator-video-host]");
          var pauseOverlay = wrap.querySelector("[data-pdp-creator-video-pause-overlay]");
          var video = wrap.querySelector("video");
          if (!poster || !video) return;

          video.controls = false;
          video.setAttribute("controlsList", "nodownload noremoteplayback");

          function playVideo() {
            wrap.classList.add("is-playing");
            wrap.classList.remove("is-paused");
            var playPromise = video.play();
            if (playPromise && playPromise.catch) {
              playPromise.catch(function () {});
            }
          }

          function pauseVideo() {
            video.pause();
            wrap.classList.add("is-paused");
          }

          function toggleVideo() {
            if (!wrap.classList.contains("is-playing")) {
              playVideo();
              return;
            }

            if (video.paused) {
              playVideo();
            } else {
              pauseVideo();
            }
          }

          poster.addEventListener("click", function (event) {
            event.preventDefault();
            playVideo();
          });

          if (videoHost) {
            videoHost.addEventListener("click", function (event) {
              event.preventDefault();
              toggleVideo();
            });
          }

          if (pauseOverlay) {
            pauseOverlay.addEventListener("click", function (event) {
              event.preventDefault();
              playVideo();
            });
          }

          video.addEventListener("ended", function () {
            wrap.classList.remove("is-playing");
            wrap.classList.remove("is-paused");
          });

          wrap.addEventListener("keydown", function (event) {
            if (event.key !== "Enter" && event.key !== " ") return;
            event.preventDefault();
            toggleVideo();
          });
        });
      }

      setupCreatorVideos();
      renderSpecsGrid();
    })();
  </script>
</div>