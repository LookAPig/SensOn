{%- liquid
  assign swpt_bid = block.id
  assign swpt_heading = block.settings.heading | default: 'See what people think'
  assign swpt_count = 0

  for i in (1..6)
    assign swpt_video_key = 'video_' | append: i
    if block.settings[swpt_video_key] != blank
      assign swpt_count = swpt_count | plus: 1
    endif
  endfor

  assign swpt_icon_prev = 'https://cdn.shopify.com/s/files/1/0775/2446/7967/files/arrow-left-s-line.svg?v=1772728772'
  assign swpt_icon_next = 'https://cdn.shopify.com/s/files/1/0775/2446/7967/files/arrow-right-s-line.svg?v=1772728772'
  assign swpt_icon_play = 'https://cdn.shopify.com/s/files/1/0775/2446/7967/files/play-fill.svg?v=1772728781'
  assign swpt_icon_mute = 'https://cdn.shopify.com/s/files/1/0775/2446/7967/files/volume-mute-fill.svg?v=1772728781'
  assign swpt_icon_volume = 'https://cdn.shopify.com/s/files/1/0775/2446/7967/files/volume-up-fill_b0e75cc5-fc59-4aa4-aa70-e24ee19b3e18.svg?v=1772729919'
-%}

{%- if swpt_count > 0 -%}
  <div id="pdp-swpt-{{ swpt_bid }}" class="pdp-swpt-section" data-swpt-root data-swpt-total="{{ swpt_count }}" {{ block.shopify_attributes }}>
    <style>
      #pdp-swpt-{{ swpt_bid }} {
        width: 100%;
        position: relative;
        background-color: #fff;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
        text-align: left;
        font-size: 20px;
        color: #000;
        box-sizing: border-box;
        overflow: hidden;
      }

      #pdp-swpt-{{ swpt_bid }} * {
        box-sizing: border-box;
      }

      #pdp-swpt-{{ swpt_bid }} .pdp-swpt-header {
        align-self: stretch;
        display: flex;
        align-items: center;
        gap: 32px;
      }

      #pdp-swpt-{{ swpt_bid }} .pdp-swpt-title {
        flex: 1;
        margin: 0;
        position: relative;
        line-height: 120%;
        font-weight: 400;
        font-size: 16px;
      }

      #pdp-swpt-{{ swpt_bid }} .pdp-swpt-nav {
        display: flex;
        align-items: center;
        gap: 16px;
      }

      #pdp-swpt-{{ swpt_bid }} .pdp-swpt-nav-btn {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        border: 1.5px solid #ccc;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
        padding: 0;
        opacity: 0.4;
        transition: opacity 0.2s ease;
      }

      #pdp-swpt-{{ swpt_bid }} .pdp-swpt-nav-btn.is-active {
        opacity: 1;
      }

      #pdp-swpt-{{ swpt_bid }} .pdp-swpt-nav-btn img {
        width: 16px;
        height: 16px;
        display: block;
      }

      #pdp-swpt-{{ swpt_bid }} .pdp-swpt-pc-list {
        align-self: stretch;
        overflow: hidden;
      }

      #pdp-swpt-{{ swpt_bid }} .pdp-swpt-track {
        display: flex;
        gap: 12px;
        transition: transform 0.4s ease;
        font-size: 14px;
        color: #fff;
      }

      #pdp-swpt-{{ swpt_bid }} .pdp-swpt-card {
        height: 284px;
        width: 160px;
        position: relative;
        border-radius: 12px;
        overflow: hidden;
        flex-shrink: 0;
        cursor: pointer;
      }

      #pdp-swpt-{{ swpt_bid }} .pdp-swpt-card video {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      #pdp-swpt-{{ swpt_bid }} .pdp-swpt-card[data-platform='h5'] video {
        pointer-events: none;
      }

      #pdp-swpt-{{ swpt_bid }} .pdp-swpt-mute-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 26px;
        height: 26px;
        border-radius: 50px;
        background: rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(8px);
        display: none;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 2;
        border: none;
        padding: 0;
      }

      #pdp-swpt-{{ swpt_bid }} .pdp-swpt-mute-btn img {
        width: 14px;
        height: 14px;
        display: block;
      }

      #pdp-swpt-{{ swpt_bid }} .pdp-swpt-play-btn {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 32px;
        height: 32px;
        border-radius: 100px;
        background: rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(24px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2;
        pointer-events: none;
      }

      #pdp-swpt-{{ swpt_bid }} .pdp-swpt-play-btn img {
        width: 14px;
        height: 14px;
        display: block;
      }

      #pdp-swpt-{{ swpt_bid }} .pdp-swpt-caption {
        position: absolute;
        width: 100%;
        right: 0;
        bottom: 0;
        left: 0;
        background: linear-gradient(0deg, #000, rgba(128, 128, 128, 0));
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        padding: 12px;
        z-index: 2;
      }

      #pdp-swpt-{{ swpt_bid }} .pdp-swpt-caption-text {
        align-self: stretch;
        position: relative;
        line-height: 110%;
        margin: 0;
      }

      #pdp-swpt-{{ swpt_bid }} .pdp-swpt-h5-carousel {
        display: none;
        align-self: stretch;
        overflow: hidden;
      }

      @media (max-width: 999px) {
        #pdp-swpt-{{ swpt_bid }} .pdp-swpt-title {
          font-size: 16px !important;
        }

        #pdp-swpt-{{ swpt_bid }} .pdp-swpt-nav-btn {
          width: 22px !important;
          height: 22px !important;
        }

        #pdp-swpt-{{ swpt_bid }} .pdp-swpt-nav-btn img {
          width: 14px !important;
          height: 14px !important;
        }

        #pdp-swpt-{{ swpt_bid }} .pdp-swpt-pc-list {
          display: none !important;
        }

        #pdp-swpt-{{ swpt_bid }} .pdp-swpt-h5-carousel {
          display: block !important;
        }
      }
    </style>

    <div class="pdp-swpt-header">
      <h3 class="pdp-swpt-title">{{ swpt_heading | escape }}</h3>
      <div class="pdp-swpt-nav">
        <button type="button" class="pdp-swpt-nav-btn pdp-swpt-prev" data-swpt-action="prev" aria-label="Previous">
          <img src="{{ swpt_icon_prev }}" alt="" width="16" height="16">
        </button>
        <button type="button" class="pdp-swpt-nav-btn pdp-swpt-next" data-swpt-action="next" aria-label="Next">
          <img src="{{ swpt_icon_next }}" alt="" width="16" height="16">
        </button>
      </div>
    </div>

    <div class="pdp-swpt-pc-list">
      <div class="pdp-swpt-track" data-swpt-track="pc">
        {%- assign swpt_idx = 0 -%}
        {%- for i in (1..6) -%}
          {%- liquid
            assign swpt_video_key = 'video_' | append: i
            assign swpt_poster_key = 'video_' | append: i | append: '_poster'
            assign swpt_text_key = 'video_' | append: i | append: '_text'
            assign swpt_video_obj = block.settings[swpt_video_key]
            assign swpt_poster = block.settings[swpt_poster_key]
            assign swpt_label = block.settings[swpt_text_key]
            assign swpt_video_src = ''
            if swpt_video_obj != blank
              for source in swpt_video_obj.sources
                if source.mime_type == 'video/mp4'
                  assign swpt_video_src = source.url
                  break
                endif
              endfor
              if swpt_video_src == blank and swpt_video_obj.sources.size > 0
                assign swpt_video_src = swpt_video_obj.sources.first.url
              endif
            endif
            assign swpt_poster_url = ''
            if swpt_poster != blank
              assign swpt_poster_url = swpt_poster | image_url: width: 800
            elsif swpt_video_obj.preview_image != blank
              assign swpt_poster_url = swpt_video_obj.preview_image | image_url: width: 800
            endif
          -%}
          {%- if swpt_video_src != blank -%}
            <div class="pdp-swpt-card" data-swpt-card data-platform="pc" data-index="{{ swpt_idx }}">
              <video
                data-swpt-video
                data-src="{{ swpt_video_src | escape }}"
                {% if swpt_poster_url != blank %}
                  poster="{{ swpt_poster_url }}"
                {% endif %}
                loop
                preload="none"
                muted
                playsinline
                webkit-playsinline
                x5-playsinline
              ></video>
              <button type="button" class="pdp-swpt-mute-btn" data-swpt-mute aria-label="Toggle mute">
                <img src="{{ swpt_icon_mute }}" alt="" width="14" height="14" data-swpt-mute-icon>
              </button>
              <div class="pdp-swpt-play-btn" data-swpt-play-overlay>
                <img src="{{ swpt_icon_play }}" alt="" width="14" height="14">
              </div>
              {%- if swpt_label != blank -%}
                <div class="pdp-swpt-caption">
                  <p class="pdp-swpt-caption-text">{{ swpt_label | escape }}</p>
                </div>
              {%- endif -%}
            </div>
            {%- assign swpt_idx = swpt_idx | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="pdp-swpt-h5-carousel">
      <div class="pdp-swpt-track" data-swpt-track="h5">
        {%- assign swpt_idx = 0 -%}
        {%- for i in (1..6) -%}
          {%- liquid
            assign swpt_video_key = 'video_' | append: i
            assign swpt_poster_key = 'video_' | append: i | append: '_poster'
            assign swpt_text_key = 'video_' | append: i | append: '_text'
            assign swpt_video_obj = block.settings[swpt_video_key]
            assign swpt_poster = block.settings[swpt_poster_key]
            assign swpt_label = block.settings[swpt_text_key]
            assign swpt_video_src = ''
            if swpt_video_obj != blank
              for source in swpt_video_obj.sources
                if source.mime_type == 'video/mp4'
                  assign swpt_video_src = source.url
                  break
                endif
              endfor
              if swpt_video_src == blank and swpt_video_obj.sources.size > 0
                assign swpt_video_src = swpt_video_obj.sources.first.url
              endif
            endif
            assign swpt_poster_url = ''
            if swpt_poster != blank
              assign swpt_poster_url = swpt_poster | image_url: width: 800
            elsif swpt_video_obj.preview_image != blank
              assign swpt_poster_url = swpt_video_obj.preview_image | image_url: width: 800
            endif
          -%}
          {%- if swpt_video_src != blank -%}
            <div class="pdp-swpt-card" data-swpt-card data-platform="h5" data-index="{{ swpt_idx }}">
              <video
                data-swpt-video
                data-src="{{ swpt_video_src | escape }}"
                {% if swpt_poster_url != blank %}
                  poster="{{ swpt_poster_url }}"
                {% endif %}
                loop
                preload="none"
                muted
                playsinline
                webkit-playsinline
                x5-playsinline
              ></video>
              <button type="button" class="pdp-swpt-mute-btn" data-swpt-mute aria-label="Toggle mute">
                <img src="{{ swpt_icon_mute }}" alt="" width="14" height="14" data-swpt-mute-icon>
              </button>
              <div class="pdp-swpt-play-btn" data-swpt-play-overlay>
                <img src="{{ swpt_icon_play }}" alt="" width="14" height="14">
              </div>
              {%- if swpt_label != blank -%}
                <div class="pdp-swpt-caption">
                  <p class="pdp-swpt-caption-text">{{ swpt_label | escape }}</p>
                </div>
              {%- endif -%}
            </div>
            {%- assign swpt_idx = swpt_idx | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script>
    (function () {
      var root = document.getElementById('pdp-swpt-{{ swpt_bid }}');
      if (!root) return;

      var TOTAL = parseInt(root.getAttribute('data-swpt-total'), 10) || 0;
      if (TOTAL < 1) return;

      var ICON_MUTE = {{ swpt_icon_mute | json }};
      var ICON_VOLUME = {{ swpt_icon_volume | json }};
      var CARD_W = 160;
      var CARD_GAP = 12;
      var MOBILE_BP = 999;

      var pcCurrent = 0;
      var pcMuted = true;
      var h5Current = 0;
      var h5Muted = true;
      var h5Playing = -1;
      var h5Swiped = false;

      var prevBtn = root.querySelector('[data-swpt-action="prev"]');
      var nextBtn = root.querySelector('[data-swpt-action="next"]');
      var pcTrack = root.querySelector('[data-swpt-track="pc"]');
      var h5Track = root.querySelector('[data-swpt-track="h5"]');

      function isMobile() {
        return window.innerWidth <= MOBILE_BP;
      }

      function getCards(platform) {
        return root.querySelectorAll('[data-swpt-card][data-platform="' + platform + '"]');
      }

      function updateNav(idx) {
        if (!prevBtn || !nextBtn) return;
        prevBtn.classList.toggle('is-active', idx > 0);
        nextBtn.classList.toggle('is-active', idx < TOTAL - 1);
        prevBtn.style.opacity = idx === 0 ? '0.4' : '1';
        nextBtn.style.opacity = idx === TOTAL - 1 ? '0.4' : '1';
      }

      function scrollTrack(track, idx, mobilePad) {
        if (!track) return;
        var viewport = track.parentElement;
        var totalWidth = TOTAL * CARD_W + (TOTAL - 1) * CARD_GAP;
        var pad = mobilePad ? 16 : 0;
        var maxOffset = Math.max(0, totalWidth - (viewport.clientWidth - pad));
        var offset = Math.min((CARD_W + CARD_GAP) * idx, maxOffset);
        track.style.transform = 'translateX(' + -offset + 'px)';
      }

      function pcScrollTo(idx) {
        pcCurrent = idx;
        scrollTrack(pcTrack, idx, false);
        updateNav(idx);
      }

      function h5ScrollTo(idx) {
        h5Current = idx;
        scrollTrack(h5Track, idx, true);
        updateNav(idx);
      }

      function setPlayingUI(card, playing) {
        var playOverlay = card.querySelector('[data-swpt-play-overlay]');
        var muteBtn = card.querySelector('[data-swpt-mute]');
        if (playOverlay) playOverlay.style.display = playing ? 'none' : 'flex';
        if (muteBtn) muteBtn.style.display = playing ? 'flex' : 'none';
      }

      function pauseAll(platform, exceptIdx) {
        getCards(platform).forEach(function (card) {
          var idx = parseInt(card.getAttribute('data-index'), 10);
          if (idx === exceptIdx) return;
          var video = card.querySelector('[data-swpt-video]');
          if (video) video.pause();
          setPlayingUI(card, false);
        });
      }

      function togglePlay(platform, idx) {
        if (platform === 'h5' && h5Swiped) return;

        var card = root.querySelector('[data-swpt-card][data-platform="' + platform + '"][data-index="' + idx + '"]');
        if (!card) return;

        var video = card.querySelector('[data-swpt-video]');
        if (!video) return;

        if (video.paused) {
          pauseAll(platform, idx);

          if (!video.getAttribute('src')) {
            video.src = video.dataset.src;
          }

          var muted = platform === 'pc' ? pcMuted : h5Muted;
          video.muted = muted;

          if (platform === 'h5') {
            h5Playing = idx;
          }

          video
            .play()
            .then(function () {
              if (platform === 'h5' && h5Playing !== idx) return;
              setPlayingUI(card, true);
              var muteIcon = card.querySelector('[data-swpt-mute-icon]');
              if (muteIcon) muteIcon.src = muted ? ICON_MUTE : ICON_VOLUME;
              if (platform === 'pc') {
                pcCurrent = idx;
                pcScrollTo(idx);
              } else {
                h5Playing = idx;
              }
            })
            .catch(function () {
              setPlayingUI(card, false);
              if (platform === 'h5') h5Playing = -1;
            });
        } else {
          video.pause();
          setPlayingUI(card, false);
          if (platform === 'h5') h5Playing = -1;
        }
      }

      function toggleMute(platform) {
        if (platform === 'pc') {
          pcMuted = !pcMuted;
          var card = root.querySelector('[data-swpt-card][data-platform="pc"][data-index="' + pcCurrent + '"]');
          if (!card) return;
          var video = card.querySelector('[data-swpt-video]');
          if (!video || video.paused) return;
          video.muted = pcMuted;
          var muteIcon = card.querySelector('[data-swpt-mute-icon]');
          if (muteIcon) muteIcon.src = pcMuted ? ICON_MUTE : ICON_VOLUME;
        } else {
          h5Muted = !h5Muted;
          if (h5Playing < 0) return;
          var h5Card = root.querySelector('[data-swpt-card][data-platform="h5"][data-index="' + h5Playing + '"]');
          if (!h5Card) return;
          var h5Video = h5Card.querySelector('[data-swpt-video]');
          if (!h5Video) return;
          h5Video.muted = h5Muted;
          var h5MuteIcon = h5Card.querySelector('[data-swpt-mute-icon]');
          if (h5MuteIcon) h5MuteIcon.src = h5Muted ? ICON_MUTE : ICON_VOLUME;
        }
      }

      root.addEventListener('click', function (e) {
        var navBtn = e.target.closest('[data-swpt-action]');
        if (navBtn) {
          var action = navBtn.getAttribute('data-swpt-action');
          if (isMobile()) {
            if (action === 'prev' && h5Current > 0) h5ScrollTo(h5Current - 1);
            if (action === 'next' && h5Current < TOTAL - 1) h5ScrollTo(h5Current + 1);
          } else {
            if (action === 'prev' && pcCurrent > 0) pcScrollTo(pcCurrent - 1);
            if (action === 'next' && pcCurrent < TOTAL - 1) pcScrollTo(pcCurrent + 1);
          }
          return;
        }

        if (e.target.closest('[data-swpt-mute]')) {
          e.stopPropagation();
          var muteCard = e.target.closest('[data-swpt-card]');
          if (muteCard) toggleMute(muteCard.getAttribute('data-platform'));
          return;
        }

        var card = e.target.closest('[data-swpt-card]');
        if (card) {
          var platform = card.getAttribute('data-platform');
          var idx = parseInt(card.getAttribute('data-index'), 10);
          togglePlay(platform, idx);
        }
      });

      if (h5Track) {
        var startX = 0;
        h5Track.addEventListener('touchstart', function (e) {
          startX = e.touches[0].clientX;
        });
        h5Track.addEventListener('touchend', function (e) {
          var diff = startX - e.changedTouches[0].clientX;
          if (Math.abs(diff) > 40) {
            h5Swiped = true;
            setTimeout(function () {
              h5Swiped = false;
            }, 400);
            if (diff > 0 && h5Current < TOTAL - 1) h5ScrollTo(h5Current + 1);
            else if (diff < 0 && h5Current > 0) h5ScrollTo(h5Current - 1);
          }
        });
      }

      updateNav(0);
      if (TOTAL > 1) nextBtn && nextBtn.classList.add('is-active');
    })();
  </script>
{%- endif -%}
