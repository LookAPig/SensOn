{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
BLOG POST CARD COMPONENT
----------------------------------------------------------------------------------------------------------------------
Renders a single blog post

********************************************
Supported parameters
********************************************
* article: the article to render. If no article is passed then a placeholder is generated
* reveal: if set to true the card is revealed on scroll
* horizontal: if set to true, the card is rendered horizontally on desktop
* heading_size: the size of the heading to use (default to h5 size)
* show_category: if set to true, the first tag of the article is shown as a category
* show_date: if set to true, the date of the article is shown
* show_reading_time: if set to true, the reading time of the article is shown
* show_excerpt: if set to true, it will show the excerpt first or truncated part of the main content if none is set
* use_secondary_image: if set to true, the theme will be an image specified in the metafield "custom.secondary_image"
* sizes: the sizes attribute to show for loading the images
* position: the position of the card in the list. If specified, the theme will eagerly load the first 3 cards images
* placeholder_image: the name of an image used for the placeholder_svg_tag
* block: an optional block from which theme editor attributes are rendered
* podcast_mode: podcast card layout with custom audio image/title and bottom blog introduction
{%- endcomment -%}

{%- liquid
  assign podcast_mode_enabled = podcast_mode | default: false

  if template.suffix == 'podcast'
    assign podcast_mode_enabled = true
  endif

  assign audio_image = article.metafields.custom.audio_image.value
  assign audio_title = article.metafields.custom.audio_title.value | strip
  assign blog_introduction = article.metafields.custom.blog_introduction | metafield_text | strip

  assign has_blog_introduction = false

  if podcast_mode_enabled and article and blog_introduction != blank
    assign has_blog_introduction = true
  endif

  assign podcast_card_classes = 'blog-post-card'

  if horizontal
    assign podcast_card_classes = podcast_card_classes | append: ' blog-post-card--horizontal'
  endif

  if podcast_mode_enabled
    assign podcast_card_classes = podcast_card_classes | append: ' blog-post-card--podcast'
  endif

  if has_blog_introduction
    assign podcast_card_classes = podcast_card_classes | append: ' blog-post-card--podcast-with-intro'
  endif

  assign podcast_card_classes = podcast_card_classes | append: ' group snap-start'
-%}

{%- capture blog_post_card_meta -%}
  {%- if show_category and article.tags.size > 0 and podcast_mode_enabled == false -%}
    <span>{{ article.tags | first }}</span>
  {%- endif -%}

  {%- if show_date and article != blank -%}
    <span>{{ article.published_at | date: format: 'abbreviated_date' }}</span>
  {%- endif -%}

  {%- if show_reading_time -%}
    {%- assign reading_time = article.content | strip_html | split: ' ' | size | times: 1.0 | divided_by: 250 | ceil -%}
    <span>{{ 'blog.post.reading_time' | t: time: reading_time }}</span>
  {%- endif -%}
{%- endcapture -%}

{%- capture blog_post_card_image -%}
  {%- if article -%}
    {%- liquid
      assign loading_strategy = nil
      assign image = nil

      if section.index > 3 or position > 3
        assign loading_strategy = 'lazy'
      endif

      if podcast_mode_enabled
        assign image = audio_image
      else
        if use_secondary_image
          assign image = article.metafields.custom.secondary_image
        endif

        assign image = image | default: article.image
      endif
    -%}

    {%- if image != blank -%}
      {%- liquid
        assign image_width = image.width | default: 1400
      -%}

      <div class="blog-post-card__image-container overflow-hidden">
        {{- image | image_url: width: image_width | image_tag: loading: loading_strategy, sizes: sizes, widths: '300,400,500,600,800,1000,1200,1400', class: 'w-full zoom-image group-hover:zoom', alt: article.title -}}
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="blog-post-card__image-container overflow-hidden">
      {{- placeholder_image | placeholder_svg_tag: 'w-full zoom-image group-hover:zoom' -}}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture blog_post_card_content -%}
  <div class="blog-post-card__content">
    <div class="prose prose--compact">
      {%- if blog_post_card_meta != blank -%}
        <div class="meta-information subheading">
          {%- if settings.subheading_icon != blank -%}
            <span class="shape shape--{{ settings.subheading_icon }}"></span>
          {%- endif -%}

          {{- blog_post_card_meta -}}
        </div>
      {%- endif -%}

      {%- if podcast_mode_enabled and audio_title != blank -%}
        <p class="blog-post-card__audio-title subheading">{{ audio_title }}</p>
      {%- endif -%}

      {%- if article -%}
        <span class="{{ heading_size | default: 'h5' }} blog-post-card__title">{{ article.title }}</span>
      {%- else -%}
        <span class="{{ heading_size | default: 'h5' }} blog-post-card__title">{{- 'general.on_boarding.blog_post_title' | t -}}</span>
      {%- endif -%}

      {%- if show_excerpt and has_blog_introduction == false -%}
        {%- if article -%}
          {%- unless article.excerpt_or_content == blank -%}
            <p>{{ article.excerpt_or_content | strip_html | truncate: 200 }}</p>
          {%- endunless -%}
        {%- else -%}
          <p>{{ 'general.on_boarding.blog_post_excerpt' | t }}</p>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
{%- endcapture -%}

{%- if podcast_mode_enabled and has_blog_introduction -%}
  <div class="{{ podcast_card_classes }}" {% if settings.stagger_blog_posts and reveal != false %}reveal-on-scroll="true"{% endif %} {{ block.shopify_attributes }}>
    <a href="{{ article.url }}" class="blog-post-card__primary-link">
      {{- blog_post_card_image -}}
      {{- blog_post_card_content -}}
    </a>

    <a href="{{ article.url }}" class="blog-post-card__introduction prose prose--compact">
      {{ article.metafields.custom.blog_introduction | metafield_tag }}
    </a>
  </div>
{%- else -%}
  <a href="{{ article.url }}" class="{{ podcast_card_classes }}" {% if settings.stagger_blog_posts and reveal != false %}reveal-on-scroll="true"{% endif %} {{ block.shopify_attributes }}>
    {{- blog_post_card_image -}}
    {{- blog_post_card_content -}}
  </a>
{%- endif -%}
