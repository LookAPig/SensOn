{%- liquid
  assign pfc_bg = block.settings.background_color | default: '#ffffff'
  assign pfc_radius = block.settings.border_radius | default: 16
  assign pfc_has_card = false

  for i in (1..4)
    assign pfc_text_key = 'text_' | append: i
    assign pfc_bg_image_key = 'background_image_' | append: i

    if block.settings[pfc_text_key] != blank or block.settings[pfc_bg_image_key] != blank
      assign pfc_has_card = true
      break
    endif
  endfor
-%}

{%- if pfc_has_card -%}
  <style>
    #pfc-{{ block.id }} {
      --pfc-bg: {{ pfc_bg }};
      --pfc-radius: {{ pfc_radius }}px;
      {% if block.settings.mt != blank %}
        margin-top: {{ block.settings.mt | times: 0.25 }}rem;
      {% endif %}
      {% if block.settings.mb != blank %}
        margin-bottom: {{ block.settings.mb | times: 0.25 }}rem;
      {% endif %}
    }

    .pfc-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      width: 100%;
    }

    .pfc-card {
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      background-color: var(--pfc-bg);
      border-radius: var(--pfc-radius);
      padding: 8px 8px;
      min-height: 48px;
      box-sizing: border-box;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    .pfc-card__text {
      margin: 0;
      font-size: 12px;
      font-weight: 500;
      line-height: 1;
      color: #111;
      word-break: break-word;
      white-space: pre-line;
    }

    {%- for i in (1..4) -%}
      {%- assign pfc_bg_image_key = 'background_image_' | append: i -%}
      {%- assign pfc_bg_image = block.settings[pfc_bg_image_key] -%}
      {%- if pfc_bg_image != blank -%}
        #pfc-{{ block.id }} .pfc-card--{{ i }} {
          background-image: url('{{ pfc_bg_image | image_url: width: 800 }}');
        }
      {%- endif -%}
    {%- endfor -%}

    @media (min-width: 768px) {
      .pfc-grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
      }
      .pfc-card {
        padding: 10px 6px;
      }
      .pfc-card__text {
        font-size: 15px;
        line-height: 1;
      }
    }
  </style>

  <div id="pfc-{{ block.id }}" class="product-feature-cards">
    <div class="pfc-grid">
      {%- for i in (1..4) -%}
        {%- assign pfc_text_key = 'text_' | append: i -%}
        {%- assign pfc_bg_image_key = 'background_image_' | append: i -%}
        {%- assign pfc_text = block.settings[pfc_text_key] -%}
        {%- assign pfc_bg_image = block.settings[pfc_bg_image_key] -%}
        {%- if pfc_text != blank or pfc_bg_image != blank -%}
          <div class="pfc-card pfc-card--{{ i }}">
            {%- if pfc_text != blank -%}
              <div class="pfc-card__text">{{ pfc_text | newline_to_br }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
