{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
SHARE BUTTONS
----------------------------------------------------------------------------------------------------------------------

Generate share buttons for Facebook, X, Email, TikTok and Instagram.
TikTok / Instagram links are read from theme social media settings.

********************************************
Supported variables
********************************************

* url: the URL to share
* title: the title of the resource being shared (can be for instance a product or blog post title)
* description: the description of the content to share for Pinterest. It is truncated automatically to 200 characters
{%- endcomment -%}

{%- assign share_url = request.origin | append: url -%}

<ul class="share-buttons unstyled-list" role="list">
  <li class="share-buttons__item branding-colors--facebook">
    {%- capture facebook_share_url -%}https://www.facebook.com/sharer.php?u={{ share_url }}{%- endcapture -%}
    <a href="{{ facebook_share_url }}" aria-label="{{ 'general.social.share_on' | t: social_media: 'Facebook' }}" target="_blank" rel="noopener">
      {%- render 'icon' with 'facebook' -%}
    </a>
  </li>

  <li class="share-buttons__item branding-colors--twitter">
    {%- capture twitter_share_url -%}https://twitter.com/share?{% if title != blank %}text={{ title | url_param_escape }}&{% endif %}url={{ share_url }}{%- endcapture -%}
    <a href="{{ twitter_share_url }}" aria-label="{{ 'general.social.share_on' | t: social_media: 'X' }}" target="_blank" rel="noopener">
      {%- render 'icon' with 'twitter' -%}
    </a>
  </li>

  <li class="share-buttons__item branding-colors--email">
    {%- capture email_share_url -%}mailto:?&subject={{ title | escape }}&body={{ share_url }}{%- endcapture -%}
    <a href="{{ email_share_url }}" aria-label="{{ 'general.social.share_email' | t }}" target="_blank" rel="noopener">
      {%- render 'icon' with 'email-social' -%}
    </a>
  </li>

  {%- if settings.social_tiktok != blank or shop.brand.metafields.social_links.tiktok != blank -%}
    <li class="share-buttons__item branding-colors--tiktok">
      <a href="{{ settings.social_tiktok | default: shop.brand.metafields.social_links.tiktok }}" aria-label="{{ 'general.social.follow_on' | t: social_media: 'TikTok' }}" target="_blank" rel="noopener">
        {%- render 'icon' with 'tiktok' -%}
      </a>
    </li>
  {%- endif -%}

  {%- if settings.social_instagram != blank or shop.brand.metafields.social_links.instagram != blank -%}
    <li class="share-buttons__item branding-colors--instagram">
      <a href="{{ settings.social_instagram | default: shop.brand.metafields.social_links.instagram }}" aria-label="{{ 'general.social.follow_on' | t: social_media: 'Instagram' }}" target="_blank" rel="noopener">
        {%- render 'icon' with 'instagram' -%}
      </a>
    </li>
  {%- endif -%}
</ul>
