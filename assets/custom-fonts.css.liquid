/* Source Serif 4 is loaded non-blocking from layout/theme.liquid (avoid @import chain on mobile). */

/* ========== Mabry Pro Webfont ========== */
@font-face {
  font-family: "MabryPro";
  /* src: url('{{ "mabry-regular-pro.woff2" | asset_url }}') format("woff2"),
       url('{{ "mabry-regular-pro.woff" | asset_url }}') format("woff"); */
  src: url('{{ "mabry-regular-pro.woff" | asset_url }}') format("woff");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: "MabryPro";
  /* src: url('{{ "mabry-medium-pro.woff2" | asset_url }}') format("woff2"),
       url('{{ "mabry-medium-pro.woff" | asset_url }}') format("woff"); */
  src: url('{{ "mabry-medium-pro.woff" | asset_url }}') format("woff");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: "MabryPro";
  /* src: url('{{ "mabry-black-pro.woff2" | asset_url }}') format("woff2"),
       url('{{ "mabry-black-pro.woff" | asset_url }}') format("woff"); */
  src: url('{{ "mabry-black-pro.woff" | asset_url }}') format("woff");
  font-weight: 900;
  font-style: normal;
  font-display: swap;
}

/* ========== Global apply ========== */
:root {
  --font-body-family: "MabryPro", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
  --font-heading-family: "Source Serif 4", "Source Serif Pro", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
}

html, body { font-family: var(--font-body-family); }

h1, h2, h3, h4, h5, h6,
button, input, textarea, select {
  font-family: var(--font-body-family);
}