<style>
  #shopify-section-{{ section.id }} .how_it_work_control {
    --accent-color: {{ section.settings.accent_color }};
    background: #000000;
    color: #ffffff;
    overflow: hidden;
    padding: {{ section.settings.desktop_padding_top }}px 0 {{ section.settings.desktop_padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .how_it_work_control * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .inner {
    margin: 0 auto;
    max-width: 1440px;
    padding: 0 24px;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .header {
    display: block;
    margin: 0 0 48px;
    max-width: none;
    padding: 0;
    text-align: center;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .eyebrow {
    color: var(--accent-color);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 12px;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .section_title {
    color: #ffffff;
    font-size: 42px;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin: 0 auto;
    /* max-width: 820px; */
  }

  #shopify-section-{{ section.id }} .how_it_work_control .section_description {
    color: #ffffff;
    font-size: 16px;
    line-height: 1.4;
    margin: 16px auto 0;
    /* max-width: 720px; */
  }

  #shopify-section-{{ section.id }} .how_it_work_control .section_description p,
  #shopify-section-{{ section.id }} .how_it_work_control .item_description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .content {
    align-items: flex-start;
    display: grid;
    gap: 48px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  #shopify-section-{{ section.id }} .how_it_work_control .content.layout_text_left .media {
    order: 2;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .content.layout_text_left .accordion {
    order: 1;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .media {
    aspect-ratio: 1.7 / 1;
    background: #1d1d1d;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .media_image,
  #shopify-section-{{ section.id }} .how_it_work_control .media_placeholder {
    height: 100%;
    inset: 0;
    object-fit: cover;
    opacity: 0;
    position: absolute;
    transition: opacity 0.4s ease;
    visibility: hidden;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .media_placeholder {
    background: #404040;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .media_image.is_active,
  #shopify-section-{{ section.id }} .how_it_work_control .media_placeholder.is_active {
    opacity: 1;
    visibility: visible;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .accordion {
    min-width: 0;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .item {
    border-bottom: 1px solid #666666;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .item_button {
    align-items: center;
    background: transparent;
    border: 0;
    color: #ffffff;
    cursor: pointer;
    display: flex;
    font-family: inherit;
    justify-content: space-between;
    min-height: 72px;
    padding: 20px 2px 20px 0;
    text-align: left;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .item_title {
    color: #ffffff;
    display: block;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.15;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .icon {
    border-right: 2px solid var(--accent-color);
    border-top: 2px solid var(--accent-color);
    flex: 0 0 auto;
    height: 11px;
    margin-left: 16px;
    transform: rotate(45deg);
    transition: transform 0.35s ease;
    width: 11px;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .item.is_active .icon {
    transform: rotate(135deg);
  }

  #shopify-section-{{ section.id }} .how_it_work_control .item_panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .item_panel_inner {
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .item.is_active .item_panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .how_it_work_control .item_description {
    font-size: 16px;
    line-height: 1.4;
    padding: 0 0 24px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .how_it_work_control {
      padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .how_it_work_control .inner {
      padding: 0 16px;
    }

    #shopify-section-{{ section.id }} .how_it_work_control .header {
      margin-bottom: 18px;
      max-width: 100%;
      padding: 0;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .how_it_work_control .eyebrow {
      font-size: 16px;
      margin-bottom: 13px;
    }

    #shopify-section-{{ section.id }} .how_it_work_control .section_title {
      font-size: 27px;
      line-height: 1.02;
      margin: 0;
      max-width: 390px;
    }

    #shopify-section-{{ section.id }} .how_it_work_control .section_description {
      font-size: 16px;
      line-height: 1.27;
      margin: 17px 0 0;
      max-width: none;
    }

    #shopify-section-{{ section.id }} .how_it_work_control .content {
      display: block;
      gap: 0;
    }

    #shopify-section-{{ section.id }} .how_it_work_control .content.layout_text_left .media,
    #shopify-section-{{ section.id }} .how_it_work_control .content.layout_text_left .accordion {
      order: initial;
    }

    #shopify-section-{{ section.id }} .how_it_work_control .media {
      aspect-ratio: 1.7 / 1;
      background: #404040;
      margin-bottom: 19px;
    }

    #shopify-section-{{ section.id }} .how_it_work_control .item_button {
      min-height: 54px;
      padding: 12px 2px 12px 0;
    }

    #shopify-section-{{ section.id }} .how_it_work_control .item_title {
      font-size: 20px;
    }

    #shopify-section-{{ section.id }} .how_it_work_control .item_description {
      font-size: 15px;
      line-height: 1.28;
      padding: 0 0 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .how_it_work_control .media_image,
    #shopify-section-{{ section.id }} .how_it_work_control .media_placeholder,
    #shopify-section-{{ section.id }} .how_it_work_control .icon,
    #shopify-section-{{ section.id }} .how_it_work_control .item_panel {
      transition: none;
    }
  }
</style>

<section class="how_it_work_control" id="how-it-work-control-{{ section.id }}">
  <div class="inner">
    <div class="header">
      {%- if section.settings.subtitle != blank -%}
        <p class="eyebrow">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="section_title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="section_description">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="content {% if section.settings.desktop_layout == 'text_left' %}layout_text_left{% else %}layout_image_left{% endif %}">
        <div class="media">
          {%- for block in section.blocks -%}
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  class: 'media_image',
                  loading: 'lazy',
                  sizes: '(min-width: 750px) 50vw, calc(100vw - 32px)',
                  widths: '375, 550, 750, 1000, 1200, 1600',
                  alt: block.settings.title
              }}
            {%- else -%}
              <div class="media_placeholder"></div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="accordion">
          {%- for block in section.blocks -%}
            <article
              class="item{% if forloop.first %} is_active{% endif %}"
              data-control-item="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <button
                class="item_button"
                type="button"
                data-control-trigger="{{ forloop.index0 }}"
                aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="control-panel-{{ section.id }}-{{ forloop.index0 }}"
              >
                <span class="item_title">{{ block.settings.title | escape }}</span>
                <span class="icon" aria-hidden="true"></span>
              </button>

              <div
                class="item_panel"
                id="control-panel-{{ section.id }}-{{ forloop.index0 }}"
              >
                <div class="item_panel_inner">
                  {%- if block.settings.description != blank -%}
                    <div class="item_description">{{ block.settings.description }}</div>
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const section = document.querySelector("#how-it-work-control-{{ section.id }}");

    if (!section) {
      return;
    }

    const setActiveItem = (index) => {
      section.querySelectorAll("[data-control-item]").forEach((item) => {
        item.classList.toggle("is_active", item.dataset.controlItem === index);
      });

      section.querySelectorAll("[data-control-trigger]").forEach((trigger) => {
        trigger.setAttribute("aria-expanded", trigger.dataset.controlTrigger === index ? "true" : "false");
      });

      section.querySelectorAll(".media > *").forEach((image, imageIndex) => {
        image.classList.toggle("is_active", String(imageIndex) === index);
      });
    };

    section.querySelectorAll("[data-control-trigger]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        setActiveItem(trigger.dataset.controlTrigger);
      });
    });

    setActiveItem("0");

    if (window.Shopify && window.Shopify.designMode) {
      document.addEventListener("shopify:block:select", (event) => {
        const selectedBlock = event.target.closest("[data-control-item]");

        if (selectedBlock && section.contains(selectedBlock)) {
          setActiveItem(selectedBlock.dataset.controlItem);
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "How it works control",
  "tag": "section",
  "class": "shopify-section--how-it-works-control",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
