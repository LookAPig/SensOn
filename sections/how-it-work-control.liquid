      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "移动端底部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "control",
      "name": "控制模式",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "AI Mode"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "展开内容",
          "default": "<p>Select AI Mode in the SensOn App and set minimum and maximum intensity limits. SensOn S1 then responds automatically to interactive audio, AI voice, and character interaction.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "How it works control",
      "category": "Content",
      "blocks": [
        {
          "type": "control"
        },
        {
          "type": "control",
          "settings": {
            "title": "Manual Mode",
            "description": "<p>Control SensOn S1 directly in the app and adjust the experience in real time.</p>"
          }
        },
        {
          "type": "control",
          "settings": {
            "title": "Physical Buttons",
            "description": "<p>Use the on-device buttons for simple, immediate control whenever you prefer.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
