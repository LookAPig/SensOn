{%- liquid
  assign heading_tag = section.settings.heading_tag | default: 'h2'
-%}
<style>
  #shopify-section-{{ section.id }} .pmic {
    --subtitle-color: {{ section.settings.subtitle_color }};
    --heading-color: {{ section.settings.heading_color }};
    --description-color: {{ section.settings.description_color }};
    --card-bg: {{ section.settings.card_bg }};
    --category-color: {{ section.settings.category_color }};
    --card-title-color: {{ section.settings.card_title_color }};
    --card-desc-color: {{ section.settings.card_desc_color }};
    --link-color: {{ section.settings.link_color }};
    background: {{ section.settings.background_color }};
    overflow: hidden;
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .pmic * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .pmic .inner { margin: 0 auto; max-width: 1200px; }
  #shopify-section-{{ section.id }} .pmic .header { margin: 0 0 24px; text-align: left; }
  #shopify-section-{{ section.id }} .pmic .subtitle {
    color: var(--subtitle-color); font-size: {{ section.settings.subtitle_font_size_mobile }}px;
    font-weight: 500; line-height: 1.3; margin: 0 0 8px;
  }
  #shopify-section-{{ section.id }} .pmic .title {
    color: var(--heading-color); font-size: {{ section.settings.heading_font_size_mobile }}px;
    font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; margin: 0;
  }
  #shopify-section-{{ section.id }} .pmic .intro {
    color: var(--description-color); font-size: {{ section.settings.description_font_size_mobile }}px;
    line-height: 1.45; margin: 10px 0 0; max-width: 520px;
  }
  #shopify-section-{{ section.id }} .pmic .intro p { margin: 0; }
  #shopify-section-{{ section.id }} .pmic .track {
    display: flex; gap: 12px; margin-right: -16px; overflow-x: auto; overscroll-behavior-x: contain;
    padding-right: 16px; scroll-padding-left: 0; scroll-snap-type: x mandatory;
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  #shopify-section-{{ section.id }} .pmic .track::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .pmic .card {
    background: var(--card-bg); border-radius: 16px; display: flex; flex: 0 0 calc(100% - 28px);
    flex-direction: column; min-height: 240px; padding: 28px 20px 24px; scroll-snap-align: start; text-align: center;
  }
  #shopify-section-{{ section.id }} .pmic .category {
    color: var(--category-color); font-size: 16px; font-weight: 400; line-height: 1.3; margin: 0 0 12px;
  }
  #shopify-section-{{ section.id }} .pmic .outlet {
    color: var(--card-title-color); font-size: 32px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.15; margin: 0;
  }
  #shopify-section-{{ section.id }} .pmic .body {
    color: var(--card-desc-color); font-size: 16px; line-height: 1.45; margin: 12px 0 0;
  }
  #shopify-section-{{ section.id }} .pmic .body p { margin: 0; }
  #shopify-section-{{ section.id }} .pmic .more {
    color: var(--link-color); display: inline-block; font-size: 14px; font-weight: 500; margin-top: auto;
    padding-top: 20px; text-decoration: underline; text-underline-offset: 3px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .pmic {
      padding: {{ section.settings.padding_top_desktop }}px {{ section.settings.padding_x_desktop }}px {{ section.settings.padding_bottom_desktop }}px;
    }
    #shopify-section-{{ section.id }} .pmic .header { margin-bottom: 40px; text-align: center; }
    #shopify-section-{{ section.id }} .pmic .subtitle { font-size: {{ section.settings.subtitle_font_size }}px; margin-bottom: 12px; }
    #shopify-section-{{ section.id }} .pmic .title { font-size: {{ section.settings.heading_font_size }}px; }
    #shopify-section-{{ section.id }} .pmic .intro {
      font-size: {{ section.settings.description_font_size }}px; margin: 16px auto 0; max-width: 640px;
    }
    #shopify-section-{{ section.id }} .pmic .track {
      display: grid; gap: 16px; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; overflow: visible;
      padding: 0; scroll-snap-type: none;
    }
    #shopify-section-{{ section.id }} .pmic .card { flex: none; min-height: 280px; padding: 36px 28px 28px; width: auto; }
    #shopify-section-{{ section.id }} .pmic .outlet { font-size: 24px; }
    #shopify-section-{{ section.id }} .pmic .body { font-size: 16px; }
  }
</style>

<div class="pmic">
  <div class="inner">
    <div class="header">
      {%- if section.settings.subtitle != blank -%}
        <p class="subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="title">{{ section.settings.heading | escape }}</{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="intro">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="track">
        {%- for block in section.blocks -%}
          <article class="card" {{ block.shopify_attributes }}>
            {%- if block.settings.category != blank -%}
              <p class="category">{{ block.settings.category | escape }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="outlet">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <div class="body">{{ block.settings.description }}</div>
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <a class="more" href="{{ block.settings.link_url }}">{{ block.settings.link_label | escape }}</a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Press media info cards",
  "tag": "section",
  "class": "shopify-section--press-media-info-cards",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "subtitle", "label": "副标题", "default": "Company News" },
    { "type": "range", "id": "subtitle_font_size", "label": "副标题字号（电脑）", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "subtitle_font_size_mobile", "label": "副标题字号（移动）", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "color", "id": "subtitle_color", "label": "副标题颜色", "default": "#F287EC" },
    { "type": "text", "id": "heading", "label": "大标题", "default": "SensOn S1 Launch Coverage." },
    { "type": "range", "id": "heading_font_size", "label": "大标题字号（电脑）", "min": 18, "max": 56, "step": 1, "unit": "px", "default": 42 },
    { "type": "range", "id": "heading_font_size_mobile", "label": "大标题字号（移动）", "min": 16, "max": 36, "step": 1, "unit": "px", "default": 24 },
    { "type": "color", "id": "heading_color", "label": "大标题颜色", "default": "#FFFFFF" },
    { "type": "select", "id": "heading_tag", "label": "标题标签", "options": [
      { "value": "h1", "label": "H1" },
      { "value": "h2", "label": "H2" },
      { "value": "h3", "label": "H3" }
    ], "default": "h2" },
    { "type": "richtext", "id": "description", "label": "描述", "default": "<p>Three perspectives on the launch—spanning regional news, the technology community and business innovation.</p>" },
    { "type": "range", "id": "description_font_size", "label": "描述字号（电脑）", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "description_font_size_mobile", "label": "描述字号（移动）", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 13 },
    { "type": "color", "id": "description_color", "label": "描述颜色", "default": "#FFFFFF" },
    { "type": "color", "id": "background_color", "label": "背景色", "default": "#000000" },
    { "type": "color", "id": "card_bg", "label": "卡片背景", "default": "#1C1C1C" },
    { "type": "color", "id": "category_color", "label": "卡片分类颜色", "default": "#B3B3B3" },
    { "type": "color", "id": "card_title_color", "label": "卡片标题颜色", "default": "#FFFFFF" },
    { "type": "color", "id": "card_desc_color", "label": "卡片描述颜色", "default": "#C8C8C8" },
    { "type": "color", "id": "link_color", "label": "链接颜色", "default": "#F287EC" },
    { "type": "range", "id": "padding_top", "label": "上边距（移动）", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "下边距（移动）", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_top_desktop", "label": "上边距（电脑）", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "下边距（电脑）", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_x_desktop", "label": "左右边距（电脑）", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "资讯卡片",
      "settings": [
        { "type": "text", "id": "category", "label": "分类", "default": "Regional News" },
        { "type": "text", "id": "title", "label": "媒体名称", "default": "KWWL" },
        { "type": "richtext", "id": "description", "label": "描述", "default": "<p>SensOn S1 brings AI-powered interactive storytelling and adaptive stimulation to regional news audiences.</p>" },
        { "type": "text", "id": "link_label", "label": "链接文案", "default": "Know More >" },
        { "type": "url", "id": "link_url", "label": "链接" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press media info cards",
      "category": "Media",
      "blocks": [
        { "type": "card", "settings": { "category": "Regional News", "title": "KWWL", "description": "<p>SensOn S1 brings AI-powered interactive storytelling and adaptive stimulation to regional news audiences.</p>", "link_label": "Know More >" } },
        { "type": "card", "settings": { "category": "Technology Community", "title": "HackMD", "description": "<p>A technology-focused overview of how SensOn connects voice interaction, personalized erotica and responsive hardware.</p>", "link_label": "Know More >" } },
        { "type": "card", "settings": { "category": "Business & Innovation", "title": "Bitglobalnews", "description": "<p>market with an integrated hardware-and-content experience.</p>", "link_label": "Know More >" } }
      ]
    }
  ]
}
{% endschema %}
