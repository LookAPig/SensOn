{%- liquid
  assign article_video = article.metafields.custom.video.value
  assign external_video = article.metafields.custom.external_video_url.value
  assign episode_label = article.metafields.custom.episode_label.value
  assign video_poster = article.metafields.custom.secondary_image | default: article.image
  assign audio_embed = article.metafields.custom.notes.value | default: article.excerpt | strip

  assign has_video = false
  if article_video != blank or external_video != blank
    assign has_video = true
  endif

  assign has_audio_embed = false
  if audio_embed != blank
    assign has_audio_embed = true
  endif

  assign reading_time = article.content | strip_html | split: ' ' | size | times: 1.0 | divided_by: 250 | ceil
  assign video_id = 'podcast-video-' | append: section.id
-%}

<style>
  #shopify-section-{{ section.id }} {
    --article-podcast-image-ratio: {{ section.settings.image_column_width }}%;
    --article-podcast-nav-gap: 1rem;
    --article-podcast-content-gap: 2.5rem;
    --article-podcast-nav-icon-size: 2.25rem;
    --article-podcast-play-button-size: 4.5rem;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_layout {
    display: grid;
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: var(--container-gutter);
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_player {
    width: 100%;
    max-width: 28rem;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_player iframe {
    width: 100%;
    min-height: 10rem;
    border: 0;
    border-radius: 0.75rem;
    display: block;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_player__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 10rem;
    padding: 2rem;
    border: 1px dashed rgb(var(--text-color) / 0.25);
    border-radius: 0.75rem;
    color: rgb(var(--text-color) / 0.55);
    font-size: var(--text-sm);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_content {
    display: flex;
    flex-direction: column;
    gap: var(--article-podcast-content-gap);
    width: 100%;
    max-width: {{ section.settings.content_max_width }}px;
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--article-podcast-nav-gap);
    width: 100%;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_nav__prev {
    justify-self: start;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_nav__center {
    justify-self: center;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_nav__next {
    justify-self: end;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    color: inherit;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_nav__link:hover {
    opacity: 0.65;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_nav__link.is-disabled {
    opacity: 0.35;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_nav__icon {
    display: inline-grid;
    place-items: center;
    width: var(--article-podcast-nav-icon-size);
    height: var(--article-podcast-nav-icon-size);
    border: 1px solid currentColor;
    border-radius: 50%;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_nav__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    text-decoration: none;
    color: inherit;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_nav__pill:hover {
    background: rgb(var(--text-color));
    color: rgb(var(--background));
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_video {
    width: fit-content;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_video video-media,
  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_video .play-button {
    --play-button-size: var(--article-podcast-play-button-size);
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_video video-media::part(play-button),
  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_video .play-button {
    width: var(--play-button-size);
    height: var(--play-button-size);
    background: transparent;
    border: 1px solid currentColor;
    backdrop-filter: none;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_video video-media {
    display: block;
    width: var(--play-button-size);
    aspect-ratio: 1;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_video video-media[loaded] {
    width: 100%;
    max-width: 32rem;
    aspect-ratio: 16 / 9;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    font-size: var(--text-sm);
    color: rgb(var(--text-color) / 0.7);
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_episode_type {
    margin: 0;
    color: #F287EC;
    letter-spacing: 0.06em;
    text-transform: none;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_title {
    margin: 0;
    font-size: 42px;
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_share {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    width: 100%;
    margin-block-start: 0.5rem;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_share__label {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--text-color) / 0.65);
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_share .share-buttons {
    gap: 1.25rem;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_share .share-buttons a {
    display: inline-flex;
    color: inherit;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_share .share-buttons a:hover {
    opacity: 0.65;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_comments {
    display: grid;
    gap: 1.5rem;
    width: 100%;
    padding-block-start: 1rem;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_comments__heading {
    margin: 0;
    font-size: var(--text-h3);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_comments__note {
    margin: 0;
    font-size: var(--text-sm);
    color: rgb(var(--text-color) / 0.65);
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_comments .fieldset {
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_comments .fieldset-row {
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_comments .button {
    width: 100%;
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_layout {
      grid-template-areas:
        "nav"
        "hero"
        "content";
      grid-template-columns: minmax(0, 1fr);
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_nav {
      grid-area: nav;
      padding: 1.25rem var(--container-gutter) 1rem;
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_hero_col {
      grid-area: hero;
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_hero {
      min-height: auto;
      padding: 1.5rem var(--container-gutter) 0;
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_player {
      max-width: none;
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_content_col {
      grid-area: content;
      padding: 0 var(--container-gutter) 2.5rem;
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_content_col:not(:has(.article_podcast_video)) {
      padding-top: 1.75rem;
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_content {
      gap: 1.75rem;
      max-width: none;
      margin-inline: 0;
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_video {
      position: relative;
      z-index: 2;
      margin-top: calc(var(--article-podcast-play-button-size) * -0.55);
      margin-bottom: 0.25rem;
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_video video-media::part(play-button),
    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_video .play-button {
      background: rgb(var(--background));
      border: 1px solid rgb(var(--text-color));
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_nav__pill {
      padding: 0.5rem 0.875rem;
      font-size: 0.625rem;
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_nav__link {
      font-size: 0.625rem;
      gap: 0.5rem;
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_nav__icon {
      width: 2rem;
      height: 2rem;
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_title {
      font-size: 24px;
    }
  }

  @media screen and (max-width: 399px) {
    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_nav__label {
      display: none;
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_nav__pill .article_podcast_nav__label {
      display: inline;
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_layout {
      grid-template-columns: minmax(0, var(--article-podcast-image-ratio)) minmax(0, calc(100% - var(--article-podcast-image-ratio)));
      grid-template-areas:
        "hero nav"
        "hero content";
      min-height: calc(100dvh - var(--sticky-area-height, 0px));
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_nav {
      grid-area: nav;
      align-self: start;
      padding: clamp(2.5rem, 5vw, 4rem) var(--container-gutter) 0;
      max-width: {{ section.settings.content_max_width }}px;
      width: 100%;
      margin-inline: auto;
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_hero_col {
      grid-area: hero;
      position: sticky;
      top: var(--sticky-area-height, 0px);
      align-self: start;
      min-height: calc(100dvh - var(--sticky-area-height, 0px));
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_hero {
      min-height: inherit;
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_content_col {
      grid-area: content;
      padding: 2rem var(--container-gutter) clamp(2.5rem, 5vw, 4rem);
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_content {
      padding-block: 0;
    }

    #shopify-section-{{ section.id }} .article_podcast_section .article_podcast_video {
      margin-top: 0;
      margin-bottom: 0;
    }
  }
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="article_podcast_section">
    <div class="article_podcast_layout">
      {%- if section.settings.show_navigation -%}
        <nav class="article_podcast_nav" aria-label="{{ section.settings.navigation_aria_label }}">
          <div class="article_podcast_nav__prev">
            {%- if blog.previous_article -%}
              <a href="{{ blog.previous_article.url }}" class="article_podcast_nav__link">
                <span class="article_podcast_nav__icon" aria-hidden="true">
                  {%- render 'icon' with 'arrow-left' -%}
                </span>
                <span class="article_podcast_nav__label">{{ section.settings.prev_label }}</span>
              </a>
            {%- else -%}
              <span class="article_podcast_nav__link is-disabled" aria-disabled="true">
                <span class="article_podcast_nav__icon" aria-hidden="true">
                  {%- render 'icon' with 'arrow-left' -%}
                </span>
                <span class="article_podcast_nav__label">{{ section.settings.prev_label }}</span>
              </span>
            {%- endif -%}
          </div>

          <div class="article_podcast_nav__center">
            <a href="{{ blog.url }}" class="article_podcast_nav__pill">
              <span class="article_podcast_nav__icon" aria-hidden="true">
                {%- render 'icon' with 'arrow-left' -%}
              </span>
              <span class="article_podcast_nav__label">{{ section.settings.all_episodes_label }}</span>
            </a>
          </div>

          <div class="article_podcast_nav__next">
            {%- if blog.next_article -%}
              <a href="{{ blog.next_article.url }}" class="article_podcast_nav__link">
                <span class="article_podcast_nav__label">{{ section.settings.next_label }}</span>
                <span class="article_podcast_nav__icon" aria-hidden="true">
                  {%- render 'icon' with 'arrow-right' -%}
                </span>
              </a>
            {%- else -%}
              <span class="article_podcast_nav__link is-disabled" aria-disabled="true">
                <span class="article_podcast_nav__label">{{ section.settings.next_label }}</span>
                <span class="article_podcast_nav__icon" aria-hidden="true">
                  {%- render 'icon' with 'arrow-right' -%}
                </span>
              </span>
            {%- endif -%}
          </div>
        </nav>
      {%- endif -%}

      <div class="article_podcast_hero_col">
        <div class="article_podcast_hero">
          <div class="article_podcast_player">
            {%- if has_audio_embed -%}
              <iframe
                src="{{ audio_embed }}"
                title="{{ article.title | escape }}"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                loading="lazy"
                height="232"
              ></iframe>
            {%- else -%}
              <div class="article_podcast_player__placeholder">
                {{ section.settings.audio_embed_placeholder }}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="article_podcast_content_col">
        <div class="article_podcast_content">
          {%- if has_video -%}
            <div class="article_podcast_video">
              {%- if article_video != blank -%}
                {%- render 'media' with article_video, id: video_id, preload: section.index <= 3, autoplay: false, controls: true, playsinline: true, show_play_button: true -%}
              {%- elsif external_video != blank -%}
                <video-media id="{{ video_id }}" host="{{ external_video.type }}" show-play-button>
                  {%- if video_poster != blank -%}
                    {{- video_poster | image_url: width: 1200 | image_tag: sizes: '100vw', widths: '400,600,800,1000,1200' -}}
                  {%- else -%}
                    {{- 'hero-apparel-1' | placeholder_svg_tag: 'size-full' -}}
                  {%- endif -%}

                  <template>
                    {%- if external_video.type == 'youtube' -%}
                      <iframe src="https://www.youtube.com/embed/{{ external_video.id }}?playsinline=1&enablejsapi=1&rel=0&modestbranding=1&origin={{ 'https://' | append: request.host | url_encode }}" allow="autoplay; encrypted-media" allowfullscreen="allowfullscreen"></iframe>
                    {%- elsif external_video.type == 'vimeo' -%}
                      <iframe src="https://player.vimeo.com/video/{{ external_video.id }}?autopause=1&transparent=0&responsive=1&portrait=0&title=0&byline=0&color={{ settings.text_color | remove_first: '#' }}" allow="autoplay; encrypted-media;" allowfullscreen="allowfullscreen"></iframe>
                    {%- endif -%}
                  </template>
                </video-media>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="v-stack gap-4 sm:gap-6">
            {%- if section.settings.show_category and episode_label != blank -%}
              <p class="subheading article_podcast_episode_type">{{ episode_label }}</p>
            {%- endif -%}

            <h1 class="{{ section.settings.heading_size }} article_podcast_title">{{ article.title }}</h1>

            {%- if section.settings.show_date or section.settings.show_reading_time -%}
              <div class="article_podcast_meta">
                {%- if section.settings.show_date -%}
                  <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'abbreviated_date' }}</time>
                {%- endif -%}

                {%- if section.settings.show_date and section.settings.show_reading_time -%}
                  <span aria-hidden="true">·</span>
                {%- endif -%}

                {%- if section.settings.show_reading_time -%}
                  <span>{{ 'blog.post.reading_time' | t: time: reading_time }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          <div class="prose">
            {{- article.content -}}
          </div>

          {%- if section.settings.show_social_share -%}
            {%- assign excerpt = article.excerpt | strip_html -%}
            {%- capture podcast_share_buttons -%}
              {%- render 'share-buttons', url: article.url, title: article.title, description: excerpt -%}
            {%- endcapture -%}

            {%- if podcast_share_buttons != blank -%}
              <div class="article_podcast_share">
                <span class="article_podcast_share__label">{{ section.settings.share_label }}</span>
                {{- podcast_share_buttons -}}
              </div>
            {%- endif -%}
          {%- endif -%}

          {%- if section.settings.show_comment_form and article.comments_enabled? -%}
            <div id="comments" class="article_podcast_comments">
              <h2 class="article_podcast_comments__heading">{{ section.settings.comment_heading }}</h2>

              {%- form 'new_comment', article, class: 'form' -%}
                {%- if form.posted_successfully? -%}
                  {%- capture content -%}
                    {%- if blog.moderated? -%}
                      {{- 'blog.comments.comment_sent' | t -}}
                    {%- else -%}
                      {{- 'blog.comments.comment_published' | t -}}
                    {%- endif -%}
                  {%- endcapture -%}
                  {%- render 'banner', status: 'success', content: content -%}

                {%- else -%}
                  {%- if form.errors -%}
                    {%- assign content = form.errors | default_errors -%}
                    {%- render 'banner', status: 'error', content: content -%}
                  {%- endif -%}
                {%- endif -%}

                <div class="fieldset">
                  <div class="fieldset-row">
                    {%- liquid
                      assign label = 'blog.comments.name' | t
                      render 'input', type: 'text', name: 'comment[author]', label: label, value: customer.name, required: true, autocomplete: 'name'

                      assign label = 'blog.comments.email' | t
                      render 'input', type: 'email', name: 'comment[email]', label: label, value: customer.email, required: true, autocomplete: 'email'
                    -%}
                  </div>

                  {%- assign label = 'blog.comments.message' | t -%}
                  {%- render 'input', name: 'comment[body]', label: label, multiline: 9, required: true -%}
                </div>

                {%- if blog.moderated? -%}
                  <p class="article_podcast_comments__note">{{ 'blog.comments.moderated' | t }}</p>
                {%- endif -%}

                <div class="prose">{{- 'shopify.online_store.spam_detection.disclaimer_html' | t -}}</div>

                {%- render 'button', type: 'submit', content: section.settings.comment_submit_label, stretch: true -%}
              {%- endform -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "播客文章",
  "class": "shopify-section--main-article-podcast",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "image_column_width",
      "label": "左侧播放器列宽度",
      "min": 30,
      "max": 55,
      "step": 1,
      "unit": "%",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "右侧内容最大宽度",
      "min": 480,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 680
    },
    {
      "type": "header",
      "content": "文章导航"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "显示文章切换导航",
      "default": true
    },
    {
      "type": "text",
      "id": "navigation_aria_label",
      "label": "导航无障碍标签",
      "default": "文章导航"
    },
    {
      "type": "text",
      "id": "prev_label",
      "label": "上一篇按钮文案",
      "default": "Prev"
    },
    {
      "type": "text",
      "id": "all_episodes_label",
      "label": "全部文章按钮文案",
      "default": "All Episodes"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "下一篇按钮文案",
      "default": "Next"
    },
    {
      "type": "header",
      "content": "文章信息"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:global.text.size",
      "options": [
        {
          "value": "display-l",
          "label": "Display L"
        },
        {
          "value": "display-m",
