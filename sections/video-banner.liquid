{% liquid
  assign desktop_hq_url = ''
  assign desktop_lq_url = ''
  assign mobile_hq_url = ''
  assign mobile_lq_url = ''

  if section.settings.desktop_video != blank
    for source in section.settings.desktop_video.sources
      if source.mime_type == 'video/mp4'
        assign desktop_hq_url = source.url
        break
      endif
    endfor
    if desktop_hq_url == '' and section.settings.desktop_video.sources.size > 0
      assign desktop_hq_url = section.settings.desktop_video.sources.first.url
    endif
  endif

  if section.settings.desktop_video_low != blank
    for source in section.settings.desktop_video_low.sources
      if source.mime_type == 'video/mp4'
        assign desktop_lq_url = source.url
        break
      endif
    endfor
    if desktop_lq_url == '' and section.settings.desktop_video_low.sources.size > 0
      assign desktop_lq_url = section.settings.desktop_video_low.sources.first.url
    endif
  endif

  if section.settings.mobile_video != blank
    for source in section.settings.mobile_video.sources
      if source.mime_type == 'video/mp4'
        assign mobile_hq_url = source.url
        break
      endif
    endfor
    if mobile_hq_url == '' and section.settings.mobile_video.sources.size > 0
      assign mobile_hq_url = section.settings.mobile_video.sources.first.url
    endif
  endif

  if section.settings.mobile_video_low != blank
    for source in section.settings.mobile_video_low.sources
      if source.mime_type == 'video/mp4'
        assign mobile_lq_url = source.url
        break
      endif
    endfor
    if mobile_lq_url == '' and section.settings.mobile_video_low.sources.size > 0
      assign mobile_lq_url = section.settings.mobile_video_low.sources.first.url
    endif
  endif

  assign poster_desktop = section.settings.poster
  assign poster_mobile = section.settings.mobile_poster
  if poster_mobile == blank
    assign poster_mobile = poster_desktop
  endif
%}

{% if poster_desktop != blank %}
  <link rel="preload" as="image" href="{{ poster_desktop | image_url: width: 1920 }}"
    imagesrcset="{{ poster_desktop | image_url: width: 800 }} 800w, {{ poster_desktop | image_url: width: 1200 }} 1200w, {{ poster_desktop | image_url: width: 1600 }} 1600w, {{ poster_desktop | image_url: width: 1920 }} 1920w"
    imagesizes="100vw" media="(min-width: 769px)" fetchpriority="high">
{% endif %}
{% if poster_mobile != blank %}
  <link rel="preload" as="image" href="{{ poster_mobile | image_url: width: 768 }}"
    imagesrcset="{{ poster_mobile | image_url: width: 400 }} 400w, {{ poster_mobile | image_url: width: 600 }} 600w, {{ poster_mobile | image_url: width: 768 }} 768w"
    imagesizes="100vw" media="(max-width: 768px)" fetchpriority="high">
{% endif %}

<style>
  #video-{{ section.id }} {
    position: relative;
    min-height: 100vh;
    /* 深色底：白字不依赖 poster 解码即可可见 */
    background-color: #111;
  }

  #video-{{ section.id }} .hero-media {
    position: relative;
    width: 100%;
    height: 100vh;
    background-color: #111;
  }

  #video-{{ section.id }} .hero-media .desktop-media,
  #video-{{ section.id }} .hero-media .mobile-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #video-{{ section.id }} .hero-media .desktop-media { display: block; }
  #video-{{ section.id }} .hero-media .mobile-media { display: none; }

  /* 文案优先：不依赖媒体、无入场动画/opacity 隐藏 */
  #video-{{ section.id }} .hero-inner {
    position: absolute;
    inset: 0;
    z-index: 3;
    color: #fff;
    display: flex;
    flex-flow: column;
    justify-content: center;
    align-items: center;
    font-family: MabryPro-Regular, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
  }

  #video-{{ section.id }} .vediohero-title {
    color: #fff;
    font-size: 40px;
    font-weight: 400;
    line-height: 1.3;
    margin: 0 0 16px;
    text-align: center;
    font-family: MabryPro-Medium, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
  }

  #video-{{ section.id }} .video_desc {
    color: #fff;
    font-size: 16px;
    text-align: center;
    opacity: 1;
    visibility: visible;
  }

  #video-{{ section.id }} .video_btns {
    text-align: center;
    margin-top: 32px;
  }

  #video-{{ section.id }} .btn_wj {
    background: #f287ec;
    padding: 14px 40px;
    font-size: 18px;
    border-radius: 50px;
    text-transform: capitalize;
    color: #1a1a1a;
    line-height: 1;
  }

  #video-{{ section.id }} .vediohero-title span { display: block; }

  #video-{{ section.id }}.video-banner:after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 353px;
    background: linear-gradient(180deg, rgba(102, 102, 102, 0) 0%, rgba(0, 0, 0, 0.07) 100%);
    pointer-events: none;
    z-index: 2;
  }

  #video-{{ section.id }} .hero-media .poster-image {
    position: absolute !important;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    z-index: 1;
    display: block !important;
  }

  #video-{{ section.id }} .hero-media .poster-image.is-behind { z-index: 0; }

  #video-{{ section.id }} .hero-media video {
    position: absolute !important;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    z-index: 0;
  }

  #video-{{ section.id }} .hero-media video.loaded { z-index: 1; }

  @media (max-width: 768px) {
    #video-{{ section.id }}.video-banner:after { height: 230px; }
    #video-{{ section.id }} .hero-media .desktop-media { display: none; }
    #video-{{ section.id }} .hero-media .mobile-media { display: block; }
    #video-{{ section.id }} .vediohero-title,
    #video-{{ section.id }} .vediohero-title span { font-size: 24px; }
    #video-{{ section.id }} .hero-inner { padding-bottom: 35px; }
    #video-{{ section.id }} .btn_wj { font-size: 15px; }
    #video-{{ section.id }} .video_desc {
      font-size: 14px;
      max-width: 80%;
      margin: 0 auto;
    }
  }
</style>

<section id="video-{{ section.id }}" class="video-banner" data-section-id="{{ section.id }}" allow-transparent-header>
  {%- comment -%} 文案在媒体之前：尽早进入 DOM {%- endcomment -%}
  <div class="hero-inner">
    <div class="page-width">
      {% if section.settings.title != blank %}
        <h2 class="vediohero-title h0">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.desc != blank %}
        <div class="video_desc">{{ section.settings.desc }}</div>
      {% endif %}
      <div class="video_btns">
        {% if section.settings.button != blank %}
          <a class="hero-cta btn_wj" href="{{ section.settings.cta_link | default: '#' }}" role="button">{{ section.settings.button }}</a>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="hero-media">
    {%- comment -%} 单一 picture：避免双端 poster 同时 eager 抢带宽 {%- endcomment -%}
    {% if poster_desktop != blank or poster_mobile != blank %}
      <picture>
        {% if poster_mobile != blank %}
          <source media="(max-width: 768px)"
            srcset="{{ poster_mobile | image_url: width: 400 }} 400w, {{ poster_mobile | image_url: width: 600 }} 600w, {{ poster_mobile | image_url: width: 768 }} 768w"
            sizes="100vw">
        {% endif %}
        {% if poster_desktop != blank %}
          {{ poster_desktop | image_url: width: 1920 | image_tag:
            class: 'poster-image',
            alt: section.settings.title,
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '800,1200,1600,1920'
          }}
        {% else %}
          {{ poster_mobile | image_url: width: 768 | image_tag:
            class: 'poster-image',
            alt: section.settings.title,
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '400,600,768'
          }}
        {% endif %}
      </picture>
    {% endif %}

    <div class="desktop-media">
      {% if desktop_hq_url != blank %}
        <video id="desktop-video-{{ section.id }}" muted playsinline loop preload="none"
          data-video-src="{{ desktop_hq_url }}"
          {% if section.settings.enable_low_quality_preview and desktop_lq_url != blank %}
            data-lq-src="{{ desktop_lq_url }}"
            data-hq-src="{{ desktop_hq_url }}"
          {% endif %}
        ></video>
      {% endif %}
    </div>

    <div class="mobile-media">
      {% if mobile_hq_url != blank %}
        <video id="mobile-video-{{ section.id }}" muted playsinline loop preload="none"
          data-video-src="{{ mobile_hq_url }}"
          {% if section.settings.enable_low_quality_preview and mobile_lq_url != blank %}
            data-lq-src="{{ mobile_lq_url }}"
            data-hq-src="{{ mobile_hq_url }}"
          {% endif %}
        ></video>
      {% elsif desktop_hq_url != blank %}
        <video id="mobile-video-fallback-{{ section.id }}" muted playsinline loop preload="none"
          data-video-src="{{ desktop_hq_url }}"
        ></video>
      {% endif %}
    </div>
  </div>
</section>

<script>
(function() {
  var sectionId = {{ section.id | json }};
  var desktopVideo = document.getElementById("desktop-video-" + sectionId);
  var mobileVideo = document.getElementById("mobile-video-" + sectionId)
    || document.getElementById("mobile-video-fallback-" + sectionId);
  var enableLq = {{ section.settings.enable_low_quality_preview | json }};
  var isMobile = window.innerWidth <= 768;
  var activeVideo = isMobile ? mobileVideo : desktopVideo;

  if (!activeVideo) return;

  function revealVideoOverPoster() {
    activeVideo.classList.add("loaded");
    document.querySelectorAll("#video-" + sectionId + " .poster-image").forEach(function(img) {
      img.classList.add("is-behind");
    });
  }

  function injectSource(src) {
    var source = document.createElement("source");
    source.src = src;
    source.type = "video/mp4";
    activeVideo.appendChild(source);
    activeVideo.load();
  }

  function loadHighQualityVideo() {
    var hqSrc = activeVideo.getAttribute("data-hq-src");
    if (!hqSrc || !enableLq) return;

    var tempVideo = document.createElement("video");
    tempVideo.src = hqSrc;
    tempVideo.preload = "auto";
    tempVideo.addEventListener("canplaythrough", function() {
      var currentTime = activeVideo.currentTime;
      activeVideo.innerHTML = "";
      injectSource(hqSrc);
      activeVideo.currentTime = currentTime;
      activeVideo.play();
    }, { once: true });
  }

  function loadVideo() {
    var lqSrc = activeVideo.getAttribute("data-lq-src");
    var hqSrc = activeVideo.getAttribute("data-video-src");
    var initialSrc = (enableLq && lqSrc) ? lqSrc : hqSrc;
    if (!initialSrc) return;

    injectSource(initialSrc);

    activeVideo.addEventListener("loadeddata", function() {
      var playPromise = activeVideo.play();
      if (playPromise === undefined) return;

      playPromise.then(function() {
        revealVideoOverPoster();
        if (enableLq && lqSrc && hqSrc) {
          setTimeout(loadHighQualityVideo, 2000);
        }
      }).catch(function() {
        revealVideoOverPoster();
        document.addEventListener("touchstart", function playOnTouch() {
          activeVideo.play().catch(function() {});
          document.removeEventListener("touchstart", playOnTouch);
        }, { once: true });
      });
    }, { once: true });
  }

  /* window.load 后再播，避免与 poster / 字体抢首屏带宽 */
  function scheduleVideoLoad() {
    var start = function() {
      if ("requestIdleCallback" in window) {
        requestIdleCallback(loadVideo, { timeout: 2000 });
      } else {
        setTimeout(loadVideo, 500);
      }
    };

    if (document.readyState === "complete") {
      start();
    } else {
      window.addEventListener("load", start, { once: true });
    }
  }

  scheduleVideoLoad();

  document.addEventListener("visibilitychange", function() {
    if (document.hidden) {
      activeVideo.pause();
    } else if (activeVideo.classList.contains("loaded")) {
      activeVideo.play();
    }
  });
})();
</script>

{% schema %}
{
  "name": "Video Banner",
  "settings": [
    { "type": "header", "content": "Text Content" },
    { "type": "text", "id": "title", "label": "Main title" },
    { "type": "text", "id": "desc", "label": "desc" },
    { "type": "text", "id": "button", "label": "Button text" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Performance Optimization" },
    {
      "type": "checkbox",
      "id": "enable_low_quality_preview",
      "label": "Enable low quality preview",
      "info": "Load low quality video first for fast display, then auto-switch to high quality version",
      "default": true
    },
    { "type": "header", "content": "Desktop Media" },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Background image / Video poster",
      "info": "Important: This image will display immediately, please use optimized image"
    },
    {
      "type": "video",
      "id": "desktop_video",
      "label": "Desktop video (high quality)",
      "info": "Upload or select from Shopify Files. Uses MP4 source from the file."
    },
    {
      "type": "video",
      "id": "desktop_video_low",
      "label": "Desktop low quality preview (optional)",
      "info": "Smaller MP4 for fast first paint; required if you use low quality preview on desktop."
    },
    { "type": "header", "content": "Mobile Media" },
    { "type": "image_picker", "id": "mobile_poster", "label": "Mobile background image / Video poster" },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile video (high quality)",
      "info": "Optional. If empty, the desktop video is used on mobile."
    },
    {
      "type": "video",
      "id": "mobile_video_low",
      "label": "Mobile low quality preview (optional)",
      "info": "Optional smaller MP4 for mobile when low quality preview is enabled."
    }
  ],
  "presets": [{ "name": "Video Banner" }]
}
{% endschema %}
