        { "type": "textarea", "id": "quote", "label": "引言", "default": "SensOn is not just a chatbot online that you chat to and fall in love with and it’s also not just a vibrator it’s mixed between the two!!" }
      ]
    },
    {
      "type": "article",
      "name": "专家图文",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片" },
        { "type": "text", "id": "label", "label": "标签", "default": "DR. AMARI EXPERT ARTICLE" },
        { "type": "textarea", "id": "title", "label": "标题", "default": "A sex-positive look at more personal, ethical and imaginative ways to explore erotic content." },
        { "type": "text", "id": "link_label", "label": "链接文案", "default": "Read expert article" },
