{%- liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image | default: desktop_image
  assign product_image = section.settings.product_image
-%}

<style>
  #shopify-section-{{ section.id }} .web_intro_footer {
    --accent: {{ section.settings.accent_color }};
    --overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --btn-border: {{ section.settings.button_border_color }};
    --product-w: {{ section.settings.product_max_width_mobile }}px;
    background: #0d0b12;
    color: #fff;
    overflow: hidden;
    position: relative;
    padding: {{ section.settings.padding_mobile }}px 16px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .web_intro_footer .media,
  #shopify-section-{{ section.id }} .web_intro_footer .image,
  #shopify-section-{{ section.id }} .web_intro_footer .placeholder {
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .web_intro_footer .image {
    object-fit: cover;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .web_intro_footer .media::after {
    background: rgba(13, 11, 18, var(--overlay));
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  #shopify-section-{{ section.id }} .web_intro_footer .desktop_image { display: none; }
  #shopify-section-{{ section.id }} .web_intro_footer .placeholder {
    background:
      radial-gradient(ellipse at 50% 30%, rgb(242 135 236 / 0.15) 0%, transparent 55%),
      linear-gradient(180deg, #1a1224 0%, #0d0b12 100%);
  }

  #shopify-section-{{ section.id }} .web_intro_footer .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin: 0 auto;
    max-width: 720px;
    position: relative;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .web_intro_footer .tag {
    color: var(--accent);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .web_intro_footer .title {
    color: #fff;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.12;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .web_intro_footer .description {
    color: rgb(255 255 255 / 0.85);
    font-size: 14px;
    line-height: 1.35;
    margin: 0;
    max-width: 310px;
  }

  #shopify-section-{{ section.id }} .web_intro_footer .description p { margin: 0; }

  #shopify-section-{{ section.id }} .web_intro_footer .button {
    align-items: center;
    background: var(--accent);
    border: 1px solid var(--btn-border);
    border-radius: 999px;
    color: #09020e;
    display: inline-flex;
    font-size: 14px;
    font-weight: 500;
    justify-content: center;
    line-height: 1.2;
    margin-top: 4px;
    min-height: 44px;
    min-width: 240px;
    padding: 10px 24px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .web_intro_footer .button:hover { opacity: 0.85; }

  #shopify-section-{{ section.id }} .web_intro_footer .product {
    margin-top: 8px;
    max-width: var(--product-w);
    width: 100%;
  }

  #shopify-section-{{ section.id }} .web_intro_footer .product_image {
    display: block;
    height: auto;
    margin: 0 auto;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .web_intro_footer .footnote {
    color: rgb(255 255 255 / 0.72);
    font-size: 12px;
    line-height: 1.4;
    margin: 4px 0 0;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .web_intro_footer {
      --product-w: {{ section.settings.product_max_width_desktop }}px;
      padding: {{ section.settings.padding_desktop }}px 24px;
    }

    #shopify-section-{{ section.id }} .web_intro_footer .desktop_image { display: block; }
    #shopify-section-{{ section.id }} .web_intro_footer .mobile_image { display: none; }

    #shopify-section-{{ section.id }} .web_intro_footer .inner { gap: 20px; max-width: 920px; }
    #shopify-section-{{ section.id }} .web_intro_footer .tag { font-size: 24px; }
    #shopify-section-{{ section.id }} .web_intro_footer .title { font-size: 42px; line-height: 1.15; }
    #shopify-section-{{ section.id }} .web_intro_footer .description { font-size: 16px; line-height: 1.45; max-width: 640px; }
    #shopify-section-{{ section.id }} .web_intro_footer .button { font-size: 18px; margin-top: 8px; min-height: 48px; min-width: 280px; padding: 12px 32px; }
    #shopify-section-{{ section.id }} .web_intro_footer .product { margin-top: 16px; }
    #shopify-section-{{ section.id }} .web_intro_footer .footnote { font-size: 14px; margin-top: 8px; }
  }
</style>

<section class="web_intro_footer">
  <div class="media" aria-hidden="true">
    {%- if desktop_image != blank -%}
      {{-
        desktop_image
        | image_url: width: 2400
        | image_tag:
          class: 'image desktop_image',
          loading: 'lazy',
          sizes: '100vw',
          widths: '750, 1000, 1200, 1600, 2000, 2400'
      -}}
    {%- endif -%}

    {%- if mobile_image != blank -%}
      {{-
        mobile_image
        | image_url: width: 1000
        | image_tag:
          class: 'image mobile_image',
          loading: 'lazy',
          sizes: '100vw',
          widths: '375, 550, 750, 1000'
      -}}
    {%- endif -%}

    {%- if desktop_image == blank and mobile_image == blank -%}
      <div class="placeholder"></div>
    {%- endif -%}
  </div>

  <div class="inner">
    {%- if section.settings.tag != blank -%}
      <p class="tag">{{ section.settings.tag | escape }}</p>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="description">{{ section.settings.description }}</div>
    {%- endif -%}

    {%- if section.settings.button_text != blank -%}
      <a class="button" href="{{ section.settings.button_link | default: '#' }}">
        {{- section.settings.button_text | escape -}}
      </a>
    {%- endif -%}

    {%- if product_image != blank -%}
      <div class="product" aria-hidden="true">
        {{-
          product_image
          | image_url: width: 800
          | image_tag:
            class: 'product_image',
            loading: 'lazy',
            sizes: '(max-width: 749px) 80vw, 360px',
            widths: '280, 360, 480, 640, 800'
        -}}
      </div>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="footnote">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Web introduction footer",
  "tag": "section",
  "class": "shopify-section--web-introduction-footer",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "背景图片"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "电脑端背景图"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "移动端背景图",
      "info": "未设置时使用电脑端背景图。"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "遮罩不透明度",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "header",
      "content": "文案"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "强调色",
      "default": "#f287ec"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "标签",
      "default": "Your Mood. Your Fantasy. Your Rhythm."
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Ready to meet the fantasy that meets you back?"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "描述",
      "default": "<p>Start exploring personalized AI companions and interactive voice stories today.</p>"
    },
    {
      "type": "header",
      "content": "按钮"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "按钮文案",
      "default": "Start Your 7-Days Trial"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "按钮链接"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "按钮描边颜色",
      "default": "#7dd3fc"
    },
    {
      "type": "header",
      "content": "产品图"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "产品展示图"
    },
    {
      "type": "range",
      "id": "product_max_width_desktop",
      "label": "电脑端产品图最大宽度",
      "min": 200,
      "max": 480,
      "step": 10,
      "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "product_max_width_mobile",
      "label": "移动端产品图最大宽度",
      "min": 160,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 260
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "底部说明",
      "default": "No device required · Cancel anytime"
    },
    {
      "type": "header",
      "content": "间距"
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "电脑端上下内边距",
      "min": 48,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "移动端上下内边距",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Web introduction footer",
      "category": "Banners"
    }
  ]
}
{% endschema %}
