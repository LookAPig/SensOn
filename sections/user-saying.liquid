<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
  crossorigin="anonymous"
  media="print"
  onload="this.media='all'; this.onload=null"
>
<noscript>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" crossorigin="anonymous">
</noscript>

{%- liquid
  assign tag_source = section.settings.tags
  if tag_source == blank
    for block in section.blocks
      if tag_source == blank and block.settings.tags != blank
        assign tag_source = block.settings.tags
      endif
    endfor
  endif
  assign tag_lines = tag_source | newline_to_br | replace: '<br />', '|||' | replace: '<br>', '|||' | split: '|||'
  assign cs_max_width = section.settings.max_width | default: 1160
-%}

<div id="creators-saying-{{ section.id }}" class="creators-saying cs-root {{ section.settings.slider_type }}{% if section.settings.full_width %} is-full{% endif %}" style="--cs-max-width: {{ cs_max_width }}px;">
  {% render 'user-saying-style', section_id: section.id %}
  <div class="cs-section">
    <div class="cs-container">
      <div class="cs-head">
        {% unless section.settings.heading == blank %}
          <h2 class="cs-title">{{ section.settings.heading | escape }}</h2>
        {% endunless %}
        {% if tag_source != blank %}
          <div class="cs-tags">
            {%- for line in tag_lines -%}
              {%- assign tag = line | strip -%}
              {% unless tag == blank %}
                <span class="cs-tag">{{ tag | escape }}</span>
              {% endunless %}
            {%- endfor -%}
          </div>
        {% endif %}
      </div>

      <div class="cs-swiper-wrap">
        <button type="button" class="cs-nav cs-nav--prev" aria-label="Previous slide">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="swiper creators-saying-swiper">
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                {% render 'user-saying-card', block: block %}
              </div>
            {%- endfor -%}
          </div>
        </div>
        <button type="button" class="cs-nav cs-nav--next" aria-label="Next slide">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      {% unless section.settings.button_label == blank %}
        <div class="cs-more-wrap">
          {% if section.settings.button_link != blank %}
            <a class="cs-more" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
          {% else %}
            <span class="cs-more">{{ section.settings.button_label | escape }}</span>
          {% endif %}
        </div>
      {% endunless %}
    </div>
  </div>
</div>

<script
  id="swiper-creators-{{ section.id }}"
  src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
  defer
></script>
{% render 'user-saying-script', section_id: section.id, slide_count: section.blocks.size %}

{% schema %}
{
  "name": "Creators saying slider",
  "tag": "section",
  "class": "section-creators-saying",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false,
      "info": "Full screen with 16px side padding on mobile and 100px on desktop."
    },
    {
      "type": "number",
      "id": "max_width",
      "label": "Max width (px)",
      "default": 1160,
      "visible_if": "{{ section.settings.full_width == false }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "What Creators Are Saying"
    },
    {
      "type": "textarea",
      "id": "tags",
      "label": "Tags (one per line)",
      "info": "Shown once above the carousel. If empty, the first slide's tags are used."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "See More Creator Reviews >",
      "info": "Leave blank to hide the button."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "slider_type",
      "label": "Slider type (for sticky navigation)",
      "options": [
        { "value": "expert-insights-slider", "label": "Expert Insights" },
        { "value": "creator-buzz-slider", "label": "Creator Buzz" }
      ],
      "default": "expert-insights-slider",
      "info": "Choose which sticky nav item should scroll to this section."
    }
  ],
  "blocks": [
    {
      "type": "creator_slide",
      "name": "Creator slide",
      "settings": [
        {
          "type": "textarea",
          "id": "tags",
          "label": "Tags (one per line)",
          "default": "AI-assisted\nIntense orgasm\nLong lasting",
          "info": "Used when the section tags field is empty."
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>“SensOn is not just a chatbot—and it's also not just a vibrator. It's mixed between the two.”</p>"
        },
        { "type": "header", "content": "Creator profile" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar image" },
        { "type": "text", "id": "creator_name", "label": "Name", "default": "Lilly Singh" },
        { "type": "text", "id": "creator_desc", "label": "Subtitle line", "default": "Actress, Self-Growth Nerd, Goofball" },
        { "type": "text", "id": "creator_subs", "label": "Subscribers / stats line", "default": "14.2M Subscribers" },
        { "type": "url", "id": "profile_url", "label": "Profile link (optional)" },
        { "type": "header", "content": "Video" },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Plays inline after the poster is clicked."
        },
        { "type": "image_picker", "id": "video_cover", "label": "Poster image (optional)" },
        {
          "type": "select",
          "id": "video_aspect_ratio",
          "label": "Video aspect ratio",
          "options": [
            { "value": "16-9", "label": "16:9" },
            { "value": "3-4", "label": "3:4" }
          ],
          "default": "16-9"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Creators saying slider",
      "blocks": [
        { "type": "creator_slide" },
        { "type": "creator_slide" },
        { "type": "creator_slide" }
      ]
    }
  ]
}
{% endschema %}
