<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
  crossorigin="anonymous"
>

<div id="creators-saying-{{ section.id }}" class="creators-saying cs-root {{ section.settings.slider_type }}">
  <div class="cs-section">
    <div class="cs-container">
      {% unless section.settings.heading == blank %}
        <div class="cs-title-wrapper">
          <h2 class="cs-title">{{ section.settings.heading | escape }}</h2>
        </div>
      {% endunless %}

      <div class="cs-swiper-wrap">
        <button
          type="button"
          class="cs-swiper-btn cs-swiper-btn--prev"
          aria-label="Previous slide"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>

        <div class="swiper creators-saying-swiper" data-section="{{ section.id }}">
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                <div class="cs-row">
                  <div class="cs-right-side">
                    {% unless block.settings.tags == blank %}
                      <div class="cs-tags">
                        {%- assign tag_lines = block.settings.tags | split: '
' -%}
                        {%- for line in tag_lines -%}
                          {%- assign t = line | strip -%}
                          {% unless t == blank %}
                            <span class="cs-tag">{{ t | escape }}</span>
                          {% endunless %}
                        {%- endfor -%}
                      </div>
                    {% endunless %}

                    <div class="cs-text-content">
                      {% unless block.settings.quote == blank %}
                        <div class="cs-quote rte">{{ block.settings.quote }}</div>
                      {% endunless %}

                      {% if block.settings.profile_url != blank %}
                        <a
                          href="{{ block.settings.profile_url }}"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="cs-profile"
                        >
                      {% else %}
                        <div class="cs-profile cs-profile--static">
                      {% endif %}

                      {% if block.settings.avatar != blank %}
                        <div class="cs-avatar">
                          {{
                            block.settings.avatar
                            | image_url: width: 200
                            | image_tag:
                              loading: 'lazy',
                              widths: '66, 132, 200',
                              sizes: '66px',
                              alt: block.settings.creator_name
                              | default: 'Creator'
                              | escape
                          }}
                        </div>
                      {% endif %}

                      <div class="cs-profile-info">
                        {% unless block.settings.creator_name == blank %}
                          <span class="cs-name">{{ block.settings.creator_name | escape }}</span>
                        {% endunless %}
                        <div class="cs-desc-wrap">
                          {% unless block.settings.creator_desc == blank %}
                            <p class="cs-desc">{{ block.settings.creator_desc | escape }}</p>
                          {% endunless %}
                          {% unless block.settings.creator_subs == blank %}
                            <p class="cs-subs">{{ block.settings.creator_subs | escape }}</p>
                          {% endunless %}
                        </div>
                      </div>

                      {% if block.settings.profile_url != blank %}
                        </a>
                      {% else %}
                        </div>
                      {% endif %}
                    </div>
                  </div>

                  <div class="cs-video-column">
                    {% if block.settings.video != blank %}
                      {%- assign video_ratio_class = '' -%}
                      {%- if block.settings.video_aspect_ratio == '16-9' -%}
                        {%- assign video_ratio_class = 'cs-video-wrapper--ratio-16-9' -%}
                      {%- endif -%}
                      <div
                        class="cs-video-wrapper cs-video-wrapper--inline {{ video_ratio_class }}"
                        {% if block.settings.video_cover != blank %}
                          data-cs-inline-video
                        {% endif %}
                        tabindex="0"
                        role="group"
                        aria-label="{% if block.settings.creator_name != blank %}{{ block.settings.creator_name | escape }} — {% endif %}Video"
                      >
                        {% if block.settings.video_cover != blank %}
                          <div class="cs-video-poster-layer">
                            {{
                              block.settings.video_cover
                              | image_url: width: 900
                              | image_tag:
                                class: 'cs-video-cover',
                                loading: 'lazy',
                                widths: '387, 600, 900',
                                sizes: '(min-width: 1000px) 387px, 100vw',
                                alt: block.settings.creator_name
                                | default: 'Video'
                                | escape
                            }}
                            <button
                              type="button"
                              class="cs-play-btn cs-play-btn--trigger"
                              aria-label="Play video"
                            >
                              <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M8 5v14l11-7z"/>
                              </svg>
                            </button>
                          </div>
                        {% endif %}
                        <div class="cs-video-host">
                          {% if block.settings.video_cover != blank %}
                            {{
                              block.settings.video
                              | video_tag:
                                playsinline: true,
                                controls: false,
                                preload: 'none',
                                muted: false,
                                loop: false
                            }}
                          {% else %}
                            {{
                              block.settings.video
                              | video_tag:
                                playsinline: true,
                                controls: true,
                                preload: 'metadata',
                                muted: false,
                                loop: false
                            }}
                          {% endif %}
                        </div>
                      </div>
                    {% elsif block.settings.video_cover != blank %}
                      {%- assign static_ratio_class = '' -%}
                      {%- if block.settings.video_aspect_ratio == '16-9' -%}
                        {%- assign static_ratio_class = 'cs-video-wrapper--ratio-16-9' -%}
                      {%- endif -%}
                      <div class="cs-video-wrapper cs-video-wrapper--static {{ static_ratio_class }}">
                        {{
                          block.settings.video_cover
                          | image_url: width: 900
                          | image_tag:
                            class: 'cs-video-cover',
                            loading: 'lazy',
                            widths: '387, 600, 900',
                            sizes: '(min-width: 1000px) 387px, 100vw',
                            alt: ''
                        }}
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <button
          type="button"
          class="cs-swiper-btn cs-swiper-btn--next"
          aria-label="Next slide"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  #creators-saying-{{ section.id }} .cs-section {
    width: 100%;
    background-color: #fff;
  }

  #creators-saying-{{ section.id }} .cs-container {
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
    padding: 32px 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #creators-saying-{{ section.id }} .cs-title-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
  }

  #creators-saying-{{ section.id }} .cs-title {
    margin: 0;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
    color: #000;
  }

  #creators-saying-{{ section.id }} .cs-swiper-wrap {
    position: relative;
    width: 100%;
    --cs-nav-btn-size: 40px;
    --cs-nav-gap: 40px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    column-gap: 24px;
    row-gap: 20px;
  }

  #creators-saying-{{ section.id }} .creators-saying-swiper {
    order: 1;
    flex: 1 1 100%;
    width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  #creators-saying-{{ section.id }} .cs-swiper-btn--prev {
    order: 2;
  }

  #creators-saying-{{ section.id }} .cs-swiper-btn--next {
    order: 3;
  }

  #creators-saying-{{ section.id }} .cs-swiper-btn {
    flex: 0 0 auto;
    width: var(--cs-nav-btn-size);
    height: var(--cs-nav-btn-size);
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 50%;
    background: #fff;
    color: #000;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: background 0.2s, border-color 0.2s;
    position: static;
  }

  #creators-saying-{{ section.id }} .cs-swiper-btn:hover {
    background: #f5f5f5;
    border-color: rgba(0, 0, 0, 0.25);
  }

  #creators-saying-{{ section.id }} .cs-swiper-btn.swiper-button-disabled {
    opacity: 0.35;
    cursor: default;
  }

  #creators-saying-{{ section.id }} .cs-row {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  #creators-saying-{{ section.id }} .cs-right-side {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  #creators-saying-{{ section.id }} .cs-tags {
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
  }

  #creators-saying-{{ section.id }} .cs-tag {
    background-color: #f287ec;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.1;
    color: #000;
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 24px;
    box-sizing: border-box;
  }

  #creators-saying-{{ section.id }} .cs-text-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  #creators-saying-{{ section.id }} .cs-quote {
    font-size: 12px;
    font-weight: 400;
    line-height: 1.1;
    color: #000;
    margin: 0;
    width: 100%;
  }

  #creators-saying-{{ section.id }} .cs-quote p {
    margin: 0 0 0.75em;
  }

  #creators-saying-{{ section.id }} .cs-quote p:last-child {
    margin-bottom: 0;
  }

  #creators-saying-{{ section.id }} .cs-profile {
    display: flex;
    gap: 8px;
    align-items: center;
    width: 100%;
    text-decoration: none;
    cursor: pointer;
    color: inherit;
    padding: 16px;
    border-radius: 10px;
    background-color: #F5F5F5;
  }

  #creators-saying-{{ section.id }} .cs-profile--static {
    cursor: default;
  }

  #creators-saying-{{ section.id }} .cs-avatar {
    width: 66px;
    height: 66px;
    flex-shrink: 0;
    border-radius: 50%;
    overflow: hidden;
  }

  #creators-saying-{{ section.id }} .cs-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #creators-saying-{{ section.id }} .cs-profile-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  #creators-saying-{{ section.id }} .cs-name {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    color: #000;
    text-decoration: none;
    margin: 0;
    display: block;
  }

  #creators-saying-{{ section.id }} .cs-desc-wrap {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #creators-saying-{{ section.id }} .cs-desc,
  #creators-saying-{{ section.id }} .cs-subs {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.2;
    color: #000;
    margin: 0;
  }

  #creators-saying-{{ section.id }} .cs-video-column {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* 默认视频容器 3:4 比例 */
  #creators-saying-{{ section.id }} .cs-video-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    aspect-ratio: 3 / 4;
    background-color: transparent;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    cursor: pointer;
    border-radius: 8px;
  }

  /* 16:9 比例覆盖类 */
  #creators-saying-{{ section.id }} .cs-video-wrapper--ratio-16-9 {
    aspect-ratio: 16 / 9 !important;
  }

  #creators-saying-{{ section.id }} .cs-video-wrapper--inline {
    cursor: default;
  }

  #creators-saying-{{ section.id }} .cs-video-poster-layer {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  #creators-saying-{{ section.id }} .cs-video-wrapper--inline.is-playing .cs-video-poster-layer {
    display: none;
  }

  #creators-saying-{{ section.id }} .cs-video-host {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  #creators-saying-{{ section.id }} .cs-video-wrapper--video-only .cs-video-host {
    position: relative;
    width: 100%;
    height: 100%;
  }

  #creators-saying-{{ section.id }} .cs-video-host video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 8px;
  }

  #creators-saying-{{ section.id }} .cs-play-btn--trigger {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 100px;
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(22.5px);
    -webkit-backdrop-filter: blur(22.5px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    color: #fff;
    cursor: pointer;
    pointer-events: auto;
  }

  #creators-saying-{{ section.id }} .cs-play-btn--trigger:focus-visible {
    outline: 2px solid #000;
    outline-offset: 3px;
  }

  #creators-saying-{{ section.id }} .cs-video-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.3s ease;
  }

  #creators-saying-{{ section.id }} .cs-video-cover--placeholder {
    background: #eee;
  }

  #creators-saying-{{ section.id }} .cs-video-wrapper:not(.cs-video-wrapper--inline):hover .cs-video-cover {
    opacity: 0.8;
  }

  #creators-saying-{{ section.id }} .cs-video-wrapper--inline .cs-video-poster-layer:hover .cs-video-cover {
    opacity: 0.8;
  }

  #creators-saying-{{ section.id }} .cs-video-wrapper--inline.is-playing .cs-video-host {
    z-index: 2;
  }

  @media (min-width: 1000px) {
    #creators-saying-{{ section.id }} .cs-swiper-wrap {
      display: block;
      row-gap: unset;
      column-gap: unset;
    }

    #creators-saying-{{ section.id }} .creators-saying-swiper {
      flex: none;
      order: unset;
    }

    #creators-saying-{{ section.id }} .cs-swiper-btn--prev,
    #creators-saying-{{ section.id }} .cs-swiper-btn--next {
      order: unset;
    }

    #creators-saying-{{ section.id }} .cs-swiper-btn {
      flex: none;
      display: flex;
      position: absolute;
      z-index: 5;
      top: 50%;
      transform: translateY(-50%);
    }

    #creators-saying-{{ section.id }} .cs-swiper-btn--prev {
      left: calc(-1 * (var(--cs-nav-btn-size) + var(--cs-nav-gap)));
      right: auto;
    }

    #creators-saying-{{ section.id }} .cs-swiper-btn--next {
      right: calc(-1 * (var(--cs-nav-btn-size) + var(--cs-nav-gap)));
      left: auto;
    }

    #creators-saying-{{ section.id }} .cs-container {
      padding: 64px 100px;
      gap: 40px;
      max-width: 1400px;
      margin: 0 auto;
    }

    #creators-saying-{{ section.id }} .cs-title-wrapper {
      align-items: flex-start;
    }

    #creators-saying-{{ section.id }} .cs-title {
      font-size: 32px;
    }

    #creators-saying-{{ section.id }} .cs-row {
      flex-direction: row-reverse;
      gap: 80px;
      align-items: center;
    }

    #creators-saying-{{ section.id }} .cs-right-side {
      flex: 1;
      gap: 40px;
    }

    #creators-saying-{{ section.id }} .cs-tag {
      font-size: 20px;
      padding: 8px 12px;
      min-height: 0;
    }

    #creators-saying-{{ section.id }} .cs-text-content {
      gap: 40px;
    }

    #creators-saying-{{ section.id }} .cs-quote {
      font-size: 16px;
    }

    #creators-saying-{{ section.id }} .cs-desc,
    #creators-saying-{{ section.id }} .cs-subs {
      font-size: 16px;
    }

    #creators-saying-{{ section.id }} .cs-video-column {
      flex: 0 0 387px;
      width: 387px;
    }

    /* 桌面端同样支持比例变化：宽度固定387，高度由aspect-ratio决定 */
    #creators-saying-{{ section.id }} .cs-video-wrapper--ratio-16-9 {
      aspect-ratio: 16 / 9 !important;
    }
  }
</style>

<script
  id="swiper-creators-{{ section.id }}"
  src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
  defer
></script>
<script>
  (function () {
    var root = document.getElementById('creators-saying-{{ section.id }}');
    if (!root) return;

    var slideCount = {{ section.blocks.size | json }};

    function init() {
      if (typeof Swiper === 'undefined') return false;
      var el = root.querySelector('.creators-saying-swiper');
      if (!el || el.dataset.swiperInited === '1') return true;
      var prev = root.querySelector('.cs-swiper-btn--prev');
      var next = root.querySelector('.cs-swiper-btn--next');

      function pauseAllCsVideos() {
        root.querySelectorAll('.cs-video-wrapper--inline video').forEach(function (v) {
          v.pause();
        });
      }

      function setupCsInlineVideos() {
        root.querySelectorAll('[data-cs-inline-video]').forEach(function (wrap) {
          if (wrap.dataset.csVideoBound === '1') return;
          wrap.dataset.csVideoBound = '1';
          var poster = wrap.querySelector('.cs-video-poster-layer');
          var video = wrap.querySelector('video');
          if (!poster || !video) return;

          function play() {
            if (wrap.classList.contains('is-playing')) return;
            wrap.classList.add('is-playing');
            video.controls = true;
            var p = video.play();
            if (p && p.catch) p.catch(function () {});
          }

          poster.addEventListener('click', function (e) {
            e.preventDefault();
            play();
          });

          wrap.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter' && e.key !== ' ') return;
            e.preventDefault();
            play();
          });
        });
      }

      new Swiper(el, {
        slidesPerView: 1,
        spaceBetween: 0,
        watchOverflow: true,
        loop: slideCount > 1,
        navigation: {
          prevEl: prev,
          nextEl: next,
          disabledClass: 'swiper-button-disabled',
        },
        on: {
          slideChange: function () {
            pauseAllCsVideos();
          },
        },
      });
      setupCsInlineVideos();
      el.dataset.swiperInited = '1';
      return true;
    }

    function tryInit() {
      if (init()) return;
      var s = document.getElementById('swiper-creators-{{ section.id }}');
      if (s) s.addEventListener('load', init);
      setTimeout(init, 100);
      setTimeout(init, 400);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', tryInit);
    } else {
      tryInit();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') tryInit();
    });
  })();
</script>

{% schema %}
{
  "name": "Creators saying slider",
  "tag": "section",
  "class": "section-creators-saying",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "What Creators are Saying"
    },
    {
      "type": "select",
      "id": "slider_type",
      "label": "Slider type (for sticky navigation)",
      "options": [
        { "value": "expert-insights-slider", "label": "Expert Insights" },
        { "value": "creator-buzz-slider", "label": "Creator Buzz" }
      ],
      "default": "expert-insights-slider",
      "info": "Choose which sticky nav item should scroll to this section."
    }
  ],
  "blocks": [
    {
      "type": "creator_slide",
      "name": "Creator slide",
      "settings": [
        {
          "type": "textarea",
          "id": "tags",
          "label": "Tags (one per line)",
          "default": "AI-assisted\nIntense orgasm\nLong lasting",
          "info": "Each line becomes one tag pill."
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "header",
          "content": "Creator profile"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar image"
        },
        {
          "type": "text",
          "id": "creator_name",
          "label": "Name",
          "default": "Lilly Singh"
        },
        {
          "type": "text",
          "id": "creator_desc",
          "label": "Subtitle line",
          "default": "Actress, Self-Growth Nerd, Goofball"
        },
        {
          "type": "text",
          "id": "creator_subs",
          "label": "Subscribers / stats line",
          "default": "14.2M Subscribers"
        },
        {
          "type": "url",
          "id": "profile_url",
          "label": "Profile link (optional)",
          "info": "Leave blank to disable the profile link."
        },
        {
          "type": "header",
          "content": "Video"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Upload an MP4 or pick from Files. Plays inline on click."
        },
        {
          "type": "image_picker",
          "id": "video_cover",
          "label": "Poster image (optional)",
          "info": "Shown before play. Leave blank to show the player with controls only."
        },
        {
          "type": "select",
          "id": "video_aspect_ratio",
          "label": "Video aspect ratio",
          "options": [
            { "value": "3-4", "label": "3:4" },
            { "value": "16-9", "label": "16:9" }
          ],
          "default": "3-4",
          "info": "Choose the aspect ratio that matches your uploaded video or poster image. 3:4 is recommended for portrait-style content, 16:9 for widescreen."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Creators saying slider",
      "blocks": [
        {
          "type": "creator_slide",
          "settings": {
            "creator_name": "Lilly Singh",
