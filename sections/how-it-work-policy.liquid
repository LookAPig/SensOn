<style>
  #shopify-section-{{ section.id }} .how_it_work_policy {
    --accent-color: {{ section.settings.accent_color }};
    --background-color: {{ section.settings.background_color }};
    --text-color: {{ section.settings.text_color }};
    --description-color: {{ section.settings.description_color }};
    background: var(--background-color);
    color: var(--text-color);
    overflow: hidden;
    padding: {{ section.settings.desktop_padding_top }}px 0 {{ section.settings.desktop_padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .how_it_work_policy * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .how_it_work_policy .inner {
    margin: 0 auto;
    padding: 0 100px;
  }

  #shopify-section-{{ section.id }} .how_it_work_policy .policy_list {
    display: grid;
    gap: 56px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .how_it_work_policy .policy_item {
    align-items: flex-start;
    background: #1a1a1a;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    list-style: none;
    margin: 0;
    min-width: 0;
    padding: 28px 24px;
  }

  #shopify-section-{{ section.id }} .how_it_work_policy .icon {
    color: var(--accent-color);
    flex-shrink: 0;
    height: 25px;
    width: 25px;
  }

  #shopify-section-{{ section.id }} .how_it_work_policy .icon img,
  #shopify-section-{{ section.id }} .how_it_work_policy .icon svg {
    display: block;
    height: 100%;
    object-fit: contain;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how_it_work_policy .content {
    min-width: 0;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how_it_work_policy .item_title {
    color: var(--text-color);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .how_it_work_policy .item_description {
    color: var(--description-color);
    font-size: 14px;
    line-height: 1.5;
    margin-top: 10px;
  }

  #shopify-section-{{ section.id }} .how_it_work_policy .item_description p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .how_it_work_policy {
      padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .how_it_work_policy .inner {
      padding: 0 16px;
    }

    #shopify-section-{{ section.id }} .how_it_work_policy .policy_list {
      display: flex;
      flex-direction: column;
      gap: 36px;
    }

    #shopify-section-{{ section.id }} .how_it_work_policy .policy_item {
      background: transparent;
      border-radius: 0;
      flex-direction: row;
      gap: 14px;
      padding: 0;
    }

    #shopify-section-{{ section.id }} .how_it_work_policy .icon {
      height: 24px;
      width: 24px;
    }

    #shopify-section-{{ section.id }} .how_it_work_policy .item_title {
      font-size: 22px;
    }

    #shopify-section-{{ section.id }} .how_it_work_policy .item_description {
      font-size: 15px;
      margin-top: 8px;
    }
  }
</style>

