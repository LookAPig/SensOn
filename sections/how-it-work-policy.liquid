              {%- endcase -%}
            </span>

            <div class="content">
              {%- if block.settings.title != blank -%}
                <div class="item_title">{{ block.settings.title | escape }}</div>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <div class="item_description">{{ block.settings.description }}</div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How it works policy",
  "tag": "section",
  "class": "shopify-section--how-it-works-policy",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "组件背景色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "标题颜色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "描述颜色",
      "default": "#b3b3b3"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "图标颜色",
      "default": "#f287ec"
    },
    {
      "type": "header",
      "content": "模块间距"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "PC 端顶部间距",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "PC 端底部间距",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "移动端顶部间距",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "移动端底部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "policy",
      "name": "政策条目",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "图标",
          "options": [
            {
              "value": "privacy",
              "label": "隐私盾牌"
            },
            {
              "value": "comfort",
              "label": "舒适笑脸"
            },
            {
              "value": "support",
              "label": "支持对话"
            }
          ],
          "default": "privacy"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Private by design"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "描述",
          "default": "<p>Built for private self-care moments with simple app and button control.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "How it works policy",
      "category": "Content",
      "blocks": [
        {
          "type": "policy",
          "settings": {
            "icon": "privacy",
            "title": "Private by design",
            "description": "<p>Built for private self-care moments with simple app and button control.</p>"
          }
        },
        {
          "type": "policy",
          "settings": {
            "icon": "comfort",
            "title": "Comfort-focused setup",
            "description": "<p>Magnetic components and adjustable fit help SensOn S1 feel easier to prepare and use.</p>"
          }
        },
        {
          "type": "policy",
          "settings": {
            "icon": "support",
            "title": "Support when needed",
            "description": "<p>Use the FAQ for details about privacy, safety, cleaning, connectivity, and support.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
