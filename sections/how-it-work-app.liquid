<style>
  #shopify-section-{{ section.id }} .how_it_work_app {
    --accent-color: {{ section.settings.accent_color }};
    --slides-gap: 24px;
    --slides-per-view: 1;
    background: #000000;
    color: #ffffff;
    overflow: hidden;
    padding: {{ section.settings.desktop_padding_top }}px 0 {{ section.settings.desktop_padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .how_it_work_app * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .inner {
    margin: 0 auto;
    padding: 0 100px;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .header {
    display: block;
    margin: 0 0 48px;
    max-width: none;
    padding: 0;
    text-align: center;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .eyebrow {
    color: var(--accent-color);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 12px;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .section_title {
    color: #ffffff;
    font-size: 42px;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin: 0 auto;
    max-width: 820px;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .section_description {
    color: #ffffff;
    font-size: 16px;
    line-height: 1.4;
    margin: 16px auto 0;
    max-width: 720px;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .section_description p,
  #shopify-section-{{ section.id }} .how_it_work_app .slide_description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .carousel {
    position: relative;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .viewport {
    overflow: hidden;
    touch-action: pan-y;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .track {
    align-items: flex-start;
    display: flex;
    gap: var(--slides-gap);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .slide {
    flex: 0 0 100%;
    min-width: 0;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .image_wrap {
    aspect-ratio: 3 / 4;
    background: #282828;
    border-radius: 12px;
    margin: 0 auto;
    max-width: 460px;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .image,
  #shopify-section-{{ section.id }} .how_it_work_app .video,
  #shopify-section-{{ section.id }} .how_it_work_app .placeholder {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .media {
    height: 100%;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .desktop_media {
    display: block;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .mobile_media {
    display: none;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .sound_toggle {
    align-items: center;
    background: rgb(0 0 0 / 0.45);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 50%;
    color: #ffffff;
    cursor: pointer;
    display: flex;
    height: 36px;
    justify-content: center;
    padding: 0;
    position: absolute;
    right: 12px;
    top: 12px;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
    width: 36px;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .sound_toggle:hover {
    background: rgb(0 0 0 / 0.62);
    border-color: var(--accent-color);
  }

  #shopify-section-{{ section.id }} .how_it_work_app .sound_toggle:focus-visible {
    outline: 2px solid var(--accent-color);
    outline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .sound_toggle .icon {
    display: block;
    height: 18px;
    width: 18px;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .sound_toggle .icon_unmuted {
    display: none;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .sound_toggle.is_unmuted .icon_muted {
    display: none;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .sound_toggle.is_unmuted .icon_unmuted {
    display: block;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .placeholder {
    background: linear-gradient(135deg, #51384b, #171117);
  }

  #shopify-section-{{ section.id }} .how_it_work_app .slide_content {
    margin: 30px 0 0;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .slide_title {
    color: #ffffff;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .title_line {
    background: var(--accent-color);
    height: 2px;
    margin: 12px 0 14px;
    width: 76px;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .slide_description {
    color: #ffffff;
    font-size: 16px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .arrow {
    align-items: center;
    background: #3f3f42;
    border: 0;
    border-radius: 50%;
    color: var(--accent-color);
    cursor: pointer;
    display: none;
    height: 44px;
    justify-content: center;
    padding: 0;
    position: absolute;
    top: 307px;
    transform: translateY(-50%);
    transition:
      background 0.2s ease,
      opacity 0.2s ease;
    width: 44px;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .how_it_work_app.is_scrollable .arrow {
    display: flex;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .arrow:hover {
    background: #555558;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .arrow:focus-visible {
    outline: 2px solid var(--accent-color);
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .arrow[disabled] {
    cursor: default;
    opacity: 0.35;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .arrow_prev {
    left: 0;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .arrow_next {
    right: 0;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .arrow_icon {
    border-right: 1.5px solid currentcolor;
    border-top: 1.5px solid currentcolor;
    display: block;
    height: 9px;
    width: 9px;
  }

  #shopify-section-{{ section.id }} .how_it_work_app .arrow_prev .arrow_icon {
    margin-left: 4px;
    transform: rotate(-135deg);
  }

  #shopify-section-{{ section.id }} .how_it_work_app .arrow_next .arrow_icon {
    margin-right: 4px;
    transform: rotate(45deg);
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .how_it_work_app {
      --slides-gap: 28px;
      --slides-per-view: 3;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .track {
      width: max-content;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .slide {
      flex: 0 0 calc((100cqi - (var(--slides-gap) * (var(--slides-per-view) - 1))) / var(--slides-per-view));
      width: calc((100cqi - (var(--slides-gap) * (var(--slides-per-view) - 1))) / var(--slides-per-view));
    }

    #shopify-section-{{ section.id }} .how_it_work_app .viewport {
      container-type: inline-size;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .image_wrap {
      border-radius: 0;
      margin: 0;
      max-width: none;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .slide_content {
      margin: 28px 0 0;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .slide_title {
      font-size: 22px;
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.2;
      margin: 0;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .title_line {
      display: none;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .slide_description {
      color: rgb(255 255 255 / 0.9);
      font-size: 16px;
      line-height: 1.4;
      margin-top: 12px;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .arrow {
      background: #29272a;
      border: 1px solid rgb(255 255 255 / 0.14);
      height: 48px;
      top: clamp(180px, 18vw, 260px);
      width: 48px;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .arrow:hover {
      background: var(--accent-color);
      color: #171117;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .arrow_prev {
      left: 0;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .arrow_next {
      right: 0;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .how_it_work_app {
      padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .inner {
      padding: 0 16px;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .header {
      margin-bottom: 18px;
      max-width: 100%;
      padding: 0;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .eyebrow {
      font-size: 16px;
      margin-bottom: 13px;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .section_title {
      font-size: 27px;
      line-height: 1.02;
      margin: 0;
      max-width: 390px;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .section_description {
      font-size: 16px;
      line-height: 1.27;
      margin: 17px 0 0;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .desktop_media {
      display: none;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .mobile_media {
      display: block;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .image_wrap {
      border-radius: 10px;
      max-width: min(61.2vw, 260px);
    }

    #shopify-section-{{ section.id }} .how_it_work_app .sound_toggle {
      height: 28px;
      right: 8px;
      top: 8px;
      width: 28px;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .sound_toggle .icon {
      height: 14px;
      width: 14px;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .slide_content {
      margin-top: 31px;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .slide_title {
      font-size: 18px;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .title_line {
      margin: 10px 0 13px;
      width: 76px;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .slide_description {
      font-size: 14px;
      line-height: 1.24;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .arrow {
      height: 28px;
      top: min(40.8vw, 173px);
      width: 28px;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .arrow_prev {
      left: 0;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .arrow_next {
      right: 0;
    }

    #shopify-section-{{ section.id }} .how_it_work_app .arrow_icon {
      height: 7px;
      width: 7px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .how_it_work_app .track {
      transition: none;
    }
  }
</style>

<section class="how_it_work_app" id="how-it-work-app-{{ section.id }}">
  <div class="inner">
    <div class="header">
      {%- if section.settings.subtitle != blank -%}
        <p class="eyebrow">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="section_title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="section_description">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="carousel">
        <div
          class="viewport"
          role="region"
          aria-roledescription="carousel"
          aria-label="{{ section.settings.title | default: 'SensOn App' | escape }}"
          tabindex="0"
        >
          <div class="track">
            {%- for block in section.blocks -%}
              <article
                class="slide"
                data-app-slide="{{ forloop.index0 }}"
                role="group"
                aria-roledescription="slide"
                aria-label="{{ forloop.index }} / {{ forloop.length }}"
                aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
                {{ block.shopify_attributes }}
              >
                <div class="image_wrap">
                  {%- liquid
                    assign has_desktop_video = false
                    assign has_mobile_video = false
                    assign has_desktop_image = false
                    assign has_mobile_image = false

                    if block.settings.video != blank
                      assign has_desktop_video = true
                    endif

                    if block.settings.mobile_video != blank
                      assign has_mobile_video = true
                    endif

                    if block.settings.image != blank
                      assign has_desktop_image = true
                    endif

                    if block.settings.mobile_image != blank
                      assign has_mobile_image = true
                    endif
                  -%}

                  {%- if has_desktop_video and has_mobile_video -%}
                    <div class="media desktop_media">
                      {{
                        block.settings.video
                        | video_tag:
                          class: 'video',
                          autoplay: true,
                          loop: true,
                          muted: true,
                          playsinline: true,
                          controls: false,
                          preload: 'metadata',
                          image_size: '1200x'
                      }}
                    </div>
                    <div class="media mobile_media">
                      {{
                        block.settings.mobile_video
                        | video_tag:
                          class: 'video',
                          autoplay: true,
                          loop: true,
                          muted: true,
                          playsinline: true,
                          controls: false,
                          preload: 'metadata',
                          image_size: '800x'
                      }}
                    </div>
                  {%- elsif has_desktop_video -%}
                    <div class="media">
                      {{
                        block.settings.video
                        | video_tag:
                          class: 'video',
                          autoplay: true,
                          loop: true,
                          muted: true,
                          playsinline: true,
                          controls: false,
                          preload: 'metadata',
                          image_size: '1200x'
                      }}
                    </div>
                  {%- elsif has_mobile_video -%}
                    <div class="media">
                      {{
                        block.settings.mobile_video
                        | video_tag:
                          class: 'video',
                          autoplay: true,
                          loop: true,
                          muted: true,
                          playsinline: true,
                          controls: false,
                          preload: 'metadata',
                          image_size: '800x'
                      }}
                    </div>
                  {%- elsif has_desktop_image and has_mobile_image -%}
                    <div class="media desktop_media">
                      {{
                        block.settings.image
                        | image_url: width: 1200
                        | image_tag:
                          class: 'image',
                          loading: 'lazy',
                          sizes: '(min-width: 990px) 33vw, 460px',
                          widths: '240, 320, 460, 640, 800, 1000, 1200',
                          alt: block.settings.title
                      }}
                    </div>
                    <div class="media mobile_media">
                      {{
                        block.settings.mobile_image
                        | image_url: width: 800
                        | image_tag:
                          class: 'image',
                          loading: 'lazy',
                          sizes: '61vw',
                          widths: '240, 320, 460, 640, 800',
                          alt: block.settings.title
                      }}
                    </div>
                  {%- elsif has_desktop_image -%}
                    <div class="media">
                      {{
                        block.settings.image
                        | image_url: width: 1200
                        | image_tag:
                          class: 'image',
                          loading: 'lazy',
                          sizes: '(max-width: 749px) 61vw, (min-width: 990px) 33vw, 460px',
                          widths: '240, 320, 460, 640, 800, 1000, 1200',
                          alt: block.settings.title
                      }}
                    </div>
                  {%- elsif has_mobile_image -%}
                    <div class="media">
                      {{
                        block.settings.mobile_image
                        | image_url: width: 800
                        | image_tag:
                          class: 'image',
                          loading: 'lazy',
                          sizes: '(max-width: 749px) 61vw, (min-width: 990px) 33vw, 460px',
                          widths: '240, 320, 460, 640, 800',
                          alt: block.settings.title
                      }}
                    </div>
                  {%- else -%}
                    <div class="placeholder"></div>
                  {%- endif -%}

                  {%- if has_desktop_video or has_mobile_video -%}
                    <button
                      class="sound_toggle"
                      type="button"
                      data-sound-toggle
                      aria-label="打开声音"
                      aria-pressed="false"
                    >
                      <svg class="icon icon_muted" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path
                          d="M11 5 6 9H3v6h3l5 4V5Z"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linejoin="round"
                        />
                        <path
                          d="m16 9.5 5 5M21 9.5l-5 5"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                        />
                      </svg>
                      <svg class="icon icon_unmuted" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path
                          d="M11 5 6 9H3v6h3l5 4V5Z"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linejoin="round"
                        />
                        <path
                          d="M15.5 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                        />
                      </svg>
                    </button>
                  {%- endif -%}
                </div>

                <div class="slide_content">
                  {%- if block.settings.title != blank -%}
                    <h3 class="slide_title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}

                  <div class="title_line"></div>

                  {%- if block.settings.description != blank -%}
                    <div class="slide_description">{{ block.settings.description }}</div>
                  {%- endif -%}
                </div>
              </article>
            {%- endfor -%}
          </div>
        </div>

        <button class="arrow arrow_prev" type="button" aria-label="上一张">
          <span class="arrow_icon" aria-hidden="true"></span>
        </button>
        <button class="arrow arrow_next" type="button" aria-label="下一张">
          <span class="arrow_icon" aria-hidden="true"></span>
        </button>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const section = document.querySelector("#how-it-work-app-{{ section.id }}");

    if (!section || section.dataset.carouselInitialized === "true") {
      return;
    }

    section.dataset.carouselInitialized = "true";

    const track = section.querySelector(".track");
    const viewport = section.querySelector(".viewport");
    const slides = Array.from(section.querySelectorAll("[data-app-slide]"));
    const previousButton = section.querySelector(".arrow_prev");
    const nextButton = section.querySelector(".arrow_next");
    const desktopMediaQuery = window.matchMedia("(min-width: 990px)");

    if (!track || !viewport || slides.length === 0 || !previousButton || !nextButton) {
      return;
    }

    let activeIndex = 0;
    let touchStartX = 0;
    let isMuted = true;

    const soundToggleButtons = Array.from(section.querySelectorAll("[data-sound-toggle]"));
    const videos = Array.from(section.querySelectorAll("video"));

    const getSlidesPerView = () => {
      const value = Number.parseFloat(window.getComputedStyle(section).getPropertyValue("--slides-per-view"));

      return Number.isFinite(value) && value > 0 ? value : 1;
    };

    const getMaxIndex = () => Math.max(0, slides.length - getSlidesPerView());

    const applyMuteState = () => {
      videos.forEach((video) => {
        video.muted = isMuted;
      });

      soundToggleButtons.forEach((button) => {
        button.classList.toggle("is_unmuted", !isMuted);
        button.setAttribute("aria-pressed", isMuted ? "false" : "true");
        button.setAttribute("aria-label", isMuted ? "打开声音" : "关闭声音");
      });
    };

    const syncSlideVideos = () => {
      const slidesPerView = getSlidesPerView();
      const visibleStart = activeIndex;
      const visibleEnd = activeIndex + slidesPerView - 1;

      slides.forEach((slide, slideIndex) => {
        const slideVideos = slide.querySelectorAll("video");
        const isVisible = slideIndex >= visibleStart && slideIndex <= visibleEnd;

        slideVideos.forEach((video) => {
          const media = video.closest(".media");
          const isMediaVisible = !media || window.getComputedStyle(media).display !== "none";

          video.muted = isMuted;

          if (isVisible && isMediaVisible) {
            const playPromise = video.play();

            if (playPromise && typeof playPromise.catch === "function") {
              playPromise.catch(() => {});
            }

            return;
          }

          video.pause();

          if (!isVisible) {
            video.currentTime = 0;
          }
        });
      });
    };

    const updateControls = () => {
      const maxIndex = getMaxIndex();
      const isScrollable = maxIndex > 0;

      section.classList.toggle("is_scrollable", isScrollable);
      previousButton.disabled = !isScrollable || activeIndex <= 0;
      nextButton.disabled = !isScrollable || activeIndex >= maxIndex;
    };

    const showSlide = (index) => {
      const maxIndex = getMaxIndex();

      activeIndex = Math.min(Math.max(0, index), maxIndex);

      const targetSlide = slides[activeIndex];
      const offset = targetSlide ? targetSlide.offsetLeft : 0;

      track.style.transform = `translate3d(-${offset}px, 0, 0)`;

      const slidesPerView = getSlidesPerView();
      const visibleStart = activeIndex;
      const visibleEnd = activeIndex + slidesPerView - 1;

      slides.forEach((slide, slideIndex) => {
        const isVisible = slideIndex >= visibleStart && slideIndex <= visibleEnd;

        slide.setAttribute("aria-hidden", isVisible ? "false" : "true");
      });

      updateControls();
      syncSlideVideos();
    };

    previousButton.addEventListener("click", () => {
      showSlide(activeIndex - 1);
    });

    nextButton.addEventListener("click", () => {
      showSlide(activeIndex + 1);
    });

    soundToggleButtons.forEach((button) => {
      button.addEventListener("click", (event) => {
        event.stopPropagation();
        isMuted = !isMuted;
        applyMuteState();
        syncSlideVideos();
      });
    });

    viewport.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        showSlide(activeIndex - 1);
      }

      if (event.key === "ArrowRight") {
        showSlide(activeIndex + 1);
      }
    });

    viewport.addEventListener(
      "touchstart",
      (event) => {
        touchStartX = event.touches[0].clientX;
      },
      { passive: true }
    );

    viewport.addEventListener(
      "touchend",
      (event) => {
        if (!section.classList.contains("is_scrollable")) {
          return;
        }

        const touchDistance = event.changedTouches[0].clientX - touchStartX;

        if (Math.abs(touchDistance) < 45) {
          return;
        }

        showSlide(touchDistance > 0 ? activeIndex - 1 : activeIndex + 1);
      },
      { passive: true }
    );

    if (window.Shopify && window.Shopify.designMode) {
      document.addEventListener("shopify:block:select", (event) => {
        const selectedSlide = event.target.closest("[data-app-slide]");

        if (selectedSlide && section.contains(selectedSlide)) {
          const selectedIndex = Number(selectedSlide.dataset.appSlide);
          const slidesPerView = getSlidesPerView();
          const maxIndex = getMaxIndex();
          const targetIndex = Math.min(Math.max(selectedIndex - slidesPerView + 1, 0), maxIndex);

          showSlide(targetIndex);
        }
      });
    }

    const handleResize = () => {
      showSlide(activeIndex);
    };

    if (typeof desktopMediaQuery.addEventListener === "function") {
      desktopMediaQuery.addEventListener("change", handleResize);
    } else if (typeof desktopMediaQuery.addListener === "function") {
      desktopMediaQuery.addListener(handleResize);
    }

    window.addEventListener("resize", handleResize);

    applyMuteState();
    showSlide(0);
  })();
</script>

