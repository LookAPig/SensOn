<div id="senson-edge-section">
  {%- liquid 
    assign padding_horizontal = section.settings.padding_horizontal
    assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile
    assign padding_top = section.settings.padding_top
    assign padding_bottom = section.settings.padding_bottom
    assign border_color = section.settings.border_color
    assign border_thickness = section.settings.border_thickness
    assign margin_top = section.settings.margin_top
    assign margin_bottom = section.settings.margin_bottom
    assign margin_horizontal_mobile = section.settings.margin_horizontal_mobile
    assign margin_horizontal = section.settings.margin_horizontal
    assign background_color = section.settings.background_color
    assign background_gradient = section.settings.background_gradient
    assign full_width = section.settings.full_width
    assign content_width = section.settings.content_width
    assign lazy = section.settings.lazy
    assign section_radius = section.settings.section_radius

    assign content_align = section.settings.content_align
    assign content_align_mobile = section.settings.content_align_mobile
    assign content_max_width = section.settings.content_max_width

    assign table_columns = section.settings.table_columns
    assign table_column_bg_color = section.settings.table_column_bg_color
    assign table_column_active_bg_color = section.settings.table_column_active_bg_color
    assign table_column_border_color = section.settings.table_column_border_color
    assign table_column_active_border_color = section.settings.table_column_active_border_color
    assign table_column_border_thickness = section.settings.table_column_border_thickness
    assign table_radius = section.settings.table_radius
    assign table_mt = section.settings.table_mt  
    assign table_mt_mobile = section.settings.table_mt_mobile
    assign table_bg_image_color = section.settings.table_bg_image_color
    assign table_bg_image_active_color = section.settings.table_bg_image_active_color

    assign first_heading = section.settings.first_heading
    assign first_heading_image = section.settings.first_heading_image
    assign first_heading_url = section.settings.first_heading_url
    assign second_heading = section.settings.second_heading
    assign second_heading_image = section.settings.second_heading_image
    assign second_heading_url = section.settings.second_heading_url
    assign third_heading = section.settings.third_heading
    assign third_heading_image = section.settings.third_heading_image
    assign third_heading_url = section.settings.third_heading_url

    assign heading_image_size_mobile = section.settings.heading_image_size_mobile
    assign heading_image_size = section.settings.heading_image_size   
    assign heading_image_border_thickness = section.settings.heading_image_border_thickness
    assign heading_image_border_color = section.settings.heading_image_border_color
    assign heading_image_radius = section.settings.heading_image_radius
    assign use_background_image = section.settings.use_background_image

    assign column_heading_size = section.settings.column_heading_size
    assign column_heading_size_mobile = section.settings.column_heading_size_mobile
    assign column_heading_color = section.settings.column_heading_color
    assign column_heading_active_color = section.settings.column_heading_active_color
    assign column_heading_custom = section.settings.column_heading_custom
    assign column_heading_font = section.settings.column_heading_font
    assign column_heading_height = section.settings.column_heading_height
    assign column_heading_align = section.settings.column_heading_align
    assign column_heading_align_mobile = section.settings.column_heading_align_mobile
    assign column_heading_padding_horizontal = section.settings.column_heading_padding_horizontal
    assign column_heading_padding_horizontal_mobile = section.settings.column_heading_padding_horizontal_mobile
    assign column_heading_padding_vertical = section.settings.column_heading_padding_vertical
    assign column_heading_padding_vertical_mobile = section.settings.column_heading_padding_vertical_mobile

    assign row_padding_horizontal = section.settings.row_padding_horizontal
    assign row_padding_horizontal_mobile = section.settings.row_padding_horizontal_mobile
    assign row_padding_vertical = section.settings.row_padding_vertical
    assign row_padding_vertical_mobile = section.settings.row_padding_vertical_mobile
    assign row_border_thickness = section.settings.row_border_thickness
    assign row_border_color = section.settings.row_border_color

    assign row_heading_size = section.settings.row_heading_size
    assign row_heading_size_mobile = section.settings.row_heading_size_mobile
    assign row_heading_color = section.settings.row_heading_color
    assign row_heading_custom = section.settings.row_heading_custom
    assign row_heading_font = section.settings.row_heading_font
    assign row_heading_height = section.settings.row_heading_height
    assign row_heading_border_color = section.settings.row_heading_border_color

    assign value_size = section.settings.value_size
    assign value_size_mobile = section.settings.value_size_mobile
    assign value_color = section.settings.value_color
    assign value_active_color = section.settings.value_active_color
    assign value_custom = section.settings.value_custom
    assign value_font = section.settings.value_font
    assign value_height = section.settings.value_height

    assign value_icon_size = section.settings.value_icon_size
    assign value_icon_size_mobile = section.settings.value_icon_size_mobile
    assign value_icon_color = section.settings.value_icon_color
    assign value_icon_active_color = section.settings.value_icon_active_color
    assign value_icon_check = section.settings.value_icon_check
    assign value_icon_cross = section.settings.value_icon_cross

    if lazy
      assign loading_attribute = "lazy"
    else
      assign loading_attribute = "eager"
    endif

    assign table_row_count = 0
    for block in section.blocks
      if block.type == "table_row"
        assign table_row_count = table_row_count | plus: 1
      endif
    endfor
  -%}

  {%- style -%}
    {{ column_heading_font | font_face: font_display: 'swap' }}
    {{ row_heading_font | font_face: font_display: 'swap' }}
    {{ value_font | font_face: font_display: 'swap' }}

    #senson-edge-section .section-{{ section.id }} {
      border-top: solid {{ border_color }} {{ border_thickness }}px;
      border-bottom: solid {{ border_color }} {{ border_thickness }}px;
      margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
      margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px;
      margin-left: {{ margin_horizontal_mobile }}rem;
      margin-right: {{ margin_horizontal_mobile }}rem;
      border-radius: {{ section_radius | times: 0.6 | round: 0 }}px;
      overflow: visible;
    }

    #senson-edge-section .section-{{ section.id }}-settings {
      margin: 0 auto;
      padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
      padding-left: {{ padding_horizontal_mobile }}rem;
      padding-right: {{ padding_horizontal_mobile }}rem;
    }

    #senson-edge-section .comparison-table-wrapper-{{ section.id }} {
      margin-top: {{ table_mt_mobile }}px;
      width: 100%;
      margin-left: {% if content_align_mobile == 'center' %}auto{% else %}0{% endif %};
      margin-right: {% if content_align_mobile == 'center' %}auto{% else %}0{% endif %};
    }

    #senson-edge-section .comparison-table-inner-{{ section.id }},
    #senson-edge-section .comparison-table-{{ section.id }} {
      width: 100%;
    }

    #senson-edge-section .comparison-columns-{{ section.id }} {
      display: grid;
      grid-template-columns: repeat({{ table_columns }}, minmax(0, 1fr));
      grid-template-rows: auto repeat({{ table_row_count }}, minmax(64px, auto));
      column-gap: 12px;
      width: 100%;
      padding-top: {{ heading_image_size_mobile | times: 42 | divided_by: 100 | round: 0 }}px;
      overflow: visible;
    }

    #senson-edge-section .comparison-column-{{ section.id }} {
      display: grid;
      grid-template-rows: subgrid;
      grid-row: 1 / -1;
      min-width: 0;
    }

    #senson-edge-section .comparison-column-card-{{ section.id }} {
      display: contents;
    }

    #senson-edge-section .comparison-column-header-{{ section.id }} {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      min-height: 72px;
      padding: {{ heading_image_size_mobile | times: 28 | divided_by: 100 | round: 0 }}px {{ column_heading_padding_horizontal_mobile }}px {{ column_heading_padding_vertical_mobile | plus: 16 }}px;
      border-radius: {{ table_radius }}px {{ table_radius }}px 0 0;
      background-color: {{ table_bg_image_color }};
      overflow: visible;
    }

    #senson-edge-section .comparison-column-{{ section.id }}.active .comparison-column-header-{{ section.id }} {
      background: linear-gradient(180deg, {{ table_column_active_border_color }} 0%, #c77dff 55%, #9b6fd0 100%);
    }

    #senson-edge-section .comparison-column-{{ section.id }}:not(.active) .comparison-column-header-{{ section.id }} {
      background-color: {{ table_bg_image_color }};
    }

    #senson-edge-section .comparison-column-heading-{{ section.id }} {
      position: relative;
      z-index: 2;
      margin: 0;
      width: 100%;
      font-size: {{ column_heading_size_mobile }}px;
      color: {{ column_heading_color }};
      line-height: {{ column_heading_height }}%;
      text-align: {{ column_heading_align_mobile }};
      font-weight: 700;
    }

    #senson-edge-section .comparison-column-{{ section.id }}.active .comparison-column-heading-{{ section.id }} {
      color: #ffffff;
    }

    #senson-edge-section .comparison-column-image-{{ section.id }} {
      position: absolute;
      top: 0;
      left: 50%;
      z-index: 4;
      display: flex;
      justify-content: center;
      width: 100%;
      transform: translate(-50%, -42%);
      pointer-events: none;
    }

    #senson-edge-section .comparison-item-heading-image-{{ section.id }} {
      display: block;
      flex-shrink: 0;
      border: {{ heading_image_border_thickness }}px solid {{ heading_image_border_color }};
      border-radius: {{ heading_image_radius }}px;
      width: {{ heading_image_size_mobile }}px;
      overflow: hidden;
      pointer-events: auto;
    }

    #senson-edge-section .comparison-item-heading-image-{{ section.id }} img,
    #senson-edge-section .comparison-item-heading-image-{{ section.id }} svg {
      display: block;
      width: 100%;
      height: auto;
      object-fit: contain;
    }

    #senson-edge-section .comparison-item-heading-image-{{ section.id }} svg {
      background-color: #afafaf;
    }

    #senson-edge-section .comparison-column-body-{{ section.id }} {
      display: contents;
    }

    #senson-edge-section .comparison-column-row-{{ section.id }} {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: {{ row_padding_vertical_mobile }}px {{ row_padding_horizontal_mobile }}px;
      text-align: center;
      background-color: {{ table_column_bg_color }};
    }

    #senson-edge-section .comparison-column-{{ section.id }}.active .comparison-column-row-{{ section.id }} {
      background-color: {{ table_column_bg_color }};
    }

    #senson-edge-section .comparison-column-{{ section.id }}:not(.active) .comparison-column-row-{{ section.id }} {
      background-color: {{ table_column_bg_color }};
    }

    #senson-edge-section .comparison-column-{{ section.id }} .comparison-column-row-{{ section.id }}:last-child {
      border-radius: 0 0 {{ table_radius }}px {{ table_radius }}px;
    }

    #senson-edge-section .comparison-value-{{ section.id }} {
      margin: 0;
      font-size: {{ value_size_mobile }}px;
      color: {{ value_color }};
      line-height: {{ value_height }}%;
      text-align: center;
      font-weight: 400;
      word-break: break-word;
      max-width: 100%;
    }

    #senson-edge-section .comparison-column-{{ section.id }}.active .comparison-value-{{ section.id }} {
      color: {{ row_heading_color }};
      font-weight: 700;
    }

    #senson-edge-section .comparison-value-icon-{{ section.id }} {
      display: flex;
      align-items: center;
      justify-content: center;
      width: {{ value_icon_size_mobile }}px;
      height: {{ value_icon_size_mobile }}px;
    }

    #senson-edge-section .comparison-column-{{ section.id }}:not(.active) .comparison-value-icon-{{ section.id }}--cross {
      width: calc({{ value_icon_size_mobile }}px + 10px);
      height: calc({{ value_icon_size_mobile }}px + 10px);
      border: 1.5px solid {{ value_icon_color }};
      border-radius: 50%;
    }

    #senson-edge-section .comparison-column-{{ section.id }}:not(.active) .comparison-value-icon-{{ section.id }}--cross svg {
      width: calc({{ value_icon_size_mobile }}px - 8px);
      height: calc({{ value_icon_size_mobile }}px - 8px);
    }

    #senson-edge-section .comparison-value-icon-{{ section.id }} img,
    #senson-edge-section .comparison-value-icon-{{ section.id }} svg {
      display: block;
      width: 100%;
      height: 100%;
    }

    #senson-edge-section .comparison-value-icon-{{ section.id }} svg path {
      fill: {{ value_icon_color }};
    }

    #senson-edge-section .comparison-column-{{ section.id }}.active .comparison-value-icon-{{ section.id }} svg path {
      fill: {{ value_icon_active_color }};
    }

    @media (min-width: 1024px) {
      #senson-edge-section .section-{{ section.id }} {
        margin-top: {{ margin_top }}px;
        margin-bottom: {{ margin_bottom }}px;
        margin-left: {{ margin_horizontal }}rem;
        margin-right: {{ margin_horizontal }}rem;
        border-radius: {{ section_radius }}px;
      }

      #senson-edge-section .section-{{ section.id }}-settings {
        padding-top: {{ padding_top }}px;
        padding-bottom: {{ padding_bottom }}px;
        padding-left: {{ padding_horizontal }}rem;
        padding-right: {{ padding_horizontal }}rem;
      }

      #senson-edge-section .comparison-table-wrapper-{{ section.id }} {
        margin-top: {{ table_mt }}px;
        width: min(100%, max(560px, {{ content_width | times: content_max_width | divided_by: 100 }}px));
        margin-left: {% if content_align == 'center' %}auto{% else %}0{% endif %};
        margin-right: {% if content_align == 'center' %}auto{% else %}0{% endif %};
      }

      #senson-edge-section .comparison-columns-{{ section.id }} {
        column-gap: 20px;
        padding-top: {{ heading_image_size | times: 42 | divided_by: 100 | round: 0 }}px;
      }

      #senson-edge-section .comparison-column-header-{{ section.id }} {
        min-height: 88px;
        padding: {{ heading_image_size | times: 28 | divided_by: 100 | round: 0 }}px {{ column_heading_padding_horizontal }}px {{ column_heading_padding_vertical | plus: 20 }}px;
      }

      #senson-edge-section .comparison-column-heading-{{ section.id }} {
        font-size: {{ column_heading_size }}px;
        text-align: {{ column_heading_align }};
      }

      #senson-edge-section .comparison-item-heading-image-{{ section.id }} {
        width: {{ heading_image_size }}px;
      }

      #senson-edge-section .comparison-column-row-{{ section.id }} {
        padding: {{ row_padding_vertical }}px {{ row_padding_horizontal }}px;
      }

      #senson-edge-section .comparison-value-{{ section.id }} {
        font-size: {{ value_size }}px;
      }

      #senson-edge-section .comparison-value-icon-{{ section.id }} {
        width: {{ value_icon_size }}px;
        height: {{ value_icon_size }}px;
      }

      #senson-edge-section .comparison-column-{{ section.id }}:not(.active) .comparison-value-icon-{{ section.id }}--cross {
        width: calc({{ value_icon_size }}px + 10px);
        height: calc({{ value_icon_size }}px + 10px);
      }

      #senson-edge-section .comparison-column-{{ section.id }}:not(.active) .comparison-value-icon-{{ section.id }}--cross svg {
        width: calc({{ value_icon_size }}px - 8px);
        height: calc({{ value_icon_size }}px - 8px);
      }
    }
  {%- endstyle -%}

  {% unless full_width %}
    <style>
      .section-{{ section.id }}-settings {
        max-width: {{ content_width }}px;
      }
    </style>
  {% endunless %}

  {% if margin_horizontal_mobile > 0 %}
    <style>
      .section-{{ section.id }} {
        border-left: solid {{ border_color }} {{ border_thickness }}px;
        border-right: solid {{ border_color }} {{ border_thickness }}px;
      }
      @media(min-width: 1024px) {
        .section-{{ section.id }} {
          border-left: 0px;
          border-right: 0px;
        }
      }
    </style>
  {% endif %}

  {% if margin_horizontal > 0 %}
    <style>
      @media(min-width: 1024px) {
        .section-{{ section.id }} {
          border-left: solid {{ border_color }} {{ border_thickness }}px;
          border-right: solid {{ border_color }} {{ border_thickness }}px;
        }
      }
    </style>
  {% endif %}

  {% if column_heading_custom %}
    <style>
      .comparison-column-heading-{{ section.id }} {
        font-family: {{ column_heading_font.family }}, {{ column_heading_font.fallback_families }};
        font-weight: {{ column_heading_font.weight }};
        font-style: {{ column_heading_font.style }};
      }
    </style>
  {% endif %}

  {% if row_heading_custom %}
    <style>
      .comparison-column-{{ section.id }}.active .comparison-value-{{ section.id }} {
        font-family: {{ row_heading_font.family }}, {{ row_heading_font.fallback_families }};
        font-weight: {{ row_heading_font.weight }};
        font-style: {{ row_heading_font.style }};
      }
    </style>
  {% endif %}

  {% if value_custom %}
    <style>
      .comparison-column-{{ section.id }}:not(.active) .comparison-value-{{ section.id }} {
        font-family: {{ value_font.family }}, {{ value_font.fallback_families }};
        font-weight: {{ value_font.weight }};
        font-style: {{ value_font.style }};
      }
    </style>
  {% endif %}

  <div class="section-{{ section.id }} comparison-{{ section.id }}" style="background-color:{{ background_color }}; background-image: {{ background_gradient }};">
    <div class="section-{{ section.id }}-settings">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}
            {% if block.settings.heading != blank %}
              {% style %}
                .comparison-heading-{{ block.id }} {
                  text-align: {{ content_align_mobile }};
                }
                .comparison-heading-{{ block.id }} * {
                  margin: 0;
                  font-size: {{ block.settings.heading_size_mobile }}px;
                  color: {{ block.settings.heading_color }};
                  line-height: {{ block.settings.heading_height }}%;
                }
                @media (min-width: 1024px) {
                  .comparison-heading-{{ block.id }} {
                    text-align: {{ content_align }};
                    margin-top: {{ block.settings.heading_mt }}px;
                  }
                  .comparison-heading-{{ block.id }} * {
                    font-size: {{ block.settings.heading_size }}px;
                  }
                }
              {% endstyle %}
              {% if block.settings.heading_custom %}
                {% style %}
                  .comparison-heading-{{ block.id }} * {
                    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
                    font-weight: {{ block.settings.heading_font.weight }};
                    font-style: {{ block.settings.heading_font.style }};
                  }
                {% endstyle %}
              {% endif %}
              <div class="comparison-heading-{{ block.id }}" style="margin-top: {{ block.settings.heading_mt_mobile }}px;">
                {{ block.settings.heading }}
              </div>
            {% endif %}
          {% when 'text' %}
            {% if block.settings.text != blank %}
              {% style %}
                .comparison-text-{{ block.id }} {
                  margin-top: {{ block.settings.text_mt_mobile }}px;
                  text-align: {{ content_align_mobile }};
                }
                .comparison-text-{{ block.id }} * {
                  margin: 0;
                  font-size: {{ block.settings.text_size_mobile }}px;
                  color: {{ block.settings.text_color }};
                  line-height: {{ block.settings.text_height }}%;
                }
                @media (min-width: 1024px) {
                  .comparison-text-{{ block.id }} {
                    margin-top: {{ block.settings.text_mt }}px;
                    text-align: {{ content_align }};
                  }
                  .comparison-text-{{ block.id }} * {
                    font-size: {{ block.settings.text_size }}px;
                  }
                }
              {% endstyle %}
              {% if block.settings.text_custom %}
                {% style %}
                  .comparison-text-{{ block.id }} * {
                    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
                    font-weight: {{ block.settings.text_font.weight }};
                    font-style: {{ block.settings.text_font.style }};
                  }
                {% endstyle %}
              {% endif %}
              <div class="comparison-text-{{ block.id }}">
                {{ block.settings.text }}
              </div>
            {% endif %}
        {% endcase %}
      {% endfor %}

      <div class="comparison-table-wrapper-{{ section.id }}">
        <div class="comparison-table-inner-{{ section.id }}">
          <div class="comparison-table-{{ section.id }}">
            <div class="comparison-columns-{{ section.id }}">

              {% if first_heading != blank or first_heading_image != blank %}
                <div class="comparison-column-{{ section.id }} active">
                  <div class="comparison-column-card-{{ section.id }}">
                    <div class="comparison-column-header-{{ section.id }}">
                      <div class="comparison-column-image-{{ section.id }}">
                        <{% if first_heading_url != blank %}a href="{{ first_heading_url }}"{% else %}div{% endif %} class="comparison-item-heading-image-{{ section.id }}">
                          {% if first_heading_image != blank %}
                            {{ first_heading_image | image_url: width: 535 | image_tag: loading: loading_attribute }}
                          {% else %}
                            {{ "image" | placeholder_svg_tag }}
                          {% endif %}
                        </{% if first_heading_url != blank %}a{% else %}div{% endif %}>
                      </div>
                      {% if first_heading != blank %}
                        <{% if first_heading_url != blank %}a href="{{ first_heading_url }}"{% else %}h3{% endif %} class="comparison-column-heading-{{ section.id }}">{{ first_heading }}</{% if first_heading_url != blank %}a{% else %}h3{% endif %}>
                      {% endif %}
                    </div>
                    <div class="comparison-column-body-{{ section.id }}">
                      {% for block in section.blocks %}
                        {% if block.type == "table_row" %}
                          <div class="comparison-column-row-{{ section.id }}">
                            {% if block.settings.first_column_image != blank or block.settings.first_column_icon != "none" %}
                              <div class="comparison-value-icon-{{ section.id }}{% if block.settings.first_column_icon == "cross" %} comparison-value-icon-{{ section.id }}--cross{% endif %}">
                                {% if block.settings.first_column_image != blank %}
                                  {{ block.settings.first_column_image | image_url: width: 535 | image_tag: loading: loading_attribute }}
                                {% elsif block.settings.first_column_icon == "check" %}
                                  {% if value_icon_check != blank %}
                                    <img src="{{ value_icon_check | image_url }}" alt="{{ value_icon_check.alt }}">
                                  {% else %}
                                    <svg width="35" height="27" viewBox="0 0 35 27" fill="none"><path d="M34.0312 5.00946L12.1162 25.321L0.706055 13.1432L4.92773 9.18719L12.0713 16.8112L12.4121 17.1745L12.7764 16.8356L30.1074 0.756531L34.0312 5.00946Z" fill="#6CB324"/></svg>
                                  {% endif %}
                                {% elsif block.settings.first_column_icon == "cross" %}
                                  {% if value_icon_cross != blank %}
                                    <img src="{{ value_icon_cross | image_url }}" alt="{{ value_icon_cross.alt }}">
                                  {% else %}
                                    <svg width="26" height="26" viewBox="0 0 26 26" fill="none"><path d="M25.7313 3.27235L22.5085 0.0494995L12.8657 9.69232L3.22285 0.0494995L0 3.27235L9.64282 12.9152L0 22.558L3.22285 25.7808L12.8657 16.138L22.5085 25.7808L25.7313 22.558L16.0885 12.9152L25.7313 3.27235Z" fill="#FF1616"/></svg>
                                  {% endif %}
                                {% endif %}
                              </div>
                            {% endif %}
                            {% if block.settings.first_column != blank %}
                              <p class="comparison-value-{{ section.id }}">{{ block.settings.first_column }}</p>
                            {% endif %}
                          </div>
                        {% endif %}
                      {% endfor %}
                    </div>
                  </div>
                </div>
              {% endif %}

              {% if table_columns > 1 and second_heading != blank or second_heading_image != blank %}
                <div class="comparison-column-{{ section.id }}">
                  <div class="comparison-column-card-{{ section.id }}">
                    <div class="comparison-column-header-{{ section.id }}">
                      <div class="comparison-column-image-{{ section.id }}">
                        <{% if second_heading_url != blank %}a href="{{ second_heading_url }}"{% else %}div{% endif %} class="comparison-item-heading-image-{{ section.id }}">
                          {% if second_heading_image != blank %}
                            {{ second_heading_image | image_url: width: 535 | image_tag: loading: loading_attribute }}
                          {% else %}
                            {{ "image" | placeholder_svg_tag }}
