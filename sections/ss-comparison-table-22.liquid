<div id="senson-edge-section">
  {%- liquid 
    assign padding_horizontal = section.settings.padding_horizontal
    assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile
    assign padding_top = section.settings.padding_top
    assign padding_bottom = section.settings.padding_bottom
    assign border_color = section.settings.border_color
    assign border_thickness = section.settings.border_thickness
    assign margin_top = section.settings.margin_top
    assign margin_bottom = section.settings.margin_bottom
    assign margin_horizontal_mobile = section.settings.margin_horizontal_mobile
    assign margin_horizontal = section.settings.margin_horizontal
    assign background_color = section.settings.background_color
    assign background_gradient = section.settings.background_gradient
    assign full_width = section.settings.full_width
    assign content_width = section.settings.content_width
    assign lazy = section.settings.lazy
    assign section_radius = section.settings.section_radius

    assign content_align = section.settings.content_align
    assign content_align_mobile = section.settings.content_align_mobile
    assign content_max_width = section.settings.content_max_width

    assign table_columns = section.settings.table_columns
    assign table_column_bg_color = section.settings.table_column_bg_color
    assign table_column_active_bg_color = section.settings.table_column_active_bg_color
    assign table_column_border_color = section.settings.table_column_border_color
    assign table_column_active_border_color = section.settings.table_column_active_border_color
    assign table_column_border_thickness = section.settings.table_column_border_thickness
    assign table_radius = section.settings.table_radius
    assign table_mt = section.settings.table_mt  
    assign table_mt_mobile = section.settings.table_mt_mobile
    assign table_bg_image_color = section.settings.table_bg_image_color
    assign table_bg_image_active_color = section.settings.table_bg_image_active_color

    assign first_heading = section.settings.first_heading
    assign first_heading_image = section.settings.first_heading_image
    assign first_heading_url = section.settings.first_heading_url
    assign second_heading = section.settings.second_heading
    assign second_heading_image = section.settings.second_heading_image
    assign second_heading_url = section.settings.second_heading_url
    assign third_heading = section.settings.third_heading
    assign third_heading_image = section.settings.third_heading_image
    assign third_heading_url = section.settings.third_heading_url

    assign heading_image_size_mobile = section.settings.heading_image_size_mobile
    assign heading_image_size = section.settings.heading_image_size   
    assign heading_image_border_thickness = section.settings.heading_image_border_thickness
    assign heading_image_border_color = section.settings.heading_image_border_color
    assign heading_image_radius = section.settings.heading_image_radius
    assign use_background_image = section.settings.use_background_image

    assign column_heading_size = section.settings.column_heading_size
    assign column_heading_size_mobile = section.settings.column_heading_size_mobile
    assign column_heading_color = section.settings.column_heading_color
    assign column_heading_active_color = section.settings.column_heading_active_color
    assign column_heading_custom = section.settings.column_heading_custom
    assign column_heading_font = section.settings.column_heading_font
    assign column_heading_height = section.settings.column_heading_height
    assign column_heading_align = section.settings.column_heading_align
    assign column_heading_align_mobile = section.settings.column_heading_align_mobile
    assign column_heading_padding_horizontal = section.settings.column_heading_padding_horizontal
    assign column_heading_padding_horizontal_mobile = section.settings.column_heading_padding_horizontal_mobile
    assign column_heading_padding_vertical = section.settings.column_heading_padding_vertical
    assign column_heading_padding_vertical_mobile = section.settings.column_heading_padding_vertical_mobile

    assign row_padding_horizontal = section.settings.row_padding_horizontal
    assign row_padding_horizontal_mobile = section.settings.row_padding_horizontal_mobile
    assign row_padding_vertical = section.settings.row_padding_vertical
    assign row_padding_vertical_mobile = section.settings.row_padding_vertical_mobile
    assign row_border_thickness = section.settings.row_border_thickness
    assign row_border_color = section.settings.row_border_color

    assign row_heading_size = section.settings.row_heading_size
    assign row_heading_size_mobile = section.settings.row_heading_size_mobile
    assign row_heading_color = section.settings.row_heading_color
    assign row_heading_custom = section.settings.row_heading_custom
    assign row_heading_font = section.settings.row_heading_font
    assign row_heading_height = section.settings.row_heading_height
    assign row_heading_border_color = section.settings.row_heading_border_color

    assign value_size = section.settings.value_size
    assign value_size_mobile = section.settings.value_size_mobile
    assign value_color = section.settings.value_color
    assign value_active_color = section.settings.value_active_color
    assign value_custom = section.settings.value_custom
    assign value_font = section.settings.value_font
    assign value_height = section.settings.value_height

    assign value_icon_size = section.settings.value_icon_size
    assign value_icon_size_mobile = section.settings.value_icon_size_mobile
    assign value_icon_color = section.settings.value_icon_color
    assign value_icon_active_color = section.settings.value_icon_active_color
    assign value_icon_check = section.settings.value_icon_check
    assign value_icon_cross = section.settings.value_icon_cross
  -%}

  {%- style -%}
    {{ heading_font | font_face: font_display: 'swap' }}
    {{ text_font | font_face: font_display: 'swap' }}
    {{ column_heading_font | font_face: font_display: 'swap' }}
    {{ row_heading_font | font_face: font_display: 'swap' }}
    {{ value_font | font_face: font_display: 'swap' }}
    
    .section-{{ section.id }} {
      border-top: solid {{ border_color }} {{ border_thickness }}px;
      border-bottom: solid {{ border_color }} {{ border_thickness }}px;
      margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
      margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px;
      margin-left: {{ margin_horizontal_mobile }}rem;
      margin-right: {{ margin_horizontal_mobile }}rem;
      border-radius: {{ section_radius | times: 0.6 | round: 0 }}px;
      overflow: visible;
    }
    
    .section-{{ section.id }}-settings {
      margin: 0 auto;
      padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
      padding-left: 16px;
      padding-right: 16px;
    }

    .comparison-heading-{{ section.id }} {
      text-align: {{ content_align_mobile }};
    }
    .comparison-heading-{{ section.id }} * {
      margin: 0;
      font-size: {{ heading_size_mobile }}px;
      color: {{ heading_color }};
      line-height: {{ heading_height }}%;
    }

    .comparison-text-{{ section.id }} {
      margin-top: {{ text_mt_mobile }}px;
      text-align: {{ content_align_mobile }};
    }
    .comparison-text-{{ section.id }} * {
      margin: 0;
      font-size: {{ text_size_mobile }}px;
      color: {{ text_color }};
      line-height: {{ text_height }}%;
    }

    .comparison-grid-{{ section.id }} {
      display: flex;
      gap: 25px;
    }

    .comparison-table-wrapper-{{ section.id }} {
      padding-top: {{ heading_image_size_mobile | divided_by: 2 }}px;
      overflow-x: auto;
      scrollbar-width: thin;
      margin-left: -{{ padding_horizontal_mobile }}rem;
      margin-right: -{{ padding_horizontal_mobile }}rem;
    }
    .comparison-table-inner-{{ section.id }} {
      /* 移除固定最小宽度，让内容自然撑开 */
      padding-left: {{ padding_horizontal_mobile }}rem;
      padding-right: {{ padding_horizontal_mobile }}rem;
      display: inline-block;
      min-width: 100%;
    }
    .comparison-table-{{ section.id }} {
      padding-bottom: 25px;
      /* 移除右侧固定 padding-right，避免额外空白 */
      margin-top: {{ table_mt_mobile }}px;
      display: inline-block;
      min-width: 100%;
    }

    .comparison-item-{{ section.id }} {
      position: relative;
      display: flex !important;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .comparison-item-bg-image-{{ section.id }} {
      position: absolute;
      z-index: 1;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border-top-left-radius: {{ table_radius }}px;
      border-top-right-radius: {{ table_radius }}px;
      overflow: hidden;
    }
    .comparison-item-bg-image-{{ section.id }} img,
    .comparison-item-bg-image-{{ section.id }} svg {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .comparison-{{ section.id }} .comparison-item-{{ section.id }} .comparison-item-bg-image-{{ section.id }} svg defs linearGradient stop {
      stop-color: {{ table_bg_image_color }} !important;
    }
    .comparison-{{ section.id }} .comparison-item-{{ section.id }}.active .comparison-item-bg-image-{{ section.id }} svg defs linearGradient stop {
      stop-color: {{ table_bg_image_active_color }} !important;
    }

    .comparison-grid-rows-{{ section.id }} .comparison-item-{{ section.id }}:first-child:after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0%;
      width: 70%;
      height: {{ row_border_thickness }}px;
      background-color: {{ row_heading_border_color }};
      mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgb(0, 0, 0) 0%, rgb(0, 0, 0) 57%, rgba(0, 0, 0, 0) 100%);
    }

    .comparison-grid-header-{{ section.id }} .comparison-item-{{ section.id }} {
      padding: {{ column_heading_padding_vertical_mobile }}px {{ column_heading_padding_horizontal_mobile }}px;  
    }
    .comparison-grid-header-{{ section.id }} .comparison-item-{{ section.id }}:not(:first-child) {
      border-top: {{ table_column_border_thickness }}px solid {{ table_column_border_color }};
      border-left: {{ table_column_border_thickness }}px solid {{ table_column_border_color }};
      border-right: {{ table_column_border_thickness }}px solid {{ table_column_border_color }};
    }
    .comparison-grid-header-{{ section.id }} .comparison-item-{{ section.id }}:not(:first-child).active {
      border-top: {{ table_column_border_thickness }}px solid {{ table_column_active_border_color }};
      border-left: {{ table_column_border_thickness }}px solid {{ table_column_active_border_color }};
      border-right: {{ table_column_border_thickness }}px solid {{ table_column_active_border_color }};
    }

    .comparison-grid-rows-{{ section.id }} .comparison-item-{{ section.id }}:not(:first-child) {
      border-left: {{ table_column_border_thickness }}px solid {{ table_column_border_color }};
      border-right: {{ table_column_border_thickness }}px solid {{ table_column_border_color }};
    }
    .comparison-grid-rows-{{ section.id }} .comparison-item-{{ section.id }}:not(:first-child).active {  
      border-left: {{ table_column_border_thickness }}px solid {{ table_column_active_border_color }};
      border-right: {{ table_column_border_thickness }}px solid {{ table_column_active_border_color }};
    }
    .comparison-grid-rows-{{ section.id }}:last-child .comparison-item-{{ section.id }}:not(:first-child) {
      border-left: {{ table_column_border_thickness }}px solid {{ table_column_border_color }};
      border-right: {{ table_column_border_thickness }}px solid {{ table_column_border_color }};
      border-bottom: {{ table_column_border_thickness }}px solid {{ table_column_border_color }};
    }
    .comparison-grid-rows-{{ section.id }}:last-child .comparison-item-{{ section.id }}:not(:first-child).active {  
      border-left: {{ table_column_border_thickness }}px solid {{ table_column_active_border_color }};
      border-right: {{ table_column_border_thickness }}px solid {{ table_column_active_border_color }};
      border-bottom: {{ table_column_border_thickness }}px solid {{ table_column_active_border_color }};
    }

    .comparison-grid-header-{{ section.id }} .comparison-item-{{ section.id }}:not(:first-child),
    .comparison-grid-rows-{{ section.id }} .comparison-item-{{ section.id }}:not(:first-child) {
      background-color: {{ table_column_bg_color }};
    }
    .comparison-grid-header-{{ section.id }} .comparison-item-{{ section.id }}.active {
      background-color: {{ table_column_active_bg_color }};    
    }

    .comparison-grid-rows-{{ section.id }}:not(:last-child) .comparison-item-{{ section.id }}:not(:first-child):after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 60%;
      height: {{ row_border_thickness }}px;
      background-color: {{ table_column_border_color }};
    }
    .comparison-grid-rows-{{ section.id }}:not(:last-child) .comparison-item-{{ section.id }}.active:after {
      background-color: {{ table_column_active_border_color }};
    }

    .comparison-grid-header-{{ section.id }} .comparison-column-heading-{{ section.id }} {
      margin: 16px 0 0 0;
      width: 100%;
      position: relative;
      z-index: 2;
      font-size: {{ column_heading_size_mobile }}px;
      color: {{ column_heading_color }};
      line-height: {{ column_heading_height }}%;
      text-align: {{ column_heading_align_mobile }};
      font-weight: 700;
    }
    .comparison-grid-header-{{ section.id }} .comparison-item-{{ section.id }}.active h3,
    .comparison-grid-header-{{ section.id }} .comparison-item-{{ section.id }}.active a {
      color: {{ column_heading_active_color }};
    }

    .comparison-grid-rows-{{ section.id }} .comparison-item-{{ section.id }} {
      padding: {{ row_padding_vertical_mobile }}px {{ row_padding_horizontal_mobile }}px;
    }

    .comparison-grid-header-{{ section.id }} + .comparison-grid-rows-{{ section.id }} .comparison-item-{{ section.id }}:first-child {
      border-top-left-radius: {{ table_radius }}px;
    }
    .comparison-grid-header-{{ section.id }} .comparison-item-{{ section.id }} {
      border-top-left-radius: {{ table_radius }}px;
      border-top-right-radius: {{ table_radius }}px;
    }
    .comparison-grid-rows-{{ section.id }}:last-child .comparison-item-{{ section.id }} {
      border-bottom-left-radius: {{ table_radius }}px;
      border-bottom-right-radius: {{ table_radius }}px;
    }

    .comparison-grid-rows-{{ section.id }} .comparison-item-{{ section.id }}.active {
      background-color: {{ table_column_active_bg_color }};
    }

    .comparison-grid-rows-{{ section.id }} .comparison-item-{{ section.id }}:first-child h3 {
      display: block;
      margin: 0;
      font-size: {{ row_heading_size_mobile }}px;
      color: {{ row_heading_color }};
      line-height: {{ row_heading_height }}%;
      text-align: left;
      font-weight: 700;
    }

    .comparison-item-heading-image-{{ section.id }} {
      display: block;
      position: relative;
      z-index: 2;
      margin-top: calc(-{{ heading_image_size_mobile | divided_by: 2 }}px - {{ column_heading_padding_vertical_mobile }}px);
      border: {{ heading_image_border_thickness }}px solid {{ heading_image_border_color }};
      border-radius: {{ heading_image_radius }}px;
      width: 100%;
      max-width: {{ heading_image_size_mobile }}px;
      overflow: hidden;
      aspect-ratio: 1/1;
    }
    .comparison-item-heading-image-{{ section.id }} img,
    .comparison-item-heading-image-{{ section.id }} svg {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .comparison-item-heading-image-{{ section.id }} svg {
      background-color: #AFAFAF;
    }

    .comparison-value-{{ section.id }} {
      margin: 0;
      font-size: {{ value_size_mobile }}px;
      color: {{ value_color }};
      line-height: {{ value_height }}%;
      text-align: center;
    }
    .comparison-item-{{ section.id }}.active .comparison-value-{{ section.id }} {
      color: {{ value_active_color }};
    }

    .comparison-value-icon-{{ section.id }} {
      width: {{ value_icon_size_mobile }}px;
      height: {{ value_icon_size_mobile }}px;    
    }
    .comparison-value-icon-{{ section.id }} img,
    .comparison-value-icon-{{ section.id }} svg {
      display: block;
      width: 100%;
      height: 100%;
    }
    .comparison-value-icon-{{ section.id }} svg path {
      fill: {{ value_icon_color }};
    }
    .comparison-item-{{ section.id }}.active .comparison-value-icon-{{ section.id }} svg path {
      fill: {{ value_icon_active_color }};
    }

    .comparison-grid-header-{{ section.id }} .comparison-item-{{ section.id }},
    .comparison-grid-rows-{{ section.id }} .comparison-item-{{ section.id }} {
      width: 220px;
    }

    /* ========== 移动端双列布局 ========== */
    .comparison-table-desktop-{{ section.id }} {
      display: none;
    }

    .comparison-mobile-{{ section.id }} {
      margin-top: {{ table_mt_mobile }}px;
      overflow: visible;
    }

    .comparison-mobile-columns-{{ section.id }} {
      display: flex;
      align-items: stretch;
      gap: 0;
    }

    .comparison-mobile-col-{{ section.id }} {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .comparison-mobile-col-primary-{{ section.id }} {
      position: relative;
      z-index: 2;
      flex: 11;
    }

    .comparison-mobile-col-secondary-{{ section.id }} {
      position: relative;
      z-index: 1;
      flex: 9;
    }

    .comparison-mobile-col-top-{{ section.id }} {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .comparison-mobile-col-image-wrap-{{ section.id }} {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      width: 100%;
      height: 100px;
      position: relative;
      z-index: 3;
      margin-bottom: -28px;
    }

    .comparison-mobile-col-image-wrap-{{ section.id }} img,
    .comparison-mobile-col-image-wrap-{{ section.id }} svg {
      display: block;
      max-height: 100%;
      max-width: 90%;
      width: auto;
      height: auto;
      object-fit: contain;
    }

    .comparison-mobile-col-primary-{{ section.id }} .comparison-mobile-col-image-wrap-{{ section.id }} img,
    .comparison-mobile-col-primary-{{ section.id }} .comparison-mobile-col-image-wrap-{{ section.id }} svg {
      max-width: 100%;
    }

    .comparison-mobile-col-header-{{ section.id }} {
      width: 100%;
      padding: 36px 8px 14px;
      text-align: center;
      leading-trim: both;
      text-edge: cap;
      font-feature-settings: "liga" off, "clig" off;
      font-size: 16px;
      font-style: normal;
      font-weight: 700;
      line-height: normal;
    }

    .comparison-mobile-col-primary-{{ section.id }} .comparison-mobile-col-header-{{ section.id }} {
      border-radius: 12px 0 0 0;
      background: linear-gradient(90deg, #F287EC 0%, #8543FF 100%);
      color: #fff;
    }

    .comparison-mobile-col-secondary-{{ section.id }} .comparison-mobile-col-header-{{ section.id }} {
      border-radius: 0 12px 0 0;
      background: #E1E1E1;
      color: #000;
    }

    .comparison-mobile-col-header-{{ section.id }} a {
      color: inherit;
      text-decoration: none;
    }

    .comparison-mobile-col-body-{{ section.id }} {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .comparison-mobile-col-primary-{{ section.id }} .comparison-mobile-col-body-{{ section.id }} {
      border-radius: 0 0 0 12px;
      background: linear-gradient(90deg, #FBE0FA 0%, #E0D0FF 100%);
    }

    .comparison-mobile-col-secondary-{{ section.id }} .comparison-mobile-col-body-{{ section.id }} {
      border-radius: 0 0 12px 0;
      background: #F5F5F5;
    }

    .comparison-mobile-col-row-{{ section.id }} {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex: 1;
      padding: 32px 16px;
      text-align: center;
      font-feature-settings: "liga" off, "clig" off;
      font-style: normal;
      line-height: 110%;
    }

    .comparison-mobile-col-primary-{{ section.id }} .comparison-mobile-col-row-{{ section.id }} {
      color: #000;
      font-size: 16px;
      font-weight: 700;
    }

    .comparison-mobile-col-secondary-{{ section.id }} .comparison-mobile-col-row-{{ section.id }} {
      color: #565656;
      font-size: 14px;
      font-weight: 500;
    }

    .comparison-mobile-col-row-{{ section.id }} .comparison-value-{{ section.id }} {
      margin: 0;
      text-align: center;
      font-feature-settings: "liga" off, "clig" off;
      font-style: normal;
      line-height: 110%;
    }

    .comparison-mobile-col-primary-{{ section.id }} .comparison-mobile-col-row-{{ section.id }} .comparison-value-{{ section.id }} {
      color: #000;
      font-size: 16px;
      font-weight: 700;
    }

    .comparison-mobile-col-secondary-{{ section.id }} .comparison-mobile-col-row-{{ section.id }} .comparison-value-{{ section.id }} {
      color: #565656;
      font-size: 14px;
      font-weight: 500;
    }

    .comparison-mobile-col-row-{{ section.id }} .comparison-value-icon-{{ section.id }} {
      margin-bottom: 4px;
    }

    @media(min-width: 1024px) {
      .comparison-table-desktop-{{ section.id }} {
        display: block;
      }

      .comparison-mobile-{{ section.id }} {
        display: none;
      }

      .section-{{ section.id }} {
        margin-top: {{ margin_top }}px;
        margin-bottom: {{ margin_bottom }}px;
        margin-left: {{ margin_horizontal }}rem;
        margin-right: {{ margin_horizontal }}rem;
        border-radius: {{ section_radius }}px;
        overflow: hidden;
      }
      .section-{{ section.id }}-settings {
        padding-top: {{ padding_top }}px;
        padding-bottom: {{ padding_bottom }}px;
        padding-left: {{ padding_horizontal }}rem;
        padding-right: {{ padding_horizontal }}rem;
      }  
      .comparison-heading-{{ section.id }} {
        text-align: {{ content_align }};
      }
      .comparison-heading-{{ section.id }} * {
        font-size: {{ heading_size }}px;
      }
      .comparison-text-{{ section.id }} {
        margin-top: {{ text_mt }}px;
        text-align: {{ content_align }};
      }
      .comparison-text-{{ section.id }} * {
        font-size: {{ text_size }}px;
      }
      .comparison-grid-{{ section.id }} {
        gap: 25px;
        justify-content: center;
      }
      .comparison-table-wrapper-{{ section.id }} {
        padding-top: {{ heading_image_size | divided_by: 2 }}px;
        margin-left: 0rem;
        margin-right: 0rem;
        overflow-x: visible;
      }
      .comparison-table-inner-{{ section.id }} {
        padding-left: 0rem;
        padding-right: 0rem;
        display: block;
      }
      .comparison-table-{{ section.id }} {
        margin-top: {{ table_mt }}px;
        padding-right: 0;
        display: block;
      }
      .comparison-item-heading-image-{{ section.id }} {
        margin-top: calc(-{{ heading_image_size | divided_by: 2 }}px - {{ column_heading_padding_vertical }}px);
        max-width: {{ heading_image_size }}px;
      }
      .comparison-grid-header-{{ section.id }} .comparison-item-{{ section.id }} {
        padding: {{ column_heading_padding_vertical }}px {{ column_heading_padding_horizontal }}px;
      }
      .comparison-grid-header-{{ section.id }} .comparison-column-heading-{{ section.id }} {
        text-align: {{ column_heading_align }};
        font-size: {{ column_heading_size }}px;
      }
      .comparison-grid-rows-{{ section.id }} .comparison-item-{{ section.id }} {
        padding: {{ row_padding_vertical }}px {{ row_padding_horizontal }}px;
      }
      .comparison-grid-rows-{{ section.id }} .comparison-item-{{ section.id }}:first-child h3 {
        font-size: {{ row_heading_size }}px;
      }
      .comparison-value-{{ section.id }} {
        font-size: {{ value_size }}px;
      }
      .comparison-value-icon-{{ section.id }} {
        width: {{ value_icon_size }}px;
        height: {{ value_icon_size }}px;
      }
    }

    /* ========== 自定义覆盖 ========== */
    /* 移动端：第一列宽73px，其他列宽147px，第一列右边距12.5px，其他列间距25px */
    .comparison-grid-header-{{ section.id }} .comparison-item-{{ section.id }}:first-child,
    .comparison-grid-rows-{{ section.id }} .comparison-item-{{ section.id }}:first-child {
      width: 73px !important;
