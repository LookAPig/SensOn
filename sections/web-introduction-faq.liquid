<style>
  #shopify-section-{{ section.id }} .web_intro_faq {
    --accent: {{ section.settings.accent_color }};
    --title: {{ section.settings.title_color }};
    --muted: {{ section.settings.description_color }};
    --question: {{ section.settings.question_color }};
    --answer: {{ section.settings.answer_color }};
    --line: {{ section.settings.divider_color }};
    background: {{ section.settings.background_color }};
    color: var(--title);
    overflow: hidden;
    padding: {{ section.settings.padding_mobile }}px 0;
  }

  #shopify-section-{{ section.id }} .web_intro_faq * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .web_intro_faq .inner {
    margin: 0 auto;
    padding: 0 16px;
  }

  #shopify-section-{{ section.id }} .web_intro_faq .eyebrow {
    color: var(--accent);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 10px;
  }

  #shopify-section-{{ section.id }} .web_intro_faq .section_title {
    color: var(--title);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .web_intro_faq .section_description {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.4;
    margin: 14px 0 0;
  }

  #shopify-section-{{ section.id }} .web_intro_faq .section_description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .web_intro_faq .faq_list {
    border-top: 1px solid var(--line);
    margin-top: 32px;
  }

  #shopify-section-{{ section.id }} .web_intro_faq .faq_item {
    border-bottom: 1px solid var(--line);
  }

  #shopify-section-{{ section.id }} .web_intro_faq .faq_item:last-child {
    border-bottom: 0;
  }

  #shopify-section-{{ section.id }} .web_intro_faq .faq_summary {
    align-items: flex-start;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    display: flex;
    gap: 10px;
    padding: 22px 0;
    text-align: left;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .web_intro_faq .faq_num {
    color: var(--accent);
    flex: 0 0 auto;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .web_intro_faq .faq_question {
    color: var(--question);
    flex: 1 1 auto;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
    min-width: 0;
    padding-right: 8px;
  }

  #shopify-section-{{ section.id }} .web_intro_faq .faq_icon {
    color: var(--accent);
    flex: 0 0 auto;
    height: 16px;
    margin-top: 4px;
    width: 16px;
  }

  #shopify-section-{{ section.id }} .web_intro_faq .faq_icon svg {
    display: block;
    height: 16px;
    transform: rotate(0deg);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    width: 16px;
  }

  #shopify-section-{{ section.id }} .web_intro_faq .faq_item.is_active .faq_icon svg {
    transform: rotate(90deg);
  }

  #shopify-section-{{ section.id }} .web_intro_faq .faq_panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease;
  }

  #shopify-section-{{ section.id }} .web_intro_faq .faq_panel_inner {
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .web_intro_faq .faq_item.is_active .faq_panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .web_intro_faq .faq_answer {
    color: var(--answer);
    font-size: 14px;
    line-height: 1.5;
    padding: 0 0 22px 30px;
  }

  #shopify-section-{{ section.id }} .web_intro_faq .faq_answer p {
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .web_intro_faq {
      padding: {{ section.settings.padding_desktop }}px 0;
    }

    #shopify-section-{{ section.id }} .web_intro_faq .inner {
      padding: 0 100px;
    }

    #shopify-section-{{ section.id }} .web_intro_faq .layout {
      align-items: start;
      display: grid;
      gap: 64px;
      grid-template-columns: minmax(240px, 0.78fr) minmax(0, 1.22fr);
    }

    #shopify-section-{{ section.id }} .web_intro_faq .eyebrow {
      font-size: 24px;
      margin-bottom: 12px;
    }

    #shopify-section-{{ section.id }} .web_intro_faq .section_title {
      font-size: 42px;
      letter-spacing: -0.03em;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .web_intro_faq .section_description {
      font-size: 16px;
      line-height: 1.5;
      margin-top: 16px;
    }

    #shopify-section-{{ section.id }} .web_intro_faq .faq_list {
      border-top: 0;
      margin-top: 0;
    }

    #shopify-section-{{ section.id }} .web_intro_faq .faq_summary {
      gap: 16px;
      padding: 28px 0;
    }

    #shopify-section-{{ section.id }} .web_intro_faq .faq_num,
    #shopify-section-{{ section.id }} .web_intro_faq .faq_question {
      font-size: 24px;
      font-weight: 600;
      line-height: 1.25;
    }

    #shopify-section-{{ section.id }} .web_intro_faq .faq_icon {
      height: 18px;
      width: 18px;
    }

    #shopify-section-{{ section.id }} .web_intro_faq .faq_icon svg {
      height: 18px;
      width: 18px;
    }

    #shopify-section-{{ section.id }} .web_intro_faq .faq_answer {
      font-size: 16px;
      line-height: 1.55;
      padding: 0 36px 28px 48px;
    }
  }
</style>

<div class="web_intro_faq" id="web-intro-faq-{{ section.id }}">
  <div class="inner">
    <div class="layout">
      <div class="intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="section_title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="section_description">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <div class="faq_list">
          {%- for block in section.blocks -%}
            {%- if block.settings.question != blank -%}
              {%- liquid
                assign num = forloop.index | prepend: '0' | slice: -2, 2
              -%}
              <article
                class="faq_item{% if forloop.first %} is_active{% endif %}"
                data-faq-item="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                <button
                  class="faq_summary"
                  type="button"
                  data-faq-trigger="{{ forloop.index0 }}"
                  aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-controls="faq-panel-{{ section.id }}-{{ forloop.index0 }}"
                >
                  <span class="faq_num">{{ num }}</span>
                  <span class="faq_question">{{ block.settings.question | escape }}</span>
                  <span class="faq_icon" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M6 3.2 11 8 6 12.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </button>
                <div
                  class="faq_panel"
                  id="faq-panel-{{ section.id }}-{{ forloop.index0 }}"
                >
                  <div class="faq_panel_inner">
                    {%- if block.settings.answer != blank -%}
                      <div class="faq_answer">{{ block.settings.answer }}</div>
                    {%- endif -%}
                  </div>
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (() => {
    const section = document.querySelector("#web-intro-faq-{{ section.id }}");

    if (!section) {
      return;
    }

    const setActiveItem = (index) => {
      section.querySelectorAll("[data-faq-item]").forEach((item) => {
        item.classList.toggle("is_active", item.dataset.faqItem === index);
      });

      section.querySelectorAll("[data-faq-trigger]").forEach((trigger) => {
        trigger.setAttribute("aria-expanded", trigger.dataset.faqTrigger === index ? "true" : "false");
      });
    };

    section.querySelectorAll("[data-faq-trigger]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        setActiveItem(trigger.dataset.faqTrigger);
      });
    });
  })();
</script>

