<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
  crossorigin="anonymous"
>

<style>
  .reviews {
    background: var(--reviews-bg);
    color: var(--reviews-fg);
    padding-bottom: 75px
  }

  .reviews .reviews_in {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 80px;
    box-sizing: border-box;
  }

  .reviews .reviews_tit {
    margin: 0 0 60px;
    text-align: center;
    font-size: 42px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--reviews-fg);
  }

  .reviews .reviews_wrap {
    position: relative;
    overflow-x: hidden;
  }

  .reviews .reviews_sw {
    overflow: hidden;
    padding-bottom: 8px;
  }

  .reviews .reviews_cd {
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
  }

  .reviews .reviews_md {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 9 / 16;
    max-height: min(52vh, 420px);
    margin: 0 auto;
    width: 100%;
    background: #111;
  }

  .reviews .reviews_po {
    position: absolute;
    inset: 0;
    z-index: 2;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .reviews .reviews_po_min {
    background: #111;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .reviews .reviews_po.reviews_po_hi {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .reviews .reviews_img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .reviews .reviews_img_st {
    position: absolute;
    inset: 0;
  }

  .reviews .reviews_pl {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 56px;
    height: 56px;
    border: none;
    border-radius: 50%;
    background: var(--reviews-pink);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .reviews .reviews_pl:hover {
    transform: scale(1.05);
    filter: brightness(1.05);
  }

  .reviews .reviews_pl_ic {
    display: flex;
    margin-left: 3px;
  }

  .reviews .reviews_vh {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .reviews .reviews_vh_bk {
    z-index: 0;
  }

  .reviews .reviews_vid {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .reviews .reviews_ph {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    font-size: 0.85rem;
    color: #888;
    padding: 16px;
    text-align: center;
  }

  .reviews .reviews_bd {
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1 1 0;
    gap: 10px;
  }

  .reviews .reviews_txt {
    font-size: 15px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.92);
    margin: 0;
    text-align: left;
  }

  .reviews .reviews_txt p {
    margin: 0;
  }

  .reviews .reviews_row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
  }

  .reviews .reviews_stars {
    display: flex;
    gap: 2px;
    color: #fff;
  }

  .reviews .reviews_st_off {
    color: rgba(255, 255, 255, 0.28);
  }

  .reviews .reviews_tag {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 4px 8px;
    border-radius: 4px;
    background: var(--reviews-pink);
    color: #fff;
    line-height: 1;
    white-space: nowrap;
  }

  /* Author section with avatar */
  .reviews_author {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 6px;
  }

  .reviews_avatar {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
  }

  .reviews_avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .reviews_author_info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .reviews_nm_line {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .reviews_nm {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--reviews-fg);
  }

  .reviews_author_details {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .reviews_desc,
  .reviews_subs {
    margin: 0;
    font-size: 13px;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.7);
  }

  .reviews_nv {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 28px;
  }

  .reviews_bt {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: #fff;
    color: #111;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease, transform 0.15s ease;
  }

  .reviews_bt:hover:not(:disabled) {
    transform: scale(1.05);
  }

  .reviews_bt:disabled,
  .reviews_bt.swiper-button-disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .reviews_st svg {
    width: 25px;
    height: 25px;
  }

  .reviews_sw .swiper-slide {
    height: auto;
  }

  .reviews_pl_ic svg {
    width: 30px;
    height: 30px;
  }

  @media (max-width: 768px) {
    .reviews .reviews_in {
      padding: 0 24px;
    }
    .reviews .reviews_tit {
      margin: 0 0 20px;
      text-align: left;
      font-size: 24px;
    }
    .reviews_st svg {
      width: 18px;
      height: 18px;
    }
    .reviews_avatar {
      width: 40px;
      height: 40px;
    }
    .reviews_nm {
      font-size: 15px;
    }
    .reviews_desc,
    .reviews_subs {
      font-size: 12px;
    }
  }
</style>

<div
  class="reviews"
  data-reviews="{{ section.id }}"
  style="--reviews-pink: #f287ec; --reviews-bg: #000000; --reviews-fg: #ffffff;"
>
  <div class="reviews_in">
    {%- unless section.settings.heading == blank -%}
      <h2 class="reviews_tit">{{ section.settings.heading | escape }}</h2>
    {%- endunless -%}

    <div class="reviews_wrap">
      <div class="swiper reviews_sw" data-reviews-sw>
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <article class="reviews_cd">
                <div class="reviews_md">
                  {%- liquid
                    assign reviews_has_po = false
                    if block.settings.cover != blank
                      assign reviews_has_po = true
                    elsif block.settings.video != blank and block.settings.video.preview_image
                      assign reviews_has_po = true
                    endif
                  -%}
                  {%- if block.settings.video != blank -%}
                    {%- if block.settings.cover != blank -%}
                      <div class="reviews_po" data-reviews-po>
                        {{
                          block.settings.cover
                          | image_url: width: 800
                          | image_tag:
                            loading: 'lazy',
                            class: 'reviews_img',
                            widths: '400, 600, 800',
                            sizes: '(min-width: 990px) 22vw, 82vw',
                            alt: block.settings.creator_name
                            | default: 'Video cover'
                            | escape
                        }}
                        <button
                          type="button"
                          class="reviews_pl"
                          aria-label="{{ 'general.accessibility.play_video' | t | default: 'Play video' }}"
                          data-reviews-pl
                        >
                          <span class="reviews_pl_ic" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M8 5v14l11-7z"/>
                            </svg>
                          </span>
                        </button>
                      </div>
                    {%- elsif block.settings.video.preview_image -%}
                      <div class="reviews_po" data-reviews-po>
                        {{
                          block.settings.video.preview_image
                          | image_url: width: 800
                          | image_tag:
                            loading: 'lazy',
                            class: 'reviews_img',
                            widths: '400, 600, 800',
                            sizes: '(min-width: 990px) 22vw, 82vw',
                            alt: block.settings.creator_name
                            | default: 'Video'
                            | escape
                        }}
                        <button
                          type="button"
                          class="reviews_pl"
                          aria-label="{{ 'general.accessibility.play_video' | t | default: 'Play video' }}"
                          data-reviews-pl
                        >
                          <span class="reviews_pl_ic" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M8 5v14l11-7z"/>
                            </svg>
                          </span>
                        </button>
                      </div>
                    {%- endif -%}
                    {%- unless reviews_has_po -%}
                      <div class="reviews_po reviews_po_min" data-reviews-po>
                        <button
                          type="button"
                          class="reviews_pl"
                          aria-label="{{ 'general.accessibility.play_video' | t | default: 'Play video' }}"
                          data-reviews-pl
                        >
                          <span class="reviews_pl_ic" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M8 5v14l11-7z"/>
                            </svg>
                          </span>
                        </button>
                      </div>
                    {%- endunless -%}
                    <div class="reviews_vh reviews_vh_bk">
                      {{
                        block.settings.video
                        | video_tag:
                          class: 'reviews_vid',
                          playsinline: true,
                          controls: false,
                          preload: 'none',
                          muted: false,
                          loop: false,
                          image_size: '800x'
                      }}
                    </div>
                  {%- elsif block.settings.cover != blank -%}
                    {{
                      block.settings.cover
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        class: 'reviews_img reviews_img_st',
                        widths: '400, 600, 800',
                        sizes: '(min-width: 990px) 22vw, 82vw',
                        alt: block.settings.creator_name
                        | default: 'Image'
                        | escape
                    }}
                  {%- else -%}
                    <div class="reviews_ph">Add video or cover image</div>
                  {%- endif -%}
                </div>

                <div class="reviews_bd">
                  {%- unless block.settings.comment == blank -%}
                    <div class="reviews_txt rte">{{ block.settings.comment }}</div>
                  {%- endunless -%}

                  <div>
                    <div class="reviews_row">
                      {%- unless section.settings.show_stars == false -%}
                        {%- liquid
                          assign stars = block.settings.stars | default: 5
                          if stars > 5
                            assign stars = 5
                          endif
                          if stars < 1
                            assign stars = 1
                          endif
                        -%}
                        <div class="reviews_stars" aria-label="{{ stars }} of 5 stars">
                          {%- for i in (1..5) -%}
                            <span class="reviews_st{% if i > stars %} reviews_st_off{% endif %}" aria-hidden="true">
                              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                              </svg>
                            </span>
                          {%- endfor -%}
                        </div>
                      {%- endunless -%}
                    </div>

                    <div class="reviews_author">
                      {%- if block.settings.avatar != blank -%}
                        <div class="reviews_avatar">
                          {{
                            block.settings.avatar
                            | image_url: width: 100
                            | image_tag:
                              loading: 'lazy',
                              widths: '50, 100',
                              sizes: '48px',
                              alt: block.settings.creator_name | default: 'Avatar' | escape
                          }}
                        </div>
                      {%- endif -%}

                      <div class="reviews_author_info">
                        <div class="reviews_nm_line">
                          {%- unless block.settings.creator_name == blank -%}
                            <p class="reviews_nm">{{ block.settings.creator_name | escape }}</p>
                          {%- endunless -%}
                          <span class="reviews_tag">Verified Creator</span>
                        </div>

                        {%- if block.settings.creator_desc != blank or block.settings.creator_subs != blank -%}
                          <div class="reviews_author_details">
                            {%- unless block.settings.creator_desc == blank -%}
                              <p class="reviews_desc">{{ block.settings.creator_desc | escape }}</p>
                            {%- endunless -%}
                            {%- unless block.settings.creator_subs == blank -%}
                              <p class="reviews_subs">{{ block.settings.creator_subs | escape }}</p>
                            {%- endunless -%}
                          </div>
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                </div>
              </article>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="reviews_nv">
        <button type="button" class="reviews_bt reviews_bt_pr" aria-label="{{ 'general.pagination.previous' | t }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button type="button" class="reviews_bt reviews_bt_ne" aria-label="{{ 'general.pagination.next' | t }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script
  data-reviews-sc="{{ section.id }}"
  src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
  defer
></script>
<script>
  (function () {
    var root = document.querySelector('.reviews[data-reviews="{{ section.id }}"]');
    if (!root) return;

    function initSwiper() {
      if (typeof Swiper === 'undefined') return false;
      var el = root.querySelector('[data-reviews-sw]');
      if (!el || el.dataset.reviewsInited === '1') return true;
      var prev = root.querySelector('.reviews_bt_pr');
      var next = root.querySelector('.reviews_bt_ne');

      var swiper = new Swiper(el, {
        slidesPerView: 1.2,
        spaceBetween: 14,
        watchOverflow: true,
        observer: true,
        observeParents: true,
        navigation: {
          prevEl: prev,
          nextEl: next,
        },
        breakpoints: {
          990: {
            slidesPerView: 4,
            spaceBetween: 20,
          },
        },
      });

      el.dataset.reviewsInited = '1';
      el._reviewsSwiper = swiper;

      root.querySelectorAll('[data-reviews-pl]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var slide = btn.closest('.swiper-slide');
          if (!slide) return;
          var poster = slide.querySelector('[data-reviews-po]');
          var video = slide.querySelector('.reviews_vid');
          if (!video) return;
          if (poster) poster.classList.add('reviews_po_hi');
          video.setAttribute('controls', 'controls');
          video.play().catch(function () {});
        });
      });

      return true;
    }

    function tryInit() {
      if (initSwiper()) return;
      var s = document.querySelector('script[data-reviews-sc="{{ section.id }}"]');
      if (s && !s.dataset.reviewsListen) {
        s.dataset.reviewsListen = '1';
        s.addEventListener('load', tryInit);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', tryInit);
    } else {
      tryInit();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.target.contains && e.target.contains(root)) tryInit();
    });
  })();
</script>

{% schema %}
{
  "name": "Reviews with video",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Creators Are Saying"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show star rating",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "cover",
          "label": "Video cover image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (upload)"
        },
        {
          "type": "richtext",
          "id": "comment",
          "label": "Comment",
          "default": "<p>Share what creators said about your product.</p>"
        },
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "header",
          "content": "Creator profile"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar image"
        },
        {
          "type": "text",
          "id": "creator_name",
          "label": "Creator name",
          "default": "Creator name"
        },
        {
          "type": "text",
          "id": "creator_desc",
          "label": "Creator description (optional)",
          "default": "Actress, Self-Growth Nerd"
        },
        {
          "type": "text",
          "id": "creator_subs",
          "label": "Subscribers / stats line (optional)",
          "default": "14.2M Subscribers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews with video",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "comment": "<p>Amazing experience and seamless sync with the app.</p>",
            "stars": 5,
            "creator_name": "Alex M.",
            "creator_desc": "Tech Creator",
            "creator_subs": "1.2M Followers"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "comment": "<p>My audience loved the story modes — highly recommend.</p>",
            "stars": 5,
            "creator_name": "Jordan K.",
            "creator_desc": "Lifestyle Creator",
            "creator_subs": "850K Subscribers"
          }
        }
      ]
    }
  ]
}
{% endschema %}