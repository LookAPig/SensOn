{%- liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  if desktop_image == blank
    assign desktop_image = mobile_image
  endif
  if mobile_image == blank
    assign mobile_image = desktop_image
  endif
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign heading = section.settings.heading
  assign heading_mobile = section.settings.heading_mobile
  if heading_mobile == blank
    assign heading_mobile = heading
  endif
-%}
<style>
  #shopify-section-{{ section.id }} .press_media_overlay {
    --subtitle-color: {{ section.settings.subtitle_color }};
    --heading-color: {{ section.settings.heading_color }};
    --description-color: {{ section.settings.description_color }};
    --btn-bg: {{ section.settings.button_bg }};
    --btn-color: {{ section.settings.button_text_color }};
    background: #1a1218;
    min-height: {{ section.settings.mobile_height | default: 560 }}px;
    overflow: hidden;
    position: relative;
  }
  #shopify-section-{{ section.id }} .press_media_overlay * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .press_media_overlay .media,
  #shopify-section-{{ section.id }} .press_media_overlay .image,
  #shopify-section-{{ section.id }} .press_media_overlay .placeholder {
    height: 100%; inset: 0; position: absolute; width: 100%;
  }
  #shopify-section-{{ section.id }} .press_media_overlay .image { object-fit: cover; object-position: center bottom; }
  #shopify-section-{{ section.id }} .press_media_overlay .desktop_image { display: none; }
  #shopify-section-{{ section.id }} .press_media_overlay .placeholder {
    background: linear-gradient(180deg, #2a1a24 0%, #4a3040 100%);
  }
  #shopify-section-{{ section.id }} .press_media_overlay .shade {
    background: linear-gradient(180deg, rgba(0,0,0,.5) 0%, rgba(0,0,0,.12) 42%, rgba(0,0,0,.28) 100%);
    inset: 0; pointer-events: none; position: absolute; z-index: 1;
  }
  #shopify-section-{{ section.id }} .press_media_overlay .content {
    align-items: center; display: flex; flex-direction: column; padding: 28px 20px 0; position: relative;
    text-align: center; z-index: 2;
  }
  #shopify-section-{{ section.id }} .press_media_overlay .subtitle {
    color: var(--subtitle-color); font-size: {{ section.settings.subtitle_font_size_mobile }}px;
    font-weight: 500; line-height: 1.3; margin: 0 0 10px;
  }
  #shopify-section-{{ section.id }} .press_media_overlay .title {
    color: var(--heading-color); font-size: {{ section.settings.heading_font_size_mobile }}px;
    font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; margin: 0; max-width: 340px;
  }
  #shopify-section-{{ section.id }} .press_media_overlay .title--desktop { display: none; }
  #shopify-section-{{ section.id }} .press_media_overlay .description {
    color: var(--description-color); font-size: {{ section.settings.description_font_size_mobile }}px;
    line-height: 1.45; margin: 12px 0 0; max-width: 340px;
  }
  #shopify-section-{{ section.id }} .press_media_overlay .description p { margin: 0; }
  #shopify-section-{{ section.id }} .press_media_overlay .cta {
    align-items: center; background: var(--btn-bg); border-radius: 100px; color: var(--btn-color);
    display: inline-flex; font-size: 14px; font-weight: 500; height: 36px; justify-content: center;
    margin-top: 20px; text-decoration: none; width: 162px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .press_media_overlay {
      min-height: {{ section.settings.desktop_height | default: 420 }}px;
    }
    #shopify-section-{{ section.id }} .press_media_overlay .desktop_image { display: block; object-position: center; }
    #shopify-section-{{ section.id }} .press_media_overlay .mobile_image { display: none; }
    #shopify-section-{{ section.id }} .press_media_overlay .shade {
      background: linear-gradient(90deg, rgba(0,0,0,.08) 38%, rgba(0,0,0,.42) 100%);
    }
    #shopify-section-{{ section.id }} .press_media_overlay .content {
      align-items: flex-start; inset: 0; justify-content: center; margin-left: auto;
      max-width: min(640px, 48%); padding: 48px 80px 48px 24px; position: absolute; text-align: left;
    }
    #shopify-section-{{ section.id }} .press_media_overlay .subtitle { font-size: {{ section.settings.subtitle_font_size }}px; margin-bottom: 12px; }
    #shopify-section-{{ section.id }} .press_media_overlay .title {
      font-size: {{ section.settings.heading_font_size }}px; max-width: none;
    }
    #shopify-section-{{ section.id }} .press_media_overlay .title--mobile { display: none; }
    #shopify-section-{{ section.id }} .press_media_overlay .title--desktop { display: block; }
    #shopify-section-{{ section.id }} .press_media_overlay .description {
      font-size: {{ section.settings.description_font_size }}px; margin-top: 16px; max-width: 560px;
    }
    #shopify-section-{{ section.id }} .press_media_overlay .cta { font-size: 20px; height: 48px; width: 220px; }
  }
</style>

<section class="press_media_overlay">
  <div class="media" aria-hidden="true">
    {%- if desktop_image != blank -%}
      {{- desktop_image | image_url: width: 2400 | image_tag: class: 'image desktop_image', loading: 'lazy', sizes: '100vw', widths: '750, 1000, 1200, 1600, 2000, 2400' -}}
    {%- endif -%}
    {%- if mobile_image != blank -%}
      {{- mobile_image | image_url: width: 1000 | image_tag: class: 'image mobile_image', loading: 'lazy', sizes: '100vw', widths: '375, 550, 750, 1000' -}}
    {%- endif -%}
    {%- if desktop_image == blank and mobile_image == blank -%}<div class="placeholder"></div>{%- endif -%}
  </div>
  <div class="shade" aria-hidden="true"></div>
  <div class="content">
    {%- if section.settings.subtitle != blank -%}
      <p class="subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
    {%- if heading != blank or heading_mobile != blank -%}
      {%- if heading_mobile != heading -%}
        {%- if heading_mobile != blank -%}
          <{{ heading_tag }} class="title title--mobile">{{ heading_mobile | escape | newline_to_br }}</{{ heading_tag }}>
        {%- endif -%}
        {%- if heading != blank -%}
          <{{ heading_tag }} class="title title--desktop">{{ heading | escape | newline_to_br }}</{{ heading_tag }}>
        {%- endif -%}
      {%- else -%}
        <{{ heading_tag }} class="title">{{ heading | escape | newline_to_br }}</{{ heading_tag }}>
      {%- endif -%}
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="description">{{ section.settings.description }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="cta" href="{{ section.settings.button_url }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Press media overlay",
  "tag": "section",
  "class": "shopify-section--press-media-overlay",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "图片" },
    { "type": "image_picker", "id": "desktop_image", "label": "电脑端图片" },
    { "type": "image_picker", "id": "mobile_image", "label": "移动端图片", "info": "未设置时使用电脑端图片。" },
    { "type": "number", "id": "desktop_height", "label": "电脑端高度（px）", "default": 420 },
    { "type": "number", "id": "mobile_height", "label": "移动端高度（px）", "default": 560 },
    { "type": "header", "content": "文案" },
    { "type": "text", "id": "subtitle", "label": "副标题", "default": "Independent editorial review" },
    { "type": "range", "id": "subtitle_font_size", "label": "副标题字号（电脑）", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "subtitle_font_size_mobile", "label": "副标题字号（移动）", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "color", "id": "subtitle_color", "label": "副标题颜色", "default": "#F287EC" },
    { "type": "textarea", "id": "heading", "label": "大标题", "default": "I Tried a Sex Toy With Built-In, Personalized AI Erotica—It Was the Most Unhinged Tech I’ve Ever Tested" },
    { "type": "textarea", "id": "heading_mobile", "label": "大标题（移动）", "info": "留空则使用电脑端大标题。" },
    { "type": "range", "id": "heading_font_size", "label": "大标题字号（电脑）", "min": 18, "max": 48, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "heading_font_size_mobile", "label": "大标题字号（移动）", "min": 16, "max": 36, "step": 1, "unit": "px", "default": 22 },
    { "type": "color", "id": "heading_color", "label": "大标题颜色", "default": "#FFFFFF" },
    { "type": "select", "id": "heading_tag", "label": "标题标签", "options": [
      { "value": "h1", "label": "H1" },
      { "value": "h2", "label": "H2" },
      { "value": "h3", "label": "H3" }
    ], "default": "h2" },
    { "type": "richtext", "id": "description", "label": "描述", "default": "<p>SheKnows writer Delilah Gray tested the SensOn S1 experience firsthand, from AI storytelling and voice interaction to synchronized stimulation.</p>" },
    { "type": "range", "id": "description_font_size", "label": "描述字号（电脑）", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "description_font_size_mobile", "label": "描述字号（移动）", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 13 },
    { "type": "color", "id": "description_color", "label": "描述颜色", "default": "#FFFFFF" },
    { "type": "header", "content": "按钮" },
    { "type": "text", "id": "button_label", "label": "按钮文案", "default": "Know More" },
    { "type": "url", "id": "button_url", "label": "按钮链接" },
    { "type": "color", "id": "button_bg", "label": "按钮背景", "default": "#F287EC" },
    { "type": "color", "id": "button_text_color", "label": "按钮文字", "default": "#000000" }
  ],
  "presets": [{ "name": "Press media overlay", "category": "Banners" }]
}
{% endschema %}
