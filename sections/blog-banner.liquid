<style>
  #shopify-section-{{ section.id }} .blog-banner-clickable,
  #shopify-section-{{ section.id }} .blog-banner-carousel {
    position: relative;
    isolation: isolate;
  }

  #shopify-section-{{ section.id }} .blog-banner-clickable > .content-box__background-media {
    z-index: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .blog-banner-image-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    border-radius: inherit;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .blog-banner-image-link:focus-visible {
    outline: 3px solid #F287EC;
    outline-offset: -3px;
  }

  #shopify-section-{{ section.id }} .blog-banner-clickable > .blog-banner-content,
  #shopify-section-{{ section.id }} .blog-banner-carousel > .blog-banner-content {
    position: relative;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .blog-banner-clickable > .blog-banner-content {
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .blog-banner-clickable .blog-banner-content :is(
    a,
    button,
    input,
    select,
    textarea,
    label,
    summary,
    [role="button"],
    [tabindex]
  ) {
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .blog_banner_section .button-group .button .button__content .icon {
    margin: 0;
    margin-block-start: 0;
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .blog_banner_section > *:nth-child(1) p {
    color: #c8a0e8;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .blog_banner_section {
      width: 100%;
      max-width: 100%;
      padding-inline: 0.5rem;
    }

    #shopify-section-{{ section.id }} .blog_banner_section > *:nth-child(1) p {
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.18em;
      line-height: 1.4;
      margin-block: 0 0.875rem;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .blog_banner_section .custom-responsive-heading {
      margin-block-end: 0.625rem;
    }

    #shopify-section-{{ section.id }} .blog_banner_section .custom-responsive-heading .heading {
      letter-spacing: -0.01em;
    }

    #shopify-section-{{ section.id }} .blog_banner_section .subheading {
      background: none !important;
      border: none !important;
      color: #9ca3af !important;
      display: block;
      font-size: 0.8125rem;
      font-weight: 400;
      letter-spacing: 0.01em;
      line-height: 1.65;
      padding: 0 !important;
    }

    #shopify-section-{{ section.id }} .blog_banner_section > *:nth-child(4) p {
      color: rgb(255 255 255 / 0.85);
      font-size: 0.75rem;
      letter-spacing: 0.03em;
      line-height: 1.5;
      margin-block: 1rem 0;
    }

    #shopify-section-{{ section.id }} .blog_banner_section .button-group {
      display: flex;
      flex-wrap: nowrap;
      gap: 0.625rem;
      justify-content: center;
      margin-block-start: 1.25rem;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .blog_banner_section .button-group .button {
      --button-padding-block: 0.625rem;
      --button-padding-inline: 0.875rem;
      border-radius: 999px;
      flex: 1 1 0;
      font-size: 0.625rem;
      letter-spacing: 0.01em;
      line-height: 1.2;
      min-width: 0;
      text-transform: none;
    }

    #shopify-section-{{ section.id }} .blog_banner_section .button-group .button .button__content {
      align-items: center;
      column-gap: 0.375rem;
      justify-content: center;
      padding: var(--button-padding-block) var(--button-padding-inline);
      text-align: center;
      white-space: normal;
    }

    #shopify-section-{{ section.id }} .blog_banner_section .button-group .button .button__content .icon,
    #shopify-section-{{ section.id }} .blog_banner_section .button-group .button .button__content svg {
      flex-shrink: 0;
      height: 1rem;
      margin: 0;
      margin-block-start: 0;
      margin-top: 0;
      width: 1rem;
    }

    #shopify-section-{{ section.id }} .blog_banner_section .button-group .button:not(.button--outline) {
      --button-background: 242 135 236;
      --button-text-color: 0 0 0;
      background: rgb(var(--button-background));
      border-color: rgb(var(--button-background));
      color: rgb(var(--button-text-color));
    }

    #shopify-section-{{ section.id }} .blog_banner_section .button-group .button--outline {
      --button-text-color: 255 255 255;
      background: transparent;
      border-color: rgb(255 255 255 / 0.9);
      color: rgb(var(--button-text-color));
    }
  }

  #shopify-section-{{ section.id }} .blog-banner-carousel > .blog-banner-slide {
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 450ms ease;
  }

  #shopify-section-{{ section.id }} .blog-banner-carousel > .blog-banner-slide.is-active {
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .blog-banner-carousel > .blog-banner-slide--overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} senson-blog-banner-rotation {
    position: absolute;
    inset-inline-end: 0.75rem;
    inset-block-end: 0.75rem;
    z-index: 3;
  }

  #shopify-section-{{ section.id }} .blog-banner-rotation-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.65);
    color: white;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .blog-banner-rotation-toggle[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .blog-banner-carousel > .blog-banner-slide {
      transition: none;
    }
  }
</style>

{%- liquid
  assign banner_image_keys = 'image,image_2,image_3' | split: ','
  assign banner_image_count = 0

  for image_key in banner_image_keys
    assign selected_image = section.settings[image_key]
    if selected_image == blank
      continue
    endif

    if banner_image_count == 0
      assign first_banner_key = image_key
      assign mobile_image_key = 'mobile_' | append: image_key
      assign banner_image = selected_image
      assign banner_mobile_image = section.settings[mobile_image_key]
    endif

    assign banner_image_count = banner_image_count | plus: 1
  endfor

  assign carousel_enabled = false
  if banner_image_count > 1
    assign carousel_enabled = true
  endif

  assign whole_image_link_enabled = false
  if section.settings.enable_whole_image_link and section.settings.whole_image_link != blank
    assign whole_image_link_enabled = true
  endif

  assign whole_image_link_label = section.settings.whole_image_link_label | default: '查看详情'
-%}

<div
  {% if section.settings.allow_transparent_header %}
    allow-transparent-header
  {% endif %}
  class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}"
>
  <div class="content-box min-h-{{ section.settings.image_size }}{% if carousel_enabled %} blog-banner-carousel{% endif %}{% if whole_image_link_enabled %} blog-banner-clickable{% endif %}">

    <div class="content-box__background-media{% if carousel_enabled %} blog-banner-slide is-active{% endif %}">
      {%- liquid
        if banner_image != blank
          render 'media' with banner_image, mobile_media: banner_mobile_image, preload: true
        else
          echo 'hero-apparel-1' | placeholder_svg_tag: 'size-full'
        endif
      -%}
    </div>

    {%- if carousel_enabled -%}
      {%- for image_key in banner_image_keys -%}
        {%- assign slide_image = section.settings[image_key] -%}
        {%- if image_key == first_banner_key or slide_image == blank -%}
          {%- continue -%}
        {%- endif -%}
        {%- assign mobile_image_key = 'mobile_' | append: image_key -%}
        {%- assign slide_mobile_image = section.settings[mobile_image_key] -%}
        <div class="content-box__background-media blog-banner-slide blog-banner-slide--overlay" aria-hidden="true">
          {%- render 'media' with slide_image, mobile_media: slide_mobile_image, preload: false -%}
        </div>
      {%- endfor -%}
    {%- endif -%}

    {%- if whole_image_link_enabled -%}
      <a
        class="blog-banner-image-link"
        href="{{ section.settings.whole_image_link | escape }}"
        aria-label="{{ whole_image_link_label | escape }}"
      ></a>
    {%- endif -%}

    {%- capture blocks -%}
      {% content_for 'blocks' %}
    {%- endcapture -%}

    {%- if section.blocks.size > 0 -%}
      {%- assign mobile_text_alignment = section.settings.mobile_text_position | split: '-' | last -%}
      {%- assign desktop_text_alignment = section.settings.desktop_text_position | split: '-' | last -%}

      {%- if section.settings.enable_sticky_content -%}
        <div class="blog-banner-content justify-self-{{ mobile_text_alignment }} sm:justify-self-{{ desktop_text_alignment }}">
          <div class="sticky">
            <div class="blog_banner_section max-w-{{ section.settings.content_width }} prose prose-justify-{{ mobile_text_alignment }} sm:prose-justify-{{ desktop_text_alignment }}">
              {{- blocks -}}
            </div>
          </div>
        </div>
      {%- else -%}
        <div class="blog-banner-content {{ section.settings.mobile_text_position }} {{ section.settings.desktop_text_position }}">
          <div class="blog_banner_section max-w-{{ section.settings.content_width }} prose prose-justify-{{ mobile_text_alignment }} sm:prose-justify-{{ desktop_text_alignment }}">
            {{- blocks -}}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if carousel_enabled -%}
      <senson-blog-banner-rotation>
        <button class="blog-banner-rotation-toggle" type="button" aria-label="Pause slideshow" hidden>
          <span aria-hidden="true">❚❚</span>
        </button>
      </senson-blog-banner-rotation>
    {%- endif -%}
  </div>
</div>

{% javascript %}
  if (!customElements.get('senson-blog-banner-rotation')) {
    customElements.define('senson-blog-banner-rotation', class extends HTMLElement {
      connectedCallback() {
        const carousel = this.closest('.blog-banner-carousel');
        const slides = [...carousel.querySelectorAll(':scope > .blog-banner-slide')];
        const toggle = this.querySelector('button');
        const indicator = toggle.querySelector('span');
        const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let current = slides.findIndex(slide => slide.classList.contains('is-active'));

        const setPlaying = (playing) => {
          window.clearInterval(this.timer);
          this.timer = null;

          if (playing) {
            this.timer = window.setInterval(() => {
              slides[current].classList.remove('is-active');
              slides[current].setAttribute('aria-hidden', 'true');
              current = (current + 1) % slides.length;
              slides[current].classList.add('is-active');
              slides[current].removeAttribute('aria-hidden');
            }, 5000);
          }

          toggle.setAttribute('aria-label', playing ? 'Pause slideshow' : 'Play slideshow');
          indicator.textContent = playing ? '❚❚' : '▶';
        };

        this.listeners = new AbortController();
        const options = { signal: this.listeners.signal };

        toggle.addEventListener('click', () => setPlaying(this.timer === null), options);
        motion.addEventListener('change', () => {
          if (motion.matches) setPlaying(false);
        }, options);

        toggle.hidden = false;
        setPlaying(!motion.matches);
      }

      disconnectedCallback() {
        window.clearInterval(this.timer);
        this.listeners.abort();
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.blog_banner.name",
  "class": "shopify-section--image-with-text-overlay",
  "tag": "section",
  "max_blocks": 10,
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-3"
    },
    {
      "type": "checkbox",
      "id": "allow_transparent_header",
      "label": "t:global.section.allow_transparent_header",
      "info": "t:global.section.allow_transparent_header_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.image_with_text_overlay.image_category"
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "t:global.image.size",
      "options": [
        { "value": "auto", "label": "t:global.sizes.original_image_ratio" },
        { "value": "xs", "label": "t:global.sizes.x_small" },
        { "value": "sm", "label": "t:global.sizes.small" },
        { "value": "md", "label": "t:global.sizes.medium" },
        { "value": "lg", "label": "t:global.sizes.large" },
        { "value": "fill", "label": "t:global.sizes.fit_screen" }
      ],
      "info": "t:global.image.ratio_avoid_cropping_info",
      "default": "auto"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:global.image.image",
      "info": "t:sections.image_with_text_overlay.image_size_recommendation"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:global.image.mobile_image",
      "info": "t:sections.image_with_text_overlay.mobile_image_size_recommendation"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "轮播第 2 张图",
      "info": "上传至少两张主图后，每 5 秒自动切换一次。"
    },
    {
      "type": "image_picker",
      "id": "mobile_image_2",
      "label": "第 2 张图 · 移动端（选填）"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "轮播第 3 张图"
    },
    {
      "type": "image_picker",
      "id": "mobile_image_3",
      "label": "第 3 张图 · 移动端（选填）"
    },
    {
      "type": "header",
      "content": "整图跳转"
    },
    {
      "type": "checkbox",
      "id": "enable_whole_image_link",
      "label": "开启整图跳转",
      "default": false
    },
    {
      "type": "url",
      "id": "whole_image_link",
      "label": "跳转链接",
      "info": "开启后，点击图片或文字区域跳转；原有按钮保留各自链接。"
    },
    {
      "type": "text",
      "id": "whole_image_link_label",
      "label": "链接说明",
      "default": "查看详情",
      "info": "供屏幕阅读器识别，例如：查看黑五活动。"
    },
    {
      "type": "header",
      "content": "t:sections.image_with_text_overlay.layout_category"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_content",
      "label": "t:global.section.content_follows_on_scroll",
      "info": "t:global.section.content_follows_on_scroll_info",
      "default": false
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:global.sizes.content_width",
      "options": [
        { "value": "sm", "label": "t:global.sizes.small" },
        { "value": "md", "label": "t:global.sizes.medium" },
        { "value": "lg", "label": "t:global.sizes.large" },
        { "value": "full", "label": "t:global.sizes.full_width" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "desktop_text_position",
      "label": "t:global.position.desktop_content_position",
      "options": [
        { "value": "sm:place-self-start", "label": "t:global.position.top_left" },
        { "value": "sm:place-self-start-center", "label": "t:global.position.top_center" },
        { "value": "sm:place-self-start-end", "label": "t:global.position.top_right" },
        { "value": "sm:place-self-center-start", "label": "t:global.position.middle_left" },
        { "value": "sm:place-self-center", "label": "t:global.position.middle_center" },
        { "value": "sm:place-self-center-end", "label": "t:global.position.middle_right" },
        { "value": "sm:place-self-end-start", "label": "t:global.position.bottom_left" },
        { "value": "sm:place-self-end-center", "label": "t:global.position.bottom_center" },
        { "value": "sm:place-self-end", "label": "t:global.position.bottom_right" }
      ],
      "default": "sm:place-self-center"
    },
    {
      "type": "select",
      "id": "mobile_text_position",
      "label": "t:global.position.mobile_content_position",
      "options": [
        { "value": "place-self-start", "label": "t:global.position.top_left" },
        { "value": "place-self-start-center", "label": "t:global.position.top_center" },
        { "value": "place-self-start-end", "label": "t:global.position.top_right" },
        { "value": "place-self-center-start", "label": "t:global.position.middle_left" },
        { "value": "place-self-center", "label": "t:global.position.middle_center" },
        { "value": "place-self-center-end", "label": "t:global.position.middle_right" },
        { "value": "place-self-end-start", "label": "t:global.position.bottom_left" },
        { "value": "place-self-end-center", "label": "t:global.position.bottom_center" },
        { "value": "place-self-end", "label": "t:global.position.bottom_right" }
      ],
      "default": "place-self-center"
    }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "icon" },
    { "type": "subheading" },
    { "type": "heading" },
    { "type": "button-group" },
    { "type": "button" },
    { "type": "rich-text" },
    { "type": "liquid" }
  ],
  "presets": [
    {
      "name": "t:sections.blog_banner.name",
      "category": "t:global.categories.banners",
      "blocks": [
        {
          "type": "subheading",
          "settings": { "text": "Subheading" }
        },
        {
          "type": "heading",
          "settings": { "text": "Image with text overlay" }
        },
        { "type": "rich-text" }
      ]
    }
  ]
}
{% endschema %}