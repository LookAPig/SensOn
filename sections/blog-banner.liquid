
<style>
  #shopify-section-{{ section.id }} .blog-banner-clickable {
    position: relative;
    isolation: isolate;
  }

  #shopify-section-{{ section.id }} .blog-banner-clickable > .content-box__background-media {
    z-index: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .blog-banner-image-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    border-radius: inherit;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .blog-banner-image-link[hidden] {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .blog-banner-image-link:focus-visible {
    outline: 3px solid #F287EC;
    outline-offset: -3px;
  }

  #shopify-section-{{ section.id }} .blog-banner-clickable > .blog-banner-content {
    position: relative;
    z-index: 2;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .blog-banner-clickable .blog-banner-content :is(
    a, button, input, select, textarea, label, summary,
    [role="button"], [tabindex]
  ) {
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .blog_banner_section .button-group .button .button__content .icon {
    margin: 0;
    margin-block-start: 0;
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .blog_banner_section > *:nth-child(1) p {
    color: #c8a0e8;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .blog_banner_section {
      width: 100%;
      max-width: 100%;
      padding-inline: 0.5rem;
    }

    #shopify-section-{{ section.id }} .blog_banner_section > *:nth-child(1) p {
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.18em;
      line-height: 1.4;
      margin-block: 0 0.875rem;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .blog_banner_section .custom-responsive-heading {
      margin-block-end: 0.625rem;
    }

    #shopify-section-{{ section.id }} .blog_banner_section .custom-responsive-heading .heading {
      letter-spacing: -0.01em;
    }

    #shopify-section-{{ section.id }} .blog_banner_section .subheading {
      background: none !important;
      border: none !important;
      color: #9ca3af !important;
      display: block;
      font-size: 0.8125rem;
      font-weight: 400;
      letter-spacing: 0.01em;
      line-height: 1.65;
      padding: 0 !important;
    }

    #shopify-section-{{ section.id }} .blog_banner_section > *:nth-child(4) p {
      color: rgb(255 255 255 / 0.85);
      font-size: 0.75rem;
      letter-spacing: 0.03em;
      line-height: 1.5;
      margin-block: 1rem 0;
    }

    #shopify-section-{{ section.id }} .blog_banner_section .button-group {
      display: flex;
      flex-wrap: nowrap;
      gap: 0.625rem;
      justify-content: center;
      margin-block-start: 1.25rem;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .blog_banner_section .button-group .button {
      --button-padding-block: 0.625rem;
      --button-padding-inline: 0.875rem;
      border-radius: 999px;
      flex: 1 1 0;
      font-size: 0.625rem;
      letter-spacing: 0.01em;
      line-height: 1.2;
      min-width: 0;
      text-transform: none;
    }

    #shopify-section-{{ section.id }} .blog_banner_section .button-group .button .button__content {
      align-items: center;
      column-gap: 0.375rem;
      justify-content: center;
      padding: var(--button-padding-block) var(--button-padding-inline);
      text-align: center;
      white-space: normal;
    }

    #shopify-section-{{ section.id }} .blog_banner_section .button-group .button .button__content .icon,
    #shopify-section-{{ section.id }} .blog_banner_section .button-group .button .button__content svg {
      flex-shrink: 0;
      height: 1rem;
      margin: 0;
      margin-block-start: 0;
      margin-top: 0;
      width: 1rem;
    }

    #shopify-section-{{ section.id }} .blog_banner_section .button-group .button:not(.button--outline) {
      --button-background: 242 135 236;
      --button-text-color: 0 0 0;
      background: rgb(var(--button-background));
      border-color: rgb(var(--button-background));
      color: rgb(var(--button-text-color));
    }

    #shopify-section-{{ section.id }} .blog_banner_section .button-group .button--outline {
      --button-text-color: 255 255 255;
      background: transparent;
      border-color: rgb(255 255 255 / 0.9);
      color: rgb(var(--button-text-color));
    }
  }

  #shopify-section-{{ section.id }} .blog-banner-carousel {
    position: relative;
    isolation: isolate;
    touch-action: pan-y pinch-zoom;
  }

  #shopify-section-{{ section.id }} .blog-banner-carousel > .blog-banner-slide {
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 450ms ease;
  }

  #shopify-section-{{ section.id }} .blog-banner-carousel > .blog-banner-slide.is-active {
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .blog-banner-carousel > .blog-banner-slide--overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .blog-banner-carousel > .blog-banner-slide--overlay picture,
  #shopify-section-{{ section.id }} .blog-banner-carousel > .blog-banner-slide--overlay img {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .blog-banner-carousel > .blog-banner-slide--overlay img {
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .blog-banner-carousel > .blog-banner-content {
    position: relative;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .blog-banner-arrow {
    position: absolute;
    inset-block-start: 50%;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: white;
    opacity: 0.25;
    cursor: pointer;
    transform: translateY(-50%);
    transition: opacity 150ms ease;
  }

  #shopify-section-{{ section.id }} .blog-banner-arrow--prev {
    left: 0.5rem;
  }

  #shopify-section-{{ section.id }} .blog-banner-arrow--next {
    right: 0.5rem;
  }

  #shopify-section-{{ section.id }} .blog-banner-arrow::before {
    content: '';
    width: 0.65rem;
    height: 0.65rem;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
    transform: rotate(45deg);
  }

  #shopify-section-{{ section.id }} .blog-banner-arrow--prev::before {
    transform: rotate(-135deg);
  }

  #shopify-section-{{ section.id }} .blog-banner-arrow:hover,
  #shopify-section-{{ section.id }} .blog-banner-arrow:focus-visible {
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .blog-banner-arrow:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -4px;
  }

  #shopify-section-{{ section.id }} senson-blog-banner-navigation {
    display: contents;
  }

  #shopify-section-{{ section.id }} senson-blog-banner-navigation[hidden] {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} senson-blog-banner-navigation {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .blog-banner-carousel > .blog-banner-slide {
      transition: none;
    }
  }
</style>

{%- liquid
  assign banner_image_keys = 'image,image_2,image_3' | split: ','
  assign banner_image_count = 0

  for image_key in banner_image_keys
    assign selected_image = section.settings[image_key]

    if selected_image == blank
      continue
    endif

    if banner_image_count == 0
      assign first_banner_key = image_key
      assign mobile_image_key = 'mobile_' | append: image_key
      assign banner_image = selected_image
      assign banner_mobile_image = section.settings[mobile_image_key]
    endif

    assign banner_image_count = banner_image_count | plus: 1
  endfor

  assign carousel_enabled = false
  if banner_image_count > 1
    assign carousel_enabled = true
  endif

  assign whole_image_link_enabled = section.settings.enable_whole_image_link
  assign whole_image_link_label = section.settings.whole_image_link_label | default: '查看详情'

  assign first_link_key = first_banner_key | append: '_link'
  assign first_slide_link = section.settings[first_link_key]
-%}

<div
  {% if section.settings.allow_transparent_header %}
    allow-transparent-header
  {% endif %}
  class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}"
>
  <div
    class="content-box min-h-{{ section.settings.image_size }}{% if carousel_enabled %} blog-banner-carousel{% endif %}{% if whole_image_link_enabled %} blog-banner-clickable{% endif %}"
  >

    <div class="content-box__background-media{% if carousel_enabled %} blog-banner-slide is-active{% endif %}">
      {%- liquid
        if banner_image != blank
          render 'media' with banner_image, mobile_media: banner_mobile_image, preload: true
        else
          echo 'hero-apparel-1' | placeholder_svg_tag: 'size-full'
        endif
      -%}
    </div>

    {%- if carousel_enabled -%}
      {%- for image_key in banner_image_keys -%}
        {%- assign slide_image = section.settings[image_key] -%}

        {%- if image_key == first_banner_key or slide_image == blank -%}
          {%- continue -%}
        {%- endif -%}

        {%- assign mobile_image_key = 'mobile_' | append: image_key -%}
        {%- assign slide_mobile_image = section.settings[mobile_image_key] -%}

        <div
          class="content-box__background-media blog-banner-slide blog-banner-slide--overlay"
          aria-hidden="true"
        >
          <picture>
            {%- if slide_mobile_image != blank -%}
              <source
                media="(max-width: 749px)"
                data-srcset="{{ slide_mobile_image | image_url: width: 750 }} 750w, {{ slide_mobile_image | image_url: width: 1100 }} 1100w"
                sizes="100vw"
              >
            {%- endif -%}

            <img
              data-src="{{ slide_image | image_url: width: 1600 }}"
              data-srcset="{{ slide_image | image_url: width: 750 }} 750w, {{ slide_image | image_url: width: 1100 }} 1100w, {{ slide_image | image_url: width: 1600 }} 1600w, {{ slide_image | image_url: width: 2200 }} 2200w"
              sizes="100vw"
              width="{{ slide_image.width }}"
              height="{{ slide_image.height }}"
              alt="{{ slide_image.alt | escape }}"
              loading="lazy"
              decoding="async"
            >
          </picture>
        </div>
      {%- endfor -%}
    {%- endif -%}

    {%- if whole_image_link_enabled -%}
      <a
        class="blog-banner-image-link"
        {% if first_slide_link != blank %}
          href="{{ first_slide_link | escape }}"
        {% else %}
          hidden
        {% endif %}
        aria-label="{{ whole_image_link_label | escape }}"
        data-slide-link
      ></a>

      <script type="application/json" data-blog-banner-links>
        [
          {%- assign separator = '' -%}
          {%- for image_key in banner_image_keys -%}
            {%- assign slide_image = section.settings[image_key] -%}
            {%- if slide_image != blank -%}
              {%- assign link_key = image_key | append: '_link' -%}
              {{ separator }}{{ section.settings[link_key] | default: '' | json }}
              {%- assign separator = ',' -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      </script>
    {%- endif -%}

    {%- capture blocks -%}
      {% content_for 'blocks' %}
    {%- endcapture -%}

    {%- if section.blocks.size > 0 -%}
      {%- assign mobile_text_alignment = section.settings.mobile_text_position | split: '-' | last -%}
      {%- assign desktop_text_alignment = section.settings.desktop_text_position | split: '-' | last -%}

      {%- if section.settings.enable_sticky_content -%}
        <div class="blog-banner-content justify-self-{{ mobile_text_alignment }} sm:justify-self-{{ desktop_text_alignment }}">
          <div class="sticky">
            <div class="blog_banner_section max-w-{{ section.settings.content_width }} prose prose-justify-{{ mobile_text_alignment }} sm:prose-justify-{{ desktop_text_alignment }}">
              {{- blocks -}}
            </div>
          </div>
        </div>
      {%- else -%}
        <div class="blog-banner-content {{ section.settings.mobile_text_position }} {{ section.settings.desktop_text_position }}">
          <div class="blog_banner_section max-w-{{ section.settings.content_width }} prose prose-justify-{{ mobile_text_alignment }} sm:prose-justify-{{ desktop_text_alignment }}">
            {{- blocks -}}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if carousel_enabled -%}
      <senson-blog-banner-navigation hidden>
        <button
          class="blog-banner-arrow blog-banner-arrow--prev"
          type="button"
          aria-label="Previous slide"
        ></button>
        <button
          class="blog-banner-arrow blog-banner-arrow--next"
          type="button"
          aria-label="Next slide"
        ></button>
      </senson-blog-banner-navigation>
    {%- endif -%}

  </div>
</div>

{% javascript %}
  if (!customElements.get('senson-blog-banner-navigation')) {
    customElements.define(
      'senson-blog-banner-navigation',
      class extends HTMLElement {
        connectedCallback() {
          const carousel = this.closest('.blog-banner-carousel');
          if (!carousel) return;

          const slides = [
            ...carousel.querySelectorAll(':scope > .blog-banner-slide')
          ];

          if (slides.length < 2) return;

          const motion = window.matchMedia(
            '(prefers-reduced-motion: reduce)'
          );

          const linkElement = carousel.querySelector('[data-slide-link]');
          const linkData = carousel.querySelector('[data-blog-banner-links]');

          let slideLinks = [];

          if (linkData) {
            try {
              slideLinks = JSON.parse(linkData.textContent);
            } catch (error) {
              slideLinks = [];
            }
          }

          let current = slides.findIndex(
            slide => slide.classList.contains('is-active')
          );

          if (current < 0) current = 0;

          let touchStart;
          let suppressClick = false;
          let changing = false;

          const loaded = new Set([current]);
          const pending = new Map();

          this.listeners = new AbortController();
          const { signal } = this.listeners;

          const updateSlideLink = () => {
            if (!linkElement) return;

            const link = slideLinks[current] || '';

            if (link) {
              linkElement.href = link;
              linkElement.hidden = false;
            } else {
              linkElement.removeAttribute('href');
              linkElement.hidden = true;
            }
          };

          const loadSlide = index => {
            if (loaded.has(index)) {
              return Promise.resolve(true);
            }

            if (pending.has(index)) {
              return pending.get(index);
            }

            const slide = slides[index];
            const img = slide?.querySelector('img');

            if (!img) {
              return Promise.resolve(false);
            }

            const picture = img.closest('picture');

            if (picture) {
              picture.querySelectorAll('source[data-srcset]').forEach(source => {
                source.srcset = source.dataset.srcset;
                source.removeAttribute('data-srcset');
              });
            }

            const promise = new Promise(resolve => {
              const finish = success => {
                if (success) loaded.add(index);
                pending.delete(index);
                resolve(success);
              };

              img.addEventListener(
                'load',
                () => finish(true),
                { once: true }
              );

              img.addEventListener(
                'error',
                () => finish(false),
                { once: true }
              );

              if (img.dataset.srcset) {
                img.srcset = img.dataset.srcset;
                img.removeAttribute('data-srcset');
              }

              if (img.dataset.src) {
                img.src = img.dataset.src;
                img.removeAttribute('data-src');
              }

              if (img.complete && img.naturalWidth > 0) {
                finish(true);
              }
            });

            pending.set(index, promise);
            return promise;
          };

          const switchSlide = async direction => {
            if (changing) return;

            changing = true;

            const next = (current + direction + slides.length) % slides.length;

            const success = await loadSlide(next);

            if (!success || !this.isConnected) {
              changing = false;
              return;
            }

            slides[current].classList.remove('is-active');
            slides[current].setAttribute('aria-hidden', 'true');

            current = next;

            slides[current].classList.add('is-active');
            slides[current].removeAttribute('aria-hidden');

            updateSlideLink();

            changing = false;
          };

          const restartAutoplay = () => {
            window.clearInterval(this.timer);

            if (!motion.matches) {
              this.timer = window.setInterval(() => {
                if (!document.hidden) switchSlide(1);
              }, 5000);
            }
          };

          const navigate = direction => {
            switchSlide(direction);
            restartAutoplay();
          };

          this.querySelector('.blog-banner-arrow--prev')
            .addEventListener(
              'click',
              () => navigate(-1),
              { signal }
            );

          this.querySelector('.blog-banner-arrow--next')
            .addEventListener(
              'click',
              () => navigate(1),
              { signal }
            );

          carousel.addEventListener(
            'pointerdown',
            event => {
              if (!event.isPrimary) return;

              suppressClick = false;

              if (event.pointerType !== 'touch') return;

              touchStart = {
                id: event.pointerId,
                x: event.clientX,
                y: event.clientY
              };
            },
            { passive: true, signal }
          );

          carousel.addEventListener(
            'pointerup',
            event => {
              if (touchStart?.id !== event.pointerId) return;

              const dx = event.clientX - touchStart.x;
              const dy = event.clientY - touchStart.y;

              touchStart = undefined;

              if (
                Math.abs(dx) < 40 ||
                Math.abs(dx) < Math.abs(dy) * 1.25
              ) {
                return;
              }

              suppressClick = true;
              navigate(dx < 0 ? 1 : -1);
            },
            { passive: true, signal }
          );

          carousel.addEventListener(
            'pointercancel',
            event => {
              if (touchStart?.id === event.pointerId) {
                touchStart = undefined;
              }
            },
            { passive: true, signal }
          );

          carousel.addEventListener(
            'click',
            event => {
              if (!suppressClick || event.detail === 0) return;

              suppressClick = false;
              event.preventDefault();
              event.stopPropagation();
            },
            { capture: true, signal }
          );

          motion.addEventListener(
            'change',
            restartAutoplay,
            { signal }
          );

          this.hidden = false;
          updateSlideLink();

          const beginPreloading = () => {
            loadSlide((current + 1) % slides.length).then(() => {
              if (slides.length > 2) {
                loadSlide((current + 2) % slides.length);
              }
            });
          };

          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(beginPreloading, {
              timeout: 3000
            });
          } else {
            window.setTimeout(beginPreloading, 1500);
          }

          restartAutoplay();
        }

        disconnectedCallback() {
          window.clearInterval(this.timer);

          if (this.listeners) {
            this.listeners.abort();
          }
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.blog_banner.name",
  "class": "shopify-section--image-with-text-overlay",
  "tag": "section",
  "max_blocks": 10,
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-3"
    },
    {
      "type": "checkbox",
      "id": "allow_transparent_header",
      "label": "t:global.section.allow_transparent_header",
      "info": "t:global.section.allow_transparent_header_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.image_with_text_overlay.image_category"
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "t:global.image.size",
      "options": [
        {
          "value": "auto",
          "label": "t:global.sizes.original_image_ratio"
        },
        {
          "value": "xs",
          "label": "t:global.sizes.x_small"
        },
        {
          "value": "sm",
          "label": "t:global.sizes.small"
        },
        {
          "value": "md",
          "label": "t:global.sizes.medium"
        },
        {
          "value": "lg",
          "label": "t:global.sizes.large"
        },
        {
          "value": "fill",
          "label": "t:global.sizes.fit_screen"
        }
      ],
      "info": "t:global.image.ratio_avoid_cropping_info",
      "default": "auto"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:global.image.image",
      "info": "t:sections.image_with_text_overlay.image_size_recommendation"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:global.image.mobile_image",
      "info": "t:sections.image_with_text_overlay.mobile_image_size_recommendation"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "轮播第 2 张图",
      "info": "上传至少两张主图后，每 5 秒自动切换一次。"
    },
    {
      "type": "image_picker",
      "id": "mobile_image_2",
      "label": "第 2 张图 · 移动端（选填）"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "轮播第 3 张图"
    },
    {
      "type": "image_picker",
      "id": "mobile_image_3",
      "label": "第 3 张图 · 移动端（选填）"
    },
    {
      "type": "header",
      "content": "整图跳转"
    },
    {
      "type": "checkbox",
      "id": "enable_whole_image_link",
      "label": "开启整图跳转",
      "default": false
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "第 1 张图片跳转链接"
    },
    {
      "type": "url",
      "id": "image_2_link",
      "label": "第 2 张图片跳转链接"
    },
    {
      "type": "url",
      "id": "image_3_link",
      "label": "第 3 张图片跳转链接"
    },
    {
      "type": "text",
      "id": "whole_image_link_label",
      "label": "链接说明",
      "default": "查看详情",
      "info": "供屏幕阅读器识别。"
    },
    {
      "type": "header",
      "content": "t:sections.image_with_text_overlay.layout_category"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_content",
      "label": "t:global.section.content_follows_on_scroll",
      "info": "t:global.section.content_follows_on_scroll_info",
      "default": false
    },
    {
      "type": "select",
