<style>
  #shopify-section-{{ section.id }} .web_intro_rules {
    --accent: {{ section.settings.accent_color }};
    --title: {{ section.settings.title_color }};
    --muted: {{ section.settings.description_color }};
    --card-bg: {{ section.settings.card_background }};
    --card-title: {{ section.settings.card_title_color }};
    --card-text: {{ section.settings.card_text_color }};
    background: linear-gradient(
      180deg,
      {{ section.settings.background_top }} 0%,
      {{ section.settings.background_bottom }} 100%
    );
    color: var(--title);
    overflow: hidden;
    padding: {{ section.settings.padding_desktop }}px 0;
  }

  #shopify-section-{{ section.id }} .web_intro_rules * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .web_intro_rules .inner {
    margin: 0 auto;
    padding: 0 100px;
  }

  #shopify-section-{{ section.id }} .web_intro_rules .header {
    margin: 0 auto 48px;
    max-width: 760px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .web_intro_rules .eyebrow {
    color: var(--accent);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 12px;
  }

  #shopify-section-{{ section.id }} .web_intro_rules .section_title {
    color: var(--title);
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .web_intro_rules .section_description {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.5;
    margin: 16px 0 0;
  }

  #shopify-section-{{ section.id }} .web_intro_rules .section_description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .web_intro_rules .cards_track {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  #shopify-section-{{ section.id }} .web_intro_rules .card {
    background: var(--card-bg);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    min-height: 360px;
    padding: 28px 24px 32px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .web_intro_rules .card_title {
    color: var(--card-title);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.25;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .web_intro_rules .card_visual {
    align-items: center;
    display: flex;
    flex: 1 1 auto;
    justify-content: center;
    margin: 16px 0;
    min-height: 140px;
    position: relative;
  }

  #shopify-section-{{ section.id }} .web_intro_rules .card_image {
    display: block;
    height: auto;
    max-height: 160px;
    max-width: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .web_intro_rules .glow {
    height: 88px;
    position: relative;
    width: 180px;
  }

  #shopify-section-{{ section.id }} .web_intro_rules .glow::before {
    background: radial-gradient(ellipse at 50% 70%, #f4d9ff 0%, #c084fc 28%, #7c3aed 58%, transparent 72%);
    content: "";
    filter: blur(8px);
    height: 56px;
    left: 50%;
    opacity: 0.95;
    position: absolute;
    top: 42px;
    transform: translateX(-50%);
    width: 170px;
  }

  #shopify-section-{{ section.id }} .web_intro_rules .star {
    background: #ffffff;
    clip-path: polygon(50% 0%, 61% 35%, 98% 50%, 61% 65%, 50% 100%, 39% 65%, 2% 50%, 39% 35%);
    position: absolute;
  }

  #shopify-section-{{ section.id }} .web_intro_rules .star--l {
    height: 22px;
    left: 50%;
    top: 8px;
    transform: translateX(-50%);
    width: 22px;
  }

  #shopify-section-{{ section.id }} .web_intro_rules .star--m {
    height: 12px;
    left: 38px;
    top: 0;
    width: 12px;
  }

  #shopify-section-{{ section.id }} .web_intro_rules .star--s {
    height: 10px;
    right: 42px;
    top: 18px;
    width: 10px;
  }

  #shopify-section-{{ section.id }} .web_intro_rules .card_text {
    color: var(--card-text);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.45;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .web_intro_rules {
      padding: {{ section.settings.padding_mobile }}px 0;
    }

    #shopify-section-{{ section.id }} .web_intro_rules .inner {
      padding: 0 16px;
    }

    #shopify-section-{{ section.id }} .web_intro_rules .header {
      margin: 0 0 24px;
      max-width: none;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .web_intro_rules .eyebrow {
      font-size: 14px;
      margin-bottom: 10px;
    }

    #shopify-section-{{ section.id }} .web_intro_rules .section_title {
      font-size: 26px;
      letter-spacing: -0.02em;
      line-height: 1.15;
    }

    #shopify-section-{{ section.id }} .web_intro_rules .section_description {
      font-size: 14px;
      line-height: 1.4;
      margin-top: 12px;
    }

    #shopify-section-{{ section.id }} .web_intro_rules .cards_scroll {
      margin-right: -16px;
      overflow-x: auto;
      padding-right: 16px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    #shopify-section-{{ section.id }} .web_intro_rules .cards_scroll::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .web_intro_rules .cards_track {
      display: flex;
      gap: 12px;
      width: max-content;
    }

    #shopify-section-{{ section.id }} .web_intro_rules .card {
      flex: 0 0 260px;
      min-height: 340px;
      padding: 24px 20px 28px;
    }
  }
</style>

<div class="web_intro_rules">
  <div class="inner">
    <div class="header">
      {%- if section.settings.subtitle != blank -%}
        <p class="eyebrow">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="section_title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="section_description">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="cards_scroll">
        <div class="cards_track">
          {%- for block in section.blocks -%}
            <article class="card" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h3 class="card_title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}

              <div class="card_visual">
                {%- if block.settings.image != blank -%}
                  <img
                    class="card_image"
                    src="{{ block.settings.image | image_url: width: 480 }}"
                    alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="glow" aria-hidden="true">
                    <span class="star star--m"></span>
                    <span class="star star--l"></span>
                    <span class="star star--s"></span>
                  </div>
                {%- endif -%}
              </div>

              {%- if block.settings.text != blank -%}
                <p class="card_text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Web introduction rules",
  "class": "shopify-section--web-intro-rules",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
