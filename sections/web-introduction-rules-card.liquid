      "default": "#14081f"
    },
    {
      "type": "color",
      "id": "background_bottom",
      "label": "背景色（下）",
      "default": "#3a1460"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "小标题颜色",
      "default": "#e879f9"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "标题颜色",
