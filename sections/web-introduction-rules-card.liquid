  ],
  "presets": [
    {
      "name": "Web introduction rules",
      "category": "Banners",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Companions With Memory",
            "text": "Return to characters that learn your preferences and make each interaction feel more personal over time."
