<style>
  #shopify-section-{{ section.id }} .web_intro_choose {
    --accent: {{ section.settings.accent_color }};
    --title: {{ section.settings.title_color }};
    --muted: {{ section.settings.description_color }};
    --card-body-title: {{ section.settings.card_title_color }};
    --card-body-text: {{ section.settings.card_text_color }};
    --btn-text: {{ section.settings.button_text_color }};
    background: {{ section.settings.background_color }};
    color: var(--title);
    overflow: hidden;
    padding: {{ section.settings.padding_desktop }}px 0;
  }

  #shopify-section-{{ section.id }} .web_intro_choose * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .web_intro_choose .inner {
    margin: 0 auto;
    padding: 0 100px;
  }

  #shopify-section-{{ section.id }} .web_intro_choose .header {
    margin: 0 auto 48px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .web_intro_choose .eyebrow {
    color: var(--accent);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 12px;
  }

  #shopify-section-{{ section.id }} .web_intro_choose .section_title {
    color: var(--title);
    font-size: 42px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .web_intro_choose .section_description {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.5;
    margin: 16px auto 0;
    max-width: 720px;
  }

  #shopify-section-{{ section.id }} .web_intro_choose .section_description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .web_intro_choose .cards_track {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  #shopify-section-{{ section.id }} .web_intro_choose .choose_card {
    aspect-ratio: 3 / 4;
    border-radius: 0;
    overflow: hidden;
    position: relative;
  }

  #shopify-section-{{ section.id }} .web_intro_choose .card_media {
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .web_intro_choose .card_image,
  #shopify-section-{{ section.id }} .web_intro_choose .card_placeholder {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .web_intro_choose .card_placeholder {
    background: linear-gradient(135deg, #c4b5c8, #6b5a72);
  }

  #shopify-section-{{ section.id }} .web_intro_choose .card_overlay {
    background: linear-gradient(180deg, rgb(0 0 0 / 0) 35%, rgb(0 0 0 / 0.72) 100%);
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    inset: 0;
    justify-content: flex-end;
    padding: 28px 24px;
    position: absolute;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .web_intro_choose .card_tag {
    color: var(--accent);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .web_intro_choose .card_overlay_title {
    color: #ffffff;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.25;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .web_intro_choose .card_overlay_text {
    color: rgb(255 255 255 / 0.88);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.45;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .web_intro_choose .card_body {
    display: none;
  }

  #shopify-section-{{ section.id }} .web_intro_choose .section_footer {
    margin-top: 48px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .web_intro_choose .choose_btn {
    background: var(--accent);
    border-radius: 999px;
    color: var(--btn-text);
    display: inline-block;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
    padding: 14px 32px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .web_intro_choose .choose_btn:hover {
    opacity: 0.88;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .web_intro_choose {
      padding: {{ section.settings.padding_mobile }}px 0;
    }

    #shopify-section-{{ section.id }} .web_intro_choose .inner {
      padding: 0 16px;
    }

    #shopify-section-{{ section.id }} .web_intro_choose .header {
      margin: 0 0 32px;
      padding: 0;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .web_intro_choose .eyebrow {
      font-size: 16px;
      margin-bottom: 10px;
    }

    #shopify-section-{{ section.id }} .web_intro_choose .section_title {
      font-size: 24px;
      letter-spacing: -0.02em;
      line-height: 1.15;
    }

    #shopify-section-{{ section.id }} .web_intro_choose .section_description {
      font-size: 14px;
      line-height: 1.4;
      margin-top: 14px;
      max-width: none;
    }

    #shopify-section-{{ section.id }} .web_intro_choose .cards_scroll {
      margin-right: -16px;
      overflow-x: auto;
      padding-right: 16px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    #shopify-section-{{ section.id }} .web_intro_choose .cards_scroll::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .web_intro_choose .cards_track {
      display: flex;
      gap: 16px;
      width: max-content;
    }

    #shopify-section-{{ section.id }} .web_intro_choose .choose_card {
      aspect-ratio: auto;
      flex: 0 0 calc(100vw - 64px);
      max-width: 360px;
      overflow: visible;
      position: static;
    }

    #shopify-section-{{ section.id }} .web_intro_choose .card_media {
      aspect-ratio: 1 / 1;
      border-radius: 10px;
      height: auto;
      overflow: hidden;
      position: relative;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .web_intro_choose .card_overlay {
      display: none;
    }

    #shopify-section-{{ section.id }} .web_intro_choose .card_body {
      display: block;
      padding-top: 20px;
    }

    #shopify-section-{{ section.id }} .web_intro_choose .card_body_title {
      color: var(--card-body-title);
      font-size: 26px;
      font-weight: 700;
      line-height: 1.2;
      margin: 0;
    }

    #shopify-section-{{ section.id }} .web_intro_choose .card_accent_line {
      background: var(--accent);
      border-radius: 2px;
      display: block;
      height: 4px;
      margin: 12px 0 14px;
      width: 48px;
    }

    #shopify-section-{{ section.id }} .web_intro_choose .card_body_text {
      color: var(--card-body-text);
      font-size: 16px;
      font-weight: 400;
      line-height: 1.5;
      margin: 0;
    }

    #shopify-section-{{ section.id }} .web_intro_choose .section_footer {
      margin-top: 32px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .web_intro_choose .section_footer .choose_btn {
      font-size: 15px;
      padding: 12px 24px;
    }
  }
</style>

<div class="web_intro_choose">
  <div class="inner">
    <div class="header">
      {%- if section.settings.subtitle != blank -%}
        <p class="eyebrow">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="section_title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="section_description">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="cards_scroll">
        <div class="cards_track">
          {%- for block in section.blocks -%}
            {%- liquid
              assign card_image = block.settings.image
              if block.settings.mobile_image != blank
                assign mobile_card_image = block.settings.mobile_image
              else
                assign mobile_card_image = card_image
              endif
            -%}
            <article class="choose_card" {{ block.shopify_attributes }}>
              <div class="card_media">
                {%- if card_image != blank or mobile_card_image != blank -%}
                  <picture>
                    {%- if mobile_card_image != blank -%}
                      <source
                        media="(max-width: 749px)"
                        srcset="
                          {{ mobile_card_image | image_url: width: 400 }} 400w,
                          {{ mobile_card_image | image_url: width: 720 }} 720w
                        "
                        sizes="(max-width: 749px) calc(100vw - 64px), 0px"
                      >
                    {%- endif -%}
                    {%- if card_image != blank -%}
                      <img
                        class="card_image"
                        src="{{ card_image | image_url: width: 600 }}"
                        srcset="
                          {{ card_image | image_url: width: 400 }} 400w,
                          {{ card_image | image_url: width: 600 }} 600w,
                          {{ card_image | image_url: width: 900 }} 900w
                        "
                        sizes="(min-width: 750px) 33vw, calc(100vw - 64px)"
                        alt="{{ card_image.alt | default: block.settings.title | escape }}"
                        width="{{ card_image.width }}"
                        height="{{ card_image.height }}"
                        loading="lazy"
                      >
                    {%- elsif mobile_card_image != blank -%}
                      <img
                        class="card_image"
                        src="{{ mobile_card_image | image_url: width: 600 }}"
                        alt="{{ mobile_card_image.alt | default: block.settings.title | escape }}"
                        width="{{ mobile_card_image.width }}"
                        height="{{ mobile_card_image.height }}"
                        loading="lazy"
                      >
                    {%- endif -%}
                  </picture>
                {%- else -%}
                  <div class="card_placeholder" aria-hidden="true"></div>
                {%- endif -%}
              </div>

              <div class="card_overlay">
                {%- if block.settings.tag != blank -%}
                  <p class="card_tag">{{ block.settings.tag | escape }}</p>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="card_overlay_title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="card_overlay_text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>

              <div class="card_body">
                {%- if block.settings.title != blank -%}
                  <h3 class="card_body_title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                <span class="card_accent_line" aria-hidden="true"></span>
                {%- if block.settings.text != blank -%}
                  <p class="card_body_text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="section_footer">
        <a class="choose_btn" href="{{ section.settings.button_url | default: '#' }}">
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Web introduction choose",
  "class": "shopify-section--web-intro-choose",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "小标题",
      "default": "The SensOn Experience"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Choose. Interact. Feel."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "描述",
      "default": "<p>From first spark to full immersion, the experience adapts around you—not the other way around.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "按钮文字",
      "default": "Explore AI Companions"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "按钮链接"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "强调色",
      "default": "#f287ec"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "标题颜色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "描述颜色",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "移动端卡片标题颜色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "移动端卡片正文颜色",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "按钮文字颜色",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "电脑端上下内边距",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "移动端上下内边距",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "体验卡片",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "标签（电脑端）",
          "default": "Mood"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Find your frequency"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "描述",
          "default": "Choose a character, mood or voice story that matches how you want to feel."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片（电脑端）"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "图片（移动端，可选）"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Web introduction choose",
      "category": "Banners",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "tag": "Mood",
            "title": "Find your frequency",
            "text": "Choose a character, mood or voice story that matches how you want to feel."
          }
        },
        {
          "type": "card",
          "settings": {
            "tag": "Live",
            "title": "Direct the fantasy",
            "text": "Speak or type. Shape the scene and let your companion respond in real time."
          }
        },
        {
          "type": "card",
          "settings": {
            "tag": "Sync",
            "title": "Feel the story",
            "text": "Enjoy the experience online—or connect SensOn S1 for synchronized, hands-free sensation."
          }
        }
      ]
    }
  ]
}
{% endschema %}
