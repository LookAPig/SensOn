{%- liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  if desktop_image == blank
    assign desktop_image = mobile_image
  endif
  if mobile_image == blank
    assign mobile_image = desktop_image
  endif
  assign heading_tag = section.settings.heading_tag | default: 'h1'

  if section.settings.desktop_height_mode == 'fullscreen'
    assign desktop_height = '100svh'
  else
    assign desktop_height = section.settings.desktop_height | default: 560 | append: 'px'
  endif

  if section.settings.mobile_height_mode == 'fullscreen'
    assign mobile_height = '100svh'
  else
    assign mobile_height = section.settings.mobile_height | default: 480 | append: 'px'
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .our_story_banner {
    --banner-height: {{ desktop_height }};
    --banner-mobile-height: {{ mobile_height }};
    --subtitle-color: {{ section.settings.subtitle_color }};
    --heading-color: {{ section.settings.heading_color }};
    --description-color: {{ section.settings.description_color }};
    background: #1a1a1a;
    min-height: var(--banner-height);
    overflow: hidden;
    position: relative;
  }

  #shopify-section-{{ section.id }} .our_story_banner .media,
  #shopify-section-{{ section.id }} .our_story_banner .image,
  #shopify-section-{{ section.id }} .our_story_banner .placeholder {
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .our_story_banner .image {
    object-fit: cover;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .our_story_banner .mobile_image {
    display: none;
  }

  #shopify-section-{{ section.id }} .our_story_banner .placeholder {
    background: linear-gradient(180deg, #3a4a4f 0%, #6a8a8e 100%);
  }

  #shopify-section-{{ section.id }} .our_story_banner .content {
    align-items: center;
    display: flex;
    flex-direction: column;
    inset: 0;
    justify-content: center;
    padding: 40px 24px;
    position: absolute;
    text-align: center;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .our_story_banner .subtitle {
    color: var(--subtitle-color);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
    margin: 0 0 12px;
  }

  #shopify-section-{{ section.id }} .our_story_banner .title {
    color: var(--heading-color);
    font-size: 42px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0;
    max-width: 920px;
  }

  #shopify-section-{{ section.id }} .our_story_banner .description {
    color: var(--description-color);
    font-size: 16px;
    line-height: 1.45;
    margin: 16px auto 0;
    max-width: 640px;
  }

  #shopify-section-{{ section.id }} .our_story_banner .description p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .our_story_banner {
      min-height: var(--banner-mobile-height);
    }

    #shopify-section-{{ section.id }} .our_story_banner .desktop_image {
      display: none;
    }

    #shopify-section-{{ section.id }} .our_story_banner .mobile_image {
      display: block;
    }

    #shopify-section-{{ section.id }} .our_story_banner .content {
      padding: 24px 16px;
    }

    #shopify-section-{{ section.id }} .our_story_banner .subtitle {
      font-size: 14px;
      margin-bottom: 10px;
    }

    #shopify-section-{{ section.id }} .our_story_banner .title {
      font-size: 28px;
    }

    #shopify-section-{{ section.id }} .our_story_banner .description {
      font-size: 14px;
      margin-top: 12px;
    }
  }
</style>

<section
  class="our_story_banner"
  {% if section.settings.allow_transparent_header %}allow-transparent-header{% endif %}
>
  <div class="media" aria-hidden="true">
    {%- if desktop_image != blank -%}
      {{-
        desktop_image
        | image_url: width: 2400
        | image_tag:
          class: 'image desktop_image',
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '750, 1000, 1200, 1600, 2000, 2400'
      -}}
    {%- endif -%}

    {%- if mobile_image != blank -%}
      {{-
        mobile_image
        | image_url: width: 1000
        | image_tag:
          class: 'image mobile_image',
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '375, 550, 750, 1000'
      -}}
    {%- endif -%}

    {%- if desktop_image == blank and mobile_image == blank -%}
      <div class="placeholder"></div>
    {%- endif -%}
  </div>

  <div class="content">
    {%- if section.settings.subtitle != blank -%}
      <p class="subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <{{ heading_tag }} class="title">{{ section.settings.heading | escape | newline_to_br }}</{{ heading_tag }}>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="description">{{ section.settings.description }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Our story banner",
  "tag": "section",
  "class": "shopify-section--our-story-banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "allow_transparent_header",
      "label": "启用透明页头",
      "default": true
    },
    {
      "type": "header",
      "content": "图片"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "电脑端图片"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "移动端图片",
      "info": "未设置时使用电脑端图片。"
    },
    {
      "type": "header",
      "content": "高度"
    },
    {
      "type": "select",
      "id": "desktop_height_mode",
      "label": "电脑端高度",
      "options": [
        { "value": "custom", "label": "自定义高度" },
        { "value": "fullscreen", "label": "全屏" }
      ],
      "default": "custom"
    },
    {
      "type": "number",
      "id": "desktop_height",
      "label": "电脑端高度（px）",
      "default": 560,
      "visible_if": "{{ section.settings.desktop_height_mode == 'custom' }}"
    },
    {
      "type": "select",
      "id": "mobile_height_mode",
      "label": "移动端高度",
      "options": [
        { "value": "custom", "label": "自定义高度" },
        { "value": "fullscreen", "label": "全屏" }
      ],
      "default": "custom"
    },
    {
      "type": "number",
      "id": "mobile_height",
      "label": "移动端高度（px）",
      "default": 480,
      "visible_if": "{{ section.settings.mobile_height_mode == 'custom' }}"
    },
    {
      "type": "header",
      "content": "文案"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "副标题",
      "default": "About SensOn"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "副标题颜色",
      "default": "#F287EC"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "大标题",
      "default": "Why SensOn"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "大标题颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "标题标签",
      "info": "用于 SEO。同一页面建议只保留一个 H1。",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "描述",
      "default": "<p>A revolutionary women's technology brand, built on intelligent human–machine interaction and bionic innovation.</p>"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "描述颜色",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Our story banner",
      "category": "Banners"
    }
  ]
}
{% endschema %}
