{%- if section.blocks.size > 0 -%}
  {%- unless request.page_type != 'index' and section.settings.show_on_homepage_only -%}
    <style>
      :root {
        --announcement-bar-is-sticky: {% if section.settings.enable_sticky %}1{% else %}0{% endif %};
      }

      {%- if section.settings.enable_sticky -%}
        #shopify-section-{{ section.id }} {
          position: sticky;
          top: 0;
        }

        .shopify-section--header ~ #shopify-section-{{ section.id }} {
          top: calc(var(--header-is-sticky, 0) * var(--header-is-visible, 0) * var(--header-height, 0px));
        }
      {%- endif -%}

      /* 跑马灯容器 */
      .announcement-bar {
        padding: 0;
        overflow: hidden;
        white-space: nowrap;
      }

      /* 滚动内容包装器 */
      .marquee {
        display: inline-block;
        white-space: nowrap;
        animation: marqueeScroll linear infinite;
        /* 动画时长通过 JS 动态设置，或使用固定值；这里先用变量，后面用内联样式覆盖 */
        animation-duration: {{ section.settings.scroll_speed }}s;
      }

      /* 每个消息块样式（保持原有图标+文字布局） */
      .marquee-item {
        display: inline-flex;
        align-items: center;
        margin-right: 60px; /* 消息之间的间隔，可自行调整 */
      }

      .marquee-item .subheading {
        display: flex;
        align-items: center;
        margin: 0;
        padding: 0.7rem 0;
      }

      .marquee-item svg {
        margin-right: 4px;
      }

      /* 无限滚动关键帧 */
      @keyframes marqueeScroll {
        0% {
          transform: translateX(0);
        }
        100% {
          transform: translateX(-50%);
        }
      }

      /* 微暗柔和蜜桃粉渐变 */
      #shopify-section-{{ section.id }} .announcement-bar {
        background: linear-gradient(
          to right,
          #E8A09A,
          #ECAE8C,
          #EBB8C4,
          #ECAE8C,
          #E8A09A
        );
        color: #FFFFFF;
      }

      #shopify-section-{{ section.id }} .announcement-bar,
      #shopify-section-{{ section.id }} .announcement-bar .subheading,
      #shopify-section-{{ section.id }} .announcement-bar span,
      #shopify-section-{{ section.id }} .announcement-bar p,
      #shopify-section-{{ section.id }} .announcement-bar .subheading span {
        color: #FFFFFF;
      }

      #shopify-section-{{ section.id }} .announcement-bar svg {
        fill: none;
        stroke: currentColor;
        color: #FFFFFF;
      }
    </style>

    <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
      <height-observer variable="announcement-bar">
        <div class="announcement-bar" id="announcement-bar-{{ section.id }}">
          <div class="marquee" id="marquee-{{ section.id }}">
            {%- capture marquee_content -%}
              {%- for block in section.blocks -%}
                {%- if block.settings.text != blank -%}
                  <span class="marquee-item" {{ block.shopify_attributes }}>
                    <p class="subheading subheading-xs">
                      {%- if block.settings.icon and block.settings.icon != 'null' -%}
                        {%- render 'icon' with block.settings.icon, width: block.settings.icon_size -%}
                      {%- endif -%}
                      <span>{{ block.settings.text }}</span>
                    </p>
                  </span>
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {{ marquee_content }}
            {{ marquee_content }}
          </div>
        </div>
      </height-observer>
    </div>

    <script>
      (function() {
        const marquee = document.getElementById('marquee-{{ section.id }}');
        if (!marquee) return;

        // 获取所有原始内容项（注意：由于复制了一份，实际子节点是原始的两倍）
        const items = marquee.children;
        if (items.length === 0) return;

        // 计算原始一组内容的总宽度（取前一半）
        const halfLength = items.length / 2;
        let originalWidth = 0;
        for (let i = 0; i < halfLength; i++) {
          originalWidth += items[i].offsetWidth;
          // 加上 margin-right（每个 item 有 margin-right: 60px）
          if (i < halfLength - 1) originalWidth += 60;
        }

        // 获取用户设置的滚动速度（秒），速度值越小滚动越快，这里用速度值控制动画时长：总宽度 / (像素/秒)
        // 更符合直觉：speed 秒内滚完一整份内容的距离，则动画时长 = speed 秒，但是因为动画移动了 -50%（整份内容的宽度），
        // 所以动画时长 = speed 秒即可。为了平滑，直接使用 speed 作为动画时长。
        let speed = {{ section.settings.scroll_speed | default: 20 }};
        // 避免过小或过大
        if (speed < 5) speed = 5;
        if (speed > 60) speed = 60;
        marquee.style.animationDuration = speed + 's';

        // 如果用户想暂停悬停（可选，通常跑马灯悬停暂停体验更好，默认关闭，需要可开启）
        const bar = document.getElementById('announcement-bar-{{ section.id }}');
        {% if section.settings.pause_on_hover %}
        bar.addEventListener('mouseenter', () => {
          marquee.style.animationPlayState = 'paused';
        });
        bar.addEventListener('mouseleave', () => {
          marquee.style.animationPlayState = 'running';
        });
        {% endif %}
      })();
    </script>

    <script>
      // 公告栏高度计算
      document.documentElement.style.setProperty(
        '--announcement-bar-height',
        `${Math.round(document.getElementById('shopify-section-{{ section.id }}').clientHeight)}px`
      );
    </script>
  {%- endunless -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "shopify-section--announcement-bar",
  "max_blocks": 5,
  "tag": "aside",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "t:sections.announcement_bar.enable_sticky",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_on_homepage_only",
      "label": "t:sections.announcement_bar.show_on_homepage_only",
      "default": false
    },
    {
      "type": "header",
      "content": "滚动跑马灯设置"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "滚动速度（秒）",
      "info": "数值越小滚动越快，越大越慢",
      "min": 5,
      "max": 60,
      "step": 1,
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "鼠标悬停时暂停滚动",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.announcement_bar.blocks.message.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon选项",
          "options": [
            { "value": "null", "label": "不显示 Icon" },
            { "value": "global", "label": "global" },
            { "value": "warranty", "label": "warranty" },
            { "value": "package", "label": "package" },
            { "value": "award", "label": "award" }
          ],
          "default": "null"
        },
        {
          "type": "number",
          "id": "icon_size",
          "label": "Icon 大小",
          "default": 14
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:sections.announcement_bar.blocks.message.text",
          "default": "Announce something here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.name"
    }
  ]
}
{% endschema %}