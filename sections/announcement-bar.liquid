
{%- if section.blocks.size > 0 -%}
  {%- unless request.page_type != 'index' and section.settings.show_on_homepage_only -%}

    <style>
      :root {
        --announcement-bar-is-sticky:
          {% if section.settings.enable_sticky %}1{% else %}0{% endif %};
      }

      {%- if section.settings.enable_sticky -%}
        #shopify-section-{{ section.id }} {
          position: sticky;
          top: 0;
          z-index: 30;
        }

        .shopify-section--header ~ #shopify-section-{{ section.id }} {
          top: calc(
            var(--header-is-sticky, 0) *
            var(--header-is-visible, 0) *
            var(--header-height, 0px)
          );
        }
      {%- endif -%}

      /* ========== BLACK FRIDAY ANNOUNCEMENT BAR ========== */

      #shopify-section-{{ section.id }} .announcement-bar {
        position: relative;
        width: 100%;
        overflow: hidden;
        padding: 0;
        white-space: nowrap;

        background: linear-gradient(
          to bottom,
          #EBD391 0%,
          #F3E4B6 48%,
          #FFF9E9 100%
        ) !important;

        color: #000000 !important;
      }

      /* Continuous moving track */
      #shopify-section-{{ section.id }} .marquee {
        display: flex;
        align-items: center;

        width: max-content;
        min-width: 100%;
        white-space: nowrap;

        will-change: transform;

        animation-name: sensonMarquee-{{ section.id }};
        animation-duration: {{ section.settings.scroll_speed | default: 20 }}s;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
        animation-play-state: running;

        opacity: 0;
      }

      /* Only display once enough content is ready */
      #shopify-section-{{ section.id }}
      .marquee.is-ready {
        opacity: 1;
      }

      /* Identical message sequence */
      #shopify-section-{{ section.id }} .marquee-group {
        display: flex;
        align-items: center;

        flex: 0 0 auto;
        width: max-content;
        white-space: nowrap;
      }

      /* Individual announcement */
      #shopify-section-{{ section.id }} .marquee-item {
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        white-space: nowrap;
      }

      #shopify-section-{{ section.id }}
      .marquee-item .subheading {
        display: inline-flex;
        align-items: center;
        flex: 0 0 auto;

        margin: 0;
        padding: 0.7rem 0;

        font-family: "Mabry Pro", Arial, sans-serif;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.025em;
        line-height: 1.3;
        white-space: nowrap;

        color: #000000 !important;
      }

      /* Black text */
      #shopify-section-{{ section.id }} .announcement-bar,
      #shopify-section-{{ section.id }} .announcement-bar p,
      #shopify-section-{{ section.id }} .announcement-bar span,
      #shopify-section-{{ section.id }} .announcement-bar a,
      #shopify-section-{{ section.id }} .announcement-bar strong,
      #shopify-section-{{ section.id }} .announcement-bar b {
        color: #000000 !important;
        -webkit-text-fill-color: #000000 !important;
      }

      /* Existing optional icons */
      #shopify-section-{{ section.id }} .marquee-item svg {
        display: inline-block;
        flex: 0 0 auto;
        margin-right: 6px;

        color: #000000 !important;
        stroke: currentColor;
      }

      /* Automatic diamond between messages */
      #shopify-section-{{ section.id }}
      .marquee-item::after {
        content: "✦";

        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;

        margin: 0 28px;

        color: #000000;
        font-size: 13px;
        font-weight: 400;
        line-height: 1;
      }

      /* Animation distance is calculated using JS */
      @keyframes sensonMarquee-{{ section.id }} {
        from {
          transform: translate3d(0, 0, 0);
        }

        to {
          transform: translate3d(
            calc(-1 * var(--marquee-distance, 0px)),
            0,
            0
          );
        }
      }

      /* Mobile */
      @media screen and (max-width: 740px) {
        #shopify-section-{{ section.id }}
        .marquee-item .subheading {
          padding: 0.6rem 0;
          font-size: 12px;
        }

        #shopify-section-{{ section.id }}
        .marquee-item::after {
          margin: 0 19px;
          font-size: 12px;
        }
      }

      /* Reduced motion */
      @media (prefers-reduced-motion: reduce) {
        #shopify-section-{{ section.id }} .marquee {
          animation: none !important;
          transform: none !important;
        }
      }

    </style>

    <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
      <height-observer variable="announcement-bar">

        <div
          class="announcement-bar"
          id="announcement-bar-{{ section.id }}"
        >

          <div
            class="marquee"
            id="marquee-{{ section.id }}"
          >

            {%- capture marquee_content -%}
              {%- for block in section.blocks -%}
                {%- if block.settings.text != blank -%}

                  <div
                    class="marquee-item"
                    {{ block.shopify_attributes }}
                  >

                    <p class="subheading subheading-xs">

                      {%- if block.settings.icon != blank and block.settings.icon != 'null' -%}
                        {%- render 'icon'
                          with block.settings.icon,
                          width: block.settings.icon_size
                        -%}
                      {%- endif -%}

                      <span>{{ block.settings.text }}</span>

                    </p>

                  </div>

                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}

            <div class="marquee-group" data-original="true">
              {{ marquee_content }}
            </div>

            <div class="marquee-group" aria-hidden="true">
              {{ marquee_content }}
            </div>

          </div>

        </div>

      </height-observer>
    </div>

    <script>
      (function() {

        var sectionId = 'shopify-section-{{ section.id }}';
        var marqueeId = 'marquee-{{ section.id }}';
        var barId = 'announcement-bar-{{ section.id }}';

        function initAnnouncementBar() {

          var sectionElement = document.getElementById(sectionId);
          var marquee = document.getElementById(marqueeId);
          var bar = document.getElementById(barId);

          if (!sectionElement || !marquee || !bar) return;

          var originalGroup = marquee.querySelector(
            '.marquee-group[data-original="true"]'
          );

          if (!originalGroup) return;

          var speed = {{ section.settings.scroll_speed | default: 20 }};

          speed = Math.max(5, Math.min(60, speed));

          var resizeFrame = null;

          function updateHeight() {
            document.documentElement.style.setProperty(
              '--announcement-bar-height',
              Math.round(sectionElement.clientHeight) + 'px'
            );
          }

          function rebuildMarquee() {

            /* Temporarily stop animation while measuring */
            marquee.style.animation = 'none';
            marquee.classList.remove('is-ready');

            /* Remove old generated duplicate groups */
            var groups = marquee.querySelectorAll('.marquee-group');

            for (var i = groups.length - 1; i >= 1; i--) {
              groups[i].remove();
            }

            /* Measure actual original content */
            var originalWidth = originalGroup.getBoundingClientRect().width;
            var containerWidth = bar.getBoundingClientRect().width;

            if (originalWidth <= 0 || containerWidth <= 0) {
              marquee.style.animation = 'none';
              marquee.classList.add('is-ready');
              updateHeight();
              return;
            }

            /*
              The track must cover the entire visible bar
              even when it moves left by one complete group.

              Required:
              totalWidth >= viewportWidth + originalWidth

              Add one extra group for a safe buffer.
            */

            var requiredWidth = containerWidth + originalWidth * 2;

            var totalWidth = originalWidth;

            var copyCount = 0;
            var maxCopies = 100;

            while (
              totalWidth < requiredWidth &&
              copyCount < maxCopies
            ) {

              var clone = originalGroup.cloneNode(true);

              clone.removeAttribute('data-original');
              clone.setAttribute('aria-hidden', 'true');

              /*
                Shopify editor block IDs and attributes
                should not appear on visual duplicates.
              */
              var cloneBlocks = clone.querySelectorAll(
                '[data-shopify-editor-block]'
              );

              cloneBlocks.forEach(function(block) {
                block.removeAttribute('data-shopify-editor-block');
              });

              clone.querySelectorAll('[id]').forEach(function(el) {
                el.removeAttribute('id');
              });

              marquee.appendChild(clone);

              totalWidth += originalWidth;
              copyCount++;
            }

            /*
              Move exactly ONE original group width.
              The next identical group replaces it seamlessly.
            */
            marquee.style.setProperty(
              '--marquee-distance',
              originalWidth + 'px'
            );

            /* Restore user-selected speed */
            marquee.style.animation = '';

            marquee.style.animationDuration = speed + 's';

            /* Restart from the first frame */
            void marquee.offsetWidth;

            marquee.classList.add('is-ready');

            updateHeight();
          }

          function scheduleRebuild() {
            if (resizeFrame !== null) {
              cancelAnimationFrame(resizeFrame);
            }

            resizeFrame = requestAnimationFrame(function() {
              resizeFrame = null;
              rebuildMarquee();
            });
          }

          /* Initial build */
          scheduleRebuild();

          /* Font loading can change width */
          if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(function() {
              scheduleRebuild();
            });
          }

          /* Recalculate when viewport changes */
          if (!bar.dataset.resizeBound) {
            bar.dataset.resizeBound = 'true';
            window.addEventListener('resize', scheduleRebuild);
          }

          /* Optional pause on hover */
          {% if section.settings.pause_on_hover %}

            if (!bar.dataset.hoverBound) {
              bar.dataset.hoverBound = 'true';

              bar.addEventListener('mouseenter', function() {
                marquee.style.animationPlayState = 'paused';
              });

              bar.addEventListener('mouseleave', function() {
                marquee.style.animationPlayState = 'running';
              });
            }

          {% endif %}

        }

        if (document.readyState === 'loading') {

          document.addEventListener(
            'DOMContentLoaded',
            initAnnouncementBar
          );

        } else {

          initAnnouncementBar();

        }

        /* Shopify theme editor support */
        document.addEventListener(
          'shopify:section:load',
          function(event) {
            var section = document.getElementById(sectionId);

            if (
              section &&
              (section === event.target ||
               section.contains(event.target))
            ) {
              initAnnouncementBar();
            }
          }
        );

      })();
    </script>

  {%- endunless -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "shopify-section--announcement-bar",
  "max_blocks": 5,
  "tag": "aside",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "t:sections.announcement_bar.enable_sticky",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_on_homepage_only",
      "label": "t:sections.announcement_bar.show_on_homepage_only",
      "default": false
    },
    {
      "type": "header",
      "content": "滚动跑马灯设置"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "滚动速度（秒）",
      "info": "数值越小滚动越快，越大越慢",
      "min": 5,
      "max": 60,
      "step": 1,
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "鼠标悬停时暂停滚动",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.announcement_bar.blocks.message.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon选项",
          "options": [
            {
              "value": "null",
              "label": "不显示 Icon"
            },
            {
              "value": "global",
              "label": "global"
            },
            {
              "value": "warranty",
              "label": "warranty"
            },
            {
              "value": "package",
              "label": "package"
            },
            {
              "value": "award",
              "label": "award"
            }
          ],
          "default": "null"
        },
        {
          "type": "number",
          "id": "icon_size",
          "label": "Icon 大小",
          "default": 14
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:sections.announcement_bar.blocks.message.text",
          "default": "Announce something here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.name"
    }
  ]
}
{% endschema %}
