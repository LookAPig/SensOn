
{%- if section.blocks.size > 0 -%}
  {%- unless request.page_type != 'index' and section.settings.show_on_homepage_only -%}

    <style>
      :root {
        --announcement-bar-is-sticky:
          {% if section.settings.enable_sticky %}1{% else %}0{% endif %};
      }

      {%- if section.settings.enable_sticky -%}
        #shopify-section-{{ section.id }} {
          position: sticky;
          top: 0;
          z-index: 30;
        }

        .shopify-section--header ~ #shopify-section-{{ section.id }} {
          top: calc(
            var(--header-is-sticky, 0) *
            var(--header-is-visible, 0) *
            var(--header-height, 0px)
          );
        }
      {%- endif -%}

      /* SensOn Black Friday announcement bar */
      #shopify-section-{{ section.id }} .announcement-bar {
        width: 100%;
        padding: 0;
        overflow: hidden;
        white-space: nowrap;

        /* 上金下白 */
        background: linear-gradient(
          to bottom,
          #EBD391 0%,
          #F3E4B6 48%,
          #FFF9E9 100%
        ) !important;

        color: #000000 !important;
      }

      /* Marquee track */
      #shopify-section-{{ section.id }} .marquee {
        display: flex;
        align-items: center;
        width: max-content;
        white-space: nowrap;

        animation: sensonMarquee-{{ section.id }}
          {{ section.settings.scroll_speed | default: 20 }}s
          linear infinite;

        will-change: transform;
      }

      /* Each identical content group */
      #shopify-section-{{ section.id }} .marquee-group {
        display: flex;
        align-items: center;
        flex: 0 0 auto;
        width: max-content;
      }

      /* Individual message */
      #shopify-section-{{ section.id }} .marquee-item {
        display: inline-flex;
        align-items: center;
        flex: 0 0 auto;
        white-space: nowrap;
      }

      #shopify-section-{{ section.id }} .marquee-item .subheading {
        display: inline-flex;
        align-items: center;
        flex: 0 0 auto;

        margin: 0;
        padding: 0.7rem 0;

        color: #000000 !important;
        font-family: "Mabry Pro", Arial, sans-serif;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: 0.025em;
        white-space: nowrap;
      }

      #shopify-section-{{ section.id }} .marquee-item span,
      #shopify-section-{{ section.id }} .marquee-item p,
      #shopify-section-{{ section.id }} .marquee-item a,
      #shopify-section-{{ section.id }} .marquee-item strong,
      #shopify-section-{{ section.id }} .marquee-item b {
        color: #000000 !important;
        -webkit-text-fill-color: #000000 !important;
      }

      /* Icons */
      #shopify-section-{{ section.id }} .marquee-item svg {
        display: inline-block;
        flex: 0 0 auto;
        margin-right: 6px;
        color: #000000 !important;
        stroke: currentColor;
      }

      /* Automatic diamond separator */
      #shopify-section-{{ section.id }} .marquee-item::after {
        content: "✦";

        display: inline-flex;
        justify-content: center;
        align-items: center;
        flex: 0 0 auto;

        margin: 0 28px;

        color: #000000;
        font-size: 13px;
        font-weight: 400;
        line-height: 1;
      }

      /* Seamless marquee loop */
      @keyframes sensonMarquee-{{ section.id }} {
        from {
          transform: translate3d(0, 0, 0);
        }

        to {
          transform: translate3d(-50%, 0, 0);
        }
      }

      /* Mobile */
      @media screen and (max-width: 740px) {
        #shopify-section-{{ section.id }}
        .marquee-item .subheading {
          padding: 0.6rem 0;
          font-size: 12px;
        }

        #shopify-section-{{ section.id }}
        .marquee-item::after {
          margin: 0 19px;
          font-size: 12px;
        }
      }

      /* Accessibility */
      @media (prefers-reduced-motion: reduce) {
        #shopify-section-{{ section.id }} .marquee {
          animation: none !important;
        }
      }
    </style>

    <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
      <height-observer variable="announcement-bar">

        <div
          class="announcement-bar"
          id="announcement-bar-{{ section.id }}"
        >

          <div
            class="marquee"
            id="marquee-{{ section.id }}"
          >

            {%- capture marquee_content -%}
              {%- for block in section.blocks -%}
                {%- if block.settings.text != blank -%}

                  <div
                    class="marquee-item"
                    {{ block.shopify_attributes }}
                  >
                    <p class="subheading subheading-xs">

                      {%- if block.settings.icon != blank and block.settings.icon != 'null' -%}
                        {%- render 'icon'
                          with block.settings.icon,
                          width: block.settings.icon_size
                        -%}
                      {%- endif -%}

                      <span>{{ block.settings.text }}</span>

                    </p>
                  </div>

                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}

            <div class="marquee-group">
              {{ marquee_content }}
            </div>

            <div class="marquee-group" aria-hidden="true">
              {{ marquee_content }}
            </div>

          </div>
        </div>

      </height-observer>
    </div>

    <script>
      (function() {
        function initAnnouncementBar() {
          var marquee = document.getElementById(
            'marquee-{{ section.id }}'
          );

          if (!marquee) return;

          var bar = document.getElementById(
            'announcement-bar-{{ section.id }}'
          );

          var group = marquee.querySelector('.marquee-group');

          if (!bar || !group) return;

          var speed = {{ section.settings.scroll_speed | default: 20 }};

          speed = Math.max(5, Math.min(60, speed));

          marquee.style.animationDuration = speed + 's';

          {% if section.settings.pause_on_hover %}
            if (bar.dataset.hoverBound !== 'true') {
              bar.dataset.hoverBound = 'true';

              bar.addEventListener('mouseenter', function() {
                marquee.style.animationPlayState = 'paused';
              });

              bar.addEventListener('mouseleave', function() {
                marquee.style.animationPlayState = 'running';
              });
            }
          {% endif %}

          function updateHeight() {
            var sectionElement = document.getElementById(
              'shopify-section-{{ section.id }}'
            );

            if (!sectionElement) return;

            document.documentElement.style.setProperty(
              '--announcement-bar-height',
              Math.round(sectionElement.clientHeight) + 'px'
            );
          }

          updateHeight();

          window.addEventListener('resize', updateHeight);
        }

        if (document.readyState === 'loading') {
          document.addEventListener(
            'DOMContentLoaded',
            initAnnouncementBar
          );
        } else {
          initAnnouncementBar();
        }

        document.addEventListener(
          'shopify:section:load',
          initAnnouncementBar
        );
      })();
    </script>

  {%- endunless -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "shopify-section--announcement-bar",
  "max_blocks": 5,
  "tag": "aside",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "t:sections.announcement_bar.enable_sticky",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_on_homepage_only",
      "label": "t:sections.announcement_bar.show_on_homepage_only",
      "default": false
    },
    {
      "type": "header",
      "content": "滚动跑马灯设置"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "滚动速度（秒）",
      "info": "数值越小滚动越快，越大越慢",
      "min": 5,
      "max": 60,
      "step": 1,
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "鼠标悬停时暂停滚动",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.announcement_bar.blocks.message.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon选项",
          "options": [
            {
              "value": "null",
              "label": "不显示 Icon"
            },
            {
              "value": "global",
              "label": "global"
            },
            {
              "value": "warranty",
              "label": "warranty"
            },
            {
              "value": "package",
              "label": "package"
            },
            {
              "value": "award",
              "label": "award"
            }
          ],
          "default": "null"
        },
        {
          "type": "number",
          "id": "icon_size",
          "label": "Icon 大小",
          "default": 14
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:sections.announcement_bar.blocks.message.text",
          "default": "Announce something here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.name"
    }
  ]
}
{% endschema %}
