{%- if section.blocks.size > 0 -%}
  {%- unless request.page_type != 'index' and section.settings.show_on_homepage_only -%}
    <style>
      :root {
        --announcement-bar-is-sticky: {% if section.settings.enable_sticky %}1{% else %}0{% endif %};
      }

      {%- if section.settings.enable_sticky -%}
        #shopify-section-{{ section.id }} {
          position: sticky;
          top: 0;
        }

        .shopify-section--header ~ #shopify-section-{{ section.id }} {
          top: calc(var(--header-is-sticky, 0) * var(--header-is-visible, 0) * var(--header-height, 0px));
        }
      {%- endif -%}


      /* 跑马灯容器 */
      .announcement-bar {
        padding:0;
        overflow:hidden;
        white-space:nowrap;
      }


      /* 滚动内容 */
      .marquee {
        display:inline-block;
        white-space:nowrap;
        animation: marqueeScroll linear infinite;
        animation-duration:{{ section.settings.scroll_speed }}s;
      }


      .marquee-item {
        display:inline-flex;
        align-items:center;
        margin-right:60px;
      }


      .marquee-item .subheading {
        display:flex;
        align-items:center;
        margin:0;
        padding:0.7rem 0;
      }


      .marquee-item svg {
        margin-right:4px;
      }


      /* 无限滚动 */
      @keyframes marqueeScroll {
        0% {
          transform:translateX(0);
        }

        100% {
          transform:translateX(-50%);
        }
      }



      /* ==========================
         Orgasm Day Peach Theme
         ========================== */


      #shopify-section-{{ section.id }} .announcement-bar {

        background:linear-gradient(
          90deg,
          #FFF4EE 0%,
          #FBC4B0 40%,
          #F7A58B 70%,
          #F287EC 100%
        );

        color:#34263B;

      }



      #shopify-section-{{ section.id }} .announcement-bar,
      #shopify-section-{{ section.id }} .announcement-bar .subheading,
      #shopify-section-{{ section.id }} .announcement-bar span,
      #shopify-section-{{ section.id }} .announcement-bar p,
      #shopify-section-{{ section.id }} .announcement-bar .subheading span {

        color:#34263B;

      }



      #shopify-section-{{ section.id }} .announcement-bar svg {

        fill:none;
        stroke:currentColor;
        color:#34263B;

      }



      /* Mobile */

      @media screen and (max-width:600px){

        .announcement-bar .subheading {

          font-size:12px;

        }


        .marquee-item {

          margin-right:40px;

        }

      }

    </style>



    <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">

      <height-observer variable="announcement-bar">

        <div
          class="announcement-bar"
          id="announcement-bar-{{ section.id }}"
        >

          <div
            class="marquee"
            id="marquee-{{ section.id }}"
          >


            {%- capture marquee_content -%}

              {%- for block in section.blocks -%}

                {%- if block.settings.text != blank -%}

                  <span
                    class="marquee-item"
                    {{ block.shopify_attributes }}
                  >

                    <p class="subheading subheading-xs">

                      {%- if block.settings.icon and block.settings.icon != 'null' -%}

                        {%- render 'icon'
                          with block.settings.icon,
                          width: block.settings.icon_size
                        -%}

                      {%- endif -%}


                      <span>
                        {{ block.settings.text }}
                      </span>


                    </p>

                  </span>

                {%- endif -%}

              {%- endfor -%}


            {%- endcapture -%}


            {{ marquee_content }}
            {{ marquee_content }}


          </div>

        </div>


      </height-observer>

    </div>




    <script>

      (function() {

        const marquee =
        document.getElementById('marquee-{{ section.id }}');


        if (!marquee) return;


        const items = marquee.children;


        if (items.length === 0) return;



        let speed =
        {{ section.settings.scroll_speed | default:20 }};



        if(speed < 5){
          speed = 5;
        }


        if(speed > 60){
          speed = 60;
        }


        marquee.style.animationDuration =
        speed + 's';




        const bar =
        document.getElementById(
          'announcement-bar-{{ section.id }}'
        );



        {% if section.settings.pause_on_hover %}

        bar.addEventListener(
          'mouseenter',
          () => {
            marquee.style.animationPlayState='paused';
          }
        );


        bar.addEventListener(
          'mouseleave',
          () => {
            marquee.style.animationPlayState='running';
          }
        );

        {% endif %}



      })();


    </script>




    <script>

      document.documentElement.style.setProperty(
        '--announcement-bar-height',
        `${Math.round(
          document.getElementById(
            'shopify-section-{{ section.id }}'
          ).clientHeight
        )}px`
      );

    </script>


  {%- endunless -%}

{%- endif -%}




{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "shopify-section--announcement-bar",
  "max_blocks": 5,
  "tag": "aside",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "t:sections.announcement_bar.enable_sticky",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_on_homepage_only",
      "label": "t:sections.announcement_bar.show_on_homepage_only",
      "default": false
    },
    {
      "type": "header",
      "content": "滚动跑马灯设置"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "滚动速度（秒）",
      "info": "数值越小滚动越快，越大越慢",
      "min": 5,
      "max": 60,
      "step": 1,
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "鼠标悬停时暂停滚动",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.announcement_bar.blocks.message.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon选项",
          "options": [
            {
              "value": "null",
              "label": "不显示 Icon"
            },
            {
              "value": "global",
              "label": "global"
            },
            {
              "value": "warranty",
              "label": "warranty"
            },
            {
              "value": "package",
              "label": "package"
            },
            {
              "value": "award",
              "label": "award"
            }
          ],
          "default": "null"
        },
        {
          "type": "number",
          "id": "icon_size",
          "label": "Icon 大小",
          "default":14
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:sections.announcement_bar.blocks.message.text",
          "default":"Announce something here"
        }
      ]
    }
  ],
  "presets":[
    {
      "name":"t:sections.announcement_bar.name"
    }
  ]
}
{% endschema %}