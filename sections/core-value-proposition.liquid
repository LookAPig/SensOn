{%- if section.settings.heading != blank or section.settings.image != blank or section.blocks.size > 0 -%}
  <div id="cvp-{{ section.id }}" class="core-value-proposition">
    <style>
      #cvp-{{ section.id }} {
        width: 100%;
        background-color: {{ section.settings.background_color | default: '#000000' }};
        padding: 150px 0 80px;
        box-sizing: border-box;
      }

      #cvp-{{ section.id }} * {
        box-sizing: border-box;
      }

      #cvp-{{ section.id }} .cvp-inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        align-items: center;
      }

      .cvp-content{
            width: 50%;
    padding-right: 55px;
      }
      #cvp-{{ section.id }} .cvp-heading {
        margin: 0 0 59px;
        font-size: 42px;
        font-weight: 700;
        line-height: 1.2;
        color: #fff;
      }

      #cvp-{{ section.id }} .cvp-features {
        display: flex;
        flex-direction: column;
        gap: 44px;
      }

      #cvp-{{ section.id }} .cvp-feature {
        display: flex;
        align-items: flex-start;
        gap: 16px;
      }

      #cvp-{{ section.id }} .cvp-feature-icon {
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: transparent;
      }

      #cvp-{{ section.id }} .cvp-feature-icon img {
        width: 30px;
        height: 30px;
        object-fit: contain;
        display: block;
      }

      #cvp-{{ section.id }} .cvp-feature-body {
        min-width: 0;
        flex: 1;
      }

      #cvp-{{ section.id }} .cvp-feature-title {
        margin: 0 0 15px;
        font-size: 24px;
        font-weight: 700;
        line-height: 1.25;
        color: #fff;
      }

      #cvp-{{ section.id }} .cvp-feature-desc {
        margin: 0;
        font-size: 16px;
        font-weight: 400;
        line-height: 1.5;
        color: #b3b3b3;
      }

      #cvp-{{ section.id }} .cvp-media {
    width: 50%;
    border-radius: 4px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #3a3a3a;
      }

      #cvp-{{ section.id }} .cvp-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      @media screen and (max-width: 999px) {
        #cvp-{{ section.id }} {
          padding: 60px 16px;
        }

        #cvp-{{ section.id }} .cvp-inner {
          grid-template-columns: 1fr;
          gap: 32px;
                  flex-flow: wrap;
        }

        #cvp-{{ section.id }} .cvp-heading {
          font-size: 24px;
          margin-bottom: 24px;
        }

        #cvp-{{ section.id }} .cvp-features {
          gap: 24px;
        }

        #cvp-{{ section.id }} .cvp-media {
          order: -1;
              width: 100%;
        }
        .cvp-content {
    width: 100%;
    padding-right: 0;
}
  #cvp-{{ section.id }} .cvp-feature-title {
        margin: 0 0 8px;
        font-size: 18px;
      
      }

      #cvp-{{ section.id }} .cvp-feature-desc {
        font-size: 14px;
      
      }
      }
    </style>
 {%- if section.settings.heading != blank -%}
          <h2 class="cvp-heading mob_show">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
    <div class="cvp-inner">
      <div class="cvp-content">
        {%- if section.settings.heading != blank -%}
          <h2 class="cvp-heading pc_show">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="cvp-features">
            {%- for block in section.blocks -%}
              {%- if block.settings.title != blank or block.settings.description != blank or block.settings.icon != blank -%}
                <div class="cvp-feature" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != blank -%}
                    <div class="cvp-feature-icon">
                      {{
                        block.settings.icon
                        | image_url: width: 80
                        | image_tag: loading: 'lazy', widths: '40, 80', sizes: '40px', alt: block.settings.title
                      }}
                    </div>
                  {%- else -%}
                    <div class="cvp-feature-icon" aria-hidden="true"></div>
                  {%- endif -%}
                  <div class="cvp-feature-body">
                    {%- if block.settings.title != blank -%}
                      <h3 class="cvp-feature-title">{{ block.settings.title | escape }}</h3>
                    {%- endif -%}
                    {%- if block.settings.description != blank -%}
                      <p class="cvp-feature-desc">{{ block.settings.description | escape }}</p>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.image != blank -%}
        <div class="cvp-media">
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 1000px) 50vw, 100vw', alt: section.settings.heading
          }}
        </div>
      {%- else -%}
        <div class="cvp-media" aria-hidden="true"></div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Core value proposition",
  "class": "shopify-section--core-value-proposition",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Core Value Proposition"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Core value proposition",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "High-Performance Earnings",
            "description": "With a premium $229 AOV and a 20% commission rate, you earn $45.80 on every single sale. No caps, no limits."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Lifetime Recurring Income",
            "description": "Our 365-day cookie window and recurring commission model mean you get paid for every repeat purchase your referrals make."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Live The Loop",
            "description": "Join a community of creators who believe in pleasure without compromise. Share products you love and build income that lasts."
          }
        }
      ]
    }
  ]
}
{% endschema %}
