{%- liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  if desktop_image == blank
    assign desktop_image = mobile_image
  endif
  if mobile_image == blank
    assign mobile_image = desktop_image
  endif
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign text_align = section.settings.text_align | default: 'left'

  if section.settings.desktop_height_mode == 'fullscreen'
    assign desktop_height = '100svh'
  else
    assign desktop_height = section.settings.desktop_height | default: 720 | append: 'px'
  endif

  if section.settings.mobile_height_mode == 'fullscreen'
    assign mobile_height = '100svh'
  else
    assign mobile_height = section.settings.mobile_height | default: 640 | append: 'px'
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .ostoi {
    --h: {{ desktop_height }};
    --hm: {{ mobile_height }};
    --c-sub: {{ section.settings.subtitle_color }};
    --c-title: {{ section.settings.heading_color }};
    --c-desc: {{ section.settings.description_color }};
    --fs-sub: {{ section.settings.subtitle_font_size | default: 24 }}px;
    --fs-title: {{ section.settings.heading_font_size | default: 42 }}px;
    --fs-desc: {{ section.settings.description_font_size | default: 16 }}px;
    --fs-sub-m: {{ section.settings.subtitle_font_size_mobile | default: 16 }}px;
    --fs-title-m: {{ section.settings.heading_font_size_mobile | default: 28 }}px;
    --fs-desc-m: {{ section.settings.description_font_size_mobile | default: 14 }}px;
    background: #1a1a1a;
    min-height: var(--h);
    overflow: hidden;
    position: relative;
  }
  #shopify-section-{{ section.id }} .ostoi .media,
  #shopify-section-{{ section.id }} .ostoi .image,
  #shopify-section-{{ section.id }} .ostoi .placeholder {
    height: 100%; inset: 0; position: absolute; width: 100%;
  }
  #shopify-section-{{ section.id }} .ostoi .image { object-fit: cover; object-position: center; }
  #shopify-section-{{ section.id }} .ostoi .mobile_image { display: none; }
  #shopify-section-{{ section.id }} .ostoi .placeholder {
    background: linear-gradient(180deg, #2a1a24 0%, #1a1218 100%);
  }
  #shopify-section-{{ section.id }} .ostoi .content {
    display: flex; flex-direction: column; inset: 0; position: absolute; z-index: 2;
    padding: 48px 80px; max-width: 560px; box-sizing: border-box; width: 100%;
  }
  #shopify-section-{{ section.id }} .ostoi .content--left {
    align-items: flex-start; justify-content: center; margin-right: auto; text-align: left;
  }
  #shopify-section-{{ section.id }} .ostoi .content--center {
    align-items: center; justify-content: center; left: 50%; max-width: 720px;
    margin: 0; padding-left: 24px; padding-right: 24px; text-align: center;
    transform: translateX(-50%); width: calc(100% - 48px);
  }
  #shopify-section-{{ section.id }} .ostoi .content--right {
    align-items: flex-end; justify-content: center; margin-left: auto; text-align: right;
  }
  #shopify-section-{{ section.id }} .ostoi .subtitle {
    color: var(--c-sub); font-size: var(--fs-sub); font-weight: 500; line-height: 1.3; margin: 0 0 12px;
  }
  #shopify-section-{{ section.id }} .ostoi .title {
    color: var(--c-title); font-size: var(--fs-title); font-weight: 500;
    letter-spacing: -0.02em; line-height: 1.2; margin: 0; max-width: 100%;
  }
  #shopify-section-{{ section.id }} .ostoi .description {
    color: var(--c-desc); font-size: var(--fs-desc); line-height: 1.45; margin: 16px 0 0; max-width: 100%;
  }
  #shopify-section-{{ section.id }} .ostoi .description p { margin: 0; }
  #shopify-section-{{ section.id }} .ostoi .description p + p { margin-top: 0.75em; }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ostoi { min-height: var(--hm); }
    #shopify-section-{{ section.id }} .ostoi .desktop_image { display: none; }
    #shopify-section-{{ section.id }} .ostoi .mobile_image { display: block; }
    #shopify-section-{{ section.id }} .ostoi .content {
      left: 0; max-width: none; padding: 32px 16px; right: 0; transform: none; width: 100%;
    }
    #shopify-section-{{ section.id }} .ostoi .content--left,
    #shopify-section-{{ section.id }} .ostoi .content--right {
      align-items: flex-start; justify-content: flex-start; margin: 0; text-align: left;
    }
    #shopify-section-{{ section.id }} .ostoi .content--center {
      align-items: center; justify-content: center; text-align: center;
    }
    #shopify-section-{{ section.id }} .ostoi .subtitle { font-size: var(--fs-sub-m); margin-bottom: 10px; }
    #shopify-section-{{ section.id }} .ostoi .title { font-size: var(--fs-title-m); }
    #shopify-section-{{ section.id }} .ostoi .description { font-size: var(--fs-desc-m); margin-top: 12px; }
  }
</style>

<section class="ostoi" {% if section.settings.allow_transparent_header %}allow-transparent-header{% endif %}>
  <div class="media" aria-hidden="true">
    {%- if desktop_image != blank -%}
      {{- desktop_image | image_url: width: 2400 | image_tag: class: 'image desktop_image', loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1000, 1200, 1600, 2000, 2400' -}}
    {%- endif -%}
    {%- if mobile_image != blank -%}
      {{- mobile_image | image_url: width: 1000 | image_tag: class: 'image mobile_image', loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '375, 550, 750, 1000' -}}
    {%- endif -%}
    {%- if desktop_image == blank and mobile_image == blank -%}<div class="placeholder"></div>{%- endif -%}
  </div>
  <div class="content content--{{ text_align }}">
    {%- if section.settings.subtitle != blank -%}
      <p class="subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <{{ heading_tag }} class="title">{{ section.settings.heading | escape | newline_to_br }}</{{ heading_tag }}>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="description">{{ section.settings.description }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Our story text over image",
  "tag": "section",
  "class": "shopify-section--our-story-text-over-image",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "checkbox", "id": "allow_transparent_header", "label": "启用透明页头", "default": true },
    { "type": "header", "content": "图片" },
    { "type": "image_picker", "id": "desktop_image", "label": "电脑端图片" },
    { "type": "image_picker", "id": "mobile_image", "label": "移动端图片", "info": "未设置时使用电脑端图片。" },
    { "type": "header", "content": "高度" },
    { "type": "select", "id": "desktop_height_mode", "label": "电脑端高度", "options": [
      { "value": "custom", "label": "自定义高度" },
      { "value": "fullscreen", "label": "全屏" }
    ], "default": "custom" },
    { "type": "number", "id": "desktop_height", "label": "电脑端高度（px）", "default": 720, "visible_if": "{{ section.settings.desktop_height_mode == 'custom' }}" },
    { "type": "select", "id": "mobile_height_mode", "label": "移动端高度", "options": [
      { "value": "custom", "label": "自定义高度" },
      { "value": "fullscreen", "label": "全屏" }
    ], "default": "custom" },
    { "type": "number", "id": "mobile_height", "label": "移动端高度（px）", "default": 640, "visible_if": "{{ section.settings.mobile_height_mode == 'custom' }}" },
    { "type": "header", "content": "布局" },
    { "type": "select", "id": "text_align", "label": "文案位置", "info": "选择左或右时，移动端文案会自动置顶，避免遮挡图片主体。", "options": [
      { "value": "left", "label": "左" },
      { "value": "center", "label": "中" },
      { "value": "right", "label": "右" }
    ], "default": "left" },
    { "type": "header", "content": "文案" },
    { "type": "text", "id": "subtitle", "label": "副标题", "default": "Entirely Yours" },
    { "type": "range", "id": "subtitle_font_size", "label": "副标题字号（电脑）", "min": 12, "max": 48, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "subtitle_font_size_mobile", "label": "副标题字号（移动）", "min": 12, "max": 36, "step": 1, "unit": "px", "default": 16 },
    { "type": "color", "id": "subtitle_color", "label": "副标题颜色", "default": "#F287EC" },
    { "type": "textarea", "id": "heading", "label": "大标题", "default": "We create a sex experience that reflects you" },
    { "type": "range", "id": "heading_font_size", "label": "大标题字号（电脑）", "min": 20, "max": 80, "step": 1, "unit": "px", "default": 42 },
    { "type": "range", "id": "heading_font_size_mobile", "label": "大标题字号（移动）", "min": 16, "max": 48, "step": 1, "unit": "px", "default": 28 },
    { "type": "color", "id": "heading_color", "label": "大标题颜色", "default": "#FFFFFF" },
    { "type": "select", "id": "heading_tag", "label": "标题标签", "info": "用于 SEO。同一页面建议只保留一个 H1。", "options": [
      { "value": "h1", "label": "H1" },
      { "value": "h2", "label": "H2" },
      { "value": "h3", "label": "H3" }
    ], "default": "h2" },
    { "type": "richtext", "id": "description", "label": "描述", "default": "<p>Desire isn't one-size-fits-all. SensOn is designed to learn, adapt, and respond to you — creating intimacy that feels personal, intuitive, and uniquely yours.</p>" },
    { "type": "range", "id": "description_font_size", "label": "描述字号（电脑）", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "description_font_size_mobile", "label": "描述字号（移动）", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "color", "id": "description_color", "label": "描述颜色", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Our story text over image", "category": "Banners" }]
}
{% endschema %}
