{%- comment -%} CTA 静态样式（固定两行形态，不随点击变形） {%- endcomment -%}
<style>
  /* 容器始终保持上下垂直排列 */
  .custom-cta-form .input-with-connected-submit {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  /* 输入框固定满宽 */
  .custom-cta-form .input-with-connected-submit input[type="email"] {
    width: 100%;
    transition: border-color 0.3s ease;
  }

  /* 按钮固定满宽 */
  .custom-cta-form .input-with-connected-submit button,
  .custom-cta-form .input-with-connected-submit .button {
    width: 100%;
    transition: opacity 0.3s ease;
  }
</style>