{%- liquid
  assign center_content = false

  unless section.settings.image_position == 'split' and section.settings.image != blank
    assign center_content = true
  endunless

  # 内容垂直对齐样式映射
  case section.settings.content_position
    when 'top'
      assign position_class = 'self-start py-10 sm:py-16'
    when 'bottom'
      assign position_class = 'self-end py-10 sm:py-16'
    else
      assign position_class = 'place-self-center py-10'
  endcase
-%}

{%- comment -%} CTA 响应式独立样式设置 {%- endcomment -%}
<style>
  /* 移动端 (默认/H5) 基础样式 */
  .custom-cta-form,
  .custom-cta-form .input-with-connected-submit {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 12px !important;
    width: 100% !important;
    max-width: 100% !important;
    margin-left: auto !important;
    margin-right: auto !important;
    grid-template-columns: none !important;
  }

  .custom-cta-form .input-with-connected-submit > * {
    width: 100% !important;
    max-width: {{ section.settings.mobile_input_max_width }}px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    flex: none !important;
  }

  /* H5 Email 输入框 */
  .custom-cta-form .input-with-connected-submit input[type="email"],
  .custom-cta-form .input-with-connected-submit .input {
    width: 100% !important;
    max-width: {{ section.settings.mobile_input_max_width }}px !important;
    height: {{ section.settings.mobile_button_height }}px !important;
    margin: 0 auto !important;
    background-color: rgba(0, 0, 0, 0.35) !important;
    border: 1px solid rgba(255, 255, 255, 0.25) !important;
    border-radius: var(--button-border-radius, 4px) !important;
    color: #ffffff !important;
    box-sizing: border-box !important;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }

  .custom-cta-form .input-with-connected-submit input[type="email"]::placeholder {
    color: rgba(255, 255, 255, 0.6) !important;
  }

  .custom-cta-form .input-with-connected-submit input[type="email"]:focus {
    border-color: rgba(255, 255, 255, 0.6) !important;
    background-color: rgba(0, 0, 0, 0.5) !important;
  }

  /* H5 Subscribe 按钮 */
  .custom-cta-form .input-with-connected-submit button,
  .custom-cta-form .input-with-connected-submit .button {
    {% if section.settings.button_width_type == 'fit' %}
      width: auto !important;
      min-width: 120px !important;
      padding-left: 24px !important;
      padding-right: 24px !important;
    {% else %}
      width: 100% !important;
      max-width: {{ section.settings.mobile_input_max_width }}px !important;
    {% endif %}
    height: {{ section.settings.mobile_button_height }}px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 auto !important;
    border-radius: var(--button-border-radius, 4px) !important;
    box-sizing: border-box !important;
    transition: opacity 0.3s ease;
  }

  /* PC 端覆盖样式 (≥700px) */
  @media screen and (min-width: 700px) {
    .custom-cta-form .input-with-connected-submit > * {
      max-width: {{ section.settings.input_max_width }}px !important;
    }

    .custom-cta-form .input-with-connected-submit input[type="email"],
    .custom-cta-form .input-with-connected-submit .input {
      max-width: {{ section.settings.input_max_width }}px !important;
      height: {{ section.settings.button_height }}px !important;
    }

    .custom-cta-form .input-with-connected-submit button,
    .custom-cta-form .input-with-connected-submit .button {
      {% if section.settings.button_width_type == 'fit' %}
        padding-left: 32px !important;
        padding-right: 32px !important;
      {% else %}
        max-width: {{ section.settings.input_max_width }}px !important;
      {% endif %}
      height: {{ section.settings.button_height }}px !important;
    }
  }
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  {%- capture section_text_content -%}
    <div class="v-stack max-w-lg {% if center_content %}mx-auto{% endif %} gap-4">
      <div class="{% if center_content %}text-center{% endif %}">
        {%- if section.settings.icon != 'none' -%}
          <div class="mb-2">
            {%- render 'icon' with section.settings.icon, width: 48, mobile_width: 28 -%}
          </div>
        {%- endif -%}

        {%- comment -%} 1. Logo 图片 (固定宽度 70px，紧贴标题) {%- endcomment -%}
        {%- if section.settings.logo != blank -%}
          <div class="newsletter-logo-wrapper flex justify-center" style="margin-bottom: 4px;">
            {{ section.settings.logo | image_url: width: 300 | image_tag: style: 'width: 70px; max-width: 70px; height: auto; display: block;', class: 'newsletter-logo', loading: 'lazy' }}
          </div>
        {%- endif -%}

        {%- comment -%} 2. 主标题 (Title) {%- endcomment -%}
        {%- if section.settings.title != blank -%}
          <div style="margin: 0; padding: 0;">
            {%- render 'heading', content: section.settings.title, style: section.settings.heading_tag, html_tag: 'h2' -%}
          </div>
        {%- endif -%}

        {%- comment -%} 3. 副标题/描述 (Description) {%- endcomment -%}
        {%- if section.settings.content != blank -%}
          <div style="color: rgba(255, 255, 255, 0.9) !important; font-size: 13px; line-height: 1.5; margin-top: 8px; display: block;">
            {{ section.settings.content }}
          </div>
        {%- endif -%}
      </div>

      {%- assign newsletter_form_id = 'newsletter-form-' | append: section.id -%}

      <div class="v-stack justify-self-center w-full md:max-w-sm gap-4">
        {%- assign has_form_posted_successfully = false -%}

        {%- form 'customer', id: newsletter_form_id, class: 'form custom-cta-form' -%}
          {%- if form.posted_successfully? -%}
            {%- assign success_message = 'general.newsletter.subscribed_successfully' | t -%}
            {%- assign has_form_posted_successfully = true -%}

            <input type="hidden" data-newsletter-success value="1">
            {%- render 'banner', content: success_message, status: 'success', text_alignment: 'center' -%}
          {%- elsif form.errors -%}
            {%- capture error_message -%}{{ form.errors.translated_fields['email'] }} {{ form.errors.messages['email'] }}{%- endcapture -%}
            {%- render 'banner', content: error_message, status: 'error' -%}
          {%- endif -%}

          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- assign input_label = 'general.newsletter.email' | t -%}

          <div class="input-with-connected-submit">
            {%- liquid 
              render 'input', name: 'contact[email]', label: input_label, type: 'email', required: true, autocomplete: 'email', enterkeyhint: 'send'

              assign button_default_content = 'general.newsletter.subscribe' | t
              assign button_content = section.settings.button_text | default: button_default_content

              render 'button', type: 'submit', content: button_content, icon: 'arrow-right'
            -%}
          </div>
        {%- endform -%}

        <script>
          (function () {
            var form = document.getElementById({{ newsletter_form_id | json }});
            if (!form) return;

            var emailKey = 'newsletter_email_{{ section.id }}';
            var trackedKey = 'newsletter_ga4_{{ section.id }}';

            form.addEventListener('submit', function () {
              var emailInput = form.querySelector('input[name="contact[email]"]');
              if (!emailInput) return;
              try {
                sessionStorage.setItem(emailKey, emailInput.value.trim());
              } catch (e) {}
            });

            if (!form.querySelector('[data-newsletter-success]')) return;

            try {
              if (sessionStorage.getItem(trackedKey) === '1') return;
              sessionStorage.setItem(trackedKey, '1');
            } catch (e) {}

            var email = null;
            try {
              email = sessionStorage.getItem(emailKey) || null;
              sessionStorage.removeItem(emailKey);
            } catch (e) {}

            var eventName = 'email_submitted';
            var payload = {
              value: email,
              page_url: window.location.href,
              items: [{ email: email }]
            };

            window.dataLayer = window.dataLayer || [];
            if (typeof window.gtag === 'function') {
              window.gtag('event', eventName, payload);
            } else {
              window.dataLayer.push(Object.assign({ event: eventName }, payload));
            }
          })();
        </script>

        {%- if section.settings.privacy_policy_text != blank and has_form_posted_successfully == false -%}
          <p class="text-sm text-center {% unless section.settings.image_position == 'background' and section.settings.image != blank %}text-subdued{% endunless %}">
            {{- section.settings.privacy_policy_text -}}
          </p>
        {%- endif -%}
      </div>
    </div>
  {%- endcapture -%}

  {%- assign desktop_image = section.settings.image -%}
  {%- assign mobile_image = section.settings.mobile_image | default: desktop_image -%}

  {%- if desktop_image == blank or section.settings.image_position == 'background' -%}
    {%- if desktop_image != blank -%}
      <div class="content-box grid min-h-{{ section.settings.image_size }}">
        <div class="content-box__background-media with-overlay" style="--overlay: {{ section.settings.overlay_color.rgb }} / {{ section.settings.overlay_opacity | divided_by: 100.0 }}">
          {%- comment -%} PC 端背景图 {%- endcomment -%}
          {{- desktop_image | image_url: width: desktop_image.width | image_tag: widths: '600,800,1000,1200,1400,1600,1800,2000,2200,2400', class: 'hidden sm:block' -}}
          {%- comment -%} H5 移动端背景图 {%- endcomment -%}
          {{- mobile_image | image_url: width: mobile_image.width | image_tag: widths: '400,500,600,800', class: 'sm:hidden' -}}
        </div>

        <div class="{{ position_class }} w-full z-10">
          {{- section_text_content -}}
        </div>
      </div>
    {%- else -%}
      <div class="container section-spacing">
        {{- section_text_content -}}
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="section-split">
      <div class="section-split__column section-split__column--image {% unless section.settings.add_image_spacing %}section-split__column--flushed{% endunless %} relative">
        <div class="with-overlay" style="--overlay: {{ section.settings.overlay_color.rgb }} / {{ section.settings.overlay_opacity | divided_by: 100.0 }}; height: 100%; width: 100%;">
          {%- comment -%} PC 端分屏图 {%- endcomment -%}
          {{- desktop_image | image_url: width: desktop_image.width | image_tag: sizes: '50vw', widths: '600,800,1000,1200,1400,1600,1800,2000', class: 'hidden sm:block' -}}
          {%- comment -%} H5 移动端分屏图 {%- endcomment -%}
          {{- mobile_image | image_url: width: mobile_image.width | image_tag: sizes: '100vw', widths: '400,500,600,800', class: 'sm:hidden' -}}
        </div>
      </div>

      <div class="section-split__column {{ position_class }}">
        {{- section_text_content -}}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "class": "shopify-section--newsletter",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.newsletter.instructions"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "PC 端表单尺寸控制"
    },
    {
      "type": "range",
      "id": "input_max_width",
      "label": "PC 端表单组件宽度 (px)",
      "min": 200,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "button_height",
      "label": "PC 端按钮/输入框高度 (px)",
      "min": 32,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "H5 移动端表单尺寸控制"
    },
    {
      "type": "range",
      "id": "mobile_input_max_width",
      "label": "H5 端表单组件宽度 (px)",
      "min": 180,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "mobile_button_height",
      "label": "H5 端按钮/输入框高度 (px)",
      "min": 32,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "select",
      "id": "button_width_type",
      "label": "按钮宽度模式",
      "options": [
        { "value": "match_input", "label": "与输入框同宽" },
        { "value": "fit", "label": "根据内容自适应" }
      ],
      "default": "match_input"
    },
    {
      "type": "header",
      "content": "图片设置 (PC / H5 独立配置)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "PC 端图片",
      "info": "t:sections.newsletter.image_size_recommendation"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "H5 移动端图片",
      "info": "不传则默认使用 PC 端图片"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.newsletter.image_position",
      "options": [
        {
          "value": "split",
          "label": "t:sections.newsletter.image_position_options.split"
        },
        {
          "value": "background",
          "label": "t:sections.newsletter.image_position_options.background"
        }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "内容垂直位置",
      "options": [
        {
          "value": "top",
          "label": "靠上 (Top)"
        },
        {
          "value": "center",
          "label": "居中 (Center)"
        },
        {
          "value": "bottom",
          "label": "靠下 (Bottom)"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "t:global.image.size",
      "options": [
        {
          "value": "auto",
          "label": "t:global.sizes.original_image_ratio"
        },
        {
          "value": "sm",
          "label": "t:global.sizes.small"
        },
        {
          "value": "md",
          "label": "t:global.sizes.medium"
        },
        {
          "value": "lg",
          "label": "t:global.sizes.large"
        },
        {
          "value": "fill",
          "label": "t:global.sizes.fit_screen"
        }
      ],
      "default": "md",
      "visible_if": "{{ section.settings.image_position == 'background' }}"
    },
    {
      "type": "checkbox",
      "id": "add_image_spacing",
      "label": "t:sections.newsletter.add_image_spacing",
      "default": false,
      "visible_if": "{{ section.settings.image_position == 'split' }}"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:sections.newsletter.icon",
      "options": [
        {
          "value": "none",
          "label": "t:sections.newsletter.icon_options.none"
        },
        {
          "value": "envelope",
          "label": "t:sections.newsletter.icon_options.envelope"
        },
        {
          "value": "inbox",
          "label": "t:sections.newsletter.icon_options.inbox"
        },
        {
          "value": "plane",
          "label": "t:sections.newsletter.icon_options.plane"
        }
      ],
      "default": "envelope"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "顶图 Logo (PNG/SVG)",
      "info": "用于替代顶部文字，建议上传透明底 PNG 或 SVG 图片。"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Subscribe to our newsletter"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "副标题/描述 (Description)",
      "default": "<p>Get exclusive updates and special offers directly to your inbox.</p>"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:global.text.heading_size",
      "options": [
        {
          "value": "display-xl",
          "label": "Display XL"
        },
        {
          "value": "display-l",
          "label": "Display L"
        },
        {
          "value": "display-m",
          "label": "Display M"
        },
        {
          "value": "h1",
          "label": "XX-Large"
        },
        {
          "value": "h2",
          "label": "X-Large"
        },
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h4",
          "label": "Medium"
        },
        {
          "value": "h5",
          "label": "Small"
        },
        {
          "value": "h6",
          "label": "X-Small"
        },
        {
          "value": "h7",
          "label": "XX-Small"
        }
      ],
      "default": "h3"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:global.text.button_text",
      "default": "Subscribe"
    },
    {
      "type": "inline_richtext",
      "id": "privacy_policy_text",
      "label": "t:sections.newsletter.privacy_policy_text",
      "default": "By signing up, you agree with our privacy policy."
    },
    {
      "type": "header",
      "content": "图片遮罩设置"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "遮罩颜色",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "遮罩不透明度",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.name",
      "category": "t:global.categories.call_to_action",
      "settings": {}
    }
  ]
}
{% endschema %}