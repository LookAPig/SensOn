{%- comment -%} 1. 顶标签 (Tag / Subheading) - 专属粉色 {#f287ec} {%- endcomment -%}
        {%- if section.settings.subheading != blank -%}
          <p style="color: #f287ec !important; font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 8px 0; display: block;">
            {{ section.settings.subheading | escape }}
          </p>
        {%- endif -%}

        {%- comment -%} 2. 主标题 (Title) {%- endcomment -%}
        {%- if section.settings.title != blank -%}
          {%- render 'heading', content: section.settings.title, style: section.settings.heading_tag, html_tag: 'h2' -%}
        {%- endif -%}

        {%- comment -%} 3. 副标题/描述 (Description) - 纯白度提高 {%- endcomment -%}
        {%- if section.settings.content != blank -%}
          <div style="color: rgba(255, 255, 255, 0.9) !important; font-size: 15px; line-height: 1.5; margin-top: 12px; display: block;">
            {{ section.settings.content }}
          </div>
        {%- endif -%}