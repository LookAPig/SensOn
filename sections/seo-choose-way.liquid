<style>
  #shopify-section-{{ section.id }} {
    max-width: 100%;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .seo_choose_way {
    --subtitle-color: {{ section.settings.subtitle_color | default: '#f287ec' }};
    --title-color: {{ section.settings.title_color | default: '#ffffff' }};
    --description-color: {{ section.settings.description_color | default: '#e8e8e8' }};
    --card-subtitle-color: {{ section.settings.card_subtitle_color | default: '#f287ec' }};
    --card-title-color: {{ section.settings.card_title_color | default: '#ffffff' }};
    --card-description-color: {{ section.settings.card_description_color | default: '#d2d2d2' }};
    --button-text-color: {{ section.settings.button_text_color | default: '#ffffff' }};
    --button-border-color: {{ section.settings.button_border_color | default: '#ffffff' }};
    --card-bg: {{ section.settings.card_background_color | default: '#4a4a4a' }};
    background: {{ section.settings.background_color | default: '#161616' }};
    color: var(--title-color);
    overflow: hidden;
    padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .seo_choose_way * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .inner {
    margin: 0 auto;
    max-width: 100%;
    padding: 0 16px;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .header {
    margin: 0 0 24px;
    text-align: left;
    width: 100%;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .eyebrow {
    color: var(--subtitle-color);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 8px;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .section_title {
    color: var(--title-color);
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .section_description {
    color: var(--description-color);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.45;
    margin: 12px 0 0;
    max-width: none;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .section_description p,
  #shopify-section-{{ section.id }} .seo_choose_way .section_description a,
  #shopify-section-{{ section.id }} .seo_choose_way .card_desc p,
  #shopify-section-{{ section.id }} .seo_choose_way .card_desc a {
    color: inherit;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .section_description p + p,
  #shopify-section-{{ section.id }} .seo_choose_way .card_desc p + p {
    margin-top: 8px;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .cards {
    display: grid;
    gap: 16px;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .way_card {
    background: var(--card-bg);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    min-height: 300px;
    overflow: hidden;
    padding: 22px 20px 120px;
    position: relative;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .card_media,
  #shopify-section-{{ section.id }} .seo_choose_way .card_shade {
    inset: 0;
    position: absolute;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .card_media {
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .card_image,
  #shopify-section-{{ section.id }} .seo_choose_way .card_placeholder {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: center;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .card_placeholder {
    background: var(--card-bg);
  }

  #shopify-section-{{ section.id }} .seo_choose_way .card_shade {
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.58) 0%, rgb(0 0 0 / 0.18) 34%, rgb(0 0 0 / 0) 58%),
      linear-gradient(0deg, rgb(0 0 0 / 0.28) 0%, rgb(0 0 0 / 0) 26%);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .card_copy,
  #shopify-section-{{ section.id }} .seo_choose_way .card_btn {
    position: relative;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .card_eyebrow {
    color: var(--card-subtitle-color);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 8px;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .card_title {
    color: var(--card-title-color);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0;
    overflow-wrap: break-word;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .card_desc {
    color: var(--card-description-color);
    display: none;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    margin: 10px 0 0;
    overflow-wrap: break-word;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .card_btn {
    align-items: center;
    background: transparent;
    border: 1px solid var(--button-border-color);
    border-radius: 999px;
    color: var(--button-text-color);
    display: inline-flex;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    justify-content: center;
    line-height: 1.2;
    margin: 28px 0 0;
    max-width: 100%;
    padding: 10px 18px;
    text-decoration: none;
    transition: background-color 0.2s ease;
    width: fit-content;
  }

  #shopify-section-{{ section.id }} .seo_choose_way a.card_btn {
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .seo_choose_way a.card_btn:hover {
    background: rgb(255 255 255 / 0.1);
  }

  #shopify-section-{{ section.id }} .seo_choose_way .card_btn:focus {
    outline: none;
  }

  #shopify-section-{{ section.id }} .seo_choose_way .card_btn:focus-visible {
    outline: 2px solid var(--button-text-color);
    outline-offset: 3px;
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .seo_choose_way {
      padding: {{ section.settings.desktop_padding_top }}px 0 {{ section.settings.desktop_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .seo_choose_way .inner {
      padding: 0 100px;
    }

    #shopify-section-{{ section.id }} .seo_choose_way .header {
      margin-bottom: 48px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .seo_choose_way .eyebrow {
      font-size: 18px;
      margin-bottom: 12px;
    }

    #shopify-section-{{ section.id }} .seo_choose_way .section_title {
      font-size: 48px;
      letter-spacing: -0.035em;
      line-height: 1.08;
    }

    #shopify-section-{{ section.id }} .seo_choose_way .section_description {
      font-size: 16px;
      line-height: 1.5;
      margin: 16px auto 0;
      max-width: 760px;
    }

    #shopify-section-{{ section.id }} .seo_choose_way .cards {
      align-items: stretch;
      gap: 20px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .seo_choose_way .way_card {
      border-radius: 20px;
      height: 100%;
      min-height: clamp(480px, 34vw, 640px);
      padding: 32px 32px 0;
    }

    #shopify-section-{{ section.id }} .seo_choose_way .card_copy {
      padding-bottom: 108px;
    }

    #shopify-section-{{ section.id }} .seo_choose_way .card_eyebrow {
      font-size: 15px;
      margin-bottom: 10px;
    }

    #shopify-section-{{ section.id }} .seo_choose_way .card_title {
      font-size: 32px;
    }

    #shopify-section-{{ section.id }} .seo_choose_way .card_desc {
      display: block;
      font-size: 15px;
      line-height: 1.55;
      margin-top: 12px;
      max-width: 520px;
    }

    #shopify-section-{{ section.id }} .seo_choose_way .card_btn {
      bottom: 28px;
      font-size: 15px;
      left: 32px;
      margin: 0;
      padding: 11px 22px;
      position: absolute;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .seo_choose_way .card_btn {
      transition: none;
    }
  }
</style>

<section class="seo_choose_way" id="seo-choose-way-{{ section.id }}">
  <div class="inner">
    <div class="header">
      {%- if section.settings.subtitle != blank -%}
        <p class="eyebrow">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="section_title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="section_description">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="cards">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_alt = block.settings.title | default: block.settings.subtitle | default: 'SensOn'
          -%}
          <article class="way_card" {{ block.shopify_attributes }}>
            <div class="card_media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1600
                  | image_tag:
                    class: 'card_image',
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000, 1400, 1600',
                    sizes: '(min-width: 990px) calc((100vw - 220px) / 2), calc(100vw - 32px)',
                    alt: card_alt
                }}
                <div class="card_shade"></div>
              {%- else -%}
                <div class="card_placeholder"></div>
              {%- endif -%}
            </div>

            <div class="card_copy">
              {%- if block.settings.subtitle != blank -%}
                <p class="card_eyebrow">{{ block.settings.subtitle | escape }}</p>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <h3 class="card_title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <div class="card_desc">{{ block.settings.description }}</div>
              {%- endif -%}
            </div>

            {%- if block.settings.button_label != blank -%}
              {%- if block.settings.button_link != blank -%}
                <a class="card_btn" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
              {%- else -%}
                <span class="card_btn">{{ block.settings.button_label | escape }}</span>
              {%- endif -%}
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "SEO choose way",
  "tag": "section",
  "class": "shopify-section--seo-choose-way",
  "disabled_on": {
