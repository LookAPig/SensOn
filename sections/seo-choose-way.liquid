      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_description_color",
      "label": "卡片描述颜色",
      "default": "#d2d2d2"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "按钮文字颜色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "按钮边框颜色",
      "default": "#ffffff"
    },
    {
      "type": "header",
