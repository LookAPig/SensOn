      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "PC 端底部间距",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "移动端顶部间距",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
