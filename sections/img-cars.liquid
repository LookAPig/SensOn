{%- if section.blocks.size > 0 -%}
  <style>
    #shopify-section-{{ section.id }} {
      background-color: #fff;
      width: 100%;
      box-sizing: border-box;
      padding: 0;
    }

    #shopify-section-{{ section.id }} * {
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .wd-container {
      padding: 30px 0;
      width: 100%;
      margin: 0 auto;
    }

    #shopify-section-{{ section.id }} .wd-title {
      font-size: 24px;
      font-weight: 500;
      line-height: 1.2;
      color: #000;
      margin: 0 0 24px 0;
      padding: 0 16px;
    }

    #shopify-section-{{ section.id }} .wd-mobile-layout {
      display: block;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .wd-carousel {
      width: 100%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      scroll-padding-left: 16px;
    }

    #shopify-section-{{ section.id }} .wd-carousel::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .wd-carousel-track {
      display: flex;
      gap: 16px;
      padding: 0 16px;
      width: max-content;
    }

    #shopify-section-{{ section.id }} .wd-carousel-track::after {
      content: '';
      width: 1px;
      flex-shrink: 0;
    }

    #shopify-section-{{ section.id }} .wd-card {
      width: 320px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      scroll-snap-align: start;
    }

    #shopify-section-{{ section.id }} .wd-card-img-wrapper {
      width: 320px;
      height: 320px;
      position: relative;
      flex-shrink: 0;
    }

    #shopify-section-{{ section.id }} .wd-card-img-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #shopify-section-{{ section.id }} .wd-card-content {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .wd-card-top {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .wd-card-title {
      font-size: 18px;
      font-weight: 700;
      line-height: 1.1;
      color: #000;
      margin: 0;
    }

    #shopify-section-{{ section.id }} .wd-card-line {
      width: 80px;
      height: 2px;
      background-color: #f287ec;
    }

    #shopify-section-{{ section.id }} .wd-card-desc {
      font-size: 14px;
      line-height: 1.2;
      color: #000;
      margin: 0;
    }

    #shopify-section-{{ section.id }} .wd-grid {
      display: none;
    }

    #shopify-section-{{ section.id }} .wd-img-pc {
      display: none;
    }
    #shopify-section-{{ section.id }} .wd-pc-bg {
      display: none;
    }
    #shopify-section-{{ section.id }} .wd-spacer {
      display: none;
    }
    #shopify-section-{{ section.id }} .wd-icon-wrapper {
      display: none;
    }

    @media (min-width: 1000px) {
      #shopify-section-{{ section.id }} .wd-container {
        padding: 64px 100px 0 100px;
      }

      #shopify-section-{{ section.id }} .wd-title {
        font-size: 32px;
        margin: 0 0 32px 0;
        padding: 0;
      }

      #shopify-section-{{ section.id }} .wd-mobile-layout {
        display: none;
      }

      #shopify-section-{{ section.id }} .wd-grid {
        display: flex;
        flex-direction: row;
        gap: 24px;
      }

      #shopify-section-{{ section.id }} .wd-item {
        flex: 1;
        position: relative;
        aspect-ratio: 296 / 394.66;
        overflow: hidden;
        cursor: pointer;
        border-radius: 4px;
        min-height: 400px;
      }

      #shopify-section-{{ section.id }} .wd-img-m {
        display: none;
      }

      #shopify-section-{{ section.id }} .wd-img-pc {
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
      }

      #shopify-section-{{ section.id }} .wd-pc-bg {
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: #ffff;
        opacity: 0;
        transition: opacity 0.4s ease;
        z-index: 1;
      }

      #shopify-section-{{ section.id }} .wd-content {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        padding: 40px 24px 80px 24px;
        display: flex;
        flex-direction: column;
        z-index: 2;
      }

      #shopify-section-{{ section.id }} .wd-spacer {
        display: block;
        flex-grow: 1;
        transition: flex-grow 0.4s cubic-bezier(0.25, 1, 0.5, 1);
      }

      #shopify-section-{{ section.id }} .wd-text-wrap {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding-right: 64px;
        transition: padding-right 0.4s cubic-bezier(0.25, 1, 0.5, 1);
      }

      #shopify-section-{{ section.id }} .wd-item-title {
        margin: 0;
        font-size: 24px;
        font-weight: bold;
        line-height: 1.1;
        color: #fff;
        transition: color 0.4s cubic-bezier(0.25, 1, 0.5, 1);
      }

      #shopify-section-{{ section.id }} .wd-item-desc {
        margin: 0;
        font-size: 16px;
        font-weight: normal;
        line-height: 1.2;
        color: #000;
        opacity: 0;
        max-height: 0;
        overflow: hidden;
        transition: opacity 0.4s ease, max-height 0.4s ease;
      }

      #shopify-section-{{ section.id }} .wd-icon-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        position: absolute;
        bottom: 24px;
        right: 24px;
        width: 52px;
        height: 52px;
        border: 1.5px solid #fff;
        border-radius: 50%;
        box-sizing: border-box;
        z-index: 3;
        transition: border-color 0.4s ease;
      }

      #shopify-section-{{ section.id }} .wd-icon-inner {
        width: 29px;
        height: 29px;
        position: relative;
        transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      }

      #shopify-section-{{ section.id }} .wd-icon {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        transition: opacity 0.4s ease;
      }

      #shopify-section-{{ section.id }} .wd-icon-hover {
        opacity: 0;
      }

      #shopify-section-{{ section.id }} .wd-item:hover .wd-pc-bg {
        opacity: 0.85;
      }
      #shopify-section-{{ section.id }} .wd-item:hover .wd-spacer {
        flex-grow: 0;
      }
      #shopify-section-{{ section.id }} .wd-item:hover .wd-text-wrap {
        padding-right: 0;
      }
      #shopify-section-{{ section.id }} .wd-item:hover .wd-item-title {
        color: #000;
      }
      #shopify-section-{{ section.id }} .wd-item:hover .wd-item-desc {
        opacity: 1;
        max-height: 200px;
      }
      #shopify-section-{{ section.id }} .wd-item:hover .wd-icon-wrapper {
        border-color: #565656;
      }
      #shopify-section-{{ section.id }} .wd-item:hover .wd-icon-inner {
        transform: rotate(90deg);
      }
      #shopify-section-{{ section.id }} .wd-item:hover .wd-icon-default {
        opacity: 0;
      }
      #shopify-section-{{ section.id }} .wd-item:hover .wd-icon-hover {
        opacity: 1;
      }
    }
  </style>

  <section id="pdp-why-different" class="pdp-why-different">
    <div class="wd-container">
      {%- if section.settings.heading != blank -%}
        <h2 class="wd-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="wd-mobile-layout">
        <div class="wd-carousel">
          <div class="wd-carousel-track">
            {%- for block in section.blocks -%}
              {%- if block.type != 'item' -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign wd_alt = block.settings.title | strip | escape -%}
              <div class="wd-card" {{ block.shopify_attributes }}>
                <div class="wd-card-img-wrapper">
                  {%- if block.settings.image_mobile != blank -%}
                    {{
                      block.settings.image_mobile
                      | image_url: width: 640
                      | image_tag:
                        loading: 'lazy',
                        class: '',
                        widths: '320, 480, 640',
                        sizes: '320px',
                        alt: wd_alt
                    }}
                  {%- elsif block.settings.image_desktop != blank -%}
                    {{
                      block.settings.image_desktop
                      | image_url: width: 640
                      | image_tag:
                        loading: 'lazy',
                        widths: '320, 480, 640',
                        sizes: '320px',
                        alt: wd_alt
                    }}
                  {%- endif -%}
                </div>
                <div class="wd-card-content">
                  <div class="wd-card-top">
                    {%- if block.settings.title != blank -%}
                      <h3 class="wd-card-title">{{ block.settings.title | escape }}</h3>
                    {%- endif -%}
                    <div class="wd-card-line"></div>
                  </div>
                  {%- if block.settings.description != blank -%}
                    <p class="wd-card-desc">{{ block.settings.description | escape | newline_to_br }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>

      <div class="wd-grid">
        {%- for block in section.blocks -%}
          {%- if block.type != 'item' -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign wd_alt = block.settings.title | strip | escape -%}
          <div class="wd-item" {{ block.shopify_attributes }}>
            {%- if block.settings.image_mobile != blank -%}
              {{
                block.settings.image_mobile
                | image_url: width: 640
                | image_tag:
                  loading: 'lazy',
                  class: 'wd-img-m',
                  widths: '320, 480, 640',
                  sizes: '320px',
                  alt: wd_alt
              }}
            {%- endif -%}
            {%- if block.settings.image_desktop != blank -%}
              {{
                block.settings.image_desktop
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'wd-img-pc',
                  widths: '600, 900, 1200',
                  sizes: '(min-width: 1000px) 33vw, 0px',
                  alt: wd_alt
              }}
            {%- endif -%}
            <div class="wd-pc-bg"></div>
            <div class="wd-content">
              <div class="wd-spacer"></div>
              <div class="wd-text-wrap">
                {%- if block.settings.title != blank -%}
                  <h3 class="wd-item-title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="wd-item-desc">{{ block.settings.description | escape | newline_to_br }}</p>
                {%- endif -%}
              </div>
            </div>
            <div class="wd-icon-wrapper">
              <div class="wd-icon-inner">
                {%- if section.settings.icon_default != blank -%}
                  {{
                    section.settings.icon_default
                    | image_url: width: 58
                    | image_tag:
                      loading: 'lazy',
                      class: 'wd-icon wd-icon-default',
                      widths: '29, 58',
                      alt: ''
                  }}
                {%- else -%}
                  <img
                    class="wd-icon wd-icon-default"
                    src="https://cdn.shopify.com/s/files/1/0775/2446/7967/files/add-line.svg?v=1774785216"
                    alt=""
                    width="29"
                    height="29"
                    loading="lazy"
                  >
                {%- endif -%}
                {%- if section.settings.icon_hover != blank -%}
                  {{
                    section.settings.icon_hover
                    | image_url: width: 58
                    | image_tag:
                      loading: 'lazy',
                      class: 'wd-icon wd-icon-hover',
                      widths: '29, 58',
                      alt: ''
                  }}
                {%- else -%}
                  <img
                    class="wd-icon wd-icon-hover"
                    src="https://cdn.shopify.com/s/files/1/0775/2446/7967/files/add-line-1.svg?v=1774785216"
                    alt=""
                    width="29"
                    height="29"
                    loading="lazy"
                  >
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;
      function syncTitleHeights() {
        var titles = root.querySelectorAll('.wd-item-title');
        titles.forEach(function (el) {
          el.style.minHeight = '';
        });
        if (window.innerWidth < 1000) return;
        var maxH = 0;
        titles.forEach(function (el) {
          maxH = Math.max(maxH, el.offsetHeight);
        });
        titles.forEach(function (el) {
          el.style.minHeight = maxH + 'px';
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', syncTitleHeights);
      } else {
        syncTitleHeights();
      }
      window.addEventListener('resize', syncTitleHeights);
      document.addEventListener('shopify:section:load', function (e) {
        if (e.detail.sectionId === '{{ section.id }}') syncTitleHeights();
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Images card",
  "tag": "section",
  "class": "section-pdp-why-different",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "heading"
    },
  
    {
      "type": "image_picker",
      "id": "icon_default",
      "label": "icon default"
    },
    {
      "type": "image_picker",
      "id": "icon_hover",
      "label": "icon hover"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "title",
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "description"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "image mobile"
        },
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "image desktop"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Images card",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "AI-Led Intimacy",
            "description": "Real-time AI responses make each interaction feel more natural, emotionally engaging, and genuinely personal instead of scripted."
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Software + Hardware in One Loop",
            "description": "The app and device work together in one connected system, so every voice, story, and sensation stays seamlessly in sync."
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Personal, Continuous, Evolving",
            "description": "Each interaction builds over time, creating an experience that feels more familiar and more uniquely yours."
          }
        }
      ]
    }
  ]
}
{% endschema %}
