        }
      ],
      "default": "link"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "次按钮链接",
      "visible_if": "{{ section.settings.secondary_button_action == 'link' }}"
    },
    {
      "type": "select",
      "id": "secondary_button_scroll_target",
      "label": "次按钮滚动目标",
      "options": [
        {
          "value": "swiper",
          "label": "3 Steps（步骤 Swiper）"
        },
