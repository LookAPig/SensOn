{%- liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image | default: desktop_image
-%}

<style>
  #shopify-section-{{ section.id }} .how_it_work_banner {
    --banner-height: {{ section.settings.desktop_height }};
    --banner-mobile-height: {{ section.settings.mobile_height }};
    --button-width: {{ section.settings.button_width_desktop }}px;
    --button-mobile-width: {{ section.settings.button_width_mobile }}px;
    background: #261334;
    color: #ffffff;
    min-height: var(--banner-height);
    overflow: hidden;
    position: relative;
  }

  #shopify-section-{{ section.id }} .how_it_work_banner .media,
  #shopify-section-{{ section.id }} .how_it_work_banner .image,
  #shopify-section-{{ section.id }} .how_it_work_banner .placeholder {
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .how_it_work_banner .image {
    object-fit: cover;
    object-position: center;
  }

  {%- unless section.settings.disable_overlay -%}
    #shopify-section-{{ section.id }} .how_it_work_banner .media::after {
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.80) 8.37%, rgba(0, 0, 0, 0.00) 100%);
      content: "";
      height: 500px;
      left: 0;
      pointer-events: none;
      position: absolute;
      top: 0;
      width: 100%;
    }
  {%- endunless -%}

  #shopify-section-{{ section.id }} .how_it_work_banner .mobile_image {
    display: none;
  }

  #shopify-section-{{ section.id }} .how_it_work_banner .placeholder {
    background:
      radial-gradient(ellipse at 50% 66%, rgb(245 128 255 / 0.95) 0%, rgb(174 65 224 / 0.75) 15%, transparent 43%),
      linear-gradient(180deg, #32173e 0%, #9b36c4 48%, #080714 100%);
  }

  #shopify-section-{{ section.id }} .how_it_work_banner .content {
    align-items: center;
    display: flex;
    flex-direction: column;
    left: 50%;
    max-width: 100%;
    padding: 40px 24px;
    position: absolute;
    text-align: center;
    top: 50%;
    transform: translate(-50%, -50%);
    width: calc(100% - 48px);
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .how_it_work_banner .tag {
    color: #f287ec;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 14px;
  }

  #shopify-section-{{ section.id }} .how_it_work_banner .title {
    color: #ffffff;
    font-size: 42px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 auto;
    max-width: 100%;
    text-align: center;
    word-wrap: break-word;
  }

  #shopify-section-{{ section.id }} .how_it_work_banner .description {
    font-size: 16px;
    line-height: 1.4;
    margin-top: 16px;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .how_it_work_banner .description p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .how_it_work_banner .buttons {
    align-items: center;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 24px;
    justify-content: center;
    margin-top: 28px;
    width: auto;
  }

  #shopify-section-{{ section.id }} .how_it_work_banner .button {
    align-items: center;
    border: 1px solid #ffffff;
    border-radius: 999px;
    display: flex;
    font-size: 18px;
    font-weight: 500;
    justify-content: center;
    line-height: 1.2;
    min-height: 48px;
    min-width: var(--button-width);
    padding: 12px 28px;
    text-decoration: none;
    transition: opacity 0.2s ease;
    width: auto;
  }

  #shopify-section-{{ section.id }} .how_it_work_banner .button:hover {
    opacity: 0.85;
  }

  #shopify-section-{{ section.id }} .how_it_work_banner .button_primary {
    background: #f287ec;
    border-color: #f287ec;
    color: #09020e;
  }

  #shopify-section-{{ section.id }} .how_it_work_banner .button_secondary {
    background: rgb(255 255 255 / 0.04);
    color: #ffffff;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .how_it_work_banner {
      min-height: var(--banner-mobile-height);
    }

    #shopify-section-{{ section.id }} .how_it_work_banner .desktop_image {
      display: none;
    }

    #shopify-section-{{ section.id }} .how_it_work_banner .mobile_image {
      display: block;
    }

    #shopify-section-{{ section.id }} .how_it_work_banner .content {
      max-width: 760px;
      padding: 24px 16px;
      top: 43.3%;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .how_it_work_banner .tag {
      font-size: 14px;
      margin-bottom: 14px;
    }

    #shopify-section-{{ section.id }} .how_it_work_banner .title {
      font-size: 28px;
      font-weight: 400;
      letter-spacing: -0.025em;
      line-height: 1.12;
    }

    #shopify-section-{{ section.id }} .how_it_work_banner .description {
      font-size: 14px;
      line-height: 1.08;
      margin-top: 14px;
      max-width: 310px;
    }

    #shopify-section-{{ section.id }} .how_it_work_banner .buttons {
      flex-direction: column;
      gap: 15px;
      margin-top: 22px;
      width: var(--button-mobile-width);
    }

    #shopify-section-{{ section.id }} .how_it_work_banner .button {
      font-size: 14px;
      min-height: 30px;
      min-width: 0;
      padding: 6px 14px;
      width: 100%;
    }
  }

  @media screen and (max-width: 374px) {
    #shopify-section-{{ section.id }} .how_it_work_banner .title {
      font-size: 25px;
    }
  }
</style>

<section
  class="how_it_work_banner"
  {% if section.settings.allow_transparent_header %}allow-transparent-header{% endif %}
>
  <div class="media" aria-hidden="true">
    {%- if desktop_image != blank -%}
      {{-
        desktop_image
        | image_url: width: 2400
        | image_tag:
          class: 'image desktop_image',
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '750, 1000, 1200, 1600, 2000, 2400'
      -}}
    {%- endif -%}

    {%- if mobile_image != blank -%}
      {{-
        mobile_image
        | image_url: width: 1000
        | image_tag:
          class: 'image mobile_image',
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '375, 550, 750, 1000'
      -}}
    {%- endif -%}

    {%- if desktop_image == blank and mobile_image == blank -%}
      <div class="placeholder"></div>
    {%- endif -%}
  </div>

  <div class="content">
    {%- if section.settings.tag != blank -%}
      <p class="tag">{{ section.settings.tag | escape }}</p>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 class="title">{{ section.settings.title | escape | newline_to_br }}</h1>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="description">{{ section.settings.description }}</div>
    {%- endif -%}

    {%- if section.settings.primary_button_text != blank or section.settings.secondary_button_text != blank -%}
      <div class="buttons">
        {%- if section.settings.primary_button_text != blank -%}
          {%- liquid
            assign primary_button_action = section.settings.primary_button_action | default: 'link'
            assign primary_scroll_target = section.settings.primary_button_scroll_target
            assign primary_scroll_custom = section.settings.primary_button_scroll_custom | strip
          -%}
          {%- if primary_button_action == 'scroll' -%}
            <a
              class="button button_primary"
              href="#"
              data-how-it-work-scroll
              data-scroll-target="{{ primary_scroll_target }}"
              {% if primary_scroll_target == 'custom' and primary_scroll_custom != blank %}
                data-scroll-custom="{{ primary_scroll_custom | escape }}"
              {% endif %}
            >
              {{- section.settings.primary_button_text | escape -}}
            </a>
          {%- else -%}
            <a class="button button_primary" href="{{ section.settings.primary_button_link | default: '#' }}">
              {{- section.settings.primary_button_text | escape -}}
            </a>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.secondary_button_text != blank -%}
          {%- liquid
            assign secondary_button_action = section.settings.secondary_button_action | default: 'link'
            assign secondary_scroll_target = section.settings.secondary_button_scroll_target
            assign secondary_scroll_custom = section.settings.secondary_button_scroll_custom | strip
          -%}
          {%- if secondary_button_action == 'scroll' -%}
            <a
              class="button button_secondary"
              href="#"
              data-how-it-work-scroll
              data-scroll-target="{{ secondary_scroll_target }}"
              {% if secondary_scroll_target == 'custom' and secondary_scroll_custom != blank %}
                data-scroll-custom="{{ secondary_scroll_custom | escape }}"
              {% endif %}
            >
              {{- section.settings.secondary_button_text | escape -}}
            </a>
          {%- else -%}
            <a class="button button_secondary" href="{{ section.settings.secondary_button_link | default: '#' }}">
              {{- section.settings.secondary_button_text | escape -}}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.primary_button_action == 'scroll' or section.settings.secondary_button_action == 'scroll' -%}
  <script>
    (() => {
      const sectionRoot = document.getElementById('shopify-section-{{ section.id }}');
      if (!sectionRoot) return;

      const selectorMap = {
        swiper: '.shopify-section--how-it-works-swiper',
        app: '.shopify-section--how-it-works-app',
        cards: '.shopify-section--how-it-works-cards',
        policy: '.shopify-section--how-it-works-policy'
      };

      function resolveScrollTarget(key, customId) {
        if (key === 'custom' && customId) {
          const id = customId.replace(/^#/, '');
          return document.getElementById(id);
        }

        if (key === 'control-1' || key === 'control-2') {
          const controls = document.querySelectorAll('.shopify-section--how-it-works-control');
          const index = key === 'control-1' ? 0 : 1;
          return controls[index] || null;
        }

        const selector = selectorMap[key];
        return selector ? document.querySelector(selector) : null;
      }

      sectionRoot.querySelectorAll('[data-how-it-work-scroll]').forEach((button) => {
        button.addEventListener('click', (event) => {
          event.preventDefault();

          const target = resolveScrollTarget(
            button.dataset.scrollTarget,
            button.dataset.scrollCustom
          );

          if (!target) return;

          target.scrollIntoView({
            block: 'start',
            behavior: window.matchMedia('(prefers-reduced-motion: no-preference)').matches ? 'smooth' : 'auto'
          });
        });
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "How it works banner",
  "tag": "section",
  "class": "shopify-section--how-it-works-banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "allow_transparent_header",
      "label": "启用透明页头",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "disable_overlay",
      "label": "取消遮罩层",
      "default": false
    },
    {
      "type": "header",
      "content": "图片"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "电脑端图片"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "移动端图片",
      "info": "建议使用接近 372 × 636 的竖版图片；未设置时使用电脑端图片。"
    },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "电脑端高度",
      "options": [
        {
          "value": "480px",
          "label": "小"
        },
        {
          "value": "600px",
          "label": "中"
        },
        {
          "value": "720px",
          "label": "大"
        },
        {
          "value": "100svh",
          "label": "全屏"
        }
      ],
      "default": "100svh"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "移动端高度",
      "options": [
        {
          "value": "480px",
          "label": "小"
        },
        {
          "value": "560px",
          "label": "中"
        },
        {
          "value": "710px",
          "label": "大"
        },
        {
          "value": "100svh",
          "label": "全屏"
        }
      ],
      "default": "710px"
    },
    {
      "type": "header",
      "content": "文案"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "标签",
      "default": "How It Works"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "标题",
      "default": "How SensOn S1 Works",
      "info": "支持换行；超出内容区最大宽度时自动折行并居中。"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "描述",
      "default": "<p>An app-connected intimacy device that brings<br>the SensOn App, AI companions,</p>"
    },
    {
      "type": "header",
      "content": "按钮"
    },
    {
      "type": "range",
      "id": "button_width_desktop",
      "label": "电脑端按钮宽度",
      "min": 120,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "button_width_mobile",
      "label": "移动端按钮宽度",
      "min": 120,
      "max": 360,
      "step": 4,
      "unit": "px",
      "default": 200
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "主按钮文案",
      "default": "Start in 3 Steps"
    },
    {
      "type": "select",
      "id": "primary_button_action",
      "label": "主按钮行为",
      "options": [
        {
          "value": "link",
