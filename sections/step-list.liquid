{%- if section.settings.heading != blank or section.settings.subtitle != blank or section.blocks.size > 0 -%}
  <div id="hiw-{{ section.id }}" class="how-it-works">
    <style>
      .how-it-works{
        --hiw-accent: {{ section.settings.accent_color | default: '#f287ec' }};
        width: 100%;
        background: #000;
        padding: 56px 16px 64px;
        box-sizing: border-box;
        color: #fff;
      }

  

      #hiw-{{ section.id }} .hiw-header {
        text-align: center;
        margin-bottom: 40px;
      }

      #hiw-{{ section.id }} .hiw-heading {
        margin: 0 0 12px;
        font-size: 36px;
        font-weight: 700;
        line-height: 1.15;
        color: #fff;
        letter-spacing: -0.02em;
      }

      #hiw-{{ section.id }} .hiw-subtitle {
        margin: 0;
        font-size: 16px;
        font-weight: 400;
        line-height: 1.4;
        color: #fff;
        opacity: 0.95;
      }

      #hiw-{{ section.id }} .hiw-swiper-wrap {
        position: relative;
        padding: 0 0 8px;
      }

      #hiw-{{ section.id }} .hiw-swiper {
        overflow: hidden;
      }

      #hiw-{{ section.id }} .hiw-slide {
        height: auto;
      }

      #hiw-{{ section.id }} .hiw-card {
        background: #141414;
        border-radius: 4px;
        padding: 32px 24px 36px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100%;
      }

      #hiw-{{ section.id }} .hiw-step-label {
        margin: 0 0 40px;
        font-size: 24px;
        font-weight: 700;
        line-height: 1.2;
        color: var(--hiw-accent);
      }

      #hiw-{{ section.id }} .hiw-icon {
        width: 72px;
        height: 72px;
        margin: 0 0 35px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      #hiw-{{ section.id }} .hiw-icon img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
      }

      #hiw-{{ section.id }} .hiw-card-title {
        margin: 0 0 12px;
        font-size: 24px;
        font-weight: 700;
        line-height: 1.25;
        color: #fff;
      }

      #hiw-{{ section.id }} .hiw-card-desc {
        margin: 0;
        font-size: 14px;
        font-weight: 400;
        line-height: 1.45;
        color: rgba(255, 255, 255, 0.88);
      }

      #hiw-{{ section.id }} .hiw-nav-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 40px;
        height: 40px;
        margin-top: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #fff;
        z-index: 2;
      }

      #hiw-{{ section.id }} .hiw-nav-btn::after {
        font-size: 16px;
        font-weight: 700;
      }

      #hiw-{{ section.id }} .hiw-nav-btn.swiper-button-disabled {
        opacity: 0.25;
      }

      #hiw-{{ section.id }} .hiw-nav-prev {
        left: -4px;
      }

      #hiw-{{ section.id }} .hiw-nav-next {
        right: -4px;
      }

      #hiw-{{ section.id }} .hiw-pagination {
        position: relative;
        margin-top: 20px;
      }

      #hiw-{{ section.id }} .hiw-pagination .swiper-pagination-bullet {
        width: 8px;
        height: 8px;
        background: rgba(255, 255, 255, 0.35);
        opacity: 1;
      }

      #hiw-{{ section.id }} .hiw-pagination .swiper-pagination-bullet-active {
        background: var(--hiw-accent);
      }

      @media screen and (min-width: 769px) {
        #hiw-{{ section.id }} {
          padding: 72px 24px 80px;
        }

        #hiw-{{ section.id }} .hiw-heading {
          font-size: 42px;
        }

        #hiw-{{ section.id }} .hiw-header {
          margin-bottom: 48px;
        }

        #hiw-{{ section.id }} .hiw-swiper-wrap {
          padding: 0;
        }

        #hiw-{{ section.id }} .hiw-nav-btn,
        #hiw-{{ section.id }} .hiw-pagination {
          display: none;
        }
      }

      @media screen and (max-width: 768px) {
        #hiw-{{ section.id }} .hiw-heading {
          font-size: 24px;
                margin-bottom: 5px;
        }

        #hiw-{{ section.id }} .hiw-swiper-wrap {
          padding: 0 0;
        }

        #hiw-{{ section.id }} .hiw-card {
          padding: 28px 20px 32px;
        }
        .how-it-works {
              padding-right: 0;
          }
            #hiw-{{ section.id }} .hiw-header {
        text-align: left;
        margin-bottom: 15px;
      }
   #hiw-{{ section.id }} .hiw-subtitle {
        font-size: 14px;
      }
       #hiw-{{ section.id }} .hiw-card-title {
        font-size: 16px;
      
      }

      #hiw-{{ section.id }} .hiw-card-desc {
        font-size: 12px;
       
      }

      #hiw-{{ section.id }} .hiw-step-label {
        margin: 0 0 24px;
        font-size: 16px;
       
      }
        #hiw-{{ section.id }} .hiw-icon {
        width: 50px;
        height: 50px;
        margin: 0 0 20px;
      }
      }
    </style>

    <div class="hiw-inner limit-width">
      <div class="hiw-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="hiw-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="hiw-subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="hiw-swiper-wrap">
          <div class="swiper hiw-swiper" id="hiw-swiper-{{ section.id }}">
            <div class="swiper-wrapper">
              {%- for block in section.blocks -%}
                {%- if block.settings.step_label != blank
                  or block.settings.title != blank
                  or block.settings.description != blank
                  or block.settings.icon != blank
                -%}
                  <div class="swiper-slide hiw-slide" {{ block.shopify_attributes }}>
                    <div class="hiw-card">
                      {%- if block.settings.step_label != blank -%}
                        <p class="hiw-step-label">{{ block.settings.step_label | escape }}</p>
                      {%- endif -%}
                      {%- if block.settings.icon != blank -%}
                        <div class="hiw-icon">
                          {{
                            block.settings.icon
                            | image_url: width: 144
                            | image_tag: loading: 'lazy', widths: '72, 144', sizes: '72px', alt: block.settings.title
                          }}
                        </div>
                      {%- endif -%}
                      {%- if block.settings.title != blank -%}
                        <h3 class="hiw-card-title">{{ block.settings.title | escape }}</h3>
                      {%- endif -%}
                      {%- if block.settings.description != blank -%}
                        <p class="hiw-card-desc">{{ block.settings.description | escape }}</p>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
          <button type="button" class="swiper-button-prev hiw-nav-btn hiw-nav-prev" aria-label="Previous"></button>
          <button type="button" class="swiper-button-next hiw-nav-btn hiw-nav-next" aria-label="Next"></button>
          <div class="swiper-pagination hiw-pagination"></div>
        </div>
      {%- endif -%}
    </div>
  </div>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
  <script>
    (function () {
      var rootId = 'hiw-{{ section.id }}';
      var swiperEl = document.getElementById('hiw-swiper-{{ section.id }}');
      if (!swiperEl) return;

      var wrap = swiperEl.closest('.hiw-swiper-wrap');
      var prevEl = wrap ? wrap.querySelector('.hiw-nav-prev') : null;
      var nextEl = wrap ? wrap.querySelector('.hiw-nav-next') : null;
      var paginationEl = wrap ? wrap.querySelector('.hiw-pagination') : null;
      var instance = null;
      var MOBILE_MAX = 768;

      function isMobile() {
        return window.innerWidth <= MOBILE_MAX;
      }

      function getOptions() {
        if (isMobile()) {
          return {
            slidesPerView: 1.2,
            spaceBetween: 16,
            centeredSlides: false,
            watchOverflow: true,
            navigation: {
              nextEl: nextEl,
              prevEl: prevEl,
            },
            pagination: {
              el: paginationEl,
              clickable: true,
            },
          };
        }
        return {
          slidesPerView: 3,
          spaceBetween: 20,
          allowTouchMove: false,
          watchOverflow: true,
          navigation: false,
          pagination: false,
        };
      }

      function initSwiper() {
        if (typeof Swiper === 'undefined') {
          setTimeout(initSwiper, 50);
          return;
        }
        if (instance) {
          instance.destroy(true, true);
          instance = null;
        }
        instance = new Swiper(swiperEl, getOptions());
      }

      function onResize() {
        if (!instance) {
          initSwiper();
          return;
        }
        var mobile = isMobile();
        var wasMobile = instance.params.slidesPerView < 2;
        if (mobile !== wasMobile) {
          initSwiper();
        } else {
          instance.update();
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSwiper);
      } else {
        initSwiper();
      }

      window.addEventListener('resize', onResize);
      document.addEventListener('shopify:section:load', function (e) {
        if (e.detail && e.detail.sectionId === '{{ section.id }}') {
          initSwiper();
        }
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "How it works",
  "class": "shopify-section--how-it-works",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How it Works"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Follow these simple steps"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Step label color",
      "default": "#f287ec"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "step_label",
          "label": "Step label",
          "default": "1.Sign Up"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Join the Community"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_label": "1.Sign Up",
            "title": "Join the Community",
            "description": "Apply via Impact.com.We review within 24h."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_label": "2.Share",
            "title": "Promote Your Way",
            "description": "Access unique links and high-converting assets."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_label": "3.Earn",
            "title": "Get Paid Monthly",
            "description": "15% commission + recurring rewards."
          }
        }
      ]
    }
  ]
}
{% endschema %}
