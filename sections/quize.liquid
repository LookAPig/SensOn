<section
  class="quize-wrapper section-spacing"
  {% if section.settings.bg %}
    style="background-image: url('{{ section.settings.bg | image_url: width: 2000 }}');"
  {% endif %}
>
  <div id="pdp-quize" class="quize-box">
    <div class="quize-left">
      {% if section.settings.title %}
        <h2>{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle %}
        <p>{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
    <div class="quize-right">
      <div class="quize-question-wrapper js-quize-question-wrapper">
        {% comment %} 步数 {% endcomment %}
        <div class="quize-question-steps js-quize-steps"><p></p></div>

        <div class="quize-question-box js-quize-question-box">
          {% comment %} 问题 {% endcomment %}
          <div class="js-quize-question-title h5"></div>

          {% comment %} 选项 {% endcomment %}
          <div class="js-quize-btn-wrapper"></div>
        </div>

        <div class="quize-question-nav-wrapper js-quize-question-nav-wrapper">
          <div class="quize-question-nav-item js-quize-nav-left">
            <svg stroke="currentColor" width="20" height="20" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" ></path>
            </svg>
            <span>Back</span>
          </div>
          <div class="quize-question-nav-item js-quize-nav-right">
            <span>Next</span>
            <svg class="quize-question-icon-right" stroke="currentColor" width="20" height="20" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
            <svg class="quize-question-icon-hook" stroke="currentColor" width="20" height="20" viewBox="0 0 24 24">
              <path  stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
        </div>

        {% comment %} result {% endcomment %}
        <div class="quize-question-result-wrapper js-quize-question-result-wrapper">
          <div class="h3">Velvet Touch</div>
          <p>
            You crave soft, slow, sensory pleasure—warm hands, quiet moments, and gentle tension that lets you melt
            without pressure.
          </p>
          <div class="quize-question-result-img-box">
            <img src="" />
          </div>
          <div>
            <button class="js-quize-question-reset">Restart Quiz</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
      var quizeData = [
        {% for block in section.blocks %}
          {% if block.type == 'item' %}
            {
              question: {{ block.settings.question | json }},
              answers: [
                {
                  text: {{ block.settings.answer_1 | json }},
                  mode: {{ block.settings.mode1 | json }},
                  score: {{ block.settings.score_1 }},
                  option: {{ block.settings.option_1 | json }},
                  optionScore: {{block.settings.option_score_1 }}
                },
                {
                  text: {{ block.settings.answer_2 | json }},
                  mode: {{ block.settings.mode_2 | json }},
                  score: {{ block.settings.score_2 }},
                  option: {{ block.settings.option_2 | json }},
                  optionScore: {{block.settings.option_score_2 }}
                },
                {
                  text: {{ block.settings.answer_3 | json }},
                  mode: {{ block.settings.mode_3 | json }},
                  score: {{ block.settings.score_3 }},
                  option: {{ block.settings.option_3 | json }},
                  optionScore: {{block.settings.option_score_3 }}
                },
                {
                  text: {{ block.settings.answer_4 | json }},
                  mode: {{ block.settings.mode_4 | json }},
                  score: {{ block.settings.score_4 }},
                  option: {{ block.settings.option_4 | json }},
                  optionScore: {{block.settings.option_score_4 }}
                },
                {
                  text: {{ block.settings.answer_5 | json }},
                  mode: {{ block.settings.mode_5 | json }},
                  score: {{ block.settings.score_5 }},
                  option: {{ block.settings.option_5 | json }},
                  optionScore: {{block.settings.option_score_5 }}
                }
              ]
            }{% unless forloop.last %},{% endunless %}
          {% endif %}
        {% endfor %}
      ];
    
      {% assign result_block = nil %}
        
        {% for b in section.blocks %}
        {% if b.type == 'quize_result' %}
            {% assign result_block = b %}
            {% break %}
        {% endif %}
        {% endfor %}
    
    var quizeResultData = null;
    {% if result_block %}
        quizeResultData = {
          dom_gentle: {
            {% if result_block.settings.result_img_dom_gentle %}
            img: {{ result_block.settings.result_img_dom_gentle | image_url: width: 1200 | json }},
            {% else %}
                img: '',
                {% endif %}
            title: {{ result_block.settings.result_title_dom_gentle | json }},
            desc: {{ result_block.settings.result_desc_dom_gentle | json }}
          },
          dom_rough: {
            {% if result_block.settings.result_img_dom_rough %}
            img: {{ result_block.settings.result_img_dom_rough | image_url: width: 1200 | json }},
            {% else %}
                img: '',
                {% endif %}
            title: {{ result_block.settings.result_title_dom_rough | json }},
            desc: {{ result_block.settings.result_desc_dom_rough | json }}
          },
          dom_training: {
            {% if result_block.settings.result_img_dom_training %}
            img: {{ result_block.settings.result_img_dom_training | image_url: width: 1200 | json }},
            {% else %}
                img: '',
                {% endif %}
            title: {{ result_block.settings.result_title_dom_training | json }},
            desc: {{ result_block.settings.result_desc_dom_training | json }}
          },
      
          sub_gentle: {
            {% if result_block.settings.result_img_sub_gentle %}
            img: {{ result_block.settings.result_img_sub_gentle | image_url: width: 1200 | json }},
            {% else %}
                img: '',
                {% endif %}
            title: {{ result_block.settings.result_title_sub_gentle | json }},
            desc: {{ result_block.settings.result_desc_sub_gentle | json }}
          },
          sub_rough: {
            {% if result_block.settings.result_img_sub_rough %}
            img: {{ result_block.settings.result_img_sub_rough | image_url: width: 1200 | json }},
            {% else %}
                img: '',
                {% endif %}
            title: {{ result_block.settings.result_title_sub_rough | json }},
            desc: {{ result_block.settings.result_desc_sub_rough | json }}
          },
          sub_training: {
            {% if result_block.settings.result_img_sub_training %}
            img: {{ result_block.settings.result_img_sub_training | image_url: width: 1200 | json }},
            {% else %}
                img: '',
                {% endif %}
            title: {{ result_block.settings.result_title_sub_training | json }},
            desc: {{ result_block.settings.result_desc_sub_training | json }}
          },
      
          equal_gentle: {
            {% if result_block.settings.result_img_equal_gentle %}
            img: {{ result_block.settings.result_img_equal_gentle | image_url: width: 1200 | json }},
            {% else %}
                img: '',
                {% endif %}
            title: {{ result_block.settings.result_title_equal_gentle | json }},
            desc: {{ result_block.settings.result_desc_equal_gentle | json }}
          },
          equal_rough: {
            {% if result_block.settings.result_img_equal_rough %}
            img: {{ result_block.settings.result_img_equal_rough | image_url: width: 1200 | json }},
            {% else %}
                img: '',
                {% endif %}
            title: {{ result_block.settings.result_title_equal_rough | json }},
            desc: {{ result_block.settings.result_desc_equal_rough | json }}
          },
          equal_training: {
            {% if result_block.settings.result_img_equal_training %}
            img: {{ result_block.settings.result_img_equal_training | image_url: width: 1200 | json }},
            {% else %}
                img: '',
                {% endif %}
            title: {{ result_block.settings.result_title_equal_training | json }},
            desc: {{ result_block.settings.result_desc_equal_training | json }}
          }
        }
  {% endif %}
    
      
        if (quizeData.length) {
        let curIndex = 0;
        let curQuestion;
        let scoreMap = [];
      
        const questionWrapper = document.querySelector(".js-quize-question-wrapper");
        const questionSteps = questionWrapper.querySelector(".js-quize-steps");
        const questionBox = questionWrapper.querySelector(".js-quize-question-box");
        const questionTitle = questionBox.querySelector(".js-quize-question-title");
        const questionBtnWrapper = questionBox.querySelector(".js-quize-btn-wrapper");
        const resultWrapper = questionWrapper.querySelector(".js-quize-question-result-wrapper")
      
        const fn = () => {
          curQuestion = quizeData[curIndex];
      
          questionTitle.textContent = curQuestion.question;
      
          questionSteps.querySelector("p").innerText = `${curIndex + 1}/${quizeData.length}`;
          questionSteps.style.setProperty('--quize-step-percentage', `${(curIndex + 1) / quizeData.length * 100}%`);
      
          const fragment = document.createDocumentFragment();
          const answerList = curQuestion.answers.filter((v) => v.text && v.mode && v.option && (v.score !== undefined || v.score !== '') && (v.optionScore !== undefined || v.optionScore !== ''));
      
          answerList.forEach((v, i) => {
            const btn = document.createElement('button');
            btn.textContent = v.text;
            btn.setAttribute('data-step', curIndex);
            btn.setAttribute('data-index', i);
            btn.setAttribute('data-mode', v.mode);
            btn.setAttribute('data-score', v.score);
            btn.setAttribute('data-option', v.option);
            btn.setAttribute('data-option-score', v.optionScore);
            btn.className = "js-quize-question-answer";
            fragment.appendChild(btn);
          });
          questionBtnWrapper.innerHTML = "";
          questionBtnWrapper.appendChild(fragment);
      
          if (!scoreMap[curIndex]) {
            questionWrapper.querySelector('.js-quize-nav-right')?.classList?.add('is-disabled-nav');
          }
      
          if (curIndex === 0) {
            questionWrapper.querySelector('.js-quize-nav-left')?.classList?.add('is-disabled-nav');
            questionWrapper.querySelector('.js-quize-nav-right span').innerText = "Next";
          }
      
          if (curIndex === quizeData.length - 1) {
            questionWrapper.querySelector('.js-quize-nav-left')?.classList?.remove('is-disabled-nav');
            questionWrapper.querySelector('.js-quize-nav-right span').innerText = "Submit";
            questionWrapper.classList.add("is-hook")
          } else {
            questionWrapper.querySelector('.js-quize-nav-right span').innerText = "Next";
            questionWrapper.classList.remove("is-hook")
          }
        }
        
        const showResult = () => {
          const innerFn = (type, sortType = "score") => {
            const ret = scoreMap.reduce((acc, cur) => {
              const key = cur[type];
              const scoreType = type === "option" ? 'optionScore' : 'score';
              
              if (!acc[key]) {
                acc[key] = {
                  count: 0,
                  score: 0,
                };
              }
              acc[key].count += 1;
              acc[key].score += Number(cur[scoreType]);
              return acc;
            }, {});
        
            let result;
            let max = 0;
            
            Object.keys(ret).forEach((key) => {
              const { count, score } = ret[key];
              let temp = sortType === "count" ? count : score;
              if (temp > max) {
                max = temp;
                result = key;
              }
            });
            return result;
          };
        
          let mode = innerFn('mode');
          let option = innerFn('option');
          if (quizeResultData) {
            const key = [mode, option].map(v => v.toLowerCase()).join("_");
            const ret = quizeResultData[key];
           
            const img = resultWrapper.querySelector("img");
            const title = resultWrapper.querySelector("h3");
            const desc = resultWrapper.querySelector("p");
            img.src = ret.img;
            title.innerText = ret.title;
            desc.innerHTML = ret.desc;

            // show result
            setTimeout(()=>{
              questionWrapper.classList.toggle("is-show-result");
              resultWrapper.classList.toggle("is-show-result");
            }, 10);
          }
        }
      
        questionWrapper.addEventListener('click', (e) => {
          // 算分
          if (e.target.classList.contains('js-quize-question-answer')) {
            const { step, index, mode, score, option, optionScore } = e.target.dataset;
            const indexNum = +step;
            scoreMap[indexNum] = { step, index, mode, score, option, optionScore };
            console.log("scoreMap",scoreMap)
            questionBtnWrapper.querySelectorAll(".js-quize-question-answer").forEach((v, i) => v.dataset.index !== index && v.classList.remove('is-active-answer'));
            e.target.classList.add("is-active-answer");
      
            indexNum !== 0 && questionWrapper.querySelector('.js-quize-nav-left')?.classList?.remove('is-disabled-nav');
            questionWrapper.querySelector('.js-quize-nav-right')?.classList?.remove('is-disabled-nav');
          }
      
          if (e.target.classList.contains('js-quize-nav-left')) {
            if (curIndex === 0) return;
            scoreMap = scoreMap.slice(0, curIndex);
            curIndex = curIndex - 1 < 0 ? 0 : curIndex - 1;
            fn();
            const el = questionBtnWrapper.querySelectorAll(".js-quize-question-answer")[curIndex]
            el.focus();
            el.click();
          }
      
          if (e.target.classList.contains('js-quize-nav-right')) {
            if (!scoreMap[curIndex]) return;
            if (curIndex + 1 >= quizeData.length) {
              // 展示结果y
              showResult();
              return
            }
            curIndex = curIndex + 1 >= quizeData.length ? quizeData.length - 1 : curIndex + 1;
            fn();
          }

          if(e.target.classList.contains("js-quize-question-reset")) {
            curIndex = 0;
            scoreMap = [];

            fn();

            questionWrapper.classList.toggle("is-show-result");
            resultWrapper.classList.toggle("is-show-result");
          }
        });
      
        fn();
      }
</script>

<style>
  .quize-wrapper {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    {% comment %} padding: 96px 0; {% endcomment %}
  }
  .quize-box {
    margin: 0 auto;
    max-width: 1400px;
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    box-sizing: border-box;
    padding: 0 20px;
  }
  .quize-box > div {
    flex: 1;
  }

  .quize-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .quize-left h2 {
    color: #fff;
    font-size: 42px;
    line-height: 63px;
    margin-bottom: 24px;
  }
  .quize-left p {
    color: rgb(156, 163, 175);
    font-size: 22px;
    line-height: 33px;
    margin-bottom: 32px;
  }

  .quize-question-wrapper {
    background-color: rgba(0, 0, 0, 0.75);
    box-sizing: border-box;
    max-width: 464px;
    border: 1px solid rgb(31, 41, 55);
    margin: 0 auto;
    padding: 20px;
    border-radius: 16px;

    display: flex;
    flex-direction: column;
  }

  .quize-question-steps {
    color: #fff;
    text-align: center;
    font-size: 16px;
    margin-bottom: 24px;
    position: relative;
  }
  .quize-question-steps::after {
    content: '';
    display: block;
    background: rgb(55, 65, 81);
    margin-top: 12px;
    width: 100%;
    height: 8px;
    border-radius: 4px;
  }
  .quize-question-steps::before {
    content: '';
    display: block;
    height: 8px;
    width: var(--quize-step-percentage, 0);
    background-image: linear-gradient(to right, rgb(236, 72, 153), rgb(168, 85, 247));
    border-radius: 4px;

    transition: width 0.15s ease-in-out;

    position: absolute;
    left: 0;
    bottom: 0;
  }

  .quize-question-box {
    color: #fff;
    margin-bottom: 24px;
    max-height: 100vh;
    transition: all 0.3s ease-in-out;
  }

  .quize-question-box .h5 {
    text-align: center;
    margin-bottom: 24px;
    text-transform: none !important;
  }

  .quize-question-box > div {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: center;
    justify-content: center;
  }

  .quize-question-box > div > button {
    display: block;
    {% comment %} max-width: 60%;
    min-width: 60%; {% endcomment %}
    flex: 1;
    width: 100%;
    /* flex: 1; */
    border: 1px solid red;
    margin: auto;
    border: 1px solid rgba(255, 255, 255, 0.3);
    line-height: 50px;
    border-radius: 50px;
    transition: background 0.15s ease-in-out;
    line-height: 1.5;
    padding: 5px 10px;
    min-height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quize-question-box > div > button:hover,
  .quize-question-box > div > button:focus,
  .quize-question-box > div > button.is-active-answer {
    background-color: rgba(242, 135, 236, 1);
    color: #000;
  }

  .quize-question-nav-wrapper {
    display: flex;
    justify-content: space-between;
    --tw-text-opacity: 1;
    color: rgb(236 72 153 / var(--tw-text-opacity, 1));
  }
  .quize-question-nav-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    transition: opacity 0.15s ease-in-out;
  }
  .quize-question-nav-item::after {
    content: '';
    position: absolute;
    z-index: 1;
    opacity: 0;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
  }
  .quize-question-nav-item span {
    color: #fff;
    padding: 0 4px;
    font-size: 16px;
  }
  .quize-question-nav-item.is-disabled-nav {
    opacity: 0.5;
  }
  {% comment %} 结果 {% endcomment %}
   .quize-question-result-wrapper{
    display: flex;
    flex-direction: column;
    width: 0;
    height:0;
    opacity:0;
    transition: all 0.15s ease-in-out;
    overflow: hidden
  }
  .quize-question-result-wrapper.is-show-result {
    width: auto;
    height: auto;
    opacity: 1;
    overflow: unset
  }
  .quize-question-result-img-box {
    max-width: 80%;
    margin: 16px auto 32px
  }
  .quize-question-result-wrapper .h3{
    color: #fff;
    font-size: 30px;
    margin-bottom: 16px;
    text-align:center;
  }
  .quize-question-result-wrapper p{
    color:rgb(209, 213, 219);
    font-size: 16px;
    {% comment %} margin-bottom: 32px; {% endcomment %}
    line-height: 28px;
  }
  .quize-question-result-wrapper button{
    display: block;
    margin: 0 auto;
    font-size: 16px;
    color:#fff;
    background: linear-gradient(93.25deg, rgb(242, 135, 236) 7.14%, rgb(133, 67, 255) 99.1%);
    line-height:48px;
    padding: 0 24px;
    border-radius: 24px;
  }

  .quize-question-wrapper.is-show-result .quize-question-steps ,
  .quize-question-wrapper.is-show-result  .quize-question-box,
  .quize-question-wrapper.is-show-result .quize-question-nav-wrapper  {
    height: 0;
    opacity: 0;
    margin: 0;
    overflow: hidden;
    pointer-events: none;
  }

    {% comment %} 提交按钮 {% endcomment %}
  .quize-question-wrapper.is-hook .quize-question-icon-right{
    display: none
  }
  .quize-question-wrapper .quize-question-icon-hook {
    display: none
  }
  .quize-question-wrapper.is-hook .quize-question-icon-hook {
    display: block
  }

  @media (max-width: 1200px) {
     .quize-wrapper .quize-box{
      flex-direction: column;
      gap: 32px;
      padding: 0 16px;
    }
    .quize-left{
      text-align: center;
    }
     .quize-left h2 {
      font-size: 32px;
      line-height: 48px;
       margin-bottom: 8px
    }
    .quize-left p {
      font-size: 14px;
      line-height: 1.3;
      margin-bottom: 0
    }
    .quize-question-box > div {
      gap: 16px;
    }
    .quize-question-box > div > button{
      {% comment %} max-width: 70%;
      min-width: 70%; {% endcomment %}
       flex: 1;
    width: 100%;
    }
  }
    @media (max-width: 768px) {
  .quize-question-box h2 {
       margin-bottom: 14px;
    font-size: 16px;
}
    .quize-question-box > div {
        gap: 10px;
    }
}
</style>

{% schema %}
{
  "name": "Custom Quize",
  "limit": 1,
  "settings": [
    {
      "type": "image_picker",
      "id": "bg",
      "label": "背景图"
    },
    {
      "type": "text",
      "id": "title",
      "label": "主标题",
      "default": "Find Your Pleasure Style"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "副标题",
      "default": "Step two: answer a few quick questions to discover what turns you on."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "问题"
        },
        {
          "type": "header",
          "content": "答案1设置"
        },
        {
          "type": "text",
          "id": "answer_1",
          "label": "答案"
        },
        {
          "type": "select",
          "id": "mode1",
          "label": "权利方式",
          "options": [
            {
              "value": "Dom",
              "label": "Dom"
            },
            {
              "value": "Equal",
              "label": "Equal"
            },
            {
              "value": "Sub",
              "label": "Sub"
            }
          ]
        },
        {
          "type": "number",
          "id": "score_1",
          "label": "分值",
          "default": 1
        },
        {
          "type": "select",
          "id": "option_1",
          "label": "操作方式",
          "options": [
            {
              "value": "Gentle",
              "label": "Gentle"
            },
            {
              "value": "Rough",
              "label": "Rough"
            },
            {
              "value": "Training",
              "label": "Training"
            }
          ]
        },
        {
          "type": "number",
          "id": "option_score_1",
          "label": "分值",
          "default": 1
        },
        {
          "type": "header",
          "content": "答案2设置"
        },
        {
          "type": "text",
          "id": "answer_2",
          "label": "答案"
        },
        {
          "type": "select",
          "id": "mode_2",
          "label": "权利方式",
          "options": [
            {
              "value": "Dom",
              "label": "Dom"
            },
            {
              "value": "Equal",
              "label": "Equal"
            },
            {
              "value": "Sub",
              "label": "Sub"
            }
          ]
        },
        {
          "type": "number",
          "id": "score_2",
          "label": "分值",
          "default": 1
        },

        {
          "type": "select",
          "id": "option_2",
          "label": "操作方式",
          "options": [
            {
              "value": "Gentle",
              "label": "Gentle"
            },
            {
              "value": "Rough",
              "label": "Rough"
            },
            {
              "value": "Training",
              "label": "Training"
            }
          ]
        },
        {
          "type": "number",
          "id": "option_score_2",
          "label": "分值",
          "default": 1
        },
        {
          "type": "header",
          "content": "答案3设置"
        },
